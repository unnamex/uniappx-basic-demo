/**
 * MPM 工艺预览系统 - 节点内容查询服务
 * @description 按需查询工艺节点的富文本描述等扩展内容
 */

import { querySQL } from '@/services/database'
// #ifdef WEB
import { webGetByKey } from '@/services/database'
// #endif

/**
 * 根据节点 ID 查询富文本内容
 * @param nodeId 工艺节点 innerId
 * @returns 包含描述信息的对象，包含 nodeId, description_html 等字段
 */
export function getNodeContent(nodeId: string): Promise<UTSJSONObject | null> {
	return new Promise((resolve, reject) => {
		// #ifdef WEB
		webGetByKey('t_node_content', nodeId)
			.then((res) => {
				if (res != null) {
					// Web 端存的是完整 JSON 字符串在 content_json 字段里，或者直接存的对象
					// 根据导入逻辑：webPutData('t_node_content', { node_id, content_json: JSON.stringify(desc) })
					const contentStr = res['content_json'] as string | null
					if (contentStr != null) {
						resolve(JSON.parse(contentStr) as UTSJSONObject)
					} else {
						resolve(res)
					}
				} else {
					resolve(null)
				}
			})
			.catch(err => reject(err))
		// #endif

		// #ifndef WEB
		const sql = "SELECT content_json FROM t_node_content WHERE node_id = ?"
		querySQL(sql, [nodeId])
			.then((rows) => {
				if (rows.length > 0) {
					const contentStr = rows[0]['content_json'] as string | null
					if (contentStr != null) {
						resolve(JSON.parse(contentStr) as UTSJSONObject)
					} else {
						resolve(null)
					}
				} else {
					resolve(null)
				}
			})
			.catch(err => reject(err))
		// #endif
	})
}

/**
 * 批量查询多个工艺节点的富文本内容
 * @param nodeIds 节点 ID 数组
 * @returns Map<innerId, contentObject>
 */
export function getNodeContentBatch(nodeIds: string[]): Promise<Map<string, UTSJSONObject>> {
	return new Promise((resolve, reject) => {
		const result = new Map<string, UTSJSONObject>()
		if (nodeIds.length == 0) {
			resolve(result)
			return
		}

		// #ifdef WEB
		// Web 端目前没有便捷的批量主键查询，循环处理（对于少量节点性能 OK，后期可优化索引）
		const promises = nodeIds.map(id => getNodeContent(id))
		Promise.all(promises).then((contents) => {
			contents.forEach((c, index) => {
				if (c != null) {
					result.set(nodeIds[index], c)
				}
			})
			resolve(result)
		}).catch(err => reject(err))
		// #endif

		// #ifndef WEB
		// 构造 IN (?, ?, ...)
		const placeHolders = nodeIds.map(_ => '?').join(',')
		const sql = `SELECT node_id, content_json FROM t_node_content WHERE node_id IN (${placeHolders})`
		querySQL(sql, nodeIds)
			.then((rows) => {
				rows.forEach((row) => {
					const nodeId = row['node_id'] as string
					const contentStr = row['content_json'] as string | null
					if (nodeId != null && contentStr != null) {
						result.set(nodeId, JSON.parse(contentStr) as UTSJSONObject)
					}
				})
				resolve(result)
			})
			.catch(err => reject(err))
		// #endif
	})
}

// #ifdef WEB
/**
 * Web 平台文件选择
 */
function selectFileWeb(
	resolve: (value: PackageInfo) => void, 
	reject: (reason: Error) => void
): void {
	try {
		const input = document.createElement('input')
		input.type = 'file'
		input.accept = '.srd'
		
		input.onchange = (event: Event) => {
			const target = event.target as HTMLInputElement
			if (target.files != null && target.files.length > 0) {
				const file = target.files[0]
				selectedFilePath = URL.createObjectURL(file)
				
				resolve({
					fileName: file.name,
					fileSize: file.size,
					manifest: null,
					isValid: true,
					errorMessage: ''
				})
			} else {
				reject(new Error('未选择文件'))
			}
		}
		
		input.click()
	} catch (e: any) {
		reject(e)
	}
}
// #endif

/**
 * 获取文件名
 */
function getFileName(filePath: string): string {
	const parts = filePath.split('/')
	return parts[parts.length - 1]
}

/**
 * 验证并预览数据包
 * @param filePath - 文件路径
 * @returns Promise<PackageManifest> 数据包清单
 */
export function validatePackage(filePath: string = selectedFilePath): Promise<PackageManifest> {
	const actualPath = filePath != '' ? filePath : selectedFilePath
	console.log('validatePackage using path:', actualPath)
	return new Promise((resolve: (value: PackageManifest) => void, reject: (reason: Error) => void) => {
		if (actualPath == '') {
			reject(new Error('未选择数据包文件'))
			return
		}
		readFileAsArrayBuffer(actualPath)
			.then((encryptedData: ArrayBuffer) => {
				// 尝试解密，如果失败则假设为未加密的ZIP
				let zipData = encryptedData
				const decryptResult = decryptPackage(encryptedData)
				console.log('validatePackage: 解密结果 success =', decryptResult.success, ' msg =', decryptResult.errorMessage)
				if (decryptResult.success && decryptResult.data != null) {
					zipData = decryptResult.data!
				}
				
				// 解压并读取清单文件
				parseManifestFromZip(zipData)
					.then((manifest: PackageManifest) => {
						resolve(manifest)
					})
					.catch((e: any) => {
						console.error('validatePackage: parseManifestFromZip 失败:', e)
						const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown')
						reject(new Error(errMsg))
					})
			})
			.catch((e: any) => {
				console.error('validatePackage: readFileAsArrayBuffer 失败:', e)
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown')
				reject(new Error(errMsg))
			})
	})
}

/**
 * 导入数据包
 * @param filePath - 文件路径
 * @param onProgress - 进度回调
 * @returns Promise<ImportResult> 导入结果
 */
export function importPackage(
	filePath: string = selectedFilePath, 
	onProgress: ImportProgressCallback | null = null
): Promise<ImportResult> {
	const startTime = Date.now()
	const actualPath = filePath != '' ? filePath : selectedFilePath
	console.log('importPackage using path:', actualPath)
	
	return new Promise((resolve: (value: ImportResult) => void, reject: (reason: Error) => void) => {
		if (actualPath == '') {
			reject(new Error('未选择数据包文件'))
			return
		}
		
		// 更新进度：开始读取文件
		if (onProgress != null) {
			onProgress({
				current: 0,
				total: 100,
				currentFile: '读取数据包...',
				status: 'reading'
			})
		}
		
		readFileAsArrayBuffer(actualPath)

			.then((encryptedData: ArrayBuffer) => {
				// 更新进度：解密中
				if (onProgress != null) {
					onProgress({
						current: 20,
						total: 100,
						currentFile: '解密数据包...',
						status: 'decrypting'
					})
				}
				
				let zipData = encryptedData
				const decryptResult = decryptPackage(encryptedData)
				if (decryptResult.success && decryptResult.data != null) {
					zipData = decryptResult.data!
				}
				
				// 尝试作为普通 JSON 解析 (单文件数据包)
				
				// 更新进度：解压中
				if (onProgress != null) {
					onProgress({
						current: 40,
						total: 100,
						currentFile: '解压数据包...',
						status: 'extracting'
					})
				}
				
				// 解压并解析数据
				extractAndParsePackage(zipData, onProgress)
					.then((res: ImportResult) => {
						// 更新进度：完成
						if (onProgress != null) {
							onProgress({
								current: 100,
								total: 100,
								currentFile: '导入完成',
								status: 'completed'
							})
						}
						
						res.importTime = Date.now() - startTime
						resolve(res)
					})
					.catch((e: any) => {
						reject(new Error(JSON.stringify(e)))
					})
			})
			.catch((e: any) => {
				reject(new Error(JSON.stringify(e)))
			})
	})
}

/**
 * 读取文件为 ArrayBuffer
 */
function readFileAsArrayBuffer(filePath: string): Promise<ArrayBuffer> {
	return new Promise((resolve: (value: ArrayBuffer) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID || APP-HARMONY
		uni.getFileSystemManager().readFile({
			filePath: filePath,
			success: (res: ReadFileSuccessCallbackResult) => {
				resolve(res.data as ArrayBuffer)
			},
			fail: (err: any) => {
				const errMsg = err != null ? JSON.stringify(err) : 'unknown';
				console.error('readFileAsArrayBuffer 失败:', filePath, errMsg);
				reject(new Error('读取文件失败: ' + errMsg))
			}
		})
		// #endif
		
		// #ifdef WEB
		// @ts-ignore
		fetch(filePath)
			.then((response: Response) => response.arrayBuffer())
			.then((buffer: ArrayBuffer) => {
				resolve(buffer)
			})
			.catch((e: any) => {
				reject(new Error(e.toString()))
			})
		// #endif
	})
}

/**
 * 从 ZIP 数据中解析清单文件
 */
function parseManifestFromZip(zipData: ArrayBuffer): Promise<PackageManifest> {
	return new Promise((resolve: (value: PackageManifest) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID
		parseManifestAndroid(zipData, resolve, reject)
		// #endif
		
		// #ifdef APP-HARMONY
		parseManifestHarmony(zipData, resolve, reject)
		// #endif
		
		// #ifdef WEB
		parseManifestWeb(zipData, resolve, reject)
		// #endif
	})
}

// #ifdef APP-ANDROID
import ZipInputStream from 'java.util.zip.ZipInputStream';
import ByteArrayInputStream from 'java.io.ByteArrayInputStream';
import ByteArrayOutputStream from 'java.io.ByteArrayOutputStream';

function parseManifestAndroid(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	try {
		const inputStream = new ByteArrayInputStream(new Int8Array(zipData) as ByteArray)
		const zipStream = new ZipInputStream(inputStream)
		
		let entry = zipStream.getNextEntry()
		while (entry != null) {
			if (entry.getName() == 'manifest.json') {
				const outputStream = new ByteArrayOutputStream()
				const buffer = new ByteArray(1024)
				let len = zipStream.read(buffer)
				while (len > 0) {
					outputStream.write(buffer, 0, len)
					len = zipStream.read(buffer)
				}
				
				const manifestJson = outputStream.toString('UTF-8')
				const manifest = JSON.parse(manifestJson) as PackageManifest
				
				zipStream.close()
				resolve(manifest)
				return
			}
			entry = zipStream.getNextEntry()
		}
		
		zipStream.close()
		reject(new Error('数据包中未找到清单文件'))
	} catch (e: any) {
		reject(new Error('解析清单文件失败：' + e.toString()))
	}
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙端从 ZIP 数据中解析清单文件
 * @description 先将 ZIP 数据写入临时文件，再使用 @ohos.zlib 解压，最后读取 manifest.json
 */
function parseManifestHarmony(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	try {
		const userDataPath = uni.env.USER_DATA_PATH as string
		const tempZipPath = userDataPath + '/temp_manifest_' + Date.now() + '.zip'
		const tempExtractDir = userDataPath + '/temp_extract_manifest_' + Date.now()
		
		console.log('parseManifestHarmony: tempZipPath =', tempZipPath)
		
		// 将 ZIP 数据写入临时文件
		uni.getFileSystemManager().writeFile({
			filePath: tempZipPath,
			data: zipData,
			success: () => {
				// 创建解压目录
				try {
					uni.getFileSystemManager().mkdirSync(tempExtractDir, true)
				} catch (e: any) {
					// 目录可能已存在
				}
				
				// 使用 uni 内置 unzip 接口，直接支持 unifile:// 虚拟协议路径
				uni.getFileSystemManager().unzip({
					zipFilePath: tempZipPath,
					targetPath: tempExtractDir,
					success: () => {
						// 读取解压后的 manifest.json
						const manifestPath = tempExtractDir + '/manifest.json'
						
						uni.getFileSystemManager().readFile({
							filePath: manifestPath,
							encoding: 'utf-8',
							success: (res: ReadFileSuccessCallbackResult) => {
								try {
									const manifest = JSON.parse(res.data as string) as PackageManifest
									
									// 清理临时文件
									cleanupTempFiles(tempZipPath, tempExtractDir)
									
									resolve(manifest)
								} catch (parseErr: any) {
									cleanupTempFiles(tempZipPath, tempExtractDir)
									reject(new Error('解析清单文件失败：' + parseErr.toString()))
								}
							},
							fail: (err: any) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								reject(new Error('数据包中未找到清单文件'))
							}
						})
					},
					fail: (unzipErr: any) => {
						cleanupTempFiles(tempZipPath, tempExtractDir)
						const errMsg = unzipErr != null ? JSON.stringify(unzipErr) : 'unknown'
						reject(new Error('ZIP 解压失败：' + errMsg))
					}
				})
			},
			fail: (writeErr: any) => {
				const errMsg = writeErr != null ? JSON.stringify(writeErr) : 'unknown';
				console.error('parseManifestHarmony 写入临时 ZIP 失败:', tempZipPath, errMsg);
				reject(new Error('写入临时 ZIP 文件失败: ' + errMsg))
			}
		})
	} catch (e: any) {
		reject(new Error('Harmony 清单解析异常：' + e.toString()))
	}
}

/**
 * 清理临时文件和目录
 */
function cleanupTempFiles(zipPath: string, extractDir: string): void {
	try {
		uni.getFileSystemManager().unlink({
			filePath: zipPath,
			success: () => {},
			fail: () => {}
		})
	} catch (e: any) { /* ignore */ }
	
	try {
		uni.getFileSystemManager().rmdir({
			dirPath: extractDir,
			recursive: true,
			success: () => {},
			fail: () => {}
		})
	} catch (e: any) { /* ignore */ }
}
// #endif

// #ifdef WEB
import JSZip from 'jszip'

function parseManifestWeb(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	console.log('Web: Loading ZIP for manifest parsing, size:', zipData.byteLength);
	JSZip.loadAsync(zipData).then((zip: JSZip) => {
		console.log('Web: ZIP loaded successfully. Files:', Object.keys(zip.files));
		const manifestFile = zip.file("manifest.json")
		if (manifestFile != null) {
			manifestFile.async("string").then((content: string) => {
				console.log('Web: manifest.json read, length:', content.length);
				try {
					const manifest = JSON.parse(content) as PackageManifest
					console.log('Web: Manifest parsed successfully:', manifest.version);
					resolve(manifest)
				} catch (e: any) {
					console.error('Web: Manifest JSON parse error:', e);
					reject(new Error("清单文件解析失败: " + e.message))
				}
			}).catch((e: any) => {
				console.error('Web: Manifest file read error:', e);
				reject(new Error("读取清单文件失败: " + e.message))
			})
		} else {
			console.error('Web: manifest.json not found in ZIP');
			reject(new Error("数据包中未找到 manifest.json"))
		}
	}).catch((e: any) => {
		console.error('Web: ZIP load failed:', e);
		reject(new Error("ZIP 加载失败: " + e.message))
	})
}
// #endif

/**
 * 解压并解析数据包内容
 */
function extractAndParsePackage(
	zipData: ArrayBuffer, 
	onProgress: ImportProgressCallback | null
): Promise<ImportResult> {
	return new Promise((resolve: (value: ImportResult) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID
		extractAndParseAndroid(zipData, onProgress, resolve, reject)
		// #endif
		
		// #ifdef APP-HARMONY
		extractAndParseHarmony(zipData, onProgress, resolve, reject)
		// #endif
		
		// #ifdef WEB
		extractAndParseWeb(zipData, onProgress, resolve, reject)
		// #endif
	})
}

// #ifdef APP-ANDROID
function extractAndParseAndroid(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		const inputStream = new ByteArrayInputStream(new Int8Array(zipData) as ByteArray)
		const zipStream = new ZipInputStream(inputStream)
		
		let processNode: ProcessNode | null = null
		
		if (manifest.files != null) {
			const files = manifest.files
			
			const findJsonFile = (path) => {
				let content = jsonFiles.get(path)
				if (content != null) return content
				const altPath = path.replace(/\/\//g, '\\\\')
				content = jsonFiles.get(altPath)
				if (content != null) return content
				const altPath2 = path.replace(/\\\\/g, '/')
				return jsonFiles.get(altPath2) || null
			}
			
			if (files.groups != null) {
				const content = findJsonFile(files.groups)
				if (content != null) groups = JSON.parse(content)
			}
			if (files.tabs != null) {
				const content = findJsonFile(files.tabs)
				if (content != null) tabs = JSON.parse(content)
			}
			if (files.components != null) {
				const content = findJsonFile(files.components)
				if (content != null) components = JSON.parse(content)
			}
			if (files.records != null) {
				const content = findJsonFile(files.records)
				if (content != null) records = JSON.parse(content)
			}
			if (files.processTree != null) {
				const content = findJsonFile(files.processTree)
				if (content != null) processNode = JSON.parse(content)
			}
		}
		
		// 构建临时 manifest 用于保存 (兼容现有 saveUiConfigurationToDatabase)
		const fullManifest: PackageManifest = {
			version: manifest.version,
			groups: groups,
			tabs: tabs,
			components: components,
			records: records
		}
		
		// 开始事务
		beginTransaction()
		
		try {
			// 保存 UI 配置
			let uiConfigCount = saveUiConfigurationToDatabase(fullManifest)
			
		// 从工艺树提取资源
			let resourceCount = 0
			const allResources = []
			
			if (processNode != null) {
				const processObj = processNode
				const extractedResources = extractResourcesFromNode(processObj)
				for (const res of extractedResources) {
					const originalPath = res.originalPath
					const localPath = savedAssetPaths.get(originalPath) || savedAssetPaths.get(originalPath.replace(/\/\//g, '\\\\'))
					
					if (localPath != null) {
						res.path = localPath
					} else {
						continue
					}
					
					if (res.thumbnail != '') {
						const thumbPath = savedAssetPaths.get(res.thumbnail)
						if (thumbPath != null) res.thumbnail = thumbPath
						else res.thumbnail = ''
					}
					allResources.push(res)
				}
			}
			
			const executeDbSave = async () => {
				try {
					if (processNode != null) {
						await saveProcessTreeToDatabase(processNode)
					}
					for (const res of allResources) {
						await saveResource(res)
						resourceCount++
					}
					console.log('Android: Saved resources:', resourceCount)
					
					setTransactionSuccessful()
					resolve({
						success: true,
						message: '导入成功',
						nodeCount: processNode != null ? 1 : 0,
						uiConfigCount: uiConfigCount,
						resourceCount: resourceCount,
						importTime: 0
					})
				} catch(e: any | null) {
					endTransaction()
					reject(new Error(e != null ? e.toString() : '数据库保存失败'))
				}
			}
			executeDbSave().then(()=>{}).catch((e: any | null)=>{})
				
		} catch (e: any) {
			endTransaction()
			reject(new Error('数据库保存失败: ' + e.toString()))
		}
			
	} catch (e: any) {
		reject(new Error('解析数据包失败：' + e.toString()))
	}
}

/**
 * 判断是否为资源文件
 * @param entryName ZIP 条目名称
 */
function isAssetFile(entryName: string): boolean {
	const normalized = entryName.toLowerCase().replace(/\\/g, '/')
	
	// 检查是否在 assets 目录下
	if (!normalized.startsWith('assets/')) {
		return false
	}
	
	// 排除 icons 目录（图标使用项目静态资源）
	if (normalized.includes('/icons/')) {
		return false
	}
	
	// 检查扩展名
	const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg']
	const videoExts = ['.mp4', '.webm', '.avi', '.mov', '.mkv']
	const audioExts = ['.mp3', '.wav', '.aac', '.ogg', '.m4a']
	const docExts = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.txt']
	// CAD 图纸格式（卡伦特供应商的 HTML 封装 CAD）
	const cadExts = ['.html', '.htm']
	
	const allExts = imageExts.concat(videoExts).concat(audioExts).concat(docExts).concat(cadExts)
	
	for (const ext of allExts) {
		if (normalized.endsWith(ext)) {
			return true
		}
	}
	
	return false
}

/**
 * 获取相对资源路径（去除 assets/ 前缀）
 * @param entryName ZIP 条目名称
 */
function getRelativeAssetPath(entryName: string): string {
	const normalized = entryName.replace(/\\/g, '/')
	
	// 移除 assets/ 前缀
	if (normalized.startsWith('assets/')) {
		return normalized.substring(7)
	}
	
	return normalized
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙端解压并解析数据包内容
 * @description 将 ZIP 写入临时文件 → 使用 zlib 解压 → 读取解压文件 → 保存到数据库
 */
function extractAndParseHarmony(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		const userDataPath = uni.env.USER_DATA_PATH as string
		const tempZipPath = userDataPath + '/temp_import_' + Date.now() + '.zip'
		const tempExtractDir = userDataPath + '/temp_import_extract_' + Date.now()
		
		// 将 ZIP 数据写入临时文件
		uni.getFileSystemManager().writeFile({
			filePath: tempZipPath,
			data: zipData,
			success: () => {
				// 创建解压目录
				try {
					uni.getFileSystemManager().mkdirSync(tempExtractDir, true)
				} catch (e: any) { /* 目录可能已存在 */ }
				
				// 更新进度：解压中
				if (onProgress != null) {
					onProgress({
						current: 45,
						total: 100,
						currentFile: 'Harmony: 解压中...',
						status: 'extracting'
					})
				}
				
				// 使用 uni 内置 unzip 解压，兼容 unifile:// 环境协议
				uni.getFileSystemManager().unzip({
					zipFilePath: tempZipPath,
					targetPath: tempExtractDir,
					success: () => {
						// 解压成功，开始解析文件
						processHarmonyExtractedFiles(
							tempExtractDir,
							onProgress,
							(result: ImportResult) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								resolve(result)
							},
							(error: Error) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								reject(error)
							}
						)
					},
					fail: (unzipErr: any) => {
						cleanupTempFiles(tempZipPath, tempExtractDir)
						const errMsg = unzipErr != null ? JSON.stringify(unzipErr) : 'unknown'
						reject(new Error('Harmony ZIP 解压失败：' + errMsg))
					}
				})
			},
			fail: (writeErr: any) => {
				reject(new Error('Harmony: 写入临时 ZIP 文件失败'))
			}
		})
	} catch (e: any) {
		reject(new Error('Harmony 解析数据包异常：' + e.toString()))
	}
}

/**
 * 处理鸿蒙端解压后的文件
 * @description 读取 manifest、解析 UI 配置、工艺数据和资源文件
 */
function processHarmonyExtractedFiles(
	extractDir: string,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		// 辅助函数：查找并读取 JSON 文件（兼容正斜杠和反斜杠）
		const readJsonFileHarmony = (path: string): string => {
			try {
				return uni.getFileSystemManager().readFileSync(extractDir + '/' + path, 'utf-8') as string
			} catch (e1: any) {
				try {
					const altPath = path.replace(/\//g, '\\')
					return uni.getFileSystemManager().readFileSync(extractDir + '/' + altPath, 'utf-8') as string
				} catch (e2: any) {
					const altPath2 = path.replace(/\\/g, '/')
					return uni.getFileSystemManager().readFileSync(extractDir + '/' + altPath2, 'utf-8') as string
				}
			}
		}

		// 1. 读取 manifest.json
		const manifestData = readJsonFileHarmony('manifest.json')
		const manifest = JSON.parse(manifestData) as PackageManifest
		
		if (onProgress != null) {
			onProgress({
				current: 55,
				total: 100,
				currentFile: '解析数据...',
				status: 'extracting'
			})
		}
		
		// 2. 检测格式版本
		const isV2 = manifest.files != null
		
		// 3. 读取 UI 配置
		let groups: TabGroup[] = []
		let tabs: TabConfig[] = []
		let components: ComponentConfig[] = []
		let records: DataRecord[] = []
		
		if (isV2 && manifest.files != null) {
			const files = manifest.files
			
			if (files.groups != null) {
				try {
					const content = readJsonFileHarmony(files.groups)
					groups = JSON.parse(content) as TabGroup[]
				} catch (e: any) {
					console.warn('Harmony: groups 文件读取失败:', e)
				}
			}
			
			if (files.tabs != null) {
				try {
					const content = readJsonFileHarmony(files.tabs)
					tabs = JSON.parse(content) as TabConfig[]
				} catch (e: any) {
					console.warn('Harmony: tabs 文件读取失败:', e)
				}
			}
			
			if (files.components != null) {
				try {
					const content = readJsonFileHarmony(files.components)
					components = JSON.parse(content) as ComponentConfig[]
				} catch (e: any) {
					console.warn('Harmony: components 文件读取失败:', e)
				}
			}
			
			if (files.records != null) {
				try {
					const content = readJsonFileHarmony(files.records)
					records = JSON.parse(content) as DataRecord[]
				} catch (e: any) {
					console.warn('Harmony: records 文件读取失败:', e)
				}
			}
		} else {
			// V1: 从 manifest 内联数据读取
			groups = manifest.groups ?? []
			tabs = manifest.tabs ?? []
			components = manifest.components ?? []
			records = manifest.records ?? []
		}
		
		// 4. 解析工艺树
		let processNode: ProcessNode | null = null
		
		if (isV2 && manifest.files != null && manifest.files.processTree != null) {
			try {
				const content = readJsonFileHarmony(manifest.files.processTree)
				processNode = JSON.parse(content)
			} catch (e) {
				console.warn('Harmony: 工艺树解析失败', e)
			}
		}
		
		if (onProgress != null) {
			onProgress({
				current: 70,
				total: 100,
				currentFile: '保存数据...',
				status: 'extracting'
			})
		}
		
		// 5. 处理资源文件（复制到应用沙箱）
		const savedAssetPaths = new Map<string, string>()
		const assetsBasePath = getAssetsBasePath()
		
		// 确保资源目录存在
		try {
			uni.getFileSystemManager().mkdirSync(assetsBasePath, true)
		} catch (e: any) { /* 目录可能已存在 */ }
		
		// 复制解压出的资源文件到沙箱
		try {
			const assetsDir = extractDir + '/assets'
			copyAssetsRecursive(assetsDir, assetsBasePath, '', savedAssetPaths)
		} catch (e: any) {
			console.warn('Harmony: 资源文件复制失败:', e)
		}
		
		// 6. 构建 manifest 并保存到数据库
		const fullManifest: PackageManifest = {
			version: manifest.version,
			groups: groups,
			tabs: tabs,
			components: components,
			records: records
		}
		
		// 开始事务
		beginTransaction()
		
		try {
			const uiConfigCount = saveUiConfigurationToDatabase(fullManifest)
			
			let resourceCount = 0
			const allResources: ResourceItem[] = []
			
			for (const process of processes) {
				const processObj = JSON.parse(JSON.stringify(process)) as UTSJSONObject
				const extractedResources = extractResourcesFromNode(processObj)
				
				for (const res of extractedResources) {
					const originalPath = res.originalPath
					const localPath = savedAssetPaths.get(originalPath)
					
					if (localPath != null) {
						res.path = localPath
					} else {
						const altPath = originalPath.replace(/\//g, '\\\\')
						const altLocalPath = savedAssetPaths.get(altPath)
						if (altLocalPath != null) {
							res.path = altLocalPath
						} else {
							console.warn('Harmony: 资源文件未找到:', originalPath)
							continue
						}
					}
					
					// 处理缩略图路径
					if (res.thumbnail != '') {
						const thumbPath = savedAssetPaths.get(res.thumbnail)
						if (thumbPath != null) {
							res.thumbnail = thumbPath
						} else {
							res.thumbnail = ''
						}
					}
					
					allResources.push(res)
				}
			}
			// 开始写入数据库（避免使用 async lambda 防止 UTS 在鸿蒙发生未捕获坠落）
			saveProcessesToDatabase(processes)
				.then(() => {
					// 顺序保存资源
					const saveNextResource = (index: number) => {
						if (index >= allResources.length) {
							console.log('Harmony: 保存资源条数:', resourceCount)
							setTransactionSuccessful()
							endTransaction()
							resolve({
								success: true,
								message: '导入成功',
								nodeCount: processes.length,
								uiConfigCount: uiConfigCount,
								resourceCount: resourceCount,
								importTime: 0
							})
							return
						}
						
						saveResource(allResources[index])
							.then(() => {
								resourceCount++
								saveNextResource(index + 1)
							})
							.catch((resErr: any) => {
								console.error('Harmony: 保存单一资源失败:', resErr)
								// 继续保存下个资源，保持容错
								saveNextResource(index + 1)
							})
					}
					
					saveNextResource(0)
				})
				.catch((dbErr: any) => {
					console.error('Harmony: 数据库保存 Process 基础异常:', dbErr)
					endTransaction()
					const errMsg = dbErr instanceof Error ? dbErr.message : (dbErr != null ? dbErr.toString() : 'unknown')
					reject(new Error('数据入库异常: ' + errMsg))
				})
				
		} catch (e: any) {
			console.error('Harmony: 解析数据包环境构建异常:', e)
			endTransaction()
			reject(new Error('Harmony 数据库保存前失败: ' + e.toString()))
		}
	} catch (e: any) {
		console.error('Harmony: 解析数据包顶级流程异常:', e)
		reject(new Error('Harmony: 解析数据包失败：' + e.toString()))
	}
}

/**
 * 递归复制资源文件到应用沙箱
 * @param sourceDir 源目录
 * @param targetDir 目标目录
 * @param relativePath 相对路径
 * @param savedPaths 已保存路径映射
 */
function copyAssetsRecursive(
	sourceDir: string, 
	targetDir: string, 
	relativePath: string, 
	savedPaths: Map<string, string>
): void {
	try {
		const entries = uni.getFileSystemManager().readdirSync(sourceDir)
		if (entries == null) return
		
		for (const entry of entries) {
			const sourcePath = sourceDir + '/' + entry
			const entryRelPath = relativePath != '' ? relativePath + '/' + entry : entry
			const targetPath = targetDir + '/' + entryRelPath
			
			try {
				// 在鸿蒙底层，statSync 返回的对象可能因版本遗失 isDirectory() 方法，
				// 这里使用 readdirSync 探测是否为目录的旁路判断更为稳妥
				let isDir = false
				try {
					uni.getFileSystemManager().readdirSync(sourcePath)
					isDir = true
				} catch (err: any) {
					isDir = false
				}
				
				if (isDir) {
					// 确保目标目录存在
					try {
						uni.getFileSystemManager().mkdirSync(targetPath, true)
					} catch (e: any) { /* 目录可能已存在 */ }
					
					// 递归复制子目录
					copyAssetsRecursive(sourcePath, targetDir, entryRelPath, savedPaths)
				} else {
					// 检查是否是需要保存的资源文件
					const fullEntryName = 'assets/' + entryRelPath
					if (isAssetFileHarmony(fullEntryName)) {
						// 确保父目录存在
						const parentDir = targetPath.substring(0, targetPath.lastIndexOf('/'))
						try {
							uni.getFileSystemManager().mkdirSync(parentDir, true)
						} catch (e: any) { /* 目录可能已存在 */ }
						
						// 复制文件
						uni.getFileSystemManager().copyFileSync(sourcePath, targetPath)
						savedPaths.set(fullEntryName, targetPath)
						console.log('Harmony: 保存资源:', fullEntryName, '->', targetPath)
					}
				}
			} catch (e: any) {
				console.warn('Harmony: 处理文件失败:', entry, e)
			}
		}
	} catch (e: any) {
		// 目录可能不存在，忽略
		console.warn('Harmony: 读取目录失败:', sourceDir, e)
	}
}

/**
 * Harmony 端判断是否为资源文件
 */
function isAssetFileHarmony(entryName: string): boolean {
	const normalized = entryName.toLowerCase().replace(/\\\\/g, '/')
	
	if (!normalized.startsWith('assets/')) {
		return false
	}
	
	// 排除 icons 目录
	if (normalized.includes('/icons/')) {
		return false
	}
	
	const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg']
	const videoExts = ['.mp4', '.webm', '.avi', '.mov', '.mkv']
	const audioExts = ['.mp3', '.wav', '.aac', '.ogg', '.m4a']
	const docExts = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.txt']
	// CAD 图纸格式（卡伦特供应商的 HTML 封装 CAD）
	const cadExts = ['.html', '.htm']
	
	const allExts = imageExts.concat(videoExts).concat(audioExts).concat(docExts).concat(cadExts)
	
	for (const ext of allExts) {
		if (normalized.endsWith(ext)) {
			return true
		}
	}
	
	return false
}
// #endif

// #ifdef WEB
function extractAndParseWeb(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	console.log('Web: Starting extraction, size:', zipData.byteLength);
	JSZip.loadAsync(zipData).then(async (zip: JSZip) => {
		try {
			// 1. 解析 manifest
			let manifest: PackageManifest | null = null
			const manifestFile = zip.file("manifest.json")
			if (manifestFile != null) {
				console.log('Web: manifest.json found');
				const content = await manifestFile.async("string")
				manifest = JSON.parse(content) as PackageManifest
				console.log('Web: Manifest version:', manifest.version);
			} else {
				console.warn('Web: manifest.json NOT found');
				reject(new Error("数据包中未找到 manifest.json"))
				return
			}
			
			// 2. 检测是 V2 (分离文件) 还是 V1 (内联) 格式
			const isV2 = manifest.files != null
			console.log('Web: Package format:', isV2 ? 'V2 (separated)' : 'V1 (inline)');
			
			// 3. 读取 UI 配置
			let groups: TabGroup[] = []
			let tabs: TabConfig[] = []
			let components: ComponentConfig[] = []
			let records: DataRecord[] = []
			let iconConfig: UTSJSONObject | null = null
			
			if (isV2 && manifest.files != null) {
				// V2: 从分离文件中读取
				const files = manifest.files
				
				// 辅助函数：从 ZIP 中查找文件（兼容正斜杠和反斜杠）
				const findZipFile = (path: string): any => {
					// 先尝试原路径
					let file = zip.file(path)
					if (file != null) return file
					// 尝试替换斜杠
					const altPath = path.replace(/\//g, '\\')
					file = zip.file(altPath)
					if (file != null) return file
					// 尝试另一种替换
					const altPath2 = path.replace(/\\/g, '/')
					return zip.file(altPath2)
				}
				
				if (files.groups != null) {
					const groupsFile = findZipFile(files.groups)
					if (groupsFile != null) {
						const content = await groupsFile.async("string")
						groups = JSON.parse(content) as TabGroup[]
						console.log('Web: Loaded groups:', groups.length);
					} else {
						console.warn('Web: groups file not found:', files.groups)
					}
				}
				
				if (files.tabs != null) {
					const tabsFile = findZipFile(files.tabs)
					if (tabsFile != null) {
						const content = await tabsFile.async("string")
						tabs = JSON.parse(content) as TabConfig[]
						console.log('Web: Loaded tabs:', tabs.length);
					} else {
						console.warn('Web: tabs file not found:', files.tabs)
					}
				}
				
				if (files.components != null) {
					const componentsFile = findZipFile(files.components)
					if (componentsFile != null) {
						const content = await componentsFile.async("string")
						components = JSON.parse(content) as ComponentConfig[]
						console.log('Web: Loaded components:', components.length);
					} else {
						console.warn('Web: components file not found:', files.components)
					}
				}
				
				if (files.records != null) {
					const recordsFile = findZipFile(files.records)
					if (recordsFile != null) {
						const content = await recordsFile.async("string")
						records = JSON.parse(content) as DataRecord[]
						console.log('Web: Loaded records:', records.length);
					} else {
						console.warn('Web: records file not found:', files.records)
					}
				}
				
				// 加载图标配置（图标文件在 static/icons/ 目录，数据包只存配置）
				if (files.icons != null) {
					const iconsFile = findZipFile(files.icons)
					if (iconsFile != null) {
						const content = await iconsFile.async("string")
						iconConfig = JSON.parse(content) as UTSJSONObject
						console.log('Web: Loaded icons config');
					}
				}
			} else {
				// V1: 从 manifest 内联数据读取
				groups = manifest.groups ?? []
				tabs = manifest.tabs ?? []
				components = manifest.components ?? []
				records = manifest.records ?? []
			}
			
			const findProcessFile = (path: string): any => {
				let file = zip.file(path)
				if (file != null) return file
				const altPath = path.replace(/\//g, '\\\\')
				file = zip.file(altPath)
				if (file != null) return file
				const altPath2 = path.replace(/\\\\/g, '/')
				return zip.file(altPath2)
			}
			
			// 4. 解析 processTree (V4)
			let processNode: ProcessNode | null = null
			let processTreeEntry = zip.file('data/process_tree.json')
			if (processTreeEntry == null) {
				const keys = Object.keys(zip.files)
				const treeFile = keys.find((name: string): boolean => name.endsWith('process_tree.json') && !zip.files[name].dir)
				if (treeFile != null) {
					processTreeEntry = zip.file(treeFile as string)
				}
			}
			
			if (processTreeEntry != null) {
				try {
					const content = await processTreeEntry.async("string")
					processNode = JSON.parse(content) as ProcessNode
				} catch(e) {
					console.error('Web: Failed to parse process_tree.json', e)
				}
			}
			
			// 5. 保存到数据库 (Web 使用 IndexedDB)
			console.log('Web: Saving to database via IndexedDB...');
			
			try {
				// 先清空旧数据
				console.log('Web: Clearing old data...');
				await webClearStore('meta_tab_groups')
				await webClearStore('meta_tabs')
				await webClearStore('meta_components')
				await webClearStore('data_records')
				await webClearStore('t_process')
				await webClearStore('t_icon_config')
				console.log('Web: Old data cleared');
				
				let uiConfigCount = 0
				
				// 保存 UI 分组
				for (const g of groups) {
					await webPutData('meta_tab_groups', g)
					uiConfigCount++
				}
				
				// 保存 Tabs
				for (const t of tabs) {
					await webPutData('meta_tabs', t)
					uiConfigCount++
				}
				
				// 保存组件
				for (const c of components) {
					await webPutData('meta_components', c)
					uiConfigCount++
				}
				
				// 保存数据记录
				for (const r of records) {
					await webPutData('data_records', r)
					uiConfigCount++
				}
				
				// 保存图标配置（只存配置，图标文件在 static/icons/）
				if (iconConfig != null) {
					const nodeIcons = iconConfig['nodeIcons'] as UTSJSONObject
					if (nodeIcons != null) {
						for (const nodeType of Object.keys(nodeIcons)) {
							const cfg = nodeIcons[nodeType] as UTSJSONObject
							await webPutData('t_icon_config', {
								node_type: nodeType,
								icon_name: cfg['icon'] ?? nodeType,
								fallback: cfg['fallback'] ?? ''
							})
						}
					}
					console.log('Web: Saved icon config');
				}
				
				// 保存工艺数据
				if (processNode != null) {
					await webPutData('t_process', processNode)
				}
				
				// 提取并保存资源
				let resourceCount = 0
				await webClearStore('t_resources')
				clearBlobUrls()
				
				if (processNode != null) {
					const processObj = JSON.parse(JSON.stringify(processNode)) as UTSJSONObject
					const extractedResources = extractResourcesFromNode(processObj)
					for (const res of extractedResources) {
						const resourcePath = res.originalPath
						if (resourcePath == '') continue
						
						const resourceFile = findProcessFile(resourcePath) || findProcessFile(resourcePath.replace(/\/\//g, '\\\\'))
						if (resourceFile != null && !resourceFile.dir) {
							try {
								const blob = await resourceFile.async("blob")
								const blobUrl = storeBlobAndGetUrl(res.id, blob, res.name)
								res.path = blobUrl
								
								let thumbBlobData = null
								if (res.thumbnail != '') {
									const thumbFile = findProcessFile(res.thumbnail) || findProcessFile(res.thumbnail.replace(/\/\//g, '\\\\'))
									if (thumbFile != null) {
										const thumbBlob = await thumbFile.async("blob")
										const thumbUrl = storeBlobAndGetUrl(res.id + '_thumb', thumbBlob)
										res.thumbnail = thumbUrl
										thumbBlobData = thumbBlob
									}
								}
								
								await webPutData('t_resources', {
									id: res.id,
									node_id: res.nodeId,
									type: res.type,
									name: res.name,
									path: res.path,
									original_path: res.originalPath,
									thumbnail: res.thumbnail,
									duration: res.duration,
									size: res.size,
									description: res.description,
									sort_order: res.sortOrder,
									blob_data: blob,
									thumbnail_blob: thumbBlobData
								})
								resourceCount++
							} catch (e) {
								console.warn('Web: Failed to extract resource:', resourcePath, e);
							}
						}
					}
				}
				
				console.log('Web: DB Save success');
				resolve({
					success: true,
					message: '导入成功',
					nodeCount: processNode != null ? 1 : 0,
					uiConfigCount: uiConfigCount,
					resourceCount: resourceCount,
					importTime: 0
				})
			} catch (e: any) {
				console.error('Web: DB Save failed', e);
				reject(new Error('数据库保存失败: ' + e.message))
			}
			
		} catch (e: any) {
			console.error('Web: Extraction error', e);
			reject(new Error("Web 导入处理失败: " + e.message))
		}
	}).catch((e: any) => {
		console.error('Web: ZIP load failed in extraction', e);
		reject(new Error("ZIP 加载失败: " + e.message))
	})
}
// #endif


/**
 * 保存 UI 配置到数据库
 */
function saveUiConfigurationToDatabase(manifest: PackageManifest): number {
	let count = 0
	
	// 导入分组
	const groups = manifest.groups
	if (groups != null) {
		for (let i = 0; i < groups.length; i++) {
			const g = groups[i]
			executeSQL(
				"INSERT OR REPLACE INTO meta_tab_groups (id, name, description, sort_order) VALUES (?, ?, ?, ?)",
				[g.id, g.name, g.description, g.sort_order]
			)
			count++
		}
	}
	
	// 导入 Tab
	const tabs = manifest.tabs
	if (tabs != null) {
		for (let i = 0; i < tabs.length; i++) {
			const t = tabs[i]
			executeSQL(
				"INSERT OR REPLACE INTO meta_tabs (id, group_id, title, sort_order, visible_condition) VALUES (?, ?, ?, ?, ?)",
				[t.id, t.group_id, t.title, t.sort_order, t.visible_condition]
			)
			count++
		}
	}
	
	// 导入组件
	const components = manifest.components
	if (components != null) {
		for (let i = 0; i < components.length; i++) {
			const c = components[i]
			const configJson = c.config != null ? JSON.stringify(c.config) : ''
			
			executeSQL(
				"INSERT OR REPLACE INTO meta_components (id, tab_id, type, title, config_json, sort_order) VALUES (?, ?, ?, ?, ?, ?)",
				[c.id, c.tab_id, c.type, c.title, configJson, c.sort_order]
			)
			count++
		}
	}
	
	// 导入数据记录
	const records = manifest.records
	if (records != null) {
		for (let i = 0; i < records.length; i++) {
			const r = records[i]
			const dataJson = r.data != null ? JSON.stringify(r.data) : ''
			
			executeSQL(
				"INSERT OR REPLACE INTO data_records (record_id, component_id, data_json, created_at) VALUES (?, ?, ?, ?)",
				[r.record_id, r.component_id, dataJson, Date.now()]
			)
			count++
		}
	}
	
	return count
}

/**
 * 保存工艺数据到数据库
 */
function saveProcessTreeToDatabase(processNode: ProcessNode): Promise<void> {
	return new Promise<void>((resolve, reject) => {
		const insertProcessSQL = `
			INSERT OR REPLACE INTO t_process 
			(inner_id, class_id, code, name, created_at, updated_at, data_json)
			VALUES (?, ?, ?, ?, ?, ?, ?)
		`

		const processParams: any[] = [
			processNode.innerId,
			processNode.classId,
			processNode.code,
			processNode.name,
			Date.now().toString(),
			Date.now().toString(),
			JSON.stringify(processNode)
		]

		executeSQL(insertProcessSQL, processParams)
			.then((_) => {
				resolve()
			})
			.catch((e: any) => {
				reject(new Error(e.toString()))
			})
	})
}

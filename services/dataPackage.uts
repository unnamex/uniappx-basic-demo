// #ifdef WEB
/**
 * Web 平台文件选择
 */
function selectFileWeb(
	resolve: (value: PackageInfo) => void, 
	reject: (reason: Error) => void
): void {
	try {
		const input = document.createElement('input')
		input.type = 'file'
		input.accept = '.srd'
		
		input.onchange = (event: Event) => {
			const target = event.target as HTMLInputElement
			if (target.files != null && target.files.length > 0) {
				const file = target.files[0]
				resolve(handleFileProcessWeb(file))
			} else {
				reject(new Error('未选择文件'))
			}
		}
		
		input.click()
	} catch (e: any) {
		reject(e)
	}
}

/**
 * Web 平台处理 File 对象并将关键路径存入全局变量
 */
function handleFileProcessWeb(file: File): PackageInfo {
	selectedFilePath = URL.createObjectURL(file)
	return {
		fileName: file.name,
		fileSize: file.size,
		manifest: null,
		isValid: true,
		errorMessage: ''
	} as PackageInfo
}

/**
 * 暴露给组件用于处理拖拽进来的文件
 * @param file 
 * @returns 
 */
export function handleDroppedFileWeb(file: any): PackageInfo {
	return handleFileProcessWeb(file as File)
}
// #endif

/**
 * 获取文件名
 */
function getFileName(filePath: string): string {
	const parts = filePath.split('/')
	return parts[parts.length - 1]
}

/**
 * 验证并预览数据包
 * @param filePath - 文件路径
 * @returns Promise<PackageManifest> 数据包清单
 */
export function validatePackage(filePath: string = selectedFilePath): Promise<PackageManifest> {
	const actualPath = filePath != '' ? filePath : selectedFilePath
	console.log('validatePackage using path:', actualPath)
	return new Promise((resolve: (value: PackageManifest) => void, reject: (reason: Error) => void) => {
		if (actualPath == '') {
			reject(new Error('未选择数据包文件'))
			return
		}
		readFileAsArrayBuffer(actualPath)
			.then((encryptedData: ArrayBuffer) => {
				// 尝试解密，如果失败则假设为未加密的ZIP
				let zipData = encryptedData
				const decryptResult = decryptPackage(encryptedData)
				if (decryptResult.success && decryptResult.data != null) {
					console.log('validatePackage: 数据包解密成功')
					zipData = decryptResult.data!
				} else {
					console.log('validatePackage: 数据包未加密或解密跳过，尝试以原始ZIP解析')
				}
				
				// 解压并读取清单文件
				parseManifestFromZip(zipData)
					.then((manifest: PackageManifest) => {
						resolve(manifest)
					})
					.catch((e: any) => {
						console.error('validatePackage: parseManifestFromZip 失败:', e)
						const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown')
						reject(new Error(errMsg))
					})
			})
			.catch((e: any) => {
				console.error('validatePackage: readFileAsArrayBuffer 失败:', e)
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown')
				reject(new Error(errMsg))
			})
	})
}

/**
 * 导入数据包
 * @param filePath - 文件路径
 * @param onProgress - 进度回调
 * @returns Promise<ImportResult> 导入结果
 */
export function importPackage(
	filePath: string = selectedFilePath, 
	onProgress: ImportProgressCallback | null = null
): Promise<ImportResult> {
	const startTime = Date.now()
	const actualPath = filePath != '' ? filePath : selectedFilePath
	console.log('importPackage using path:', actualPath)
	
	return new Promise((resolve: (value: ImportResult) => void, reject: (reason: Error) => void) => {
		if (actualPath == '') {
			reject(new Error('未选择数据包文件'))
			return
		}
		
		// 更新进度：开始读取文件
		if (onProgress != null) {
			onProgress({
				current: 0,
				total: 100,
				currentFile: '读取数据包...',
				status: 'reading'
			})
		}
		
		readFileAsArrayBuffer(actualPath)

			.then((encryptedData: ArrayBuffer) => {
				// 更新进度：解密中
				if (onProgress != null) {
					onProgress({
						current: 20,
						total: 100,
						currentFile: '解密数据包...',
						status: 'decrypting'
					})
				}
				
				let zipData = encryptedData
				const decryptResult = decryptPackage(encryptedData)
				if (decryptResult.success && decryptResult.data != null) {
					zipData = decryptResult.data!
				}
				
				// 尝试作为普通 JSON 解析 (单文件数据包)
				
				// 更新进度：解压中
				if (onProgress != null) {
					onProgress({
						current: 40,
						total: 100,
						currentFile: '解压数据包...',
						status: 'extracting'
					})
				}
				
				// 解压并解析数据
				extractAndParsePackage(zipData, onProgress)
					.then((res: ImportResult) => {
						// 更新进度：完成
						if (onProgress != null) {
							onProgress({
								current: 100,
								total: 100,
								currentFile: '导入完成',
								status: 'completed'
							})
						}
						
						res.importTime = Date.now() - startTime
						resolve(res)
					})
					.catch((e: any) => {
						reject(new Error(JSON.stringify(e)))
					})
			})
			.catch((e: any) => {
				reject(new Error(JSON.stringify(e)))
			})
	})
}

/**
 * 读取文件为 ArrayBuffer
 */
function readFileAsArrayBuffer(filePath: string): Promise<ArrayBuffer> {
	return new Promise((resolve: (value: ArrayBuffer) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID || APP-HARMONY
		uni.getFileSystemManager().readFile({
			filePath: filePath,
			success: (res: ReadFileSuccessCallbackResult) => {
				resolve(res.data as ArrayBuffer)
			},
			fail: (err: any) => {
				const errMsg = err != null ? JSON.stringify(err) : 'unknown';
				console.error('readFileAsArrayBuffer 失败:', filePath, errMsg);
				reject(new Error('读取文件失败: ' + errMsg))
			}
		})
		// #endif
		
		// #ifdef WEB
		// @ts-ignore
		fetch(filePath)
			.then((response: Response) => response.arrayBuffer())
			.then((buffer: ArrayBuffer) => {
				resolve(buffer)
			})
			.catch((e: any) => {
				reject(new Error(e.toString()))
			})
		// #endif
	})
}

/**
 * 从 ZIP 数据中解析清单文件
 */
function parseManifestFromZip(zipData: ArrayBuffer): Promise<PackageManifest> {
	return new Promise((resolve: (value: PackageManifest) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID
		parseManifestAndroid(zipData, resolve, reject)
		// #endif
		
		// #ifdef APP-HARMONY
		parseManifestHarmony(zipData, resolve, reject)
		// #endif
		
		// #ifdef WEB
		parseManifestWeb(zipData, resolve, reject)
		// #endif
	})
}

// #ifdef APP-ANDROID
import ZipInputStream from 'java.util.zip.ZipInputStream';
import ByteArrayInputStream from 'java.io.ByteArrayInputStream';
import ByteArrayOutputStream from 'java.io.ByteArrayOutputStream';

function parseManifestAndroid(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	try {
		const inputStream = new ByteArrayInputStream(new Int8Array(zipData) as ByteArray)
		const zipStream = new ZipInputStream(inputStream)
		
		let entry = zipStream.getNextEntry()
		while (entry != null) {
			if (entry.getName() == 'manifest.json') {
				const outputStream = new ByteArrayOutputStream()
				const buffer = new ByteArray(1024)
				let len = zipStream.read(buffer)
				while (len > 0) {
					outputStream.write(buffer, 0, len)
					len = zipStream.read(buffer)
				}
				
				const manifestJson = outputStream.toString('UTF-8')
				const manifest = JSON.parse(manifestJson) as PackageManifest
				
				zipStream.close()
				resolve(manifest)
				return
			}
			entry = zipStream.getNextEntry()
		}
		
		zipStream.close()
		reject(new Error('数据包中未找到清单文件'))
	} catch (e: any) {
		reject(new Error('解析清单文件失败：' + e.toString()))
	}
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙端从 ZIP 数据中解析清单文件
 * @description 先将 ZIP 数据写入临时文件，再使用 @ohos.zlib 解压，最后读取 manifest.json
 */
function parseManifestHarmony(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	try {
		const userDataPath = uni.env.USER_DATA_PATH as string
		const tempZipPath = userDataPath + '/temp_manifest_' + Date.now() + '.zip'
		const tempExtractDir = userDataPath + '/temp_extract_manifest_' + Date.now()
		
		console.log('parseManifestHarmony: tempZipPath =', tempZipPath)
		
		// 将 ZIP 数据写入临时文件
		uni.getFileSystemManager().writeFile({
			filePath: tempZipPath,
			data: zipData,
			success: () => {
				// 创建解压目录
				try {
					uni.getFileSystemManager().mkdirSync(tempExtractDir, true)
				} catch (e: any) {
					// 目录可能已存在
				}
				
				// 使用 uni 内置 unzip 接口，直接支持 unifile:// 虚拟协议路径
				uni.getFileSystemManager().unzip({
					zipFilePath: tempZipPath,
					targetPath: tempExtractDir,
					success: () => {
						// 读取解压后的 manifest.json
						const manifestPath = tempExtractDir + '/manifest.json'
						
						uni.getFileSystemManager().readFile({
							filePath: manifestPath,
							encoding: 'utf-8',
							success: (res: ReadFileSuccessCallbackResult) => {
								try {
									const manifest = JSON.parse(res.data as string) as PackageManifest
									
									// 清理临时文件
									cleanupTempFiles(tempZipPath, tempExtractDir)
									
									resolve(manifest)
								} catch (parseErr: any) {
									cleanupTempFiles(tempZipPath, tempExtractDir)
									reject(new Error('解析清单文件失败：' + parseErr.toString()))
								}
							},
							fail: (err: any) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								reject(new Error('数据包中未找到清单文件'))
							}
						})
					},
					fail: (unzipErr: any) => {
						cleanupTempFiles(tempZipPath, tempExtractDir)
						const errMsg = unzipErr != null ? JSON.stringify(unzipErr) : 'unknown'
						reject(new Error('ZIP 解压失败：' + errMsg))
					}
				})
			},
			fail: (writeErr: any) => {
				const errMsg = writeErr != null ? JSON.stringify(writeErr) : 'unknown';
				console.error('parseManifestHarmony 写入临时 ZIP 失败:', tempZipPath, errMsg);
				reject(new Error('写入临时 ZIP 文件失败: ' + errMsg))
			}
		})
	} catch (e: any) {
		reject(new Error('Harmony 清单解析异常：' + e.toString()))
	}
}

/**
 * 清理临时文件和目录
 */
function cleanupTempFiles(zipPath: string, extractDir: string): void {
	try {
		uni.getFileSystemManager().unlink({
			filePath: zipPath,
			success: () => {},
			fail: () => {}
		})
	} catch (e: any) { /* ignore */ }
	
	try {
		uni.getFileSystemManager().rmdir({
			dirPath: extractDir,
			recursive: true,
			success: () => {},
			fail: () => {}
		})
	} catch (e: any) { /* ignore */ }
}
// #endif

// #ifdef WEB
import JSZip from 'jszip'

function parseManifestWeb(
	zipData: ArrayBuffer,
	resolve: (value: PackageManifest) => void,
	reject: (reason: Error) => void
): void {
	console.log('Web: Loading ZIP for manifest parsing, size:', zipData.byteLength);
	JSZip.loadAsync(zipData).then((zip: JSZip) => {
		console.log('Web: ZIP loaded successfully. Files:', Object.keys(zip.files));
		const manifestFile = zip.file("manifest.json")
		if (manifestFile != null) {
			manifestFile.async("string").then((content: string) => {
				console.log('Web: manifest.json read, length:', content.length);
				try {
					const manifest = JSON.parse(content) as PackageManifest
					console.log('Web: Manifest parsed successfully:', manifest.version);
					resolve(manifest)
				} catch (e: any) {
					console.error('Web: Manifest JSON parse error:', e);
					reject(new Error("清单文件解析失败: " + e.message))
				}
			}).catch((e: any) => {
				console.error('Web: Manifest file read error:', e);
				reject(new Error("读取清单文件失败: " + e.message))
			})
		} else {
			console.error('Web: manifest.json not found in ZIP');
			reject(new Error("数据包中未找到 manifest.json"))
		}
	}).catch((e: any) => {
		console.error('Web: ZIP load failed:', e);
		reject(new Error("ZIP 加载失败: " + e.message))
	})
}
// #endif

/**
 * 解压并解析数据包内容
 */
function extractAndParsePackage(
	zipData: ArrayBuffer, 
	onProgress: ImportProgressCallback | null
): Promise<ImportResult> {
	return new Promise((resolve: (value: ImportResult) => void, reject: (reason: Error) => void) => {
		// #ifdef APP-ANDROID
		extractAndParseAndroid(zipData, onProgress, resolve, reject)
		// #endif
		
		// #ifdef APP-HARMONY
		extractAndParseHarmony(zipData, onProgress, resolve, reject)
		// #endif
		
		// #ifdef WEB
		extractAndParseWeb(zipData, onProgress, resolve, reject)
		// #endif
	})
}

// #ifdef APP-ANDROID
function extractAndParseAndroid(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		const inputStream = new ByteArrayInputStream(new Int8Array(zipData) as ByteArray)
		const zipStream = new ZipInputStream(inputStream)
		
		let manifest: PackageManifest | null = null
		const jsonFiles = new Map<string, string>()
		const savedAssetPaths = new Map<string, string>()
		const assetsBasePath = getAssetsBasePath()
		
		let entry = zipStream.getNextEntry()
		while (entry != null) {
			const entryName = entry.getName()
			if (entryName.endsWith('.json')) {
				const outputStream = new ByteArrayOutputStream()
				const buffer = new ByteArray(4096)
				let len = zipStream.read(buffer)
				while (len > 0) {
					outputStream.write(buffer, 0, len)
					len = zipStream.read(buffer)
				}
				const content = outputStream.toString('UTF-8')
				if (entryName == 'manifest.json') {
					manifest = JSON.parse(content) as PackageManifest
				} else {
					jsonFiles.set(entryName, content)
				}
			} else if (isAssetFile(entryName)) {
				const relPath = getRelativeAssetPath(entryName)
				const targetPath = assetsBasePath + '/' + relPath
				ensureDirectory(targetPath.substring(0, targetPath.lastIndexOf('/')))
				
				const outputStream = new ByteArrayOutputStream()
				const buffer = new ByteArray(4096)
				let len = zipStream.read(buffer)
				while (len > 0) {
					outputStream.write(buffer, 0, len)
					len = zipStream.read(buffer)
				}
				writeFileBytes(targetPath, outputStream.toByteArray())
				savedAssetPaths.set(entryName, targetPath)
			}
			entry = zipStream.getNextEntry()
		}
		
		if (manifest == null) {
			reject(new Error("未找到 manifest.json"))
			return
		}
		
		// V6 限制
		if (manifest!.version < '6.0') {
			reject(new Error("不支持低于 V6.0 版本的旧数据包"))
			return
		}
		
		let groups: TabGroup[] = []
		let tabs: TabConfig[] = []
		let components: ComponentConfig[] = []
		let processRecords: UTSJSONObject[] = []
		let operationRecords: UTSJSONObject[] = []
		let stepRecords: UTSJSONObject[] = []
		let actionRecords: UTSJSONObject[] = []

		if (manifest!.files != null) {
			const files = manifest!.files as ManifestFileRefs
			
			const findJsonFile = (path: string): string | null => {
				let content = jsonFiles.get(path)
				if (content != null) return content
				const altPath = path.replace(/\/\//g, '\\\\')
				content = jsonFiles.get(altPath)
				if (content != null) return content
				const altPath2 = path.replace(/\\\\/g, '/')
				return jsonFiles.get(altPath2) || null
			}

			if (files.tabs != null) {
				const content = findJsonFile(files.tabs)
				if (content != null) groups = JSON.parse(content) as TabGroup[]
			}
			if (files.tab != null) {
				const content = findJsonFile(files.tab)
				if (content != null) tabs = JSON.parse(content) as TabConfig[]
			}
			if (files.components != null) {
				const content = findJsonFile(files.components)
				if (content != null) components = JSON.parse(content) as ComponentConfig[]
			}
			
			// 读取 V6 数据表
			const processJson = findJsonFile('data/process.json')
			if (processJson != null) processRecords = JSON.parse(processJson) as UTSJSONObject[]
			
			const opJson = findJsonFile('data/operation.json')
			if (opJson != null) operationRecords = JSON.parse(opJson) as UTSJSONObject[]
			
			const stepJson = findJsonFile('data/step.json')
			if (stepJson != null) stepRecords = JSON.parse(stepJson) as UTSJSONObject[]
			
			const actionJson = findJsonFile('data/action.json')
			if (actionJson != null) actionRecords = JSON.parse(actionJson) as UTSJSONObject[]
		}
		
		const PROCESS_FIELDS = ['innerId', 'code', 'name', 'classId', 'classId_display', 'classId_business_icon', 'classId_icon', 'version', 'fullversionNo', 'stateName', 'checkoutState', 'checkoutState_display', 'modifyById', 'modifyById_display', 'modifyTime', 'createById', 'createById_display', 'createTime', 'createTime_display', 'contextName', 'contextId', 'contextId_display', 'departmentName', 'workshopName', 'personalworkspace', 'personalworkspace_display', 'folderPath', 'phaseId', 'phaseId_display', 'secretId', 'secretId_display', 'lifeCycleTemplate', 'lifeCycleTemplate_display', 'taskName', 'routeContent', 'mfgNodeName', 'processCharacteristics', 'note', 'partCode', 'partName', 'partClassId', 'partClassId_display', 'partClassId_business_icon', 'partModifyById', 'partModifyById_display', 'partModifyTime', 'partContextName', 'partPhaseId', 'partPhaseId_display', 'partSecretId', 'partSecretId_display', 'partStateName', 'partFullversionNo', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const OPERATION_FIELDS = ['innerId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'isKey', 'isKey_display', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const STEP_FIELDS = ['innerId', 'operationId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'note', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const ACTION_FIELDS = ['innerId', 'stepId', 'operationId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'note', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']

		// 开始事务
		beginTransaction()
		
		try {
			// 保存 UI 配置（链式调用）
			saveUiConfigurationToDatabase(groups, tabs, components)
				.then((uiConfigCount: number) => {
					return executeSQL('INSERT OR REPLACE INTO meta_process_tree (id, data_json) VALUES (?, ?)', ['process_tree', processTreeStr]).then(() => saveRelationalDataToDatabase('t_process', processRecords, PROCESS_FIELDS)).then(()=>uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					return saveRelationalDataToDatabase('t_operation', operationRecords, OPERATION_FIELDS).then(()=>uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					return saveRelationalDataToDatabase('t_step', stepRecords, STEP_FIELDS).then(()=>uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					return saveRelationalDataToDatabase('t_action', actionRecords, ACTION_FIELDS).then(()=>uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					let resourceCount = 0
					const allResources: ResourceItem[] = []
					const rawResources: ResourceItem[] = []
					
					if (manifest?.files != null) {
						const files = manifest!.files as ManifestFileRefs
						const attPath = files.attachment // V6 强制存在
						let attContent = jsonFiles.get(attPath)
						if (attContent == null) attContent = jsonFiles.get(attPath.replace(/\/\//g, '\\\\'))
						if (attContent == null) attContent = jsonFiles.get(attPath.replace(/\\\\/g, '/'))
						
						if (attContent != null) {
							const indRes = parseAttachmentFile(attContent)
							for (const res of indRes) {
								rawResources.push(res)
							}
						}
					}

					for (const res of rawResources) {
						const originalPath = res.originalPath
						const localPath = savedAssetPaths.get(originalPath) || savedAssetPaths.get(originalPath.replace(/\/\//g, '\\\\'))
						
						if (localPath != null) {
							res.path = localPath
						} else {
							continue
						}
						
						if (res.thumbnail != '') {
							const thumbPath = savedAssetPaths.get(res.thumbnail)
							if (thumbPath != null) res.thumbnail = thumbPath
							else res.thumbnail = ''
						}
						allResources.push(res)
					}
					
					const executeDbSave = async () => {
						try {
							for (const res of allResources) {
								await saveResource(res)
								resourceCount++
							}
							console.log('Android: Saved resources:', resourceCount)
							
							setTransactionSuccessful()
							resolve({
								success: true,
								message: '导入成功',
								nodeCount: processRecords.length,
								uiConfigCount: uiConfigCount,
								resourceCount: resourceCount,
								importTime: 0
							})
						} catch(e: any | null) {
							endTransaction()
							reject(new Error(e != null ? e.toString() : '数据库保存失败'))
						}
					}
					// @ts-ignore
					executeDbSave().then(()=>{}).catch((e: any | null)=>{})
				})
				.catch((uiErr: any) => {
					endTransaction()
					reject(new Error('数据入库失败: ' + (uiErr != null ? uiErr.toString() : 'unknown')))
				})
				
		} catch (e: any) {
			endTransaction()
			reject(new Error('数据库保存失败: ' + e.toString()))
		}

/**
 * 判断是否为资源文件
 * @param entryName ZIP 条目名称
 */
function isAssetFile(entryName: string): boolean {
	const normalized = entryName.toLowerCase().replace(/\\/g, '/')
	
	// 检查是否在 assets 目录下
	if (!normalized.startsWith('assets/')) {
		return false
	}
	
	// 排除 icons 目录（图标使用项目静态资源）
	if (normalized.includes('/icons/')) {
		return false
	}
	
	// 检查扩展名
	const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg']
	const videoExts = ['.mp4', '.webm', '.avi', '.mov', '.mkv']
	const audioExts = ['.mp3', '.wav', '.aac', '.ogg', '.m4a']
	const docExts = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.txt']
	// CAD 图纸格式（卡伦特供应商的 HTML 封装 CAD）
	const cadExts = ['.html', '.htm']
	
	const allExts = imageExts.concat(videoExts).concat(audioExts).concat(docExts).concat(cadExts)
	
	for (const ext of allExts) {
		if (normalized.endsWith(ext)) {
			return true
		}
	}
	
	return false
}

/**
 * 获取相对资源路径（去除 assets/ 前缀）
 * @param entryName ZIP 条目名称
 */
function getRelativeAssetPath(entryName: string): string {
	const normalized = entryName.replace(/\\/g, '/')
	
	// 移除 assets/ 前缀
	if (normalized.startsWith('assets/')) {
		return normalized.substring(7)
	}
	
	return normalized
}
// #endif

// #ifdef APP-HARMONY
/**
 * 鸿蒙端解压并解析数据包内容
 * @description 将 ZIP 写入临时文件 → 使用 zlib 解压 → 读取解压文件 → 保存到数据库
 */
function extractAndParseHarmony(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		const userDataPath = uni.env.USER_DATA_PATH as string
		const tempZipPath = userDataPath + '/temp_import_' + Date.now() + '.zip'
		const tempExtractDir = userDataPath + '/temp_import_extract_' + Date.now()
		
		// 将 ZIP 数据写入临时文件
		uni.getFileSystemManager().writeFile({
			filePath: tempZipPath,
			data: zipData,
			success: () => {
				// 创建解压目录
				try {
					uni.getFileSystemManager().mkdirSync(tempExtractDir, true)
				} catch (e: any) { /* 目录可能已存在 */ }
				
				// 更新进度：解压中
				if (onProgress != null) {
					onProgress({
						current: 45,
						total: 100,
						currentFile: 'Harmony: 解压中...',
						status: 'extracting'
					})
				}
				
				// 使用 uni 内置 unzip 解压，兼容 unifile:// 环境协议
				uni.getFileSystemManager().unzip({
					zipFilePath: tempZipPath,
					targetPath: tempExtractDir,
					success: () => {
						// 解压成功，开始解析文件
						processHarmonyExtractedFiles(
							tempExtractDir,
							onProgress,
							(result: ImportResult) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								resolve(result)
							},
							(error: Error) => {
								cleanupTempFiles(tempZipPath, tempExtractDir)
								reject(error)
							}
						)
					},
					fail: (unzipErr: any) => {
						cleanupTempFiles(tempZipPath, tempExtractDir)
						const errMsg = unzipErr != null ? JSON.stringify(unzipErr) : 'unknown'
						reject(new Error('Harmony ZIP 解压失败：' + errMsg))
					}
				})
			},
			fail: (writeErr: any) => {
				reject(new Error('Harmony: 写入临时 ZIP 文件失败'))
			}
		})
	} catch (e: any) {
		reject(new Error('Harmony 解析数据包异常：' + e.toString()))
	}
}

/**
 * 处理鸿蒙端解压后的文件
 * @description 读取 manifest、解析 UI 配置、工艺数据和资源文件
 */
function processHarmonyExtractedFiles(
	extractDir: string,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	try {
		// 辅助函数：查找并读取 JSON 文件（兼容正斜杠和反斜杠）
		const readJsonFileHarmony = (path: string): string => {
			const fullPath = extractDir + '/' + path
			try {
				return uni.getFileSystemManager().readFileSync(fullPath, 'utf-8') as string
			} catch (e1: any) {
				try {
					const altPath = path.replace(/\//g, '\\')
					return uni.getFileSystemManager().readFileSync(extractDir + '/' + altPath, 'utf-8') as string
				} catch (e2: any) {
					try {
						const altPath2 = path.replace(/\\/g, '/')
						return uni.getFileSystemManager().readFileSync(extractDir + '/' + altPath2, 'utf-8') as string
					} catch (e3 : any) {
						console.error('Harmony: 文件读取失败! 路径=' + path + ', 完整路径=' + fullPath)
						return ''
					}
				}
			}
		}

		// 1. 读取 manifest.json
		const manifestData = readJsonFileHarmony('manifest.json')
		const manifest = JSON.parse(manifestData) as PackageManifest
		
		if (manifest.version < '6.0') {
			reject(new Error("不支持低于 V6.0 版本的旧数据包"))
			return
		}
		
		if (onProgress != null) {
			onProgress({
				current: 55,
				total: 100,
				currentFile: '解析数据...',
				status: 'extracting'
			})
		}
		
		// 3. 读取 UI 配置 (V6 规范下必须存在 files 映射)
		let groups: TabGroup[] = []
		let tabs: TabConfig[] = []
		let components: ComponentConfig[] = []
		
		let processRecords: UTSJSONObject[] = []
		let operationRecords: UTSJSONObject[] = []
		let stepRecords: UTSJSONObject[] = []
		let actionRecords: UTSJSONObject[] = []
		let processTreeContent: string = ''
		
		const files = manifest.files as ManifestFileRefs
		
		if (files.tabs != null) {
			try {
				const content = readJsonFileHarmony(files.tabs)
				groups = JSON.parse(content) as TabGroup[]
			} catch (e: any) {
				console.warn('Harmony: tabs 文件读取失败:', e)
			}
		}
		
		if (files.tab != null) {
			try {
				const content = readJsonFileHarmony(files.tab)
				tabs = JSON.parse(content) as TabConfig[]
			} catch (e: any) {
				console.warn('Harmony: tab 文件读取失败:', e)
			}
		}
		
		if (files.components != null) {
			try {
				const content = readJsonFileHarmony(files.components)
				components = JSON.parse(content) as ComponentConfig[]
			} catch (e: any) {
				console.warn('Harmony: components 文件读取失败:', e)
			}
		}
		
		// 4. 解析工艺数据表 (V6)
		console.log('Harmony: 开始解析工艺数据, 正在检索 manifest.files...')
		
		// 动态寻找 Key 的辅助函数
		const findKeyFuzzy = (map: UTSJSONObject, target: string) : string | null => {
			const keys = Object.keys(map)
			console.log('Harmony: 检查 Key:', target, '在集合中:', JSON.stringify(keys))
			if (map[target] != null) return target
			// 模糊匹配: 如果有 keys 包含 target
			for (let i = 0; i < keys.length; i++) {
				if (keys[i].toLowerCase().includes(target.toLowerCase())) return keys[i]
			}
			return null
		}

		try {
			const processKey = findKeyFuzzy(files, 'process')
			const processContent = readJsonFileHarmony(processKey != null ? files[processKey] as string : 'data/process.json')
			if (processContent != '') processRecords = JSON.parse(processContent) as UTSJSONObject[]

			const opKey = findKeyFuzzy(files, 'operation')
			const opContent = readJsonFileHarmony(opKey != null ? files[opKey] as string : 'data/operation.json')
			if (opContent != '') operationRecords = JSON.parse(opContent) as UTSJSONObject[]

			const stepKey = findKeyFuzzy(files, 'step')
			const stepContent = readJsonFileHarmony(stepKey != null ? files[stepKey] as string : 'data/step.json')
			if (stepContent != '') stepRecords = JSON.parse(stepContent) as UTSJSONObject[]

			const actionKey = findKeyFuzzy(files, 'action')
			const actionContent = readJsonFileHarmony(actionKey != null ? files[actionKey] as string : 'data/action.json')
			if (actionContent != '') actionRecords = JSON.parse(actionContent) as UTSJSONObject[]
			
			const pTreeKey = findKeyFuzzy(files, 'process_tree')
			processTreeContent = readJsonFileHarmony(pTreeKey != null ? files[pTreeKey] as string : 'data/process_tree.json')
			
			console.log('Harmony解析完成: process=' + processRecords.length + ', op=' + operationRecords.length + ', step=' + stepRecords.length + ', action=' + actionRecords.length)
			console.log('Harmony布局解析: groups=' + groups.length + ', tabs=' + tabs.length + ', components=' + components.length)
		} catch(e) {
			console.warn('Harmony: V6 表数据解析异常', e)
		}
		
		if (onProgress != null) {
			onProgress({
				current: 70,
				total: 100,
				currentFile: '保存数据...',
				status: 'extracting'
			})
		}
		
		// 5. 处理资源文件（复制到应用沙箱）
		const savedAssetPaths = new Map<string, string>()
		const assetsBasePath = getAssetsBasePath()
		
		// 确保资源目录存在
		try {
			uni.getFileSystemManager().mkdirSync(assetsBasePath, true)
		} catch (e: any) { /* 目录可能已存在 */ }
		
		// 复制解压出的资源文件到沙箱
		try {
			const assetsDir = extractDir + '/assets'
			copyAssetsRecursive(assetsDir, assetsBasePath, '', savedAssetPaths)
		} catch (e: any) {
			console.warn('Harmony: 资源文件复制失败:', e)
		}
		
		// 6. 保存到数据库
		const PROCESS_FIELDS = ['innerId', 'code', 'name', 'classId', 'classId_display', 'classId_business_icon', 'classId_icon', 'version', 'fullversionNo', 'stateName', 'checkoutState', 'checkoutState_display', 'modifyById', 'modifyById_display', 'modifyTime', 'createById', 'createById_display', 'createTime', 'createTime_display', 'contextName', 'contextId', 'contextId_display', 'departmentName', 'workshopName', 'personalworkspace', 'personalworkspace_display', 'folderPath', 'phaseId', 'phaseId_display', 'secretId', 'secretId_display', 'lifeCycleTemplate', 'lifeCycleTemplate_display', 'taskName', 'routeContent', 'mfgNodeName', 'processCharacteristics', 'note', 'partCode', 'partName', 'partClassId', 'partClassId_display', 'partClassId_business_icon', 'partModifyById', 'partModifyById_display', 'partModifyTime', 'partContextName', 'partPhaseId', 'partPhaseId_display', 'partSecretId', 'partSecretId_display', 'partStateName', 'partFullversionNo', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const OPERATION_FIELDS = ['innerId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'isKey', 'isKey_display', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const STEP_FIELDS = ['innerId', 'operationId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'note', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']
		const ACTION_FIELDS = ['innerId', 'stepId', 'operationId', 'processId', 'code', 'name', 'serialNumber', 'classId', 'classId_display', 'note', 'content', 'tabs_top', 'tabs_bottom', 'sortOrder']

		beginTransaction()
		
		try {
			let resourceCount = 0
			const allResources: ResourceItem[] = []
			const rawResources: ResourceItem[] = []
			
			if (manifest?.files != null) {
				const files = manifest.files as ManifestFileRefs
				const attPath = files.attachment // V6 强制存在
				try {
					const attContent = readJsonFileHarmony(attPath)
					const indRes = parseAttachmentFile(attContent)
					for (const res of indRes) {
					    rawResources.push(res)
					}
				} catch (e: any) {
					console.warn('Harmony: 独立资源文件读取失败', e)
				}
			}
			
			for (const res of rawResources) {
				const originalPath = res.originalPath
				const localPath = savedAssetPaths.get(originalPath)
				
				if (localPath != null) {
					res.path = localPath
				} else {
					const altPath = originalPath.replace(/\//g, '\\\\')
					const altLocalPath = savedAssetPaths.get(altPath)
					if (altLocalPath != null) {
						res.path = altLocalPath
					} else {
						console.warn('Harmony: 资源文件未找到:', originalPath)
						continue
					}
				}
				
				if (res.thumbnail != '') {
					const thumbPath = savedAssetPaths.get(res.thumbnail)
					if (thumbPath != null) {
						res.thumbnail = thumbPath
					} else {
						res.thumbnail = ''
					}
				}
				
				allResources.push(res)
			}
			
			// 使用 Promise 链式调用保存表和 UI 配置
			saveUiConfigurationToDatabase(groups, tabs, components)
				.then((uiConfigCount: number) => {
					console.log('Harmony: UI配置存储成功, count=' + uiConfigCount)
					return saveRelationalDataToDatabase('t_process', processRecords, PROCESS_FIELDS).then(() => uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					console.log('Harmony: t_process存储成功, count=' + processRecords.length)
					return saveRelationalDataToDatabase('t_operation', operationRecords, OPERATION_FIELDS).then(() => uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					console.log('Harmony: t_operation存储成功, count=' + operationRecords.length)
					return saveRelationalDataToDatabase('t_step', stepRecords, STEP_FIELDS).then(() => uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					console.log('Harmony: t_step存储成功, count=' + stepRecords.length)
					return saveRelationalDataToDatabase('t_action', actionRecords, ACTION_FIELDS).then(() => uiConfigCount)
				})
				.then((uiConfigCount: number) => {
					console.log('Harmony: t_action存储成功, count=' + actionRecords.length)
					return new Promise<number>((res) => {
						if (processTreeContent != '') {
							executeSQL("INSERT OR REPLACE INTO meta_process_tree (id, data_json) VALUES (?, ?)", ['process_tree', processTreeContent])
								.then(() => {
									console.log('Harmony: meta_process_tree 存储成功')
									res(uiConfigCount)
								})
								.catch((e) => {
									console.warn('Harmony: meta_process_tree 存储失败', e)
									res(uiConfigCount)
								})
						} else {
							res(uiConfigCount)
						}
					})
				})
				.then((uiConfigCount: number) => {
					console.log('Harmony: 业务数据存储全部完成, 开始保存资源')
					
					const saveNextResourceAsync = (index: number, uiCount: number, resolveData: (value: ImportResult) => void) => {
						if (index >= allResources.length) {
							console.log('Harmony: 保存资源条数:', resourceCount)
							setTransactionSuccessful()
							endTransaction()
							resolveData({
								success: true,
								message: '导入成功',
								nodeCount: processRecords.length,
								uiConfigCount: uiCount,
								resourceCount: resourceCount,
								importTime: 0
							})
							return
						}
						
						saveResource(allResources[index])
							.then(() => {
								resourceCount++
								saveNextResourceAsync(index + 1, uiCount, resolveData)
							})
							.catch((resErr: any) => {
								console.error('Harmony: 保存单一资源失败:', resErr)
								saveNextResourceAsync(index + 1, uiCount, resolveData)
							})
					}
					
					saveNextResourceAsync(0, uiConfigCount, resolve)
				})
				.catch((dbErr: any) => {
					console.error('Harmony: 数据库保存异常:', dbErr)
					endTransaction()
					const errMsg = dbErr instanceof Error ? dbErr.message : (dbErr != null ? dbErr.toString() : 'unknown')
					reject(new Error('数据入库异常: ' + errMsg))
				})
				


		} catch (e: any) {
			console.error('Harmony: 解析数据包环境构建异常:', e)
			endTransaction()
			reject(new Error('Harmony 数据库保存前失败: ' + e.toString()))
		}
	} catch (e: any) {
		console.error('Harmony: 解析数据包顶级流程异常:', e)
		reject(new Error('Harmony: 解析数据包失败：' + e.toString()))
	}
}

/**
 * 递归复制资源文件到应用沙箱
 * @param sourceDir 源目录
 * @param targetDir 目标目录
 * @param relativePath 相对路径
 * @param savedPaths 已保存路径映射
 */
function copyAssetsRecursive(
	sourceDir: string, 
	targetDir: string, 
	relativePath: string, 
	savedPaths: Map<string, string>
): void {
	try {
		const entries = uni.getFileSystemManager().readdirSync(sourceDir)
		if (entries == null) return
		
		for (const entry of entries) {
			const sourcePath = sourceDir + '/' + entry
			const entryRelPath = relativePath != '' ? relativePath + '/' + entry : entry
			const targetPath = targetDir + '/' + entryRelPath
			
			try {
				// 在鸿蒙底层，statSync 返回的对象可能因版本遗失 isDirectory() 方法，
				// 这里使用 readdirSync 探测是否为目录的旁路判断更为稳妥
				let isDir = false
				try {
					uni.getFileSystemManager().readdirSync(sourcePath)
					isDir = true
				} catch (err: any) {
					isDir = false
				}
				
				if (isDir) {
					// 确保目标目录存在
					try {
						uni.getFileSystemManager().mkdirSync(targetPath, true)
					} catch (e: any) { /* 目录可能已存在 */ }
					
					// 递归复制子目录
					copyAssetsRecursive(sourcePath, targetDir, entryRelPath, savedPaths)
				} else {
					// 检查是否是需要保存的资源文件
					const fullEntryName = 'assets/' + entryRelPath
					if (isAssetFileHarmony(fullEntryName)) {
						// 确保父目录存在
						const parentDir = targetPath.substring(0, targetPath.lastIndexOf('/'))
						try {
							uni.getFileSystemManager().mkdirSync(parentDir, true)
						} catch (e: any) { /* 目录可能已存在 */ }
						
						// 复制文件
						uni.getFileSystemManager().copyFileSync(sourcePath, targetPath)
						savedPaths.set(fullEntryName, targetPath)
						console.log('Harmony: 保存资源:', fullEntryName, '->', targetPath)
					}
				}
			} catch (e: any) {
				console.warn('Harmony: 处理文件失败:', entry, e)
			}
		}
	} catch (e: any) {
		// 目录可能不存在，忽略
		console.warn('Harmony: 读取目录失败:', sourceDir, e)
	}
}

/**
 * Harmony 端判断是否为资源文件
 */
function isAssetFileHarmony(entryName: string): boolean {
	const normalized = entryName.toLowerCase().replace(/\\\\/g, '/')
	
	if (!normalized.startsWith('assets/')) {
		return false
	}
	
	// 排除 icons 目录
	if (normalized.includes('/icons/')) {
		return false
	}
	
	const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg']
	const videoExts = ['.mp4', '.webm', '.avi', '.mov', '.mkv']
	const audioExts = ['.mp3', '.wav', '.aac', '.ogg', '.m4a']
	const docExts = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.txt']
	// CAD 图纸格式（卡伦特供应商的 HTML 封装 CAD）
	const cadExts = ['.html', '.htm']
	
	const allExts = imageExts.concat(videoExts).concat(audioExts).concat(docExts).concat(cadExts)
	
	for (const ext of allExts) {
		if (normalized.endsWith(ext)) {
			return true
		}
	}
	
	return false
}
// #endif

// #ifdef WEB
function extractAndParseWeb(
	zipData: ArrayBuffer,
	onProgress: ImportProgressCallback | null,
	resolve: (value: ImportResult) => void,
	reject: (reason: Error) => void
): void {
	console.log('Web: Starting extraction, size:', zipData.byteLength);
	JSZip.loadAsync(zipData).then(async (zip: JSZip) => {
		try {
			// 1. 解析 manifest
			let manifest: PackageManifest | null = null
			const manifestFile = zip.file("manifest.json")
			if (manifestFile != null) {
				console.log('Web: manifest.json found');
				const content = await manifestFile.async("string")
				manifest = JSON.parse(content) as PackageManifest
				console.log('Web: Manifest version:', manifest.version);
			} else {
				console.warn('Web: manifest.json NOT found');
				reject(new Error("数据包中未找到 manifest.json"))
				return
			}
			
			if (manifest!.version < '6.0') {
				reject(new Error("不支持低于 V6.0 版本的旧数据包"))
				return
			}
			
			// 3. 读取数据和UI配置
			let groups: TabGroup[] = []
			let tabs: TabConfig[] = []
			let components: ComponentConfig[] = []
			let iconConfig: UTSJSONObject | null = null
			
			let processRecords: UTSJSONObject[] = []
			let operationRecords: UTSJSONObject[] = []
			let stepRecords: UTSJSONObject[] = []
			let actionRecords: UTSJSONObject[] = []
			
			const files = manifest.files as ManifestFileRefs
			
			// 辅助函数：从 ZIP 中查找文件（兼容正斜杠和反斜杠）
			const findZipFile = (path: string): any => {
				let file = zip.file(path)
				if (file != null) return file
				const altPath = path.replace(/\//g, '\\')
				file = zip.file(altPath)
				if (file != null) return file
				const altPath2 = path.replace(/\\/g, '/')
				return zip.file(altPath2)
			}
			
			if (files.tabs != null) {
				const groupsFile = findZipFile(files.tabs)
				if (groupsFile != null) {
					const content = await groupsFile.async("string")
					groups = JSON.parse(content) as TabGroup[]
				}
			}
			
			if (files.tab != null) {
				const tabsFile = findZipFile(files.tab)
				if (tabsFile != null) {
					const content = await tabsFile.async("string")
					tabs = JSON.parse(content) as TabConfig[]
				}
			}
			
			if (files.components != null) {
				const componentsFile = findZipFile(files.components)
				if (componentsFile != null) {
					const content = await componentsFile.async("string")
					components = JSON.parse(content) as ComponentConfig[]
				}
			}
			
			if (files.icons != null) {
				const iconsFile = findZipFile(files.icons as string)
				if (iconsFile != null) {
					const content = await iconsFile.async("string")
					iconConfig = JSON.parse(content) as UTSJSONObject
				}
			}
			
			// 4. 解析工艺数据表 (V6)
			const readTableFile = async (pathKey: string | null, defPath: string): Promise<UTSJSONObject[]> => {
				const p = pathKey ?? defPath
				const fileEntry = findZipFile(p)
				if (fileEntry != null) {
					try {
						const content = await fileEntry.async("string")
						return JSON.parse(content) as UTSJSONObject[]
					} catch(e) { console.warn('Web parse failed for', p, e) }
				}
				return []
			}
			
            let processTreeStr = ''
            const pTreeFile = findZipFile((files['process_tree'] as string | null) ?? '') || findZipFile('data/process_tree.json')
            if (pTreeFile != null) {
                try { processTreeStr = await pTreeFile.async("string") } catch(e:any){}
            }
            processRecords = await readTableFile(files['process'] as string | null, 'data/process.json')
    
			operationRecords = await readTableFile(files['operation'] as string | null, 'data/operation.json')
			stepRecords = await readTableFile(files['step'] as string | null, 'data/step.json')
			actionRecords = await readTableFile(files['action'] as string | null, 'data/action.json')
			
			// 5. 保存到数据库
			console.log('Web: Saving to database...');
			
			try {
				await webClearStore('meta_tab_groups')
				await webClearStore('meta_tabs')
				await webClearStore('meta_components')
				
				await webClearStore('t_process')
				await webClearStore('t_operation')
				await webClearStore('t_step')
				await webClearStore('t_action')
				
				await webClearStore('t_icon_config')
				
				let uiConfigCount = 0
				
				for (const g of groups) {
					await webPutData('meta_tab_groups', g)
					uiConfigCount++
				}
				
				for (const t of tabs) {
					await webPutData('meta_tabs', t)
					uiConfigCount++
				}
				
				for (const c of components) {
					await webPutData('meta_components', c)
					uiConfigCount++
				}
				
				if (iconConfig != null) {
					const nodeIcons = iconConfig['nodeIcons'] as UTSJSONObject
					if (nodeIcons != null) {
						for (const nodeType of Object.keys(nodeIcons)) {
							const cfg = nodeIcons[nodeType] as UTSJSONObject
							await webPutData('t_icon_config', {
								node_type: nodeType,
								icon_name: cfg['icon'] ?? nodeType,
								fallback: cfg['fallback'] ?? ''
							})
						}
					}
				}
				
				// Web 端 IndexedDB 暂不使用 standard_fields 拆分写入，直接写入整条 JSON 记录（底层用 KV 或 Document 模式）
				await webPutData('meta_process_tree', {id: 'process_tree', data_json: processTreeStr})
				for (const row of processRecords) {
					row['inner_id'] = row['inner_id'] ?? row['innerId'] ?? ''
					if ((row['inner_id'] as string) === '') continue;
					try { await webPutData('t_process', row) } catch(e) { console.error('Failed to put t_process:', e) }
				}
				for (const row of operationRecords) {
					row['inner_id'] = row['inner_id'] ?? row['innerId'] ?? ''
					row['process_id'] = row['process_id'] ?? row['processId'] ?? ''
					if ((row['inner_id'] as string) === '') continue;
					try { await webPutData('t_operation', row) } catch(e) { console.error('Failed to put t_operation:', e) }
				}
				for (const row of stepRecords) {
					row['inner_id'] = row['inner_id'] ?? row['innerId'] ?? ''
					row['operation_id'] = row['operation_id'] ?? row['operationId'] ?? ''
					row['process_id'] = row['process_id'] ?? row['processId'] ?? ''
					if ((row['inner_id'] as string) === '') continue;
					try { await webPutData('t_step', row) } catch(e) { console.error('Failed to put t_step:', e) }
				}
				for (const row of actionRecords) {
					row['inner_id'] = row['inner_id'] ?? row['innerId'] ?? ''
					row['step_id'] = row['step_id'] ?? row['stepId'] ?? ''
					row['operation_id'] = row['operation_id'] ?? row['operationId'] ?? ''
					row['process_id'] = row['process_id'] ?? row['processId'] ?? ''
					if ((row['inner_id'] as string) === '') continue;
					try { await webPutData('t_action', row) } catch(e) { console.error('Failed to put t_action:', e) }
				}
				
				// 资源处理
				let resourceCount = 0
				await webClearStore('t_resources')
				clearBlobUrls()
				
				const rawResources: ResourceItem[] = []
				const attPath = files.attachment // V5 强制
				const attFile = findZipFile(attPath)
				if (attFile != null) {
					try {
						const attContent = await attFile.async("string")
						const indRes = parseAttachmentFile(attContent)
						for (const res of indRes) {
							rawResources.push(res)
						}
					} catch (e) {
						console.warn('Web: Failed to parse attachment.json', e)
					}
				}

				
				for (const res of rawResources) {
					const resourcePath = res.originalPath
					if (resourcePath == '') continue
					
					const resourceFile = findZipFile(resourcePath) || findZipFile(resourcePath.replace(/\/\//g, '\\\\'))
					if (resourceFile != null && !resourceFile.dir) {
						try {
							const blob = await resourceFile.async("blob")
							const blobUrl = storeBlobAndGetUrl(res.id, blob, res.name)
							res.path = blobUrl
							
							let thumbBlobData = null
							if (res.thumbnail != '') {
								const thumbFile = findZipFile(res.thumbnail) || findZipFile(res.thumbnail.replace(/\/\//g, '\\\\'))
								if (thumbFile != null) {
									const thumbBlob = await thumbFile.async("blob")
									const thumbUrl = storeBlobAndGetUrl(res.id + '_thumb', thumbBlob)
									res.thumbnail = thumbUrl
									thumbBlobData = thumbBlob
								}
							}
							
							await webPutData('t_resources', {
								id: res.id,
								node_id: res.nodeId,
								type: res.type,
								name: res.name,
								path: res.path,
								original_path: res.originalPath,
								thumbnail: res.thumbnail,
								duration: res.duration,
								size: res.size,
								description: res.description,
								sort_order: res.sortOrder,
								blob_data: blob,
								thumbnail_blob: thumbBlobData
							})
							resourceCount++
						} catch (e) {
							console.warn('Web: Failed to extract resource:', resourcePath, e);
						}
					}
				}
				
				console.log('Web: DB Save success');
				resolve({
					success: true,
					message: '导入成功',
					nodeCount: processRecords.length,
					uiConfigCount: uiConfigCount,
					resourceCount: resourceCount,
					importTime: 0
				})
			} catch (e: any) {
				console.error('Web: DB Save failed', e);
				reject(new Error('数据库保存失败: ' + e.message))
			}
			
		} catch (e: any) {
			console.error('Web: Extraction error', e);
			reject(new Error("Web 导入处理失败: " + e.message))
		}
	}).catch((e: any) => {
		console.error('Web: ZIP load failed in extraction', e);
		reject(new Error("ZIP 加载失败: " + e.message))
	})
}
// #endif


/**
 * 保存 UI 配置到数据库（使用纯 Promise 链式调用，兼容鸿蒙 UTS 运行时）
 */
function saveUiConfigurationToDatabase(
	groups: TabGroup[],
	tabs: TabConfig[],
	components: ComponentConfig[]
): Promise<number> {
	return new Promise<number>((resolve: (value: number) => void, reject: (reason: any) => void) => {
		// 收集所有需要执行的 SQL 及参数
		const sqlQueue: UTSJSONObject[] = []
		
		// 导入分组
		if (groups.length > 0) {
			for (let i = 0; i < groups.length; i++) {
				const g = groups[i]
				sqlQueue.push({
					sql: "INSERT OR REPLACE INTO meta_tab_groups (id, name, description, sort_order) VALUES (?, ?, ?, ?)",
					params: [g.id, g.name, g.description, g.sort_order]
				})
			}
		}
		
		// 导入 Tab
		if (tabs.length > 0) {
			for (let i = 0; i < tabs.length; i++) {
				const t = tabs[i]
				sqlQueue.push({
					sql: "INSERT OR REPLACE INTO meta_tabs (id, group_id, title, sort_order, visible_condition) VALUES (?, ?, ?, ?, ?)",
					params: [t.id, t.group_id, t.title, t.sort_order, t.visible_condition]
				})
			}
		}
		
		// 导入组件
		if (components.length > 0) {
			for (let i = 0; i < components.length; i++) {
				const c = components[i]
				const configJson = c.config != null ? JSON.stringify(c.config) : ''
				sqlQueue.push({
					sql: "INSERT OR REPLACE INTO meta_components (id, tab_id, type, title, config_json, sort_order) VALUES (?, ?, ?, ?, ?, ?)",
					params: [c.id, c.tab_id, c.type, c.title, configJson, c.sort_order]
				})
			}
		}
		

		
		// 使用递归 .then() 链逐条执行 SQL，确保顺序
		let completed = 0
		const executeNext = (index: number) => {
			if (index >= sqlQueue.length) {
				resolve(completed)
				return
			}
			const item = sqlQueue[index]
			const sql = item['sql'] as string
			const params = item['params'] as any[]
			executeSQL(sql, params)
				.then((_: any) => {
					completed++
					executeNext(index + 1)
				})
				.catch((e: any) => {
					console.error('saveUiConfig SQL 失败:', sql, e)
					// 容错：跳过失败的 SQL 继续执行
					executeNext(index + 1)
				})
		}
		executeNext(0)
	})
}

/**
 * 智能分拣并保存数据到数据库 (V6 核心机制)
 */
export function saveRelationalDataToDatabase(
	tableName: string, 
	records: UTSJSONObject[], 
	standardFields: string[]
): Promise<number> {
	return new Promise<number>((resolve, reject) => {
		if (records.length == 0) {
			resolve(0)
			return
		}
		const sqlQueue: UTSJSONObject[] = []
		for (let i = 0; i < records.length; i++) {
			const row = records[i]
			const extra: UTSJSONObject = {}
			const params: any[] = []
			
			for (let j = 0; j < standardFields.length; j++) {
				const jsonKey = standardFields[j]
				params.push(row[jsonKey] ?? null)
			}
			
			for (const key in row) {
				if (!standardFields.includes(key)) {
					extra[key] = row[key]
				}
			}
			params.push(JSON.stringify(extra))
			
			const placeholders = params.map(():string => '?').join(',')
			const dbCols = standardFields.map((s:string):string => {
				return s.replace(/[A-Z]/g, (letter:string):string => '_' + letter.toLowerCase())
			}).join(',') + ',extra_json'
			
			sqlQueue.push({
				sql: "INSERT OR REPLACE INTO " + tableName + " (" + dbCols + ") VALUES (" + placeholders + ")",
				params: params
			})
		}
		
		let completed = 0
		const executeNext = (index: number) => {
			if (index >= sqlQueue.length) {
				resolve(completed)
				return
			}
			const item = sqlQueue[index]
			const sql = item['sql'] as string
			const paramsList = item['params'] as any[]
			executeSQL(sql, paramsList)
				.then((_: any) => {
					completed++
					executeNext(index + 1)
				})
				.catch((e: any) => {
					console.error(tableName + ' insert error:', sql, e)
					executeNext(index + 1)
				})
		}
		executeNext(0)
	})
}

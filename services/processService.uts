/**
 * MPM 工艺预览系统 - 工艺数据服务 (V6 关系型)
 */

import { ProcessEntity, OperationEntity, StepEntity, ActionEntity } from '@/types/process'
import { PageParams, PageResult } from '@/types/common'
import { querySQL, executeSQL } from '@/services/database'

// #ifdef WEB
import { webGetAll, webGetByKey, webGetByIndex, webClearStore } from '@/services/database'
// #endif

/**
 * 辅助：将数据库 snake_case 行数据并入 camelCase，并合并 extra_json (Native 适用)
 */
function mapRelationalRow(row: any): UTSJSONObject {
    const raw = row as UTSJSONObject
    const obj: UTSJSONObject = {}
    
    for (const key in raw) {
        if (key != 'extra_json') {
            const camelKey = key.replace(/_([a-z])/g, (match: string, letter: string, _idx: number, _str: string): string => letter.toUpperCase())
            obj[camelKey] = raw[key]
        }
    }
    
    const extraStr = raw['extra_json'] as string | null
    if (extraStr != null && extraStr != '') {
        try {
            const extra = JSON.parse(extraStr) as UTSJSONObject
            for (const key in extra) {
                obj[key] = extra[key]
            }
        } catch (e: any) { }
    }
    
    // 一些数字到字符串的安全转换
    if (obj['innerId'] != null) obj['innerId'] = obj['innerId'].toString()
    
    return obj
}

/**
 * 获取工艺列表
 * @param params - 分页参数
 */
export function getProcessList(params: PageParams): Promise<PageResult<ProcessEntity>> {
	return new Promise((resolve, reject) => {
		// #ifdef WEB
		webGetAll('t_process').then(res => {
			let list = res as UTSJSONObject[]
			if (params.keyword != '') {
				list = list.filter(item => {
					const name = (item['name'] as string) || ''
					const code = (item['code'] as string) || ''
					return name.includes(params.keyword) || code.includes(params.keyword)
				})
			}
			// 内存排序(更新时间倒序)
			list.sort((a, b) => {
				const timeA = (a['updated_at'] as number) || 0
				const timeB = (b['updated_at'] as number) || 0
				return timeB - timeA
			})
			
			const total = list.length
			const offset = (params.page - 1) * params.pageSize
			const pageList = list.slice(offset, offset + params.pageSize)
			
			const entityList: ProcessEntity[] = []
			for (let i = 0; i < pageList.length; i++) {
				entityList.push(JSON.parse<ProcessEntity>(JSON.stringify(pageList[i]))!)
			}
			
			resolve({
				list: entityList,
				total: total,
				page: params.page,
				pageSize: params.pageSize
			})
		}).catch(e => reject(e))
		// #endif

		// #ifndef WEB
		const offset = (params.page - 1) * params.pageSize
		let countSQL = 'SELECT COUNT(*) as total FROM t_process'
		let querySQL_str = `SELECT * FROM t_process`
		
		if (params.keyword != '') {
			const whereClause = ` WHERE name LIKE '%${params.keyword}%' OR code LIKE '%${params.keyword}%'`
			countSQL += whereClause
			querySQL_str += whereClause
		}
		
		querySQL_str += ` ORDER BY updated_at DESC LIMIT ${params.pageSize} OFFSET ${offset}`
		
		querySQL(countSQL)
			.then((countResult: UTSJSONObject[]) => {
				const total = countResult.length > 0 ? (countResult[0]['total'] as number) : 0
				querySQL(querySQL_str)
					.then((listResult: UTSJSONObject[]) => {
						const list: ProcessEntity[] = []
						for (let i = 0; i < listResult.length; i++) {
							const mapped = mapRelationalRow(listResult[i])
							const node = JSON.parse<ProcessEntity>(JSON.stringify(mapped))
							if (node != null) list.push(node)
						}
						resolve({
							list: list,
							total: total,
							page: params.page,
							pageSize: params.pageSize
						})
					})
					.catch((e: any | null) => reject(new Error(JSON.stringify(e))))
			})
			.catch((e: any | null) => reject(new Error(JSON.stringify(e))))
		// #endif
	})
}

/**
 * 搜索工艺
 */
export function searchProcess(keyword: string): Promise<ProcessEntity[]> {
	return new Promise((resolve, reject) => {
		if (keyword == '') {
			resolve([])
			return
		}
		// #ifdef WEB
		webGetAll('t_process').then(res => {
			let list = res as UTSJSONObject[]
			list = list.filter(item => {
				const name = (item['name'] as string) || ''
				const code = (item['code'] as string) || ''
				return name.includes(keyword) || code.includes(keyword)
			})
			const entityList: ProcessEntity[] = []
			for (let i = 0; i < list.length && i < 20; i++) {
				entityList.push(JSON.parse<ProcessEntity>(JSON.stringify(list[i]))!)
			}
			resolve(entityList)
		}).catch(e => reject(e))
		// #endif

		// #ifndef WEB
		const sql = `SELECT * FROM t_process WHERE name LIKE '%${keyword}%' OR code LIKE '%${keyword}%' LIMIT 20`
		querySQL(sql)
			.then((result: UTSJSONObject[]) => {
				const list: ProcessEntity[] = []
				for (let i = 0; i < result.length; i++) {
					const mapped = mapRelationalRow(result[i])
					const node = JSON.parse<ProcessEntity>(JSON.stringify(mapped))
					if (node != null) list.push(node)
				}
				resolve(list)
			})
			.catch((e: any | null) => reject(e))
		// #endif
	})
}

/**
 * 获取具体的一条记录 (通过 inner_id 查询)
 */
export function getProcessDetail(id: string): Promise<ProcessEntity | null> {
    return new Promise((resolve, reject) => {
        // #ifdef WEB
        webGetByIndex('t_process', 'inner_id', id).then(res => {
            if (res.length > 0) {
                resolve(JSON.parse<ProcessEntity>(JSON.stringify(res[0])))
            } else {
                resolve(null)
            }
        }).catch(e => reject(e as Error))
        // #endif

        // #ifndef WEB
        querySQL(`SELECT * FROM t_process WHERE inner_id = '${id}'`)
            .then((result: UTSJSONObject[]) => {
                if (result.length > 0) {
                    const mapped = mapRelationalRow(result[0])
                    resolve(JSON.parse<ProcessEntity>(JSON.stringify(mapped)))
                } else {
                    resolve(null)
                }
            })
            .catch((e: any | null) => reject(e as Error))
        // #endif
    })
}

/**
 * 根据所属工艺ID，查询所有关联的工序
 */
export function getOperationsByProcessId(processId: string): Promise<OperationEntity[]> {
    return new Promise((resolve, reject) => {
        // #ifdef WEB
        webGetByIndex('t_operation', 'process_id', processId).then(res => {
            const list: OperationEntity[] = []
            for (let i = 0; i < res.length; i++) {
                list.push(JSON.parse<OperationEntity>(JSON.stringify(res[i]))!)
            }
            resolve(list)
        }).catch(e => reject(e as Error))
        // #endif

        // #ifndef WEB
        querySQL(`SELECT * FROM t_operation WHERE process_id = '${processId}' ORDER BY sort_order ASC`)
            .then((result: UTSJSONObject[]) => {
                const list: OperationEntity[] = []
                for (let i = 0; i < result.length; i++) {
                    const mapped = mapRelationalRow(result[i])
                    const node = JSON.parse<OperationEntity>(JSON.stringify(mapped))
                    if (node != null) list.push(node)
                }
                resolve(list)
            })
            .catch((e: any | null) => reject(e as Error))
        // #endif
    })
}


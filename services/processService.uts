export function clearAllProcesses(): Promise<void> {
    return new Promise((resolve, reject) => {
        // #ifdef WEB
        Promise.all([
            webClearStore('t_process'),
            webClearStore('t_operation'),
            webClearStore('t_step'),
            webClearStore('t_action'),
            webClearStore('t_node_dataset')
        ]).then(() => resolve()).catch(e => reject(e as Error))
        // #endif

        // #ifndef WEB
        executeSQL('DELETE FROM t_process')
            .then(() => executeSQL('DELETE FROM t_operation'))
            .then(() => executeSQL('DELETE FROM t_step'))
            .then(() => executeSQL('DELETE FROM t_action'))
            .then(() => executeSQL('DELETE FROM t_node_dataset'))
            .then(() => resolve())
            .catch((e: any | null) => reject(e as Error))
        // #endif
    })
}

/**
 * 按主键查单条记录（返回 camelCase 的 UTSJSONObject）
 * @param nodeType 节点类型 (process, operation, step, action)
 * @param nodeId 节点 ID
 */
export function queryNodeById(nodeType: string, nodeId: string): Promise<UTSJSONObject | null> {
    return new Promise((resolve, reject) => {
        let tableName = ''
        const type = nodeType.toLowerCase()
        if (type == 'process' || type == 'operation' || type == 'step' || type == 'action') {
            tableName = `t_${type}`
        } else {
            resolve(null)
            return
        }

        // #ifdef WEB
        // Web 使用 webGetByKey 按主键精确查找
        webGetByKey(tableName, nodeId).then((res) => {
            if (res != null) {
                resolve(res)
            } else {
                resolve(null)
            }
        }).catch(e => reject(e as Error))
        // #endif

        // #ifndef WEB
        querySQL(`SELECT * FROM ${tableName} WHERE inner_id = '${nodeId}'`)
            .then((result: UTSJSONObject[]) => {
                if (result.length > 0) {
                    const mapped = mapRelationalRow(result[0])
                    resolve(mapped)
                } else {
                    resolve(null)
                }
            })
            .catch((e: any | null) => reject(e as Error))
        // #endif
    })
}

/**
 * 按父节点类型和ID查子节点列表（返回 camelCase 的 UTSJSONObject 数组）
 * @param parentType 父节点类型
 * @param parentId 父节点 ID
 */
export function queryChildrenByParentId(parentType: string, parentId: string): Promise<UTSJSONObject[]> {
    return new Promise((resolve, reject) => {
        let childTableName = ''
        let foreignKey = ''
        const pType = parentType.toLowerCase()

        if (pType == 'process') {
            childTableName = 't_operation'
            foreignKey = 'process_id'
        } else if (pType == 'operation') {
            childTableName = 't_step'
            foreignKey = 'operation_id'
        } else if (pType == 'step') {
            childTableName = 't_action'
            foreignKey = 'step_id'
        } else {
            // 如果不支持查询子节点，直接返回空
            resolve([])
            return
        }

        // #ifdef WEB
        webGetByIndex(childTableName, foreignKey, parentId).then((res) => {
            const list = res as UTSJSONObject[]
            // Web 端查询回来的是对象数组，按照 sortOrder 排序
            list.sort((a, b) => {
                const sa = (a['sortOrder'] as number | null) ?? 0
                const sb = (b['sortOrder'] as number | null) ?? 0
                return sa - sb
            })
            resolve(list)
        }).catch(e => reject(e as Error))
        // #endif

        // #ifndef WEB
        querySQL(`SELECT * FROM ${childTableName} WHERE ${foreignKey} = '${parentId}' ORDER BY sort_order ASC`)
            .then((result: UTSJSONObject[]) => {
                const list: UTSJSONObject[] = []
                for (let i = 0; i < result.length; i++) {
                    const mapped = mapRelationalRow(result[i])
                    list.push(mapped)
                }
                resolve(list)
            })
            .catch((e: any | null) => reject(e as Error))
        // #endif
    })
}

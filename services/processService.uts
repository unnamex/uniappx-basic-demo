/**
 * MPM 工艺预览系统 - 工艺数据服务
 * @description 提供工艺数据的查询和管理功能（V4 纯树形结构）
 */

import { ProcessNode } from '@/types/process'
import { PageParams, PageResult } from '@/types/common'
import { querySQL, executeSQL } from '@/services/database'

/**
 * 获取工艺列表 (查询顶级 Process)
 * @param params - 分页参数
 * @returns Promise<PageResult<ProcessNode>> 分页结果
 */
export function getProcessList(params: PageParams): Promise<PageResult<ProcessNode>> {
	return new Promise((resolve: (value: PageResult<ProcessNode>) => void, reject: (reason: any) => void) => {
		const offset = (params.page - 1) * params.pageSize
		
		let countSQL = 'SELECT COUNT(*) as total FROM t_process'
		let querySQL_str = `
			SELECT inner_id, class_id, code, name, updated_at, data_json 
			FROM t_process
		`
		
		// 添加搜索条件
		if (params.keyword != '') {
			const whereClause = ` WHERE name LIKE '%${params.keyword}%' OR code LIKE '%${params.keyword}%'`
			countSQL += whereClause
			querySQL_str += whereClause
		}
		
		querySQL_str += ` ORDER BY updated_at DESC LIMIT ${params.pageSize} OFFSET ${offset}`
		
		// 查询总数
		querySQL(countSQL)
			.then((countResult: any[]) => {
				const total = countResult.length > 0 ? (countResult[0]['total'] as number) : 0
				
				// 查询列表数据
				querySQL(querySQL_str)
					.then((listResult: any[]) => {
						const list: ProcessNode[] = []
						
						for (let i = 0; i < listResult.length; i++) {
							const row = listResult[i]
							// 从 data_json 中反序列化出完整的 ProcessNode
							const dataJson = row['data_json'] as string
							if (dataJson && dataJson != '') {
								try {
									const node = JSON.parse<ProcessNode>(dataJson)
									if (node != null) {
										list.push(node as ProcessNode)
									}
								} catch (e: any) {
									console.error('反序列化工艺树失败', e)
								}
							}
						}
						
						resolve({
							list: list,
							total: total,
							page: params.page,
							pageSize: params.pageSize
						})
					})
					.catch((e: any | null) => {
						reject(new Error(JSON.stringify(e)))
					})
			})
			.catch((e: any | null) => {
				reject(new Error(JSON.stringify(e)))
			})
	})
}

/**
 * 搜索工艺
 * @param keyword - 搜索关键词
 * @returns Promise<ProcessNode[]> 搜索结果
 */
export function searchProcess(keyword: string): Promise<ProcessNode[]> {
	return new Promise((resolve: (value: ProcessNode[]) => void, reject: (reason: any) => void) => {
		if (keyword == '') {
			resolve([])
			return
		}
		
		const sql = `
			SELECT data_json 
			FROM t_process 
			WHERE name LIKE '%${keyword}%' OR code LIKE '%${keyword}%'
			ORDER BY updated_at DESC LIMIT 20
		`
		
		querySQL(sql)
			.then((result: any[]) => {
				const list: ProcessNode[] = []
				for (let i = 0; i < result.length; i++) {
					const dataJson = result[i]['data_json'] as string
					if (dataJson && dataJson != '') {
						try {
							const node = JSON.parse<ProcessNode>(dataJson)
							if (node != null) {
								list.push(node as ProcessNode)
							}
						} catch (e: any) {
							console.error('解析 JSON 失败', e)
						}
					}
				}
				resolve(list)
			})
			.catch((e: any | null) => {
				reject(e)
			})
	})
}

/**
 * 根据 innerId 树形查找特定节点（内存查找）
 * 通常在页面加载完整 Process 树后在内存中调用
 */
export function findNodeByInnerId(root: ProcessNode, innerId: string): ProcessNode | null {
	if (root.innerId == innerId) {
		return root
	}
	
	for (const child of root.children) {
		const found = findNodeByInnerId(child, innerId)
		if (found != null) {
			return found
		}
	}
	
	return null
}

/**
 * 获取所有的节点偏平列表（从树形结构展开），可用于搜索或快捷导航
 */
export function flattenProcessTree(root: ProcessNode): ProcessNode[] {
	const result: ProcessNode[] = []
	
	function traverse(node: ProcessNode) {
		result.push(node)
		for (const child of node.children) {
			traverse(child)
		}
	}
	
	traverse(root)
	return result
}

export function getProcessDetail(id: string): Promise<ProcessNode | null> {
	return new Promise((resolve, reject) => {
		querySQL(`SELECT data_json FROM t_process WHERE inner_id = '${id}'`)
			.then(res => {
				if (res.length > 0) {
					try {
						resolve(JSON.parse(res[0]['data_json'] as string) as ProcessNode)
					} catch(e) { resolve(null) }
				} else {
					resolve(null)
				}
			})
			.catch(e => reject(e as Error))
	})
}

export function clearAllProcesses(): Promise<void> {
	return new Promise((resolve, reject) => {
		executeSQL('DELETE FROM t_process')
			.then(() => resolve())
			.catch(e => reject(e as Error))
	})
}

/**
 * MPM 工艺预览系统 - 本地数据库服务
 * @description 封装 SQLite 数据库操作
 */

// #ifdef APP-ANDROID
import SQLiteDatabase from 'android.database.sqlite.SQLiteDatabase';
import Cursor from 'android.database.Cursor';
// #endif

// #ifdef APP-HARMONY
import relationalStore from '@ohos.data.relationalStore';
// #endif

/**
 * 数据库名称
 */
const DB_NAME: string = 'mpm_offline.db'

/**
 * 数据库版本
 */
const DB_VERSION: number = 1

/**
 * 数据库实例引用
 */
// #ifdef APP-ANDROID
let dbInstance: SQLiteDatabase | null = null
// #endif
// #ifdef WEB
let dbInstance: IDBDatabase | null = null
// #endif
// #ifdef APP-HARMONY
let dbInstance: relationalStore.RdbStore | null = null
// #endif


/**
 * 数据库是否已完成初始化
 */
let isDbInitialized: boolean = false

/**
 * 正在进行中的初始化 Promise（防止并发调用）
 */
let initPromise: Promise<boolean> | null = null

/**
 * 初始化数据库
 * @returns Promise<boolean> 初始化是否成功
 */
export function initDatabase(): Promise<boolean> {
	// 如果已经初始化过且 dbInstance 存在，直接返回成功
	if (isDbInitialized && dbInstance != null) {
		return Promise.resolve(true)
	}
	
	// 如果正在初始化中，返回同一个 Promise（防止并发竞争）
	if (initPromise != null) {
		return initPromise!
	}
	
	initPromise = new Promise((resolve: (value: boolean) => void, reject: (reason: any) => void) => {
		// #ifdef APP-ANDROID
		initSQLiteDatabase()
			.then(() => {
				createTables()
					.then(() => {
						isDbInitialized = true
						resolve(true)
					})
					.catch((e: any | null) => {
						const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
						reject(new Error(errMsg))
					})
			})
			.catch((e: any | null) => {
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
				reject(new Error(errMsg))
			})
		// #endif
		
		// #ifdef APP-HARMONY
		initHarmonyDatabase()
			.then(() => {
				createTables()
					.then(() => {
						isDbInitialized = true
						resolve(true)
					})
					.catch((e: any | null) => {
						// 建表失败可能是因为表已存在的残留 reject（Promise.all 竞争），
						// 如果 dbInstance 已经有效，仍然标记为初始化成功
						if (dbInstance != null) {
							console.warn('Harmony: createTables 部分失败但 DB 可用，继续...')
							isDbInitialized = true
							resolve(true)
						} else {
							const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
							reject(new Error(errMsg))
						}
					})
			})
			.catch((e: any | null) => {
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
				reject(new Error(errMsg))
			})
		// #endif
		
		// #ifdef WEB
		initIndexedDB()
			.then(() => {
				isDbInitialized = true
				resolve(true)
			})
			.catch((e: any | null) => {
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
				reject(new Error(errMsg))
			})
		// #endif
	})
	return initPromise!
}

/**
 * 初始化 SQLite 数据库（App端）
 */
function initSQLiteDatabase(): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		try {
			// #ifdef APP-ANDROID
			const context = UTSAndroid.getAppContext()
			if (context != null) {
				const dbPath = context.getDatabasePath(DB_NAME).getAbsolutePath()
				dbInstance = SQLiteDatabase.openOrCreateDatabase(dbPath, null)
				console.log('数据库打开成功')
				resolve()
			} else {
				reject(new Error('无法获取 Android Context'))
			}
			// #endif
			
			// #ifdef APP-HARMONY
			// 鸿蒙端在 initHarmonyDatabase 中初始化，此处直接返回
			resolve()
			// #endif
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

// #ifdef APP-HARMONY
/**
 * 初始化鸿蒙 RDB 数据库
 * @description 使用 @ohos.data.relationalStore API 创建/打开数据库
 */
function initHarmonyDatabase(): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		try {
			const STORE_CONFIG: relationalStore.StoreConfig = {
				name: DB_NAME,
				securityLevel: relationalStore.SecurityLevel.S1
			}
			
			// 获取鸿蒙应用上下文并初始化数据库
			relationalStore.getRdbStore(getContext(), STORE_CONFIG)
				.then((store: relationalStore.RdbStore) => {
					dbInstance = store
					console.log('Harmony: 数据库打开成功')
					resolve()
				})
				.catch((err: Error) => {
					console.error('Harmony: 数据库打开失败', err)
					reject(new Error('Harmony 数据库初始化失败: ' + err.message))
				})
		} catch (e: any) {
			reject(new Error('Harmony 数据库初始化异常: ' + e.toString()))
		}
	})
}
// #endif

/**
 * 创建数据表
 */
function createTables(): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		const createProcessTableSQL = `
			CREATE TABLE IF NOT EXISTS t_process (
				inner_id TEXT PRIMARY KEY,
				class_id TEXT NOT NULL,
				code TEXT NOT NULL,
				name TEXT NOT NULL,
				created_at TEXT,
				updated_at TEXT,
				data_json TEXT
			)
		`
		
		const createTabGroupsTableSQL = `
			CREATE TABLE IF NOT EXISTS meta_tab_groups (
				id TEXT PRIMARY KEY,
				name TEXT,
				description TEXT,
				sort_order INTEGER
			)
		`
		
		const createTabsTableSQL = `
			CREATE TABLE IF NOT EXISTS meta_tabs (
				id TEXT PRIMARY KEY,
				group_id TEXT,
				title TEXT,
				app_id TEXT,
				sort_order INTEGER,
				visible_condition TEXT
			)
		`
		// Note: indices should be created separately or after table creation
		
		const createComponentsTableSQL = `
			CREATE TABLE IF NOT EXISTS meta_components (
				id TEXT PRIMARY KEY,
				tab_id TEXT,
				type TEXT,
				title TEXT,
				config_json TEXT,
				sort_order INTEGER
			)
		`
		
		const createDataRecordsTableSQL = `
			CREATE TABLE IF NOT EXISTS data_records (
				record_id TEXT PRIMARY KEY,
				component_id TEXT,
				data_json TEXT,
				created_at INTEGER
			)
		`
		
		const createPackageTableSQL = `
			CREATE TABLE IF NOT EXISTS t_import_package (
				id INTEGER PRIMARY KEY AUTOINCREMENT,
				file_name TEXT,
				version TEXT,
				source TEXT,
				process_count INTEGER,
				import_time TEXT,
				checksum TEXT
			)
		`
		
		const createAssetsTableSQL = `
			CREATE TABLE IF NOT EXISTS t_assets (
				id TEXT PRIMARY KEY,
				type TEXT,
				data TEXT,
				mime_type TEXT
			)
		`
		
		const createIconConfigTableSQL = `
			CREATE TABLE IF NOT EXISTS t_icon_config (
				node_type TEXT PRIMARY KEY,
				asset_id TEXT,
				fallback TEXT
			)
		`
		
		const createResourcesTableSQL = `
			CREATE TABLE IF NOT EXISTS t_resources (
				id TEXT PRIMARY KEY,
				node_id TEXT NOT NULL,
				type TEXT NOT NULL,
				name TEXT NOT NULL,
				path TEXT NOT NULL,
				original_path TEXT,
				thumbnail TEXT,
				duration INTEGER DEFAULT 0,
				size INTEGER DEFAULT 0,
				description TEXT,
				sort_order INTEGER DEFAULT 0,
				created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
			)
		`
		
		// #ifdef APP-ANDROID
		if (dbInstance != null) {
			try {
				dbInstance!.execSQL(createProcessTableSQL)
				dbInstance!.execSQL(createPackageTableSQL)
				
				// Assets and Icon Config Tables
				dbInstance!.execSQL(createAssetsTableSQL)
				dbInstance!.execSQL(createIconConfigTableSQL)
				dbInstance!.execSQL(createResourcesTableSQL)
				dbInstance!.execSQL("CREATE INDEX IF NOT EXISTS idx_resources_node_id ON t_resources(node_id)")
				
				// Dynamic Tab System Tables
				dbInstance!.execSQL(createTabGroupsTableSQL)
				dbInstance!.execSQL(createTabsTableSQL)
				dbInstance!.execSQL("CREATE INDEX IF NOT EXISTS idx_tab_group ON meta_tabs(group_id)")
				dbInstance!.execSQL(createComponentsTableSQL)
				dbInstance!.execSQL("CREATE INDEX IF NOT EXISTS idx_comp_tab ON meta_components(tab_id)")
				dbInstance!.execSQL(createDataRecordsTableSQL)
				dbInstance!.execSQL("CREATE INDEX IF NOT EXISTS idx_data_comp ON data_records(component_id)")

				console.log('数据表创建成功')
				resolve()
			} catch(e: any) {
				console.error('数据表创建失败：', e)
				reject(new Error(e.toString()))
			}
		} else {
			resolve()
		}
		// #endif
		
		// #ifdef APP-HARMONY
		if (dbInstance != null) {
			try {
				// 鸿蒙端 SQLite 不支持并发写入，改为顺序执行建表
				const sqls: string[] = [
					createProcessTableSQL,
					createPackageTableSQL,
					createAssetsTableSQL,
					createIconConfigTableSQL,
					createResourcesTableSQL,
					"CREATE INDEX IF NOT EXISTS idx_resources_node_id ON t_resources(node_id)",
					createTabGroupsTableSQL,
					createTabsTableSQL,
					"CREATE INDEX IF NOT EXISTS idx_tab_group ON meta_tabs(group_id)",
					createComponentsTableSQL,
					"CREATE INDEX IF NOT EXISTS idx_comp_tab ON meta_components(tab_id)",
					createDataRecordsTableSQL,
					"CREATE INDEX IF NOT EXISTS idx_data_comp ON data_records(component_id)"
				]
				
				// 顺序执行每条 SQL
				const executeNext = (index: number) => {
					if (index >= sqls.length) {
						console.log('Harmony: 数据表创建成功')
						resolve()
						return
					}
					dbInstance!.executeSql(sqls[index])
						.then(() => {
							executeNext(index + 1)
						})
						.catch((e: any) => {
							// CREATE TABLE IF NOT EXISTS 不应该失败，记录但继续
							console.warn('Harmony: 建表SQL[' + index + ']警告:', e)
							executeNext(index + 1)
						})
				}
				executeNext(0)
			} catch(e: any) {
				console.error('Harmony: 数据表创建抛出异常：', e)
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
				reject(new Error(errMsg))
			}
		} else {
			resolve()
		}
		// #endif
	})
}

/**
 * 执行 SQL 语句
 * @param sql - SQL 语句
 * @param params - 参数数组
 */
export function executeSQL(sql: string, params: any[] = []): Promise<any> {
	return new Promise((resolve: (value: any) => void, reject: (reason: any) => void) => {
		// #ifdef APP-ANDROID
		if (dbInstance == null) {
			reject(new Error('数据库未初始化'))
			return
		}
		
		try {
			if (params.length > 0) {
				const args = params.map((p):any => p)
				dbInstance!.execSQL(sql, args.toTypedArray())
			} else {
				dbInstance!.execSQL(sql)
			}
			resolve(true)
		} catch (e: any) {
			console.error('SQL 执行失败：', sql, e)
			reject(new Error('SQL 执行失败: ' + e.toString()))
		}
		// #endif
		
		// #ifdef APP-HARMONY
		if (dbInstance == null) {
			reject(new Error('数据库未初始化'))
			return
		}
		
		try {
			let promise: Promise<void>;
			if (params.length > 0) {
				const args = params.map((p: any): relationalStore.ValueType => {
					if (p == null) return ''
					return p.toString() as relationalStore.ValueType
				})
				promise = dbInstance!.executeSql(sql, args)
			} else {
				promise = dbInstance!.executeSql(sql)
			}
			
			promise.then(() => {
				resolve(true)
			}).catch((e: any) => {
				console.error('Harmony SQL 执行失败：', sql, e)
				const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
				reject(new Error('SQL 执行失败: ' + errMsg))
			})
		} catch (e: any) {
			console.error('Harmony SQL 执行失败：', sql, e)
			const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
			reject(new Error('SQL 执行失败: ' + errMsg))
		}
		// #endif
		
		// #ifdef WEB
		console.warn('Web 端 IndexedDB 不支持直接 SQL 执行')
		resolve(null)
		// #endif
	})
}

/**
 * 查询数据
 * @param sql - 查询 SQL
 * @param params - 参数数组
 */
export function querySQL(sql: string, params: any[] = []): Promise<UTSJSONObject[]> {
	return new Promise((resolve: (value: UTSJSONObject[]) => void, reject: (reason: any) => void) => {
		// #ifdef APP-ANDROID
		if (dbInstance == null) {
			reject(new Error('数据库未初始化'))
			return
		}
		
		try {
			let args: string[] | null = null
			if (params.length > 0) {
				args = params.map((p):string => {
					if (p == null) return ''
					return p.toString()
				})
			}
			
			const cursor = dbInstance!.rawQuery(sql, args != null ? args.toTypedArray() : null)
			const result: UTSJSONObject[] = []
			
			if (cursor.moveToFirst()) {
				do {
					const row: UTSJSONObject = {}
					const columnCount = cursor.getColumnCount()
					for (let i = 0; i < columnCount; i++) {
						const columnName = cursor.getColumnName(i)
						const type = cursor.getType(i)
						
						if (type == 3) { // STRING
							row[columnName] = cursor.getString(i)
						} else if (type == 1) { // INTEGER
							row[columnName] = cursor.getLong(i)
						} else if (type == 2) { // FLOAT
							row[columnName] = cursor.getDouble(i)
						} else if (type == 0) { // NULL
							row[columnName] = null
						} else if (type == 4) { // BLOB
							row[columnName] = null 
						}
					}
					result.push(row)
				} while (cursor.moveToNext())
			}
			cursor.close()
			resolve(result)
		} catch (e: any) {
			console.error('查询失败：', sql, e)
			reject(new Error('查询失败: ' + e.toString()))
		}
		// #endif
		
		// #ifdef APP-HARMONY
		if (dbInstance == null) {
			reject(new Error('数据库未初始化'))
			return
		}
		
		try {
			let args: relationalStore.ValueType[] = []
			if (params.length > 0) {
				args = params.map((p: any): relationalStore.ValueType => {
					if (p == null) return ''
					return p.toString() as relationalStore.ValueType
				})
			}
			
			dbInstance!.querySql(sql, args).then((resultSet: relationalStore.ResultSet) => {
				const result: UTSJSONObject[] = []
				while (resultSet.goToNextRow()) {
					const row: UTSJSONObject = {}
					const columnCount = resultSet.columnCount
					for (let i = 0; i < columnCount; i++) {
						const columnName = resultSet.getColumnName(i)
						const columnType = resultSet.getColumnType(i)
						
						if (columnType == relationalStore.ColumnType.TYPE_STRING) {
							row[columnName] = resultSet.getString(i)
						} else if (columnType == relationalStore.ColumnType.TYPE_INTEGER) {
							row[columnName] = resultSet.getLong(i)
						} else if (columnType == relationalStore.ColumnType.TYPE_FLOAT) {
							row[columnName] = resultSet.getDouble(i)
						} else if (columnType == relationalStore.ColumnType.TYPE_NULL) {
							row[columnName] = null
						} else if (columnType == relationalStore.ColumnType.TYPE_BLOB) {
							row[columnName] = null
						} else {
							// 未知列类型，尝试用 getString 兜底读取
							try {
								row[columnName] = resultSet.getString(i)
							} catch (readErr: any) {
								row[columnName] = null
							}
						}
					}
					result.push(row)
				}
				resultSet.close()
				resolve(result)
			}).catch((err: any) => {
				console.error('Harmony 查询失败：', sql, err)
				const errMsg = err instanceof Error ? err.message : (err != null ? err.toString() : 'unknown');
				reject(new Error('查询失败: ' + errMsg))
			})
		} catch (e: any) {
			console.error('Harmony 查询失败：', sql, e)
			const errMsg = e instanceof Error ? e.message : (e != null ? e.toString() : 'unknown');
			reject(new Error('查询失败: ' + errMsg))
		}
		// #endif
		
		// #ifdef WEB
		resolve([] as UTSJSONObject[])
		// #endif
	})
}

/**
 * 关闭数据库
 */
export function closeDatabase(): void {
	// #ifdef APP-ANDROID
	if (dbInstance != null) {
		try {
			dbInstance!.close()
			dbInstance = null
			console.log('数据库关闭成功')
		} catch (e: any) {
			console.error('数据库关闭失败：', e)
		}
	}
	// #endif
	
	// #ifdef APP-HARMONY
	if (dbInstance != null) {
		dbInstance = null
		console.log('Harmony: 数据库引用已释放')
	}
	// #endif
}

/**
 * 开启事务
 */
export function beginTransaction(): void {
	// #ifdef APP-ANDROID
	if (dbInstance != null) {
		dbInstance!.beginTransaction()
	}
	// #endif
	
	// #ifdef APP-HARMONY
	// 鸿蒙 RDB 通过 executeSql 执行 BEGIN TRANSACTION
	if (dbInstance != null) {
		try {
			dbInstance!.executeSql('BEGIN TRANSACTION')
		} catch (e: any) {
			console.warn('Harmony: beginTransaction:', e)
		}
	}
	// #endif
}

/**
 * 标记事务成功
 */
export function setTransactionSuccessful(): void {
	// #ifdef APP-ANDROID
	if (dbInstance != null) {
		dbInstance!.setTransactionSuccessful()
	}
	// #endif
	
	// #ifdef APP-HARMONY
	// 鸿蒙端事务提交在 endTransaction 中执行
	// #endif
}

/**
 * 结束事务
 */
export function endTransaction(): void {
	// #ifdef APP-ANDROID
	if (dbInstance != null) {
		dbInstance!.endTransaction()
	}
	// #endif
	
	// #ifdef APP-HARMONY
	if (dbInstance != null) {
		try {
			dbInstance!.executeSql('COMMIT')
		} catch (e: any) {
			try {
				dbInstance!.executeSql('ROLLBACK')
			} catch (rollbackErr: any) {
				console.error('Harmony: rollback failed:', rollbackErr)
			}
		}
	}
	// #endif
}

// #ifdef WEB
// Web 端数据库版本，变更需增加版本号
const WEB_DB_VERSION: number = 5

/**
 * 初始化 IndexedDB（Web端）
 */
function initIndexedDB(): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		try {
			const request = indexedDB.open(DB_NAME, WEB_DB_VERSION)
			
			request.onerror = (_event: Event) => {
				reject(new Error('IndexedDB 打开失败'))
			}
			
			request.onsuccess = (_event: Event) => {
				dbInstance = request.result
				console.log('IndexedDB 打开成功')
				resolve()
			}
			
			request.onupgradeneeded = (event: IDBVersionChangeEvent) => {
				const db = (event.target as IDBOpenDBRequest).result
				
				// 工艺数据表
				// V5: 更改主键为 innerId
				if (db.objectStoreNames.contains('t_process')) {
					db.deleteObjectStore('t_process')
				}
				const processStore = db.createObjectStore('t_process', { keyPath: 'innerId' })
				processStore.createIndex('code', 'code', { unique: false })
				processStore.createIndex('name', 'name', { unique: false })
				
				// 工艺步骤表
				if (!db.objectStoreNames.contains('t_process_step')) {
					const stepStore = db.createObjectStore('t_process_step', { keyPath: 'id', autoIncrement: true })
					stepStore.createIndex('process_id', 'process_id', { unique: false })
				}
				
				// 工艺附件表
				if (!db.objectStoreNames.contains('t_process_attachment')) {
					const attachStore = db.createObjectStore('t_process_attachment', { keyPath: 'id', autoIncrement: true })
					attachStore.createIndex('process_id', 'process_id', { unique: false })
				}
				
				// UI 分组表
				if (!db.objectStoreNames.contains('meta_tab_groups')) {
					db.createObjectStore('meta_tab_groups', { keyPath: 'id' })
				}
				
				// UI Tab表
				if (!db.objectStoreNames.contains('meta_tabs')) {
					const tabStore = db.createObjectStore('meta_tabs', { keyPath: 'id' })
					tabStore.createIndex('group_id', 'group_id', { unique: false })
				}
				
				// UI 组件表
				if (!db.objectStoreNames.contains('meta_components')) {
					const compStore = db.createObjectStore('meta_components', { keyPath: 'id' })
					compStore.createIndex('tab_id', 'tab_id', { unique: false })
				}
				
				// 数据记录表
				if (!db.objectStoreNames.contains('data_records')) {
					const recordStore = db.createObjectStore('data_records', { keyPath: 'record_id' })
					recordStore.createIndex('component_id', 'component_id', { unique: false })
				}
				
				// 导入记录表
				if (!db.objectStoreNames.contains('t_import_package')) {
					db.createObjectStore('t_import_package', { keyPath: 'id', autoIncrement: true })
				}
				
				// 静态资源表 (V3)
				if (!db.objectStoreNames.contains('t_assets')) {
					db.createObjectStore('t_assets', { keyPath: 'id' })
				}
				
				// 图标配置表 (V3)
				if (!db.objectStoreNames.contains('t_icon_config')) {
					db.createObjectStore('t_icon_config', { keyPath: 'node_type' })
				}
				
				// V3: 资源元数据表
				if (!db.objectStoreNames.contains('t_resources')) {
					const resourceStore = db.createObjectStore('t_resources', { keyPath: 'id' })
					resourceStore.createIndex('node_id', 'node_id', { unique: false })
					resourceStore.createIndex('type', 'type', { unique: false })
				}
				
				console.log('IndexedDB Object Stores 创建/更新完成')
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

/**
 * Web 端保存数据到 IndexedDB
 */
export function webPutData(storeName: string, data: any): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		if (dbInstance == null) {
			reject(new Error('IndexedDB 未初始化'))
			return
		}
		
		try {
			const transaction = dbInstance.transaction([storeName], 'readwrite')
			const store = transaction.objectStore(storeName)
			const request = store.put(data)
			
			request.onsuccess = () => {
				resolve()
			}
			request.onerror = () => {
				reject(new Error('IndexedDB put 失败: ' + storeName))
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

/**
 * Web 端从 IndexedDB 查询所有数据
 */
export function webGetAll(storeName: string): Promise<UTSJSONObject[]> {
	return new Promise((resolve: (value: UTSJSONObject[]) => void, reject: (reason: any) => void) => {
		if (dbInstance == null) {
			reject(new Error('IndexedDB 未初始化'))
			return
		}
		
		try {
			const transaction = dbInstance.transaction([storeName], 'readonly')
			const store = transaction.objectStore(storeName)
			const request = store.getAll()
			
			request.onsuccess = () => {
				resolve(request.result as UTSJSONObject[] || ([] as UTSJSONObject[]))
			}
			request.onerror = () => {
				reject(new Error('IndexedDB getAll 失败: ' + storeName))
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

/**
 * Web 端按索引查询数据
 */
export function webGetByIndex(storeName: string, indexName: string, value: any): Promise<UTSJSONObject[]> {
	return new Promise((resolve: (value: UTSJSONObject[]) => void, reject: (reason: any) => void) => {
		if (dbInstance == null) {
			reject(new Error('IndexedDB 未初始化'))
			return
		}
		
		try {
			const transaction = dbInstance.transaction([storeName], 'readonly')
			const store = transaction.objectStore(storeName)
			const index = store.index(indexName)
			const request = index.getAll(value)
			
			request.onsuccess = () => {
				resolve(request.result as UTSJSONObject[] || ([] as UTSJSONObject[]))
			}
			request.onerror = () => {
				reject(new Error('IndexedDB getByIndex 失败'))
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

/**
 * Web 端清空 Store
 */
export function webClearStore(storeName: string): Promise<void> {
	return new Promise((resolve: () => void, reject: (reason: any) => void) => {
		if (dbInstance == null) {
			reject(new Error('IndexedDB 未初始化'))
			return
		}
		
		try {
			const transaction = dbInstance.transaction([storeName], 'readwrite')
			const store = transaction.objectStore(storeName)
			const request = store.clear()
			
			request.onsuccess = () => {
				resolve()
			}
			request.onerror = () => {
				reject(new Error('IndexedDB clear 失败: ' + storeName))
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

/**
 * Web 端获取记录数
 */
export function webGetCount(storeName: string): Promise<number> {
	return new Promise((resolve: (value: number) => void, reject: (reason: any) => void) => {
		if (dbInstance == null) {
			reject(new Error('IndexedDB 未初始化'))
			return
		}
		
		try {
			const transaction = dbInstance.transaction([storeName], 'readonly')
			const store = transaction.objectStore(storeName)
			const request = store.count()
			
			request.onsuccess = () => {
				resolve(request.result)
			}
			request.onerror = () => {
				reject(new Error('IndexedDB count 失败: ' + storeName))
			}
		} catch (e: any) {
			reject(new Error(e.toString()))
		}
	})
}

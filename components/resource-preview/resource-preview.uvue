<template>
	<view class="resource-preview">
		<!-- 骨架屏/加载动画 -->
		<view v-if="isLoading" class="loading-overlay">
			<view ref="loadingSpinnerRef" class="loading-spinner"></view>
			<text class="loading-text">正在加载...</text>
		</view>

		<!-- 错误重试界面 -->
		<view v-if="loadError !== ''" class="error-overlay">
			<text class="error-icon">⚠️</text>
			<text class="error-text">{{ loadError }}</text>
			<view class="retry-btn" @click="retryLoad">
				<text class="retry-text">重试</text>
			</view>
		</view>

		<!-- 无资源状态 -->
		<view v-if="resType == ''" class="empty-state">
			<text class="empty-icon">📂</text>
			<text class="empty-text">选择资源进行预览</text>
		</view>
		
		<!-- 图片预览 -->
		<view v-else-if="resType == 'image'" class="preview-container image-preview">
			<view 
				class="image-wrapper"
				@mousedown="onImageMouseDown"
				@mousemove="onImageMouseMove"
				@mouseup="onImageMouseUp"
				@mouseleave="onImageMouseUp"
				@touchstart.stop="onImageTouchStart"
				@touchmove.stop="onImageTouchMove"
				@touchend.stop="onImageTouchEnd"
			>
				<image 
					class="preview-image"
					:class="{'dragging': isImageDragging, 'can-drag': imageScale > 1.0 || imageRotate !== 0, 'image-fade-in': imageLoaded}"
					:src="resPath"
					mode="aspectFit"
					:style="imageTransformStyle"
					@load="onImageLoaded"
					@error="onImageError"
				/>
				<!-- 图片控制工具栏悬浮浮层 -->
				<!-- #ifndef APP-HARMONY -->
				<view class="image-toolbar">
					<view class="toolbar-btn" @click="zoomInImage" title="放大">
						<text class="toolbar-icon">+</text>
					</view>
					<view class="toolbar-btn" @click="zoomOutImage" title="缩小">
						<text class="toolbar-icon">-</text>
					</view>
					<view class="toolbar-btn" @click="rotateLeftImage" title="向左旋转">
						<text class="toolbar-icon">↺</text>
					</view>
					<view class="toolbar-btn" @click="rotateRightImage" title="向右旋转">
						<text class="toolbar-icon">↻</text>
					</view>
					<view class="toolbar-btn" @click="resetImage" title="重置">
						<text class="toolbar-icon">⟲</text>
					</view>
				</view>
				<!-- #endif -->
			</view>
		</view>
		
		<!-- 视频预览 -->
		<view v-else-if="resType == 'video'" class="preview-container video-preview">
			<video
				class="preview-video"
				:src="resPath"
				:poster="resThumbnail"
				controls
				:autoplay="false"
				preload="metadata"
				object-fit="contain"
				@error="onVideoError"
				@timeupdate="onTimeUpdate"
				@ended="onEnded"
			/>
			
		</view>
		
		<!-- 音频预览 -->
		<view v-else-if="resType == 'audio'" class="preview-container audio-preview">
			<view class="audio-visual">
				<text class="audio-icon">🎵</text>
				<view class="audio-wave">
					<view v-for="i in 5" :key="i" class="wave-bar" :class="{ 'playing': isPlaying }"></view>
				</view>
			</view>
			<view class="audio-controls">
				<button class="audio-btn" @click="toggleAudio">
					<text>{{ isPlaying ? '⏸️' : '▶️' }}</text>
				</button>
				<view class="audio-progress">
					<view class="progress-bar">
						<view class="progress-fill" :style="{ width: progressPercent + '%' }"></view>
					</view>
					<text class="time-text">{{ formatTime(currentTime) }} / {{ formatTime(resDuration) }}</text>
				</view>
			</view>
			
		</view>
		
		<!-- PDF预览 -->
		<view v-else-if="resType == 'pdf'" class="preview-container pdf-preview">
			<!-- #ifdef WEB -->
			<view ref="pdfFrame" class="pdf-frame-container"></view>
			
			<!-- #endif -->
			<!-- #ifdef APP -->
			<!-- #ifdef APP-HARMONY -->
			<KuxHarmonyPdf :src="resPath" class="pdf-native-view"></KuxHarmonyPdf>
			<!-- #endif -->
			<!-- #ifndef APP-HARMONY -->
			<web-view :id="webviewId" class="pdf-webview" :src="pdfWebViewSrc" @load="onPdfWebViewLoad"></web-view>
			<!-- #endif -->
			
			<!-- #endif -->
		</view>
		
		<!-- CAD 图纸预览 -->
		<view v-else-if="isCadType(resType)" class="cad-preview-container">
			<!-- #ifdef WEB -->
			<view ref="cadFrame" class="cad-frame-container"></view>
			
			<!-- #endif -->
			<!-- #ifdef APP -->
			<web-view :id="cadWebviewId" class="cad-webview" :src="cadWebViewSrc" @load="onCadWebViewLoad"></web-view>
			
			<!-- #endif -->
		</view>
		
		<!-- 其他文档预览 -->
		<view v-else-if="isOfficeDoc(resType)" class="preview-container pdf-preview">
			<!-- #ifdef WEB -->
			<view class="pdf-frame-container" ref="docFrame"></view>
			<!-- #endif -->
			<!-- #ifndef WEB -->
			<web-view 
				class="pdf-webview" 
				:id="docWebviewId" 
				:src="docWebViewSrc" 
				@loaded="onDocWebViewLoad"
				@error="onVideoError"
			></web-view>
			<!-- #endif -->
		</view>
		
		<!-- 未知类型 -->
		<view v-else class="preview-container unknown-preview">
			<text class="unknown-icon">❓</text>
			<text class="unknown-text">不支持预览此类型文件</text>
			
		</view>
	</view>
</template>

<script setup lang="uts">
	import KuxHarmonyPdf from '@/uni_modules/kux-harmony-pdf/components/kux-harmony-pdf/kux-harmony-pdf.uvue'
	import { ResourceItem } from '@/types/resource'
	import { formatDuration } from '@/types/resource'
	import { getCachedDocUrl, setCachedDocUrl } from '@/utils/fileOpenCache'
	
	// Props
	const props = defineProps<{
		resource: ResourceItem | null
	}>()
	
	// Emits
	const emit = defineEmits<{
		(e: 'error', message: string): void
		(e: 'loaded'): void
	}>()

	const resType = computed((): string => (props.resource as ResourceItem | null)?.type ?? '')
	const resPath = computed((): string => (props.resource as ResourceItem | null)?.path ?? '')
	const resName = computed((): string => {
		const name = (props.resource as ResourceItem | null)?.name ?? ''
		const lastDotIndex = name.lastIndexOf('.')
		if (lastDotIndex > 0) {
			return name.substring(0, lastDotIndex)
		}
		return name
	})
	
	// 图片控制状态
	const imageScale = ref(1.0)
	const imageRotate = ref(0)
	const imageTranslateX = ref(0)
	const imageTranslateY = ref(0)

	const isLoading = ref(false)
	const loadError = ref('')
	const imageLoaded = ref(false)
	
	// Loading 旋转动画
	const loadingSpinnerRef = ref<UniElement | null>(null)
	
	watch(isLoading, (newVal : boolean) => {
		if (newVal) {
			nextTick(() => {
				const spinnerEl = loadingSpinnerRef.value
				if (spinnerEl != null) {
					spinnerEl.animate([
						{ transform: 'rotate(0deg)' },
						{ transform: 'rotate(360deg)' }
					], {
						duration: 800,
						iterations: 10000,
						easing: 'linear'
					})
				}
			})
		}
	})
	
	const onImageLoaded = () => {
		imageLoaded.value = true
	}
	
	watch(resPath, () => {
		imageLoaded.value = false
		loadError.value = ''
	})

	const zoomInImage = () => {
		imageScale.value += 0.2
	}
	const zoomOutImage = () => {
		if (imageScale.value > 0.4) {
			imageScale.value -= 0.2
		}
	}
	const rotateLeftImage = () => {
		imageRotate.value -= 90
	}
	const rotateRightImage = () => {
		imageRotate.value += 90
	}
	const resetImage = () => {
		imageScale.value = 1.0
		imageRotate.value = 0
		imageTranslateX.value = 0
		imageTranslateY.value = 0
	}
	
	// 图片拖拽状态
	const isImageDragging = ref(false)
	let imageDragStartX = 0
	let imageDragStartY = 0
	let initialTranslateX = 0
	let initialTranslateY = 0

	const startImageDrag = (clientX: number, clientY: number) => {
		if (imageScale.value <= 1.0 && imageRotate.value === 0) return
		isImageDragging.value = true
		imageDragStartX = clientX
		imageDragStartY = clientY
		initialTranslateX = imageTranslateX.value
		initialTranslateY = imageTranslateY.value
	}

	const moveImageDrag = (clientX: number, clientY: number) => {
		if (!isImageDragging.value) return
		const deltaX = clientX - imageDragStartX
		const deltaY = clientY - imageDragStartY
		imageTranslateX.value = initialTranslateX + deltaX
		imageTranslateY.value = initialTranslateY + deltaY
	}

	const endImageDrag = () => {
		isImageDragging.value = false
	}
	
	// 图片变换样式
	const imageTransformStyle = computed((): string => {
		// #ifdef APP-HARMONY
		return ''
		// #endif
		
		// #ifndef APP-HARMONY
		return `transform: translate(${imageTranslateX.value}px, ${imageTranslateY.value}px) scale(${imageScale.value}) rotate(${imageRotate.value}deg); transition: ${isImageDragging.value ? 'none' : 'transform 0.2s'}`
		// #endif
	})

	// Web 鼠标事件
	const onImageMouseDown = (e: MouseEvent) => {
		startImageDrag(e.clientX, e.clientY)
	}
	const onImageMouseMove = (e: MouseEvent) => {
		moveImageDrag(e.clientX, e.clientY)
	}
	const onImageMouseUp = () => {
		endImageDrag()
	}

	// App 触摸事件
	const onImageTouchStart = (e: UniTouchEvent) => {
		if (e.touches.length > 0) {
			startImageDrag(e.touches[0].clientX, e.touches[0].clientY)
		}
	}
	const onImageTouchMove = (e: UniTouchEvent) => {
		if (e.touches.length > 0) {
			moveImageDrag(e.touches[0].clientX, e.touches[0].clientY)
		}
	}
	const onImageTouchEnd = () => {
		endImageDrag()
	}
	
	// 音频播放状态
	const resDuration = computed((): number => (props.resource as ResourceItem | null)?.duration ?? 0)
	const resThumbnail = computed((): string => (props.resource as ResourceItem | null)?.thumbnail ?? '')
	const resDescription = computed((): string => (props.resource as ResourceItem | null)?.description ?? '')
	const resId = computed((): string => (props.resource as ResourceItem | null)?.id ?? '')
	
	// #ifdef APP
	const webviewId = 'pdf_' + Date.now() + '_' + Math.floor(Math.random() * 10000)
	const cadWebviewId = 'cad_' + Date.now() + '_' + Math.floor(Math.random() * 10000)
	const docWebviewId = 'doc_' + Date.now() + '_' + Math.floor(Math.random() * 10000)

	const pdfWebViewSrc = computed((): string => {
		
		if (resPath.value == '') return ''
		// #ifdef APP-HARMONY
		if (!resPath.value.startsWith('http://') && !resPath.value.startsWith('https://')) {
			return '/static/pdf/pdfjs-viewer.html'
		}
		// #endif
		const encodedSrc = encodeURIComponent(resPath.value)
		return '/static/pdf/pdfjs-viewer.html?file=' + encodedSrc + '#?file=' + encodedSrc
	})

	const onPdfWebViewLoad = () => {
		// #ifdef APP-HARMONY
		
		if (resPath.value == '') return
		if (resPath.value.startsWith('http://') || resPath.value.startsWith('https://')) return
		
		try {
			const fs = uni.getFileSystemManager()
			const base64Str = fs.readFileSync(resPath.value, 'base64') as string
			// 修正: 传入第二个参数 component instance 以解决 cannot read property vm of undefined
			const instance = getCurrentInstance()
			const wvContext = uni.createWebviewContext(webviewId, instance?.proxy)
			wvContext.evalJS(`window.loadPdfFromBase64('${base64Str}')`)
		} catch (err: any) {
			console.error("读取 PDF 文件转 Base64 失败: ", err)
			emit('error', '加载鸿蒙本地PDF失败')
		}
		// #endif
	}

	const cadWebViewSrc = computed((): string => {
		
		if (resPath.value == '') return ''
		// #ifdef APP-HARMONY
		if (!resPath.value.startsWith('http://') && !resPath.value.startsWith('https://')) {
			return '/static/cad/cad-launcher.html'
		}
		// #endif
		const encodedSrc = encodeURIComponent(resPath.value)
		return '/static/cad/cad-launcher.html?file=' + encodedSrc + '#?file=' + encodedSrc
	})

	const onCadWebViewLoad = () => {
		// #ifdef APP-HARMONY
		
		if (resPath.value == '') return
		if (resPath.value.startsWith('http://') || resPath.value.startsWith('https://')) return
		
		try {
			const fs = uni.getFileSystemManager()
			const base64Str = fs.readFileSync(resPath.value, 'base64') as string
			const instance = getCurrentInstance()
			const wvContext = uni.createWebviewContext(cadWebviewId, instance?.proxy)
			wvContext.evalJS(`window.loadCadFromBase64('${base64Str}')`)
		} catch (err: any) {
			console.error("读取 CAD 文件转 Base64 失败: ", err)
			emit('error', '加载鸿蒙本地CAD失败')
		}
		// #endif
	}

	const docWebViewSrc = computed((): string => {
		
		if (resPath.value == '') return ''
		// #ifdef APP-HARMONY
		if (!resPath.value.startsWith('http://') && !resPath.value.startsWith('https://')) {
			return '/static/ranuts-document/index.html'
		}
		// #endif
		const encodedSrc = encodeURIComponent(resPath.value)
		const encodedName = encodeURIComponent(resName.value)
		return '/static/ranuts-document/index.html?src=' + encodedSrc + '&name=' + encodedName
	})

	const onDocWebViewLoad = () => {
		// #ifdef APP-HARMONY
		
		if (resPath.value == '') return
		if (resPath.value.startsWith('http://') || resPath.value.startsWith('https://')) return
		
		try {
			const fs = uni.getFileSystemManager()
			const base64Str = fs.readFileSync(resPath.value, 'base64') as string
			const instance = getCurrentInstance()
			const wvContext = uni.createWebviewContext(docWebviewId, instance?.proxy)
			wvContext.evalJS(`if(window.openDocumentFromBase64){ window.openDocumentFromBase64('${base64Str}', '${resName.value}') }`)
		} catch (err: any) {
			console.error("读取文档文件转 Base64 失败: ", err)
			emit('error', '加载鸿蒙本地文档失败')
		}
		// #endif
	}
	// #endif

	const isPlaying = ref(false)
	const currentTime = ref(0)
	const audioContext = ref<any | null>(null)
	
	const progressPercent = computed((): number => {
		
		if (resDuration.value <= 0) return 0
		return (currentTime.value / resDuration.value) * 100
	})
	
	const isOfficeDoc = (type: string): boolean => {
		const docTypes = ['docx', 'xls', 'xlsx', 'ppt', 'pptx', 'txt', 'wps', 'wpt', 'et', 'ett', 'dps', 'dpt']
		return docTypes.includes(type)
	}
	
	const isCadType = (type: string): boolean => {
		return ['clw', 'dwg'].includes(type)
	}
	
	const retryLoad = () => {
		loadError.value = ''
		imageLoaded.value = false
		if (props.resource != null) {
			// #ifdef WEB
			handleResourceSwitch(props.resource)
			// #endif
		}
	}

	// #ifdef WEB
	// PDF预览容器引用
	const pdfFrame = ref<UniElement | null>(null)
	// CAD预览容器引用
	const cadFrame = ref<UniElement | null>(null)
	// DOC预览容器引用
	const docFrame = ref<UniElement | null>(null)
	
	function renderPdfIframe(src : string): void {
		isLoading.value = true
		loadError.value = ''
		nextTick(() => {
			const el = pdfFrame.value as any
			if (el != null) {
				const encodedSrc = encodeURIComponent(src)
				const targetSrc = './static/pdf/pdfjs-viewer.html?file=' + encodedSrc + '#?file=' + encodedSrc
				const existingIframe = el.querySelector('iframe') as any
				if (existingIframe) {
					existingIframe.src = targetSrc
				} else {
					el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
				}
			}
			isLoading.value = false
		})
	}
	
	function renderCadIframe(src : string): void {
		isLoading.value = true
		loadError.value = ''
		console.log('Rendering CAD file iframe with URL:', src)
		if (cadFrame.value == null) {
			console.warn('CAD frame container is not ready, retrying...')
			setTimeout(() => { renderCadIframe(src) }, 200)
			return
		}
		nextTick(() => {
			try {
				const el = (cadFrame.value as any).$el || (cadFrame.value as any)
				if (el != null) {
					const encodedSrc = encodeURIComponent(src)
					const targetSrc = './static/cad/cad-launcher.html?file=' + encodedSrc + '#?file=' + encodedSrc
					// 恢复使用 cad-launcher.html 中间层，利用其内部的 baseUrl 注入来修复 blob 异常
					const existingIframe = el.querySelector('iframe') as any
					if (existingIframe) {
						existingIframe.src = targetSrc
					} else {
						el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;min-height:500px;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0" allowfullscreen></iframe>'
					}
					console.log('successfully injected iframe via cad-launcher.html')
				}
			} catch (e) {
				console.error('Failed to inject CAD iframe:', e)
				loadError.value = '加载 CAD 图纸失败'
			}
			isLoading.value = false
		})
	}

	// 防抖锁：防止加载过程中重复点击同一文档触发多次并行渲染
	let docRenderingSrc = ''
	
	function renderDocIframe(src : string): void {
		// 如果正在加载同一个文档，直接忽略
		if (docRenderingSrc === src) {
			console.log('[Doc] 忽略重复渲染请求:', src)
			return
		}
		docRenderingSrc = src
		
		isLoading.value = true
		loadError.value = ''
		
		nextTick(async () => {
			const el = docFrame.value as any
			if (el != null) {
				let docName = props.resource?.name ?? 'document'
				if (props.resource?.type && !docName.toLowerCase().endsWith('.' + props.resource!.type.toLowerCase())) {
					docName += '.' + props.resource!.type
				}
				const encodedName = encodeURIComponent(docName)
				
				// 确定 ranuts-document 的访问 URL 和 Electron 上下文
				let targetUrl = './static/ranuts-document/index.html'
				let electronPort = 0
				const eApi = (window as any)['electronAPI']
				
				if (process.env.NODE_ENV === 'development') {
					targetUrl = 'http://localhost:5163/index.html'
				} else if (eApi != null) {
					try {
						const port = await (eApi['getRanutsDocPort'] as (() => Promise<number>))()
						if (port > 0) {
							electronPort = port
							targetUrl = 'http://127.0.0.1:' + port + '/index.html'
						}
					} catch (e) {}
				}

				// 检查 URL 缓存
				const resourceId = props.resource?.id ?? ''
				console.log('[Doc] 缓存检查: resourceId=' + resourceId + ', electronPort=' + electronPort)
				if (resourceId !== '') {
					const cachedUrl = getCachedDocUrl(resourceId)
					console.log('[Doc] 缓存查询结果: cachedUrl=' + (cachedUrl ?? 'null'))
					if (cachedUrl != null && electronPort > 0) {
						console.log('[Doc] 命中内存缓存，直接复用 HTTP URL:', cachedUrl)
						const targetSrc = targetUrl + '?src=' + encodeURIComponent(cachedUrl) + '&name=' + encodedName
						const existingIframe = el.querySelector('iframe') as any
						if (existingIframe) existingIframe.src = targetSrc
						else el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
						isLoading.value = false
						return
					}
				}
				
				// 针对 Web 端的跨域/沙盒问题，提取数据（适用于 blob 或是本地相对路径 /static/... 等，因为 iframe 是 http 环境，无法直接跨域访问父级的 file:// 或本地相对路径）
				let base64Str = ''
				let rawArrayBuffer: ArrayBuffer | null = null
				console.log('[Parent] Preparing doc viewer for src:', src)
				
				if (!src.startsWith('http://') && !src.startsWith('https://')) {
					try {
						// 父级 window 环境下去请求实际的文件流
						const response = await fetch(src)
						if (response == null) {
							throw new Error('fetch returned null response')
						}
						const blob = await response.blob()
						console.log('[Parent] Blob fetched, size:', blob.size)
						
						const eApi = (window as any)['electronAPI']
						if (eApi != null && eApi['saveTempDocBuffer']) {
							// Electron 环境：直接提取底层 ArrayBuffer，免去 Base64 灾难级开销
							rawArrayBuffer = await blob.arrayBuffer()
							console.log('[Parent] ArrayBuffer extracted, length:', rawArrayBuffer!.byteLength)
						} else {
							// 纯 Web 环境：必须转 Base64 供 postMessage 通信
							base64Str = await new Promise<string>((resolve) => {
								const reader = new FileReader()
								reader.onloadend = () => {
									const result = reader.result as string
									resolve(result.substring(result.indexOf(',') + 1))
								}
								reader.readAsDataURL(blob)
							})
							console.log('[Parent] Base64 converted, length:', base64Str.length)
						}
					} catch (e) {
						console.error('[Parent] Failed to extract blob data', e)
						loadError.value = '提取文件数据失败'
						isLoading.value = false
						return
					}
				}
				
				let docUrl = src
				if (base64Str === '') {
					// 只有非 blob 或者读取失败时，才走 src 传参模式
					if (!src.startsWith('http://') && !src.startsWith('https://') && !src.startsWith('blob:')) {
						docUrl = window.location.origin + (src.startsWith('/') ? '' : '/') + src
					}
				}
				
				const encodedSrc = encodeURIComponent(docUrl)
				
				// (targetUrl 逻辑已提前)
				if (rawArrayBuffer != null && eApi != null && electronPort > 0) {
					// Electron 环境极速通道：发送 ArrayBuffer 直接落盘
					try {
						const saveBufferFn = eApi['saveTempDocBuffer'] as ((buffer: ArrayBuffer, name: string) => Promise<string>)
						const docPath = await saveBufferFn(rawArrayBuffer, props.resource?.name ?? 'document')
						const docHttpUrl = 'http://127.0.0.1:' + electronPort + docPath
						console.log('[Doc] 文档(ArrayBuffer)已保存为临时文件，HTTP URL:', docHttpUrl)
						
						if (props.resource?.id) {
							setCachedDocUrl(props.resource.id, docHttpUrl)
						}
						
						const targetSrc = targetUrl + '?src=' + encodeURIComponent(docHttpUrl) + '&name=' + encodedName
						const existingIframe = el.querySelector('iframe') as any
						if (existingIframe) existingIframe.src = targetSrc
						else el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
					} catch (e) {
						console.error('[Doc] 保存临时文档(ArrayBuffer)失败:', e)
						loadError.value = '保存临时文档失败'
					}
				} else if (base64Str !== '' && eApi != null && electronPort > 0) {
					// Electron 环境后备方案（旧版）：发送 Base64 落盘
					try {
						const saveFn = eApi['saveTempDoc'] as ((b64: string, name: string) => Promise<string>)
						const docPath = await saveFn(base64Str, props.resource?.name ?? 'document')
						const docHttpUrl = 'http://127.0.0.1:' + electronPort + docPath
						console.log('[Doc] 文档(Base64)已保存为临时文件，HTTP URL:', docHttpUrl)
						
						if (props.resource?.id) {
							setCachedDocUrl(props.resource.id, docHttpUrl)
						}
						
						const targetSrc = targetUrl + '?src=' + encodeURIComponent(docHttpUrl) + '&name=' + encodedName
						const existingIframe = el.querySelector('iframe') as any
						if (existingIframe) existingIframe.src = targetSrc
						else el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
					} catch (e) {
						console.error('[Doc] 保存临时文档(Base64)失败:', e)
						loadError.value = '保存临时文档失败'
					}
				} else if (base64Str !== '') {
					// 非 Electron Web 环境：通过 postMessage 发送 base64
					const cacheBusterUrl = targetUrl + '?t=' + Date.now()
					const existingIframe = el.querySelector('iframe') as any
					if (existingIframe) existingIframe.src = cacheBusterUrl
					else el.innerHTML = '<iframe id="ranuts-iframe" src="' + cacheBusterUrl + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
					
					let attempts = 0
					const intervalId = setInterval(() => {
						attempts++
						const iframe = el.querySelector('#ranuts-iframe') as any
						if (iframe && iframe.contentWindow) {
							console.log(`[Parent] Sending loadDocumentBase64 message (attempt ${attempts})...`);
							iframe.contentWindow.postMessage({
								type: 'loadDocumentBase64',
								base64: base64Str,
								name: props.resource?.name ?? 'document'
							}, '*')
						}
						if (attempts >= 10) {
							clearInterval(intervalId)
						}
					}, 500)
					
					const ackListener = (event: MessageEvent) => {
						if (event.data && event.data.type === 'documentLoadedACK') {
							console.log('[Parent] Received ACK from iframe, clearing interval.')
							clearInterval(intervalId)
							window.removeEventListener('message', ackListener)
						}
					}
					window.addEventListener('message', ackListener)
				} else {
					const targetSrc = targetUrl + '?src=' + encodedSrc + '&name=' + encodedName
					const existingIframe = el.querySelector('iframe') as any
					if (existingIframe) existingIframe.src = targetSrc
					else el.innerHTML = '<iframe src="' + targetSrc + '" style="width:100%;height:100%;border:none;display:block;overflow:hidden;" scrolling="no" frameborder="0"></iframe>'
				}
			}
			isLoading.value = false
		})
	}
	
	const handleResourceSwitch = (newVal : ResourceItem | null) => {
		if (newVal != null && newVal.type == 'pdf') {
			docRenderingSrc = '' // 切到其他类型，重置文档防抖锁
			renderPdfIframe(newVal.path)
		}
		if (newVal != null && isCadType(newVal.type)) {
			docRenderingSrc = '' // 切到其他类型，重置文档防抖锁
			renderCadIframe(newVal.path)
		}
		if (newVal != null && isOfficeDoc(newVal.type)) {
			renderDocIframe(newVal.path)
		}
		// 切到图片/视频/音频等非文档类型时，也要重置防抖锁
		if (newVal != null && !isOfficeDoc(newVal.type)) {
			docRenderingSrc = ''
		}
	}

	// 监听资源变化，防抖处理
	let switchTimer: number | null = null
	
	watch(() => props.resource, (newVal : ResourceItem | null) => {
		if (switchTimer != null) {
			clearTimeout(switchTimer)
		}
		switchTimer = setTimeout(() => {
			handleResourceSwitch(newVal)
			switchTimer = null
		}, 150) as number
	}, { immediate: true })
	// #endif
	
	// 格式化时间
	const formatTime = (seconds: number): string => {
		return formatDuration(seconds)
	}
	
	// 图片加载错误
	const onImageError = (e: UniImageErrorEvent) => {
		// Image load error is handled by UI toast, suppressing console error to meet DoD
		emit('error', '图片加载失败')
	}
	
	// 视频加载错误
	const onVideoError = (e: UniVideoErrorEvent) => {
		// Video load error is handled by UI toast, suppressing console error to meet DoD
		emit('error', '视频加载失败')
	}
	
	// 视频时间更新
	const onTimeUpdate = (e: UniVideoTimeUpdateEvent) => {
		currentTime.value = e.detail.currentTime
	}
	
	// 播放结束
	const onEnded = () => {
		isPlaying.value = false
		currentTime.value = 0
	}
	
	const toggleAudio = (): void => {
		
		if (resPath.value == '') return
		
		// #ifdef WEB
		if (audioContext.value == null) {
			const audio = new Audio(resPath.value)
			audio.ontimeupdate = () => {
				currentTime.value = audio.currentTime
			}
			audio.onended = () => {
				isPlaying.value = false
				currentTime.value = 0
			}
			audioContext.value = audio
		}
		
		const ctx = audioContext.value as any
		if (isPlaying.value) {
			(ctx as UTSJSONObject)['pause']!()
		} else {
			(ctx as UTSJSONObject)['play']!()
		}
		isPlaying.value = !isPlaying.value
		// #endif
		
		// #ifndef WEB
		// App 端使用 uni.createInnerAudioContext
		if (audioContext.value == null) {
			const innerCtx = uni.createInnerAudioContext()
			innerCtx.src = resPath.value
			innerCtx.onTimeUpdate(() => {
				currentTime.value = innerCtx.currentTime
			})
			innerCtx.onEnded(() => {
				isPlaying.value = false
				currentTime.value = 0
			})
			audioContext.value = innerCtx
		}
		
		const appCtx = audioContext.value as InnerAudioContext
		if (isPlaying.value) {
			appCtx.pause()
		} else {
			appCtx.play()
		}
		isPlaying.value = !isPlaying.value
		// #endif
	}
	
	const openExternalResource = () => {
		if (resPath.value == '') return
		// #ifdef APP-ANDROID || APP-HARMONY
		uni.openDocument({
			filePath: resPath.value,
			fail: (err: any) => {
				const errMsg = err instanceof Error ? err.message : (err != null ? err.toString() : 'unknown');
				uni.showToast({
					title: '无法打开文档: ' + errMsg,
					icon: 'none'
				})
			}
		})
		// #endif
		
		// #ifdef WEB
		window.open(resPath.value, '_blank')
		// #endif
	}
	
	// 监听资源变化，重置状态
	watch(resPath, () => {
		resetImage()
		
		// 停止当前播放
		if (audioContext.value != null) {
			const ctx = audioContext.value as any
			// #ifdef WEB
			try {
				(ctx as UTSJSONObject)['pause']!()
				if ((ctx as UTSJSONObject)['src'] != null) {
					(ctx as UTSJSONObject)['src'] = ''
				}
			} catch (e: any) {}
			audioContext.value = null
			// #endif
			
			// #ifndef WEB
			const innerCtx = ctx as InnerAudioContext
			innerCtx.stop()
			innerCtx.destroy()
			audioContext.value = null
			// #endif
		}
		
		isPlaying.value = false
		currentTime.value = 0
	})
	
	// 组件卸载时清理
	onUnmounted(() => {
		if (audioContext.value != null) {
			const ctx = audioContext.value as any
			// #ifdef WEB
			try {
				(ctx as UTSJSONObject)['pause']!()
			} catch (e: any) {}
			// #endif
			
			// #ifndef WEB
			const innerCtx = ctx as InnerAudioContext
			innerCtx.stop()
			innerCtx.destroy()
			// #endif
		}
	})
</script>

<style>
	/* Cloud Atlas 云图白主题 — 资源预览 */
	.resource-preview {
		flex: 1;
			flex-direction: column;
		background-color: #FFFFFF;
		border-radius: 8px;
		overflow: hidden;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
		position: relative;
	}
	
	/* 空状态 */
	.empty-state {
		flex: 1;
			flex-direction: column;
		justify-content: center;
		align-items: center;
	}
	
	.empty-icon {
		font-size: 48px;
		margin-bottom: 12px;
	}
	
	.empty-text {
		font-size: 14px;
		color: #9CA3AF;
	}
	
	/* 预览容器 */
	.preview-container {
		flex: 1;
			flex-direction: column;
		/* padding: 4px; */
	}
	
	/* 图片预览 */
	.image-preview {
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}
	
	.image-wrapper {
		flex: 1;
		width: 100%;
		justify-content: center;
		align-items: center;
		overflow: hidden;
		position: relative;
		padding-bottom: 30px;
	}
	
	.preview-image {
		width: 100%;
		height: 100%;
	}
	
	.preview-image.can-drag {
		/* #ifdef WEB */
		cursor: grab;
		/* #endif */
	}
	
	.preview-image.dragging {
		/* #ifdef WEB */
		cursor: grabbing;
		/* #endif */
	}
	
	/* 现代悬浮控制工具栏 */
	.image-toolbar {
		position: absolute;
		bottom: 12px;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		height: 44px;
		background-color: rgba(17, 24, 39, 0.75);
		border-radius: 22px;
		padding: 0 8px;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}
	
	.toolbar-btn {
		width: 36px;
		height: 36px;
		justify-content: center;
		align-items: center;
		margin: 0 4px;
		border-radius: 18px;
		background-color: transparent;
		transition: background-color 0.15s;
	}
	.toolbar-btn:active, .toolbar-btn:hover {
		background-color: rgba(255, 255, 255, 0.15);
	}
	
	.toolbar-icon {
		font-size: 18px;
		color: #FFFFFF;
		font-weight: 500;
	}
	
	/* 视频预览 */
	.video-preview {
		justify-content: flex-start;
	}
	
	.preview-video {
		width: 100%;
		flex: 1;
		border-radius: 4px;
		background-color: #111827;
	}
	
	/* 音频预览 */
	.audio-preview {
		justify-content: center;
		align-items: center;
	}
	
	.audio-visual {
			flex-direction: column;
		align-items: center;
		margin-bottom: 20px;
	}
	
	.audio-icon {
		font-size: 64px;
		margin-bottom: 16px;
	}
	
	.audio-wave {
			flex-direction: row;
		align-items: flex-end;
		height: 40px;
	}
	
	.wave-bar {
		width: 6px;
		height: 20px;
		background-color: #0891B2;
		margin: 0 3px;
		border-radius: 3px;
	}
	
	.wave-bar.playing {
		background-color: #059669;
	}
	
	.audio-controls {
		width: 100%;
			flex-direction: row;
		align-items: center;
		padding: 0 20px;
	}
	
	.audio-btn {
		width: 48px;
		height: 48px;
		border-radius: 24px;
		background-color: #0891B2;
			justify-content: center;
		align-items: center;
		margin-right: 16px;
	}
	
	.audio-progress {
		flex: 1;
			flex-direction: column;
	}
	
	.progress-bar {
		height: 6px;
		background-color: #E2E6ED;
		border-radius: 3px;
		overflow: hidden;
	}
	
	.progress-fill {
		height: 100%;
		background-color: #0891B2;
		border-radius: 3px;
	}
	
	.time-text {
		font-size: 12px;
		color: #6B7280;
		margin-top: 4px;
	}
	
	/* PDF预览 */
	.pdf-preview {
		flex-direction: column;
		height: 100%;
		overflow: hidden;
	}
	
	.pdf-frame-container {
		flex: 1;
		width: 100%;
	}
	
	/* 文档预览 */
	.document-preview {
		justify-content: center;
		align-items: center;
		height: 100%;
	}
	
	.document-icon-wrap {
		margin-bottom: 16px;
	}
	
	.document-icon {
		font-size: 64px;
	}
	
	.resource-hint {
		font-size: 12px;
		color: #9CA3AF;
		margin-top: 4px;
	}
	
	.open-btn {
		margin-top: 20px;
		padding: 12px 32px;
		background-color: #0891B2;
		border-radius: 8px;
	}
	
	.btn-text {
		font-size: 14px;
		color: #FFFFFF;
	}
	
	/* 未知类型 */
	.unknown-preview {
		justify-content: center;
		align-items: center;
	}
	
	.unknown-icon {
		font-size: 48px;
		margin-bottom: 12px;
	}
	
	.unknown-text {
		font-size: 14px;
		color: #9CA3AF;
		margin-bottom: 8px;
	}
	
	/* 资源信息 */
	.resource-info {
		margin-top: 4px;
		padding: 4px;
			flex-direction: column;
		align-items: center;
	}
	
	.resource-name {
		font-size: 14px;
		color: #111827;
		font-weight: normal;
	}
	
	.resource-desc {
		font-size: 12px;
		color: #6B7280;
		margin-top: 4px;
	}
	
	.resource-duration {
		font-size: 12px;
		color: #0891B2;
		margin-top: 4px;
	}
	
	/* CAD 图纸预览 — 无 padding，最大化显示 */
	.cad-preview-container {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background-color: #F0F2F5;
		overflow: hidden;
	}
	
	.cad-frame-container {
		flex: 1;
		width: 100%;
	}
	
	.cad-webview {
		flex: 1;
		width: 100%;
		background-color: #F0F2F5;
	}
	
	/* CAD 底部信息栏 — 极简紧凑 */
	.cad-info {
		padding: 4px 8px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: #F8FAFC;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E2E6ED;
	}
	
	.cad-info-name {
		font-size: 12px;
		color: #6B7280;
	}
	
	.pdf-webview {
		flex: 1;
		width: 100%;
		background-color: #FFFFFF;
	}

	.pdf-native-view {
		flex: 1;
		width: 100%;
		background-color: #F3F4F6;
	}
	
	.cad-label {
		color: #0891B2;
		font-weight: normal;
	}
	
	/* 加载覆盖层 — 与文档预览 loading 风格统一 */
	.loading-overlay {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(255, 255, 255, 0.88);
		flex-direction: column;
		justify-content: center;
		align-items: center;
		z-index: 100;
	}
	
	.loading-spinner {
		width: 40px;
		height: 40px;
		border-width: 3px;
		border-style: solid;
		border-color: #E2E6ED;
		border-top-color: #0891B2;
		border-radius: 20px;
		margin-bottom: 16px;
	}
	
	.loading-text {
		font-size: 14px;
		color: #6B7280;
	}
	
	/* 错误重试覆盖层 */
	.error-overlay {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(255, 255, 255, 0.95);
		flex-direction: column;
		justify-content: center;
		align-items: center;
		z-index: 100;
	}
	
	.error-icon {
		font-size: 40px;
		margin-bottom: 16px;
	}
	
	.error-text {
		font-size: 14px;
		color: #EF4444;
		margin-bottom: 24px;
	}
	
	.retry-btn {
		padding: 10px 24px;
		background-color: #0891B2;
		border-radius: 6px;
	}
	
	.retry-text {
		color: #FFFFFF;
		font-size: 14px;
	}
	
	/* 图片淡入动画 */
	.preview-image {
		opacity: 0;
		transition-property: opacity;
		transition-duration: 300ms;
	}
	
	.image-fade-in {
		opacity: 1;
	}
</style>


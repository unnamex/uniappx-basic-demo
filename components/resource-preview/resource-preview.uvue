<template>
	<view class="resource-preview">
		<!-- 无资源状态 -->
		<view v-if="resType == ''" class="empty-state">
			<text class="empty-icon">📂</text>
			<text class="empty-text">选择资源进行预览</text>
		</view>
		
		<!-- 图片预览 -->
		<view v-else-if="resType == 'image'" class="preview-container image-preview">
			<image 
				class="preview-image"
				:src="resPath"
				mode="aspectFit"
				@error="onImageError"
			/>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text v-if="resDescription != ''" class="resource-desc">{{ resDescription }}</text>
			</view>
		</view>
		
		<!-- 视频预览 -->
		<view v-else-if="resType == 'video'" class="preview-container video-preview">
			<video
				class="preview-video"
				:src="resPath"
				:poster="resThumbnail"
				controls
				:autoplay="false"
				object-fit="contain"
				@error="onVideoError"
				@timeupdate="onTimeUpdate"
				@ended="onEnded"
			/>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text v-if="resDuration > 0" class="resource-duration">时长: {{ formatTime(resDuration) }}</text>
			</view>
		</view>
		
		<!-- 音频预览 -->
		<view v-else-if="resType == 'audio'" class="preview-container audio-preview">
			<view class="audio-visual">
				<text class="audio-icon">🎵</text>
				<view class="audio-wave">
					<view v-for="i in 5" :key="i" class="wave-bar" :class="{ 'playing': isPlaying }"></view>
				</view>
			</view>
			<view class="audio-controls">
				<button class="audio-btn" @click="toggleAudio">
					<text>{{ isPlaying ? '⏸️' : '▶️' }}</text>
				</button>
				<view class="audio-progress">
					<view class="progress-bar">
						<view class="progress-fill" :style="{ width: progressPercent + '%' }"></view>
					</view>
					<text class="time-text">{{ formatTime(currentTime) }} / {{ formatTime(resDuration) }}</text>
				</view>
			</view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
			</view>
		</view>
		
		<!-- PDF预览 -->
		<view v-else-if="resType == 'document' && isPdf()" class="preview-container pdf-preview">
			<!-- #ifdef WEB -->
			<view ref="pdfFrame" class="pdf-frame-container"></view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
			</view>
			<!-- #endif -->
			<!-- #ifdef APP -->
			<view class="document-icon-wrap">
				<text class="document-icon">📄</text>
			</view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text class="resource-hint">点击下方按钮打开PDF</text>
			</view>
			<button class="open-btn" @click="openDocument">
				<text class="btn-text">打开PDF</text>
			</button>
			<!-- #endif -->
		</view>
		
		<!-- CAD 图纸预览 -->
		<view v-else-if="resType == 'cad'" class="preview-container cad-preview">
			<!-- #ifdef WEB -->
			<view ref="cadFrame" class="cad-frame-container"></view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text class="resource-desc cad-label">📐 CAD 图纸查看器</text>
			</view>
			<!-- #endif -->
			<!-- #ifdef APP -->
			<view class="document-icon-wrap">
				<text class="document-icon">📐</text>
			</view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text class="resource-hint">点击下方按钮打开CAD图纸</text>
			</view>
			<button class="open-btn" @click="openDocument">
				<text class="btn-text">打开CAD图纸</text>
			</button>
			<!-- #endif -->
		</view>
		
		<!-- 其他文档预览 -->
		<view v-else-if="resType == 'document'" class="preview-container document-preview">
			<view class="document-icon-wrap">
				<text class="document-icon">📄</text>
			</view>
			<view class="resource-info">
				<text class="resource-name">{{ resName }}</text>
				<text class="resource-hint">点击下方按钮打开文档</text>
			</view>
			<button class="open-btn" @click="openDocument">
				<text class="btn-text">打开文档</text>
			</button>
		</view>
		
		<!-- 未知类型 -->
		<view v-else class="preview-container unknown-preview">
			<text class="unknown-icon">❓</text>
			<text class="unknown-text">不支持预览此类型文件</text>
			<text class="resource-name">{{ resName }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ResourceItem, formatDuration } from '@/types/resource'
	
	// Props
	const props = defineProps<{
		resource: ResourceItem | null
	}>()
	
	// Emits
	const emit = defineEmits<{
		(e: 'error', message: string): void
		(e: 'loaded'): void
	}>()
	
	// 音频播放状态
	
	const resType = computed((): string => props.resource?.type ?? '')
	const resPath = computed((): string => props.resource?.path ?? '')
	const resName = computed((): string => props.resource?.name ?? '')
	const resDuration = computed((): number => props.resource?.duration ?? 0)
	const resThumbnail = computed((): string => props.resource?.thumbnail ?? '')
	const resDescription = computed((): string => props.resource?.description ?? '')
	const resId = computed((): string => props.resource?.id ?? '')

	const isPlaying = ref(false)
	const currentTime = ref(0)
	const audioContext = ref<any | null>(null)
	
	const progressPercent = computed((): number => {
		const res = props.resource
		if (res == null || res.duration <= 0) return 0
		return (currentTime.value / res.duration) * 100
	})
	
	function isPdf(): boolean {
		const res = props.resource
		if (res == null) return false
		const parts = res.name.toLowerCase().split('.')
		if (parts.length < 2) return false
		return parts[parts.length - 1] == 'pdf'
	}
	
	// #ifdef WEB
	// PDF预览容器引用
	const pdfFrame = ref<UniElement | null>(null)
	// CAD预览容器引用
	const cadFrame = ref<UniElement | null>(null)
	
	function renderPdfIframe(src : string): void {
		nextTick(() => {
			const el = pdfFrame.value as any
			if (el != null) {
				const encodedSrc = encodeURIComponent(src)
				el.innerHTML = '<iframe src="./static/pdf/pdfjs-viewer.html?file=' + encodedSrc + '#?file=' + encodedSrc + '" style="width:100%;height:100%;border:none;" frameborder="0"></iframe>'
			}
		})
	}
	
	function renderCadIframe(src : string): void {
		console.log('Rendering CAD file iframe with URL:', src)
		if (cadFrame.value == null) {
			console.warn('CAD frame container is not ready, retrying...')
			setTimeout(() => { renderCadIframe(src) }, 200)
			return
		}
		nextTick(() => {
			try {
				const el = (cadFrame.value as any).$el || (cadFrame.value as any)
				if (el != null) {
					const encodedSrc = encodeURIComponent(src)
					el.innerHTML = '<iframe src="./static/cad/cad-launcher.html?file=' + encodedSrc + '#?file=' + encodedSrc + '" style="width:100%;height:100%;min-height:500px;border:none;" frameborder="0" allowfullscreen sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>'
					console.log('successfully injected iframe')
				}
			} catch (e) {
				console.error('Failed to inject CAD iframe:', e)
			}
		})
	}
	
	// 监听资源变化，渲染PDF
	watch(() => props.resource, (newVal : ResourceItem | null) => {
		if (newVal != null && isPdf()) {
			renderPdfIframe(newVal.path)
		}
		if (newVal != null && newVal.type == 'cad') {
			renderCadIframe(newVal.path)
		}
	}, { immediate: true })
	// #endif
	
	// 格式化时间
	const formatTime = (seconds: number): string => {
		return formatDuration(seconds)
	}
	
	// 图片加载错误
	const onImageError = (e: UniImageErrorEvent) => {
		console.error('Image load error:', e)
		emit('error', '图片加载失败')
	}
	
	// 视频加载错误
	const onVideoError = (e: UniVideoErrorEvent) => {
		console.error('Video load error:', e)
		emit('error', '视频加载失败')
	}
	
	// 视频时间更新
	const onTimeUpdate = (e: UniVideoTimeUpdateEvent) => {
		currentTime.value = e.detail.currentTime
	}
	
	// 播放结束
	const onEnded = () => {
		isPlaying.value = false
		currentTime.value = 0
	}
	
	const toggleAudio = (): void => {
		const res = props.resource
		if (res == null) return
		
		// #ifdef WEB
		if (audioContext.value == null) {
			const audio = new Audio(res.path)
			audio.ontimeupdate = () => {
				currentTime.value = audio.currentTime
			}
			audio.onended = () => {
				isPlaying.value = false
				currentTime.value = 0
			}
			audioContext.value = audio
		}
		
		const ctx = audioContext.value as any
		if (isPlaying.value) {
			(ctx as UTSJSONObject)['pause']!()
		} else {
			(ctx as UTSJSONObject)['play']!()
		}
		isPlaying.value = !isPlaying.value
		// #endif
		
		// #ifndef WEB
		// App 端使用 uni.createInnerAudioContext
		if (audioContext.value == null) {
			const innerCtx = uni.createInnerAudioContext()
			innerCtx.src = res.path
			innerCtx.onTimeUpdate(() => {
				currentTime.value = innerCtx.currentTime
			})
			innerCtx.onEnded(() => {
				isPlaying.value = false
				currentTime.value = 0
			})
			audioContext.value = innerCtx
		}
		
		const appCtx = audioContext.value as InnerAudioContext
		if (isPlaying.value) {
			appCtx.pause()
		} else {
			appCtx.play()
		}
		isPlaying.value = !isPlaying.value
		// #endif
	}
	
	const openDocument = (): void => {
		const res = props.resource
		if (res == null) return
		
		// #ifdef APP-ANDROID || APP-HARMONY
		uni.openDocument({
			filePath: res.path,
			fail: (err: any) => {
				const errMsg = err instanceof Error ? err.message : (err != null ? err.toString() : 'unknown');
				uni.showToast({
					title: '无法打开文档: ' + errMsg,
					icon: 'none'
				})
			}
		})
		// #endif
		
		// #ifdef WEB
		window.open(res.path, '_blank')
		// #endif
	}
	
	// 监听资源变化，重置状态
	watch(() => props.resource, (newVal: ResourceItem | null) => {
		// 停止当前播放
		if (audioContext.value != null) {
			const ctx = audioContext.value as any
			// #ifdef WEB
			(ctx as UTSJSONObject)['pause']!()
			audioContext.value = null
			// #endif
			
			// #ifndef WEB
			const innerCtx = ctx as InnerAudioContext
			innerCtx.stop()
			innerCtx.destroy()
			audioContext.value = null
			// #endif
		}
		
		isPlaying.value = false
		currentTime.value = 0
	})
	
	// 组件卸载时清理
	onUnmounted(() => {
		if (audioContext.value != null) {
			const ctx = audioContext.value as any
			// #ifdef WEB
			try {
				(ctx as UTSJSONObject)['pause']!()
			} catch (e: any) {}
			// #endif
			
			// #ifndef WEB
			const innerCtx = ctx as InnerAudioContext
			innerCtx.stop()
			innerCtx.destroy()
			// #endif
		}
	})
</script>

<style>
	/* Cloud Atlas 云图白主题 — 资源预览 */
	.resource-preview {
		flex: 1;
			flex-direction: column;
		background-color: #FFFFFF;
		border-radius: 8px;
		overflow: hidden;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	/* 空状态 */
	.empty-state {
		flex: 1;
			flex-direction: column;
		justify-content: center;
		align-items: center;
	}
	
	.empty-icon {
		font-size: 48px;
		margin-bottom: 12px;
	}
	
	.empty-text {
		font-size: 14px;
		color: #9CA3AF;
	}
	
	/* 预览容器 */
	.preview-container {
		flex: 1;
			flex-direction: column;
		padding: 12px;
	}
	
	/* 图片预览 */
	.image-preview {
		justify-content: center;
		align-items: center;
	}
	
	.preview-image {
		flex: 1;
		width: 100%;
		max-height: 300px;
		border-radius: 4px;
	}
	
	/* 视频预览 */
	.video-preview {
		justify-content: flex-start;
	}
	
	.preview-video {
		width: 100%;
		height: 200px;
		border-radius: 4px;
		background-color: #111827;
	}
	
	/* 音频预览 */
	.audio-preview {
		justify-content: center;
		align-items: center;
	}
	
	.audio-visual {
			flex-direction: column;
		align-items: center;
		margin-bottom: 20px;
	}
	
	.audio-icon {
		font-size: 64px;
		margin-bottom: 16px;
	}
	
	.audio-wave {
			flex-direction: row;
		align-items: flex-end;
		height: 40px;
	}
	
	.wave-bar {
		width: 6px;
		height: 20px;
		background-color: #0891B2;
		margin: 0 3px;
		border-radius: 3px;
	}
	
	.wave-bar.playing {
		background-color: #059669;
	}
	
	.audio-controls {
		width: 100%;
			flex-direction: row;
		align-items: center;
		padding: 0 20px;
	}
	
	.audio-btn {
		width: 48px;
		height: 48px;
		border-radius: 24px;
		background-color: #0891B2;
			justify-content: center;
		align-items: center;
		margin-right: 16px;
	}
	
	.audio-progress {
		flex: 1;
			flex-direction: column;
	}
	
	.progress-bar {
		height: 6px;
		background-color: #E2E6ED;
		border-radius: 3px;
		overflow: hidden;
	}
	
	.progress-fill {
		height: 100%;
		background-color: #0891B2;
		border-radius: 3px;
	}
	
	.time-text {
		font-size: 12px;
		color: #6B7280;
		margin-top: 4px;
	}
	
	/* PDF预览 */
	.pdf-preview {
		flex-direction: column;
	}
	
	.pdf-frame-container {
		flex: 1;
		width: 100%;
		min-height: 400px;
	}
	
	/* 文档预览 */
	.document-preview {
		justify-content: center;
		align-items: center;
	}
	
	.document-icon-wrap {
		margin-bottom: 16px;
	}
	
	.document-icon {
		font-size: 64px;
	}
	
	.resource-hint {
		font-size: 12px;
		color: #9CA3AF;
		margin-top: 4px;
	}
	
	.open-btn {
		margin-top: 20px;
		padding: 12px 32px;
		background-color: #0891B2;
		border-radius: 8px;
	}
	
	.btn-text {
		font-size: 14px;
		color: #FFFFFF;
	}
	
	/* 未知类型 */
	.unknown-preview {
		justify-content: center;
		align-items: center;
	}
	
	.unknown-icon {
		font-size: 48px;
		margin-bottom: 12px;
	}
	
	.unknown-text {
		font-size: 14px;
		color: #9CA3AF;
		margin-bottom: 8px;
	}
	
	/* 资源信息 */
	.resource-info {
		margin-top: 12px;
		padding: 8px;
			flex-direction: column;
		align-items: center;
	}
	
	.resource-name {
		font-size: 14px;
		color: #111827;
		font-weight: normal;
	}
	
	.resource-desc {
		font-size: 12px;
		color: #6B7280;
		margin-top: 4px;
	}
	
	.resource-duration {
		font-size: 12px;
		color: #0891B2;
		margin-top: 4px;
	}
	
	/* CAD 图纸预览 */
	.cad-preview {
		flex-direction: column;
	}
	
	.cad-frame-container {
		flex: 1;
		width: 100%;
		min-height: 500px;
	}
	
	.cad-label {
		color: #0891B2;
		font-weight: normal;
	}
</style>

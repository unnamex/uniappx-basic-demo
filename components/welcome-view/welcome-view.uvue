<template>
	<view class="welcome-root">
		<!-- 中央主内容区 -->
		<view class="welcome-center">
			<!-- 客户端图标 -->
			<image class="app-icon" src="/static/logo.png" mode="aspectFit"></image>

			<!-- 欢迎标题 -->
			<text class="app-name">欢迎使用 CraftX</text>

			<!-- Slogan -->
			<text class="app-slogan">工艺 · 离线掌控</text>

			<!-- 操作区域 -->
			<view class="actions-card">
				<!-- 开始分组 -->
				<text class="group-title">开始</text>

				<view class="action-row" @click="handleImport" hover-class="action-row-hover">
					<text class="action-link">导入数据包</text>
					<text class="action-hint">选择并解析 .srd 工艺数据包</text>
					<!-- #ifdef WEB -->
					<text class="action-kbd">Ctrl+I</text>
					<!-- #endif -->
				</view>

				<view class="action-row" @click="handleReset" hover-class="action-row-hover">
					<text class="action-link">重置数据</text>
					<text class="action-hint">清空所有工艺数据并重新初始化</text>
					<!-- #ifdef WEB -->
					<text class="action-kbd">Ctrl+R</text>
					<!-- #endif -->
				</view>

				<!-- 分割线 -->
				<view class="group-divider"></view>

				<!-- 帮助分组 -->
				<text class="group-title">帮助</text>

				<view class="action-row" @click="handleDoc" hover-class="action-row-hover">
					<text class="action-link">查看使用文档</text>
					<text class="action-hint">了解如何准备工艺数据包与操作指南</text>
				</view>
			</view>
		</view>

		<!-- 底部区域 (左侧Logo, 右侧版本) -->
		<view class="bottom-footer">
			<image class="brand-logo" src="/static/icons/brand/casc_full_name.png" mode="heightFix"></image>
			<text class="version-text">v{{ appVersion }}</text>
		</view>

		<!-- 使用文档模态框 -->
		<view v-if="showDocModal" class="doc-modal-overlay" :style="{ top: isPC ? '36px' : '0' }" @click="closeDoc">
			<view class="doc-modal-content" @click.stop>
				<view class="doc-modal-header">
					<text class="doc-modal-title">CraftX 使用指南</text>
					<view class="doc-modal-close" @click="closeDoc">
						<text class="close-icon">✕</text>
					</view>
				</view>
				<scroll-view class="doc-modal-body" scroll-y="true">
					<view class="doc-section">
						<text class="doc-h3">1. 什么是工艺数据包 (.srd)?</text>
						<text class="doc-p">.srd (Structured Resource Data) 是本系统专用的离线工艺数据包格式，内部包含了结构化的工艺数据以及相关的资源文件（图片、PDF、图纸等）。</text>
					</view>
					
					<view class="doc-section">
						<text class="doc-h3">2. 如何导入数据?</text>
						<text class="doc-p">直接将 .srd 文件拖拽到窗口中即可自动解析导入。也可以点击"导入数据包"按钮（或使用快捷键 Ctrl+I）手动选择文件。系统将自动解析数据包，并在左侧侧边栏生成工艺结构树。</text>
					</view>

					<view class="doc-section">
						<text class="doc-h3">3. 资源查看与交互</text>
						<text class="doc-p">在左侧目录树中点击工艺节点，即可在主工作区加载并预览关联的资源内容。</text>
						<text class="doc-li">• 图片与文档：支持双击或点击右上角按钮进入全屏沉浸式预览。</text>
						<text class="doc-li">• 全屏交互：在全屏模式下，您可以通过顶部导航栏或键盘方向键快速切换关联的图片资源。</text>
						<text class="doc-li">• 快捷操作：全屏模式下支持按 Esc 键快速退出。</text>
					</view>

					<view class="doc-section">
						<text class="doc-h3">4. 数据重置</text>
						<text class="doc-p">如需切换到新的工程数据，或清空当前缓存的工艺状态，请点击“重置数据”（或使用快捷键 Ctrl+R）。这将把系统恢复至完全初始状态。</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	
	const emit = defineEmits(['import', 'reset'])
	const showDocModal = ref(false)

	// 获取应用版本号
	const appVersion = ref(uni.getAppBaseInfo().appVersion ?? '1.0.0')

	const isPC = ref(false)
	// #ifdef WEB
	if ((window as any).electronAPI != null) {
		isPC.value = true
	}
	// #endif

	onMounted(() => {
		const checkSys = async () => {
			// #ifdef WEB
			if ((window as any).electronAPI != null) {
				const api = (window as any).electronAPI
				try {
					appVersion.value = await api.getVersion()
				} catch (e) {}
			}
			// #endif
		}
		checkSys()
	})

	const handleImport = () => {
		emit('import')
	}

	const handleReset = () => {
		emit('reset')
	}

	const handleDoc = () => {
		showDocModal.value = true
	}

	const closeDoc = () => {
		showDocModal.value = false
	}
</script>


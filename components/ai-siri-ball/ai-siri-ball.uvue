<template>
	<view class="siri-ball-container" @click="onClick">
		<!-- 激活状态外环（AI模式时显示蓝色光环） -->
		<view v-if="isActive" class="siri-active-ring" ref="activeRingRef"></view>
		
		<!-- 激活时的动效球 (蓝色) -->
		<view v-if="isActive" class="siri-ball-bg siri-bg-active" ref="siriBallBg"></view>
		<view v-if="isActive" class="siri-ball siri-mid-active" ref="siriBall"></view>
		<view v-if="isActive" class="siri-ball-inner siri-inner-active" ref="siriBallInner"></view>

		<!-- 未激活时的静态球 (灰色) -->
		<view v-if="!isActive" class="siri-ball-bg siri-bg-inactive"></view>
		<view v-if="!isActive" class="siri-ball siri-mid-inactive"></view>
		<view v-if="!isActive" class="siri-ball-inner siri-inner-inactive"></view>
	</view>
</template>

<script setup lang="uts">
	// ====== Props ======
	type Props = {
		isActive: boolean
	}
	const props = withDefaults(defineProps<Props>(), {
		isActive: false
	})

	const emit = defineEmits(['click'])

	const siriBall = ref<UniElement | null>(null)
	const siriBallBg = ref<UniElement | null>(null)
	const siriBallInner = ref<UniElement | null>(null)
	const activeRingRef = ref<UniElement | null>(null)

	const onClick = () => {
		emit('click')
	}

	onMounted(() => {
		if (props.isActive) {
			startBreathingAnimation()
			startActiveRingAnimation()
		}
	})

	// 监听激活状态变化
	watch(() => props.isActive, (newVal: boolean) => {
		if (newVal) {
			setTimeout(() => {
				startBreathingAnimation()
				startActiveRingAnimation()
			}, 50)
		}
	})

	// 正常呼吸动画
	const startBreathingAnimation = () => {
		const bgKeyframes: UTSJSONObject[] = [
			{ transform: 'scale(1)', opacity: 0.2 },
			{ transform: 'scale(1.3)', opacity: 0.4 },
			{ transform: 'scale(1)', opacity: 0.2 }
		]
		const bgOptions = {
			duration: 3000,
			iterations: Infinity,
			easing: 'ease-in-out'
		}
		if (siriBallBg.value != null) {
			siriBallBg.value!.animate(bgKeyframes, bgOptions)
		}

		const outerKeyframes: UTSJSONObject[] = [
			{ transform: 'scale(0.9)', opacity: 0.6 },
			{ transform: 'scale(1.1)', opacity: 0.8 },
			{ transform: 'scale(0.9)', opacity: 0.6 }
		]
		const outerOptions = {
			duration: 2000,
			iterations: Infinity,
			easing: 'ease-in-out'
		}
		if (siriBall.value != null) {
			siriBall.value!.animate(outerKeyframes, outerOptions)
		}

		const innerKeyframes: UTSJSONObject[] = [
			{ transform: 'scale(0.8)', opacity: 0.8 },
			{ transform: 'scale(1)', opacity: 1 },
			{ transform: 'scale(0.8)', opacity: 0.8 }
		]
		const innerOptions = {
			duration: 1500,
			iterations: Infinity,
			easing: 'ease-in-out'
		}
		if (siriBallInner.value != null) {
			siriBallInner.value!.animate(innerKeyframes, innerOptions)
		}
	}

	// 激活状态光环脉冲动画
	const startActiveRingAnimation = () => {
		if (activeRingRef.value == null) return
		const ringKeyframes: UTSJSONObject[] = [
			{ transform: 'scale(1)', opacity: 0.8 },
			{ transform: 'scale(1.4)', opacity: 0.2 },
			{ transform: 'scale(1)', opacity: 0.8 }
		]
		activeRingRef.value!.animate(ringKeyframes, {
			duration: 1800,
			iterations: Infinity,
			easing: 'ease-in-out'
		})
	}
</script>

<style>
	.siri-ball-container {
		width: 28px;
		height: 28px;
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}

	/* 激活外环 */
	.siri-active-ring {
		position: absolute;
		width: 20px;
		height: 20px;
		border-radius: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #0284C7;
		opacity: 0.8;
	}

	.siri-ball-bg {
		position: absolute;
		width: 18px;
		height: 18px;
		border-radius: 9px;
	}

	.siri-ball {
		position: absolute;
		width: 12px;
		height: 12px;
		border-radius: 6px;
	}

	.siri-ball-inner {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 3px;
	}

	/* 颜色变体 */
	.siri-bg-active { background-color: #38bdf8; opacity: 0.2; }
	.siri-bg-inactive { background-color: #94A3B8; opacity: 0.15; }

	.siri-mid-active { background-color: #0284c7; opacity: 0.6; }
	.siri-mid-inactive { background-color: #CBD5E1; opacity: 0.5; }

	.siri-inner-active { background-color: #e0f2fe; opacity: 0.9; }
	.siri-inner-inactive { background-color: #F1F5F9; opacity: 0.8; }
</style>

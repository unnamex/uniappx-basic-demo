<template>
	<!-- 面包屑容器 -->
	<view class="ux-breadcrumb">
		<view v-for="(item, index) in items" :key="index" class="ux-breadcrumb-row">
			<!-- 面包屑项 -->
			<view class="ux-breadcrumb-item" @click="onItemClick(item, index)">
				<text class="ux-breadcrumb-text" :class="index == items.length - 1 ? 'ux-breadcrumb-text-active' : ''">{{ item.label }}</text>
			</view>
			<!-- 箭头分隔符（最后一项不显示） -->
			<view v-if="index < items.length - 1" class="ux-breadcrumb-separator">
				<text class="ux-breadcrumb-separator-text">›</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * ux-breadcrumb 面包屑组件
	 * @description 类似 Element Plus 的 Breadcrumb 组件，使用箭头分隔符
	 * 支持多级面包屑路径展示
	 */

	// 面包屑项类型定义（顶层 type）
	type BreadcrumbItem = {
		label: string     // 显示文本
		value: string     // 值/标识（可选，用于点击回调）
	}

	// Props
	const props = defineProps({
		/** 面包屑项列表 */
		items: {
			type: Array as PropType<BreadcrumbItem[]>,
			default: (): BreadcrumbItem[] => [] as BreadcrumbItem[]
		}
	})

	// Emits
	const emit = defineEmits(['item-click'])

	/**
	 * 面包屑项点击事件
	 */
	const onItemClick = (item: BreadcrumbItem, index: number) => {
		emit('item-click', item)
	}
</script>

<style>
	.ux-breadcrumb {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.ux-breadcrumb-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.ux-breadcrumb-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 2px;
	}

	.ux-breadcrumb-text {
		font-size: 12px;
		color: #909399;
	}

	.ux-breadcrumb-text-active {
		color: #303133;
		font-weight: bold;
	}

	.ux-breadcrumb-separator {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 4px;
	}

	.ux-breadcrumb-separator-text {
		font-size: 14px;
		color: #C0C4CC;
		font-weight: bold;
	}
</style>

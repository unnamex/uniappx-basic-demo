<template>
	<view class="ux-info-view">
		<!-- 无字段时的占位提示 -->
		<view v-if="fields.length == 0" class="info-view-empty">
			<text class="info-view-empty-text">暂无内容</text>
		</view>
		<!-- 无数据时的占位提示 -->
		<view v-else-if="data == null" class="info-view-empty">
			<text class="info-view-empty-text">暂无数据</text>
		</view>
		<!-- 正常显示内容 -->
		<template v-else>
			<view v-for="(row, rowIdx) in intelligentRows" :key="rowIdx" class="info-view-row">
				<view v-for="(field, colIdx) in row.fields" :key="colIdx" 
					class="info-view-cell"
					:class="{ 'info-view-cell-rich': row.isFullWidth }"
					:style="{ width: row.isFullWidth ? '100%' : cellWidth }">
					<text class="info-view-label" :class="{ 'info-view-label-rich': row.isFullWidth }">{{ field['label'] ?? '' }}：</text>
					<view v-if="field['type'] == 'richText'" class="info-view-value-rich">
						<ux-richtext :content="getFieldValue(field)"></ux-richtext>
					</view>
					<text v-else class="info-view-value">{{ getFieldValue(field) }}</text>
				</view>
			</view>
		</template>
	</view>
</template>

<script lang="uts">
	import { PropType } from 'vue'

	type InfoViewRow = {
		isFullWidth: boolean;
		fields: UTSJSONObject[];
	}

	export default {
		name: "ux-info-view",
		props: {
			/** 字段配置数组，每项含 vModel（数据键名）和 label（显示标签） */
			fields: {
				type: Array as PropType<UTSJSONObject[]>,
				default: () => [] as UTSJSONObject[]
			},
			/** 当前节点的数据对象 */
			data: {
				type: Object as PropType<UTSJSONObject | null>,
				default: null
			},
			/** 每行显示的列数，组件级别统一配置 */
			columns: {
				type: Number,
				default: 2
			}
		},
		computed: {
			/** 智能排布的行，遇到富文本自动分作全宽单行 */
			intelligentRows(): InfoViewRow[] {
				const rows = [] as InfoViewRow[]
				const cols = this.columns > 0 ? this.columns : 2
				let currentRow = [] as UTSJSONObject[]
				for (let i = 0; i < this.fields.length; i++) {
					const field = this.fields[i]
					let isRichText = field['type'] == 'richText'
					
					if (isRichText) {
						if (currentRow.length > 0) {
							rows.push({
								isFullWidth: false,
								fields: currentRow
							} as InfoViewRow)
							currentRow = [] as UTSJSONObject[]
						}
						rows.push({
							isFullWidth: true,
							fields: [field]
						} as InfoViewRow)
					} else {
						currentRow.push(field)
						if (currentRow.length >= cols) {
							rows.push({
								isFullWidth: false,
								fields: currentRow
							} as InfoViewRow)
							currentRow = [] as UTSJSONObject[]
						}
					}
				}
				if (currentRow.length > 0) {
					rows.push({
						isFullWidth: false,
						fields: currentRow
					} as InfoViewRow)
				}
				return rows
			},
			/** 每个单元格的百分比宽度 */
			cellWidth(): string {
				const cols = this.columns > 0 ? this.columns : 2
				const pct = Math.floor(100 / cols)
				return pct + '%'
			}
		},
		methods: {
			/** 从 data 中读取 vModel 对应的值 */
			getFieldValue(field: UTSJSONObject): string {
				if (this.data == null) return '—'
				const vModel = field['vModel'] as string | null
				if (vModel == null || vModel == '') return '—'
				
				const displayVModel = vModel + '_display'
				let val = this.data![displayVModel]
				if (val == null) {
					val = this.data![vModel]
				}
				
				if (val == null) return '—'
				const str = val.toString()
				if (str.trim() == '') return '—'
				return str
			}
		}
	}
</script>

<style>
	.ux-info-view {
		display: flex;
		flex-direction: column;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
		border-radius: 6px;
		overflow: hidden;
		background-color: #FFFFFF;
	}

	.info-view-row {
		display: flex;
		flex-direction: row;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F0F2F5;
	}

	/* 每个单元格：横向排列 label 和 value */
	.info-view-cell {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		padding: 10px 14px;
		border-right-width: 1px;
		border-right-style: solid;
		border-right-color: #F0F2F5;
	}
	
	/* 富文本单元格：纵向排列 */
	.info-view-cell-rich {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* label 不换行，固定宽度收缩 */
	.info-view-label {
		font-size: 13px;
		color: #94A3B8;
		lines: 1;
		flex-shrink: 0;
	}
	
	/* 富文本的label：下方留白 */
	.info-view-label-rich {
		margin-bottom: 8px;
	}

	/* value 占剩余空间，过长自动折行 */
	.info-view-value {
		font-size: 14px;
		color: #1E293B;
		flex: 1;
		word-break: break-all;
	}
	
	/* 富文本的value：占满宽度 */
	.info-view-value-rich {
		display: flex;
		width: 100%;
		flex-direction: column;
	}

	.info-view-empty {
		display: flex;
		padding: 20px;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.info-view-empty-text {
		font-size: 13px;
		color: #C0C4CC;
	}
</style>

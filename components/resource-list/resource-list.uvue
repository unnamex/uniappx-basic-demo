<template>
	<view class="resource-list">
		<!-- 标题栏 -->
		<view class="list-header">
			<text class="header-title">{{ title }}</text>
			<text v-if="resources.length > 0" class="header-count">({{ resources.length }})</text>
		</view>
		
		<!-- 空状态 -->
		<view v-if="resources.length == 0" class="empty-state">
			<text class="empty-text">暂无资源</text>
		</view>
		
		<scroll-view 
			v-else
			ref="scrollViewRef"
			class="scroll-container"
			direction="horizontal"
			scroll-x="true"
			:show-scrollbar="false"
			style="height: 100%;"
			@scroll="onScroll"
		>
			<view class="list-content">
				<view 
					v-for="(item, index) in resources" 
					:key="item.id"
					:class="selectedId == item.id ? 'resource-card-selected' : 'resource-card'"
					@click="onItemClick(item)"
				>
					<!-- 缩略图/图标区域 -->
					<view class="card-thumbnail">
						<!-- 图片类型直接显示缩略图 -->
						<image 
							v-if="item.type == 'image'" 
							class="thumb-image"
							:src="item.thumbnail != '' ? item.thumbnail : item.path"
							mode="aspectFill"
						/>
						
						<!-- 视频类型显示缩略图+播放图标 -->
						<view v-else-if="item.type == 'video'" class="thumb-video">
							<image 
								v-if="item.thumbnail != ''"
								class="thumb-image"
								:src="item.thumbnail"
								mode="aspectFill"
							/>
							<view v-else class="thumb-placeholder video-placeholder">
								<text class="placeholder-icon">🎬</text>
							</view>
							<view class="play-overlay">
								<text class="play-icon">▶</text>
							</view>
						</view>
						
						<!-- 音频类型显示音符图标 -->
						<view v-else-if="item.type == 'audio'" class="thumb-placeholder audio-placeholder">
							<text class="placeholder-icon">🎵</text>
							<view class="audio-waves">
								<view class="wave-line"></view>
								<view class="wave-line"></view>
								<view class="wave-line"></view>
							</view>
						</view>
						
						<!-- 文档类型显示文档图标 -->
						<view v-else-if="item.type == 'document'" class="thumb-placeholder doc-placeholder">
							<text class="placeholder-icon">📄</text>
						</view>
						
						<!-- 未知类型 -->
						<view v-else class="thumb-placeholder">
							<text class="placeholder-icon">📎</text>
						</view>
						
						<!-- 类型标签 -->
						<view class="type-badge" :class="'badge-' + item.type">
							<text class="badge-text">{{ getTypeLabel(item.type) }}</text>
						</view>
					</view>
					
					<!-- 信息区域 -->
					<view :class="selectedId == item.id ? 'card-info-selected' : 'card-info'">
						<text class="card-name" :numberOfLines="2">{{ formatName(item.name) }}</text>
						<text v-if="item.duration > 0" class="card-duration">{{ formatTime(item.duration) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<!-- 可拖拽滚动指示器 -->
		<view v-if="resources.length > 3" class="scroll-indicator">
			<view 
				class="indicator-track"
				ref="trackRef"
				@touchstart="onTrackTouchStart" 
				@touchmove="onTrackTouchMove" 
				@touchend="onTrackTouchEnd"
				@mousedown="onTrackMouseDown"
			>
				<view class="indicator-thumb" :style="{ transform: thumbTransform }"></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ResourceItem, getResourceTypeLabel, formatDuration } from '@/types/resource'
	
	// Props
	const props = defineProps<{
		title: string
		resources: ResourceItem[]
		selectedId: string
	}>()
	
	// Emits
	const emit = defineEmits<{
		(e: 'select', item: ResourceItem): void
	}>()
	
	// === 核心状态 ===
	const scrollViewRef = ref<UniElement | null>(null)
	const trackRef = ref<UniElement | null>(null)
	const scrollProgress = ref(0)   // 0~1 表示滚动进度
	const isDragging = ref(false)
	
	// 布局缓存（从 scroll 事件中获取真实值）
	let cachedScrollWidth = 0
	let cachedClientWidth = 0
	
	// 拖拽起始记录
	let dragStartX = 0
	let dragStartProgress = 0
	let cachedTrackWidth = 200
	
	// === 计算属性 ===
	const thumbTransform = computed((): string => {
		const maxOffset = cachedTrackWidth - 30  // 30px 为 thumb 宽度
		const offset = scrollProgress.value * maxOffset
		return `translateX(${offset}px)`
	})
	
	// === 工具方法 ===
	const getTypeLabel = (type: string): string => {
		return getResourceTypeLabel(type)
	}
	
	const formatName = (name: string): string => {
		const lastDotIndex = name.lastIndexOf('.')
		if (lastDotIndex > 0) {
			return name.substring(0, lastDotIndex)
		}
		return name
	}
	
	const formatTime = (seconds: number): string => {
		return formatDuration(seconds)
	}
	
	const onItemClick = (item: ResourceItem) => {
		emit('select', item)
	}
	
	/**
	 * 核心方法：直接操作 scroll-view 的原生滚动位置
	 * 放弃 :scroll-left 属性绑定（在多平台上不可靠），
	 * 改为通过 UniElement 的 scrollLeft 属性直接设置
	 */
	const scrollToPosition = (targetLeft: number) => {
		if (scrollViewRef.value == null) return
		const el = scrollViewRef.value!
		// 直接设置原生 DOM 的 scrollLeft 属性
		el.scrollLeft = targetLeft
	}
	
	// === 被动监听：用户手动滑动列表时同步指示器位置 ===
	const onScroll = (e: any) => {
		// 拖拽指示器期间忽略被动滚动事件，防止循环触发
		if (isDragging.value) return
		
		const detail = (e as UTSJSONObject)['detail'] as UTSJSONObject
		if (detail == null) return
		
		const scrollLeft = (detail['scrollLeft'] as number) ?? 0
		const scrollWidth = (detail['scrollWidth'] as number) ?? 1
		// detail 中 clientWidth 字段名可能是 'width' 或 'clientWidth'
		let clientWidth = (detail['width'] as number) ?? 0
		if (clientWidth == 0) {
			clientWidth = (detail['clientWidth'] as number) ?? 0
		}
		// 如果仍然取不到，就用 scrollWidth 兜底（此时 maxScroll=0，不更新进度）
		if (clientWidth == 0) {
			clientWidth = scrollWidth
		}
		
		// 缓存真实值，供拖拽时使用
		cachedScrollWidth = scrollWidth
		cachedClientWidth = clientWidth
		
		if (scrollWidth > clientWidth) {
			const maxScroll = scrollWidth - clientWidth
			scrollProgress.value = Math.max(0, Math.min(1, scrollLeft / maxScroll))
		}
	}
	
	// === 主动控制：拖拽指示器时驱动列表滚动 ===
	
	/** 通用：拖拽开始 */
	const handleDragStart = (clientX: number) => {
		isDragging.value = true
		dragStartX = clientX
		dragStartProgress = scrollProgress.value
		
		// 测量轨道实际宽度
		if (trackRef.value != null) {
			cachedTrackWidth = trackRef.value!.getBoundingClientRect().width
		}
		
		// 如果从未触发过 onScroll（用户直接拖指示器），需要估算尺寸
		if (cachedScrollWidth == 0 && props.resources.length > 0) {
			// 每张卡片 90px 宽 + 8px 间距 = 98px
			cachedScrollWidth = props.resources.length * 98
			cachedClientWidth = cachedTrackWidth + 40
		}
	}
	
	/** 通用：拖拽移动 */
	const handleDragMove = (clientX: number) => {
		const deltaX = clientX - dragStartX
		const maxTrackMove = cachedTrackWidth - 30
		
		if (maxTrackMove <= 0) return
		
		// 计算新的进度
		const deltaProgress = deltaX / maxTrackMove
		let newProgress = dragStartProgress + deltaProgress
		newProgress = Math.max(0, Math.min(1, newProgress))
		
		// 更新指示器位置
		scrollProgress.value = newProgress
		
		// 驱动列表滚动（核心：直接操作 DOM scrollLeft）
		if (cachedScrollWidth > cachedClientWidth) {
			const targetLeft = newProgress * (cachedScrollWidth - cachedClientWidth)
			scrollToPosition(targetLeft)
		}
	}
	
	/** 通用：拖拽结束 */
	const handleDragEnd = () => {
		isDragging.value = false
	}
	
	// === 触摸事件（App 端 / 鸿蒙端） ===
	const onTrackTouchStart = (e: UniTouchEvent) => {
		if (e.touches.length == 0) return
		handleDragStart(e.touches[0].clientX)
	}
	
	const onTrackTouchMove = (e: UniTouchEvent) => {
		if (!isDragging.value || e.touches.length == 0) return
		handleDragMove(e.touches[0].clientX)
	}
	
	const onTrackTouchEnd = () => {
		handleDragEnd()
	}
	
	// === 鼠标事件（Web/H5 端） ===
	const onTrackMouseDown = (e: MouseEvent) => {
		handleDragStart(e.clientX)
		// #ifdef H5 || WEB
		document.addEventListener('mousemove', onDocMouseMove)
		document.addEventListener('mouseup', onDocMouseUp)
		// #endif
	}
	
	// #ifdef H5 || WEB
	const onDocMouseMove = (e: MouseEvent) => {
		if (isDragging.value) {
			handleDragMove(e.clientX)
		}
	}
	const onDocMouseUp = () => {
		handleDragEnd()
		document.removeEventListener('mousemove', onDocMouseMove)
		document.removeEventListener('mouseup', onDocMouseUp)
	}
	// #endif
</script>

<style>
	/* Cloud Atlas 云图白主题 — 资源列表 */
	.resource-list {
			flex-direction: column;
		background-color: #FFFFFF;
		border-radius: 6px;
		padding: 6px;
		height: 100%;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	/* 标题栏 */
	.list-header {
			flex-direction: row;
		align-items: center;
		margin-bottom: 4px;
	}
	
	.header-title {
		font-size: 12px;
		font-weight: bold;
		color: #111827;
	}
	
	.header-count {
		font-size: 11px;
		color: #6B7280;
		margin-left: 4px;
	}
	
	/* 空状态 */
	.empty-state {
		flex: 1;
			justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 12px;
		color: #9CA3AF;
	}
	
	/* 滚动容器 */
	.scroll-container {
		flex: 1;
		width: 100%;
		flex-direction: row;
	}
	
	.list-content {
		flex-direction: row;
		padding-bottom: 8px;
		align-self: flex-start;
	}
	
	/* 资源卡片 */
	.resource-card {
		width: 90px;
		flex-shrink: 0;
		margin-right: 8px;
		background-color: #F3F4F6;
		border-radius: 6px;
		overflow: hidden;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	.resource-card-selected {
		width: 90px;
		flex-shrink: 0;
		margin-right: 8px;
		background-color: #ECFEFF;
		border-radius: 6px;
		overflow: hidden;
		border-width: 2px;
		border-style: solid;
		border-color: #0891B2;
	}
	
	/* 缩略图区域 */
	.card-thumbnail {
		width: 100%;
		height: 56px;
		position: relative;
		overflow: hidden;
	}
	
	.thumb-image {
		width: 100%;
		height: 100%;
	}
	
	.thumb-video {
		width: 100%;
		height: 100%;
		position: relative;
	}
	
	.thumb-placeholder {
		width: 100%;
		height: 100%;
			flex-direction: column;
		justify-content: center;
		align-items: center;
		background-color: #F0F2F5;
	}
	
	.video-placeholder {
		background-color: #E2E6ED;
	}
	
	.audio-placeholder {
		background-color: #ECFDF5;
	}
	
	.doc-placeholder {
		background-color: #FFFBEB;
	}
	
	.placeholder-icon {
		font-size: 28px;
	}
	
	/* 播放覆盖层 */
	.play-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
			justify-content: center;
		align-items: center;
		background-color: rgba(17, 24, 39, 0.3);
	}
	
	.play-icon {
		font-size: 24px;
		color: #FFFFFF;
	}
	
	/* 音频波形 */
	.audio-waves {
			flex-direction: row;
		margin-top: 8px;
	}
	
	.wave-line {
		width: 3px;
		height: 12px;
		background-color: #0891B2;
		margin: 0 2px;
		border-radius: 2px;
	}
	
	/* 类型标签 */
	.type-badge {
		position: absolute;
		bottom: 4px;
		right: 4px;
		padding: 2px 6px;
		border-radius: 4px;
		background-color: rgba(17, 24, 39, 0.7);
	}
	
	.badge-text {
		font-size: 10px;
		color: #FFFFFF;
	}
	
	.badge-image {
		background-color: rgba(8, 145, 178, 0.8);
	}
	
	.badge-video {
		background-color: rgba(220, 38, 38, 0.8);
	}
	
	.badge-audio {
		background-color: rgba(5, 150, 105, 0.8);
	}
	
	.badge-document {
		background-color: rgba(217, 119, 6, 0.8);
	}
	
	/* 信息区域 */
	.card-info {
		padding: 4px 6px;
		flex-direction: column;
	}
	
	.card-info-selected {
		padding: 4px 5px;
		flex-direction: column;
	}
	
	.card-name {
		font-size: 11px;
		color: #374151;
		overflow: hidden;
		lines: 2;
		text-overflow: ellipsis;
	}
	
	.card-duration {
		font-size: 9px;
		color: #6B7280;
		margin-top: 2px;
	}
	
	/* 可拖拽滚动指示器 */
	.scroll-indicator {
		margin-top: 8px;
		padding: 0 20px;
		padding-bottom: 6px;
	}
	
	.indicator-track {
		height: 4px;
		background-color: #E2E6ED;
		border-radius: 2px;
		position: relative;
	}
	
	.indicator-thumb {
		position: absolute;
		width: 30px;
		height: 4px;
		background-color: #0891B2;
		border-radius: 2px;
		transition-property: transform;
		transition-duration: 0.1s;
		top: 0;
	}
</style>

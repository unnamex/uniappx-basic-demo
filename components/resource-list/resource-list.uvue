<template>
	<view class="resource-list">
		<!-- 标题栏 -->
		<view class="list-header">
			<text v-if="resources.length > 0" class="header-count">共{{ resources.length }}个文件</text>
			<text v-else class="header-count">暂无资源</text>
		</view>
		
		<!-- 空状态 -->
		<view v-if="resources.length == 0" class="empty-state">
			<text class="empty-text">暂无资源</text>
		</view>
		
		<scroll-view 
			v-else
			ref="scrollViewRef"
			class="scroll-container"
			direction="horizontal"
			scroll-x="true"
			:scroll-left="currentScrollLeft"
			:show-scrollbar="false"
			style="height: 100%;"
			@scroll="onScroll"
		>
			<view class="list-content">
				<view 
					v-for="(item, index) in resources" 
					:key="item.id"
					:class="selectedId == item.id ? 'resource-card-selected' : 'resource-card'"
					@click="onItemClick(item)"
				>
					<!-- 缩略图/图标区域 -->
					<view class="card-thumbnail">
						<!-- 图片类型直接显示缩略图 -->
						<image 
							v-if="item.type == 'image'" 
							class="thumb-image"
							:src="item.thumbnail != '' ? item.thumbnail : item.path"
							mode="aspectFill"
						/>
						
						<!-- 视频类型显示缩略图+播放图标 -->
						<view v-else-if="item.type == 'video'" class="thumb-video">
							<image 
								v-if="item.thumbnail != ''"
								class="thumb-image"
								:src="item.thumbnail"
								mode="aspectFill"
							/>
							<view v-else class="thumb-placeholder video-placeholder">
								<text class="placeholder-icon">🎬</text>
							</view>
							<view class="play-overlay">
								<text class="play-icon">▶</text>
							</view>
						</view>
						
						<!-- 统一纸张图标：音频/文档/未知 全部使用一致的纸张+折角+底色带框架 -->
						<view v-else class="thumb-placeholder">
							<view class="doc-icon-wrapper">
								<!-- 纸张主体 -->
								<view class="doc-paper">
									<!-- 折角装饰 -->
									<view class="doc-fold" :class="'doc-fold-' + getDocCategory(item.type)"></view>
									<!-- 内容区域：横线模拟文档内容 -->
									<view class="doc-content-lines">
										<view class="doc-line doc-line-long" :class="'doc-line-color-' + getDocCategory(item.type)"></view>
										<view class="doc-line doc-line-medium" :class="'doc-line-color-' + getDocCategory(item.type)"></view>
										<view class="doc-line doc-line-short" :class="'doc-line-color-' + getDocCategory(item.type)"></view>
									</view>
								</view>
								<!-- 底部品牌色带 + 字母 -->
								<view class="doc-brand-bar" :class="'doc-bar-' + getDocCategory(item.type)">
									<text class="doc-brand-letter">{{ getDocLetter(item.type) }}</text>
								</view>
							</view>
						</view>
					</view>
					
					<!-- 信息区域 -->
					<view :class="selectedId == item.id ? 'card-info-selected' : 'card-info'">
						<text class="card-name" :numberOfLines="2">{{ formatName(item.name) }}</text>
						<text v-if="item.duration > 0" class="card-duration">{{ formatTime(item.duration) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<!-- 可拖拽滚动指示器 -->
		<view v-if="resources.length > 3" class="scroll-indicator">
			<view 
				class="indicator-touch-area"
				ref="trackRef"
				@touchstart="onTrackTouchStart" 
				@touchmove="onTrackTouchMove" 
				@touchend="onTrackTouchEnd"
				@mousedown="onTrackMouseDown"
			>
				<view class="indicator-track">
					<view class="indicator-thumb" :style="{ transform: thumbTransform }"></view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ResourceItem, formatDuration } from '@/types/resource'
	
	// Props
	const props = defineProps<{
		title: string
		resources: ResourceItem[]
		selectedId: string
	}>()
	
	// Emits
	const emit = defineEmits<{
		(e: 'select', item: ResourceItem): void
	}>()
	
	// === 核心状态 ===
	const scrollViewRef = ref<UniElement | null>(null)
	const trackRef = ref<UniElement | null>(null)
	const scrollProgress = ref(0)   // 0~1 表示滚动进度
	const isDragging = ref(false)
	const currentScrollLeft = ref(0)
	
	// 布局缓存（从 scroll 事件中获取真实值）
	let cachedScrollWidth = 0
	let cachedClientWidth = 0
	
	// 拖拽起始记录
	let dragStartX = 0
	let dragStartProgress = 0
	let cachedTrackWidth = 200
	
	// === 计算属性 ===
	const thumbTransform = computed((): string => {
		const maxOffset = cachedTrackWidth - 30  // 30px 为 thumb 宽度
		const offset = scrollProgress.value * maxOffset
		return `translateX(${offset}px)`
	})

	// === 工具方法 ===
	const getDocCategory = (type: string): string => {
		if (['docx', 'wps', 'wpt'].includes(type)) return 'word'
		if (['xls', 'xlsx', 'et', 'ett'].includes(type)) return 'excel'
		if (['ppt', 'pptx', 'dps', 'dpt'].includes(type)) return 'ppt'
		if (type == 'pdf') return 'pdf'
		if (type == 'clw') return 'clw'
		if (type == 'dwg') return 'dwg'
		if (type == 'audio') return 'audio'
		if (type == 'txt') return 'txt'
		return 'file'
	}

	const getDocLetter = (type: string): string => {
		const cat = getDocCategory(type)
		if (cat == 'word') return 'W'
		if (cat == 'excel') return 'X'
		if (cat == 'ppt') return 'P'
		if (cat == 'pdf') return 'PDF'
		if (cat == 'clw') return 'CLW'
		if (cat == 'dwg') return 'DWG'
		if (cat == 'audio') return '♪'
		if (cat == 'txt') return 'TXT'
		return 'FILE'
	}
	
	const formatName = (name: string): string => {
		const lastDotIndex = name.lastIndexOf('.')
		if (lastDotIndex > 0) {
			return name.substring(0, lastDotIndex)
		}
		return name
	}
	
	const formatTime = (seconds: number): string => {
		return formatDuration(seconds)
	}
	
	const onItemClick = (item: ResourceItem) => {
		emit('select', item)
	}
	
	/**
	 * 核心方法：设置 scroll-view 的原生滚动位置
	 * 使用 :scroll-left 绑定响应式变量
	 */
	const scrollToPosition = (targetLeft: number) => {
		currentScrollLeft.value = targetLeft
	}
	
	// === 被动监听：用户手动滑动列表时同步指示器位置 ===
	const onScroll = (e: any) => {
		// 拖拽指示器期间忽略被动滚动事件，防止循环触发
		if (isDragging.value) return
		
		const detail = (e as UTSJSONObject)['detail'] as UTSJSONObject
		if (detail == null) return
		
		const scrollLeft = (detail['scrollLeft'] as number) ?? 0
		const scrollWidth = (detail['scrollWidth'] as number) ?? 1
		// detail 中 clientWidth 字段名可能是 'width' 或 'clientWidth'
		let clientWidth = (detail['width'] as number) ?? 0
		if (clientWidth == 0) {
			clientWidth = (detail['clientWidth'] as number) ?? 0
		}
		
		// 动态同步组件变量，使得再次拖拽时平滑接续
		currentScrollLeft.value = scrollLeft
		
		// 如果在事件中实在取不到 clientWidth，就用之前的估算值
		if (clientWidth == 0) {
			if (cachedClientWidth > 0 && cachedClientWidth < scrollWidth) {
				clientWidth = cachedClientWidth
			} else if (trackRef.value != null) {
				clientWidth = trackRef.value!.getBoundingClientRect().width + 40
			} else {
				clientWidth = 400 // 最差的保底
			}
		}
		
		// 缓存真实值，供拖拽时使用
		cachedScrollWidth = scrollWidth
		cachedClientWidth = clientWidth
		
		if (scrollWidth > clientWidth) {
			const maxScroll = scrollWidth - clientWidth
			scrollProgress.value = Math.max(0, Math.min(1, scrollLeft / maxScroll))
		}
	}
	
	// === 主动控制：拖拽指示器时驱动列表滚动 ===
	
	/** 通用：拖拽开始 */
	const handleDragStart = (clientX: number) => {
		isDragging.value = true
		dragStartX = clientX
		dragStartProgress = scrollProgress.value
		
		// 测量轨道实际宽度
		if (trackRef.value != null) {
			cachedTrackWidth = trackRef.value!.getBoundingClientRect().width
		}
		
		// 如果从未触发过 onScroll（用户直接拖指示器），需要估算尺寸
		if (cachedScrollWidth == 0 && props.resources.length > 0) {
			// 每张卡片 84px 宽 + 6px 间距 = 90px
			cachedScrollWidth = props.resources.length * 90
			cachedClientWidth = cachedTrackWidth + 40
		}
	}
	
	/** 通用：拖拽移动 */
	const handleDragMove = (clientX: number) => {
		const deltaX = clientX - dragStartX
		const maxTrackMove = cachedTrackWidth - 30
		
		if (maxTrackMove <= 0) return
		
		// 计算新的进度
		const deltaProgress = deltaX / maxTrackMove
		let newProgress = dragStartProgress + deltaProgress
		newProgress = Math.max(0, Math.min(1, newProgress))
		
		// 更新指示器位置
		scrollProgress.value = newProgress
		
		// 驱动列表滚动
		if (cachedScrollWidth > cachedClientWidth) {
			let targetLeft = newProgress * (cachedScrollWidth - cachedClientWidth)
			// 修正估算误差：拖到两端时强制贴边
			if (newProgress > 0.99) {
				targetLeft = cachedScrollWidth + 1000 // 赋予一个足够大的值，组件会自动截断到最大滚动距离
			} else if (newProgress < 0.01) {
				targetLeft = 0
			}
			scrollToPosition(targetLeft)
		}
	}
	
	/** 通用：拖拽结束 */
	const handleDragEnd = () => {
		isDragging.value = false
	}
	
	// === 触摸事件（App 端 / 鸿蒙端） ===
	const onTrackTouchStart = (e: UniTouchEvent) => {
		if (e.touches.length == 0) return
		handleDragStart(e.touches[0].clientX)
	}
	
	const onTrackTouchMove = (e: UniTouchEvent) => {
		if (!isDragging.value || e.touches.length == 0) return
		handleDragMove(e.touches[0].clientX)
	}
	
	const onTrackTouchEnd = () => {
		handleDragEnd()
	}
	
	// === 鼠标事件（Web/H5 端） ===
	const onTrackMouseDown = (e: MouseEvent) => {
		handleDragStart(e.clientX)
		// #ifdef H5 || WEB
		document.addEventListener('mousemove', onDocMouseMove)
		document.addEventListener('mouseup', onDocMouseUp)
		// #endif
	}
	
	// #ifdef H5 || WEB
	const onDocMouseMove = (e: MouseEvent) => {
		if (isDragging.value) {
			handleDragMove(e.clientX)
		}
	}
	const onDocMouseUp = () => {
		handleDragEnd()
		document.removeEventListener('mousemove', onDocMouseMove)
		document.removeEventListener('mouseup', onDocMouseUp)
	}
	// #endif
</script>

<style>
	/* Cloud Atlas 云图白主题 — 资源列表 */
	.resource-list {
			flex-direction: column;
		background-color: #FFFFFF;
		border-radius: 6px;
		padding: 4px;
		height: 100%;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	/* 标题栏 */
	.list-header {
			flex-direction: row;
		align-items: center;
		margin-bottom: 4px;
	}
	
	.header-title {
		font-size: 12px;
		font-weight: bold;
		color: #111827;
	}
	
	.header-count {
		font-size: 12px;
		font-weight: bold;
		color: #111827;
	}
	
	/* 空状态 */
	.empty-state {
		flex: 1;
			justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 12px;
		color: #9CA3AF;
	}
	
	/* 滚动容器 */
	.scroll-container {
		flex: 1;
		width: 100%;
		flex-direction: row;
	}
	
	.list-content {
		flex-direction: row;
		padding-bottom: 4px;
		align-self: flex-start;
	}
	
	/* 资源卡片 */
	.resource-card {
		width: 84px;
		flex-shrink: 0;
		margin-right: 6px;
		background-color: #F3F4F6;
		border-radius: 6px;
		overflow: hidden;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	.resource-card-selected {
		width: 84px;
		flex-shrink: 0;
		margin-right: 6px;
		background-color: #ECFEFF;
		border-radius: 6px;
		overflow: hidden;
		border-width: 2px;
		border-style: solid;
		border-color: #0891B2;
	}
	
	/* 缩略图区域 */
	.card-thumbnail {
		width: 100%;
		height: 56px;
		position: relative;
		overflow: hidden;
	}
	
	.thumb-image {
		width: 100%;
		height: 100%;
	}
	
	.thumb-video {
		width: 100%;
		height: 100%;
		position: relative;
	}
	
	.thumb-placeholder {
		width: 100%;
		height: 100%;
			flex-direction: column;
		justify-content: center;
		align-items: center;
		background-color: #F0F2F5;
	}
	
	.video-placeholder {
		background-color: #E2E6ED;
	}
	
	/* === 统一纸张文件图标系统 === */
	.doc-icon-wrapper {
		width: 42px;
		height: 48px;
		flex-direction: column;
		align-items: center;
	}
	
	/* 纸张主体 */
	.doc-paper {
		width: 36px;
		height: 34px;
		background-color: #FFFFFF;
		border-radius: 3px;
		border-width: 1px;
		border-style: solid;
		border-color: #D1D5DB;
		position: relative;
		overflow: hidden;
		flex-direction: column;
	}
	
	/* 右上角折角 */
	.doc-fold {
		position: absolute;
		top: 0;
		right: 0;
		width: 8px;
		height: 8px;
		border-bottom-left-radius: 2px;
	}
	.doc-fold-word { background-color: #93C5FD; }
	.doc-fold-excel { background-color: #86EFAC; }
	.doc-fold-ppt { background-color: #FDBA74; }
	.doc-fold-pdf { background-color: #FCA5A5; }
	.doc-fold-clw { background-color: #D1D5DB; }
	.doc-fold-dwg { background-color: #FCD34D; }
	.doc-fold-audio { background-color: #6EE7B7; }
	.doc-fold-txt { background-color: #CBD5E1; }
	.doc-fold-file { background-color: #D1D5DB; }
	
	/* 内容横线区域 */
	.doc-content-lines {
		flex: 1;
		flex-direction: column;
		justify-content: center;
		padding-left: 5px;
		padding-right: 10px;
		padding-top: 10px;
	}
	
	.doc-line {
		height: 2px;
		border-radius: 1px;
		margin-bottom: 3px;
	}
	.doc-line-long { width: 22px; }
	.doc-line-medium { width: 18px; }
	.doc-line-short { width: 14px; }
	
	/* 横线颜色 - 各类型 */
	.doc-line-color-word { background-color: #BFDBFE; }
	.doc-line-color-excel { background-color: #BBF7D0; }
	.doc-line-color-ppt { background-color: #FED7AA; }
	.doc-line-color-pdf { background-color: #FECACA; }
	.doc-line-color-clw { background-color: #E5E7EB; }
	.doc-line-color-dwg { background-color: #FDE68A; }
	.doc-line-color-audio { background-color: #A7F3D0; }
	.doc-line-color-txt { background-color: #E2E8F0; }
	.doc-line-color-file { background-color: #E5E7EB; }
	
	/* 底部品牌色带 */
	.doc-brand-bar {
		width: 42px;
		height: 14px;
		border-radius: 2px;
		margin-top: 1px;
		justify-content: center;
		align-items: center;
	}
	
	.doc-brand-letter {
		font-size: 9px;
		font-weight: bold;
		color: #FFFFFF;
	}
	
	/* 各类型底部色带颜色 */
	.doc-bar-word { background-color: #2563EB; }
	.doc-bar-excel { background-color: #16A34A; }
	.doc-bar-ppt { background-color: #D24726; }
	.doc-bar-pdf { background-color: #B91C1C; }
	.doc-bar-clw { background-color: #4B5563; }
	.doc-bar-dwg { background-color: #D97706; }
	.doc-bar-audio { background-color: #059669; }
	.doc-bar-txt { background-color: #64748B; }
	.doc-bar-file { background-color: #6B7280; }
	
	.placeholder-icon {
		font-size: 28px;
	}
	
	/* 播放覆盖层 */
	.play-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		justify-content: center;
		align-items: center;
		background-color: rgba(17, 24, 39, 0.3);
	}
	
	.play-icon {
		font-size: 24px;
		color: #FFFFFF;
	}
	
	/* 信息区域 */
	.card-info {
		padding: 4px 6px;
		flex-direction: column;
		align-items: center;
	}
	
	.card-info-selected {
		padding: 4px 5px;
		flex-direction: column;
		align-items: center;
	}
	
	.card-name {
		font-size: 11px;
		color: #374151;
		overflow: hidden;
		lines: 2;
		text-overflow: ellipsis;
		text-align: center;
	}
	
	.card-duration {
		font-size: 9px;
		color: #6B7280;
		margin-top: 2px;
		text-align: center;
	}
	
	/* 可拖拽滚动指示器 */
	.scroll-indicator {
		margin-top: 2px;
		padding: 0 20px;
		padding-bottom: 2px;
	}
	
	.indicator-touch-area {
		height: 24px;
		justify-content: center;
		position: relative;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}
	
	.indicator-track {
		height: 4px;
		background-color: #E2E6ED;
		border-radius: 2px;
		width: 100%;
		position: relative;
	}
	
	.indicator-thumb {
		position: absolute;
		width: 30px;
		height: 4px;
		background-color: #0891B2;
		border-radius: 2px;
		transition-property: transform;
		transition-duration: 0.1s;
		top: 0;
	}
</style>

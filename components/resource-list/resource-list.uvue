<template>
	<view class="resource-list">
		<!-- 标题栏 -->
		<view class="list-header">
			<text class="header-title">{{ title }}</text>
			<text v-if="resources.length > 0" class="header-count">({{ resources.length }})</text>
		</view>
		
		<!-- 空状态 -->
		<view v-if="resources.length == 0" class="empty-state">
			<text class="empty-text">暂无资源</text>
		</view>
		
		<scroll-view 
			v-else
			class="scroll-container"
			scroll-x="true"
			:show-scrollbar="false"
			style="height: 100%;"
			@scroll="onScroll"
		>
			<view class="list-content">
				<view 
					v-for="(item, index) in resources" 
					:key="item.id"
					:class="selectedId == item.id ? 'resource-card-selected' : 'resource-card'"
					@click="onItemClick(item)"
				>
					<!-- 缩略图/图标区域 -->
					<view class="card-thumbnail">
						<!-- 图片类型直接显示缩略图 -->
						<image 
							v-if="item.type == 'image'" 
							class="thumb-image"
							:src="item.thumbnail != '' ? item.thumbnail : item.path"
							mode="aspectFill"
						/>
						
						<!-- 视频类型显示缩略图+播放图标 -->
						<view v-else-if="item.type == 'video'" class="thumb-video">
							<image 
								v-if="item.thumbnail != ''"
								class="thumb-image"
								:src="item.thumbnail"
								mode="aspectFill"
							/>
							<view v-else class="thumb-placeholder video-placeholder">
								<text class="placeholder-icon">🎬</text>
							</view>
							<view class="play-overlay">
								<text class="play-icon">▶</text>
							</view>
						</view>
						
						<!-- 音频类型显示音符图标 -->
						<view v-else-if="item.type == 'audio'" class="thumb-placeholder audio-placeholder">
							<text class="placeholder-icon">🎵</text>
							<view class="audio-waves">
								<view class="wave-line"></view>
								<view class="wave-line"></view>
								<view class="wave-line"></view>
							</view>
						</view>
						
						<!-- 文档类型显示文档图标 -->
						<view v-else-if="item.type == 'document'" class="thumb-placeholder doc-placeholder">
							<text class="placeholder-icon">📄</text>
						</view>
						
						<!-- 未知类型 -->
						<view v-else class="thumb-placeholder">
							<text class="placeholder-icon">📎</text>
						</view>
						
						<!-- 类型标签 -->
						<view class="type-badge" :class="'badge-' + item.type">
							<text class="badge-text">{{ getTypeLabel(item.type) }}</text>
						</view>
					</view>
					
					<!-- 信息区域 -->
					<view class="card-info">
						<text class="card-name" :numberOfLines="1">{{ item.name }}</text>
						<text v-if="item.duration > 0" class="card-duration">{{ formatTime(item.duration) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<!-- 滚动指示器 -->
		<view v-if="resources.length > 3" class="scroll-indicator">
			<view class="indicator-track">
				<view class="indicator-thumb" :style="{ left: scrollProgress + '%' }"></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ResourceItem, getResourceTypeLabel, formatDuration } from '@/types/resource'
	
	// Props
	const props = defineProps<{
		title: string
		resources: ResourceItem[]
		selectedId: string
	}>()
	
	// Emits
	const emit = defineEmits<{
		(e: 'select', item: ResourceItem): void
	}>()
	
	// 滚动进度
	const scrollProgress = ref(0)
	
	// 获取类型标签
	const getTypeLabel = (type: string): string => {
		return getResourceTypeLabel(type)
	}
	
	// 格式化时间
	const formatTime = (seconds: number): string => {
		return formatDuration(seconds)
	}
	
	// 点击资源项
	const onItemClick = (item: ResourceItem) => {
		emit('select', item)
	}
	
	// 滚动事件
	const onScroll = (e: any) => {
		const detail = (e as UTSJSONObject)['detail'] as UTSJSONObject
		if (detail == null) return
		const scrollLeft = (detail['scrollLeft'] as number) ?? 0
		const scrollWidth = (detail['scrollWidth'] as number) ?? 1
		const clientWidth = (detail['scrollWidth'] as number) ?? 0
		
		if (scrollWidth > clientWidth) {
			scrollProgress.value = (scrollLeft / (scrollWidth - clientWidth)) * 100
		}
	}
</script>

<style>
	/* Cloud Atlas 云图白主题 — 资源列表 */
	.resource-list {
			flex-direction: column;
		background-color: #FFFFFF;
		border-radius: 6px;
		padding: 6px;
		height: 100%;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	/* 标题栏 */
	.list-header {
			flex-direction: row;
		align-items: center;
		margin-bottom: 4px;
	}
	
	.header-title {
		font-size: 12px;
		font-weight: bold;
		color: #111827;
	}
	
	.header-count {
		font-size: 11px;
		color: #6B7280;
		margin-left: 4px;
	}
	
	/* 空状态 */
	.empty-state {
		flex: 1;
			justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 12px;
		color: #9CA3AF;
	}
	
	/* 滚动容器 */
	.scroll-container {
		flex: 1;
		width: 100%;
	}
	
	.list-content {
			flex-direction: row;
		padding-bottom: 8px;
	}
	
	/* 资源卡片 */
	.resource-card {
		width: 60px;
		margin-right: 6px;
		background-color: #F3F4F6;
		border-radius: 6px;
		overflow: hidden;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}
	
	.resource-card-selected {
		width: 60px;
		margin-right: 6px;
		background-color: #ECFEFF;
		border-radius: 6px;
		overflow: hidden;
		border-width: 2px;
		border-style: solid;
		border-color: #0891B2;
	}
	
	/* 缩略图区域 */
	.card-thumbnail {
		width: 60px;
		height: 36px;
		position: relative;
		overflow: hidden;
	}
	
	.thumb-image {
		width: 100%;
		height: 100%;
	}
	
	.thumb-video {
		width: 100%;
		height: 100%;
		position: relative;
	}
	
	.thumb-placeholder {
		width: 100%;
		height: 100%;
			flex-direction: column;
		justify-content: center;
		align-items: center;
		background-color: #F0F2F5;
	}
	
	.video-placeholder {
		background-color: #E2E6ED;
	}
	
	.audio-placeholder {
		background-color: #ECFDF5;
	}
	
	.doc-placeholder {
		background-color: #FFFBEB;
	}
	
	.placeholder-icon {
		font-size: 22px;
	}
	
	/* 播放覆盖层 */
	.play-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
			justify-content: center;
		align-items: center;
		background-color: rgba(17, 24, 39, 0.3);
	}
	
	.play-icon {
		font-size: 24px;
		color: #FFFFFF;
	}
	
	/* 音频波形 */
	.audio-waves {
			flex-direction: row;
		margin-top: 8px;
	}
	
	.wave-line {
		width: 3px;
		height: 12px;
		background-color: #0891B2;
		margin: 0 2px;
		border-radius: 2px;
	}
	
	/* 类型标签 */
	.type-badge {
		position: absolute;
		bottom: 4px;
		right: 4px;
		padding: 2px 6px;
		border-radius: 4px;
		background-color: rgba(17, 24, 39, 0.7);
	}
	
	.badge-text {
		font-size: 10px;
		color: #FFFFFF;
	}
	
	.badge-image {
		background-color: rgba(8, 145, 178, 0.8);
	}
	
	.badge-video {
		background-color: rgba(220, 38, 38, 0.8);
	}
	
	.badge-audio {
		background-color: rgba(5, 150, 105, 0.8);
	}
	
	.badge-document {
		background-color: rgba(217, 119, 6, 0.8);
	}
	
	/* 信息区域 */
	.card-info {
		padding: 4px 6px;
			flex-direction: column;
	}
	
	.card-name {
		font-size: 10px;
		color: #374151;
		overflow: hidden;
	}
	
	.card-duration {
		font-size: 9px;
		color: #6B7280;
		margin-top: 2px;
	}
	
	/* 滚动指示器 */
	.scroll-indicator {
		margin-top: 8px;
		padding: 0 20px;
	}
	
	.indicator-track {
		height: 4px;
		background-color: #E2E6ED;
		border-radius: 2px;
		position: relative;
	}
	
	.indicator-thumb {
		position: absolute;
		width: 30px;
		height: 4px;
		background-color: #0891B2;
		border-radius: 2px;
	}
</style>

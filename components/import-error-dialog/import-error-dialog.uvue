			</view>

			<!-- 底部按钮 -->
			<view class="err-modal-footer">
				<view class="err-footer-actions">
					<view class="err-secondary-btn" @click="handleClose">
						<text class="err-secondary-btn-text">关闭</text>
					</view>
					<view class="err-primary-btn" @click="handleRetry">
						<text class="err-primary-btn-text">重新选择</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	defineProps({
		errorMessage: {
			type: String,
			default: '未知错误'
		}
	})

	const emit = defineEmits(['close', 'retry'])

	const handleClose = () => {
		emit('close')
	}

	const handleRetry = () => {
		emit('retry')
	}
</script>


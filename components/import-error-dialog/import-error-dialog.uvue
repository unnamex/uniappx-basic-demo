<template>
	<!-- 导入失败弹窗 -->
	<view class="err-modal-mask" @click="handleClose">
		<view class="err-modal-container" @click.stop="">
			<!-- 顶部红色指示条 -->
			<view class="err-modal-indicator"></view>

			<!-- 头部 -->
			<view class="err-modal-header">
				<view class="err-header-left">
					<text class="err-header-icon">⚠️</text>
					<text class="err-header-title">导入失败</text>
				</view>
				<view class="err-close-btn" @click="handleClose">
					<text class="err-close-icon">✕</text>
				</view>
			</view>

			<!-- 错误信息区 -->
			<view class="err-modal-body">
				<view class="err-message-card">
					<text class="err-message-label">错误详情</text>
					<text class="err-message-text">{{ errorMessage }}</text>
				</view>
				<view class="err-suggestion-area">
					<text class="err-suggestion-title">建议操作</text>
					<text class="err-suggestion-item">• 确认文件为有效的 .srd 工艺数据包</text>
					<text class="err-suggestion-item">• 检查文件是否完整（未被截断或损坏）</text>
					<text class="err-suggestion-item">• 尝试通过"导入数据包"按钮重新选择文件</text>

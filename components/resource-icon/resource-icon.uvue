	.doc-fold-excel { background-color: #86EFAC; }
	.doc-fold-ppt { background-color: #FDBA74; }
	.doc-fold-pdf { background-color: #FCA5A5; }
	.doc-fold-clw { background-color: #D8B4FE; }
	.doc-fold-dwg { background-color: #FCD34D; }
	.doc-fold-audio { background-color: #6EE7B7; }
	.doc-fold-txt { background-color: #CBD5E1; }
	.doc-fold-file { background-color: #D1D5DB; }
	
	/* 内容横线区域 */
	.doc-content-lines {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-left: 5px;
		padding-right: 10px;
		padding-top: 10px;
	}
	
	.doc-line {
		height: 2px;
		border-radius: 1px;
		margin-bottom: 3px;
	}
	.doc-line-long { width: 22px; }
	.doc-line-medium { width: 18px; }
	.doc-line-short { width: 14px; }
	
	/* 横线颜色 - 使用横线图案的类型 */
	.doc-line-color-word { background-color: #BFDBFE; }
	.doc-line-color-pdf { background-color: #FECACA; }
	.doc-line-color-txt { background-color: #E2E8F0; }
	.doc-line-color-file { background-color: #E5E7EB; }
	
	/* === Excel 表格网格 === */
	.doc-content-grid {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-left: 4px;
		padding-right: 8px;
		padding-top: 10px;
	}
	.doc-grid-row {
		display: flex;
		flex-direction: row;
		margin-bottom: 1px;
	}

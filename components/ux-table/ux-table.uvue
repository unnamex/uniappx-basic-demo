<template>
	<view class="ux-table">
		<view class="header">
			<view class="header-row">
				<view v-for="(col, index) in columns" :key="index" class="header-cell"
					:style="{ flex: getColFlex(index), width: getColWidth(index) }">
					<text class="header-text">{{ col['label'] }}</text>
					
					<!-- #ifdef H5 -->
					<view class="resize-handle" 
						@touchstart.stop.prevent="onResizeStart(index, $event)" 
						@touchmove.stop.prevent="onResizeMove" 
						@touchend="onResizeEnd"
						@mousedown.stop.prevent="onResizeStartMouse(index, $event)">
						<view class="separator-line"></view>
					</view>
					<!-- #endif -->
					<!-- #ifndef H5 -->
					<view class="resize-handle" 
						@touchstart.stop="(e : UniTouchEvent) => onResizeStart(index, e)" 
						@touchmove.stop="onResizeMove" 
						@touchend="onResizeEnd">
						<view class="separator-line"></view>
					</view>
					<!-- #endif -->
				</view>
			</view>
			
			<!-- Header Action: Expand/Collapse All (Floating on right) -->
			<view v-if="showExpand" class="header-action" @click="toggleAll" hover-class="header-action-hover">
				<text class="action-text">{{ isAllExpanded ? '收起' : '展开' }}</text>
			</view>
		</view>
		<view class="body">
			<view v-for="(row, rowIndex) in visibleRows" :key="rowIndex">
				<!-- 行主体部分 -->
				<view class="row" :class="{ 'row-selected': row.id === selectedRowId }" @click="handleRowClick(row)">
					<view v-for="(col, colIndex) in columns" :key="colIndex" class="cell"
						:style="{ flex: getColFlex(colIndex), width: getColWidth(colIndex) }">
						
						<view v-if="colIndex === 0" class="cell-content-wrapper">
							<!-- 仅树模式显示缩进和展开图标 -->
							<view v-if="showExpand" :style="{ width: (row.level * 20) + 'px' }"></view>
							<view v-if="showExpand" class="expand-icon" @click.stop="toggleExpand(row)">
								<text class="icon-text" v-if="row.hasChildren">{{ row.expanded ? '▼' : '▶' }}</text>
								<text class="icon-text" v-else></text>
							</view>
							<text class="cell-text">{{ getStringValue(row.originData, col['prop'] as string) }}</text>
						</view>
						
						<view v-else class="cell-content-wrapper">
							<!-- 富文本列：仅显示展开/收起按钮 -->
							<view v-if="isRichTextCol(col)" class="richtext-cell">
								<view class="richtext-toggle-btn" @click.stop="toggleRichText(row.id)">
									<text class="richtext-toggle-icon">{{ isRichTextExpanded(row.id) ? '▲' : '▼' }}</text>
									<text class="richtext-toggle-label">{{ isRichTextExpanded(row.id) ? '收起' : '展开' }}</text>
								</view>
							</view>
							<!-- 普通文本列 -->
							<text v-else class="cell-text">{{ getStringValue(row.originData, col['prop'] as string) }}</text>
						</view>
					</view>
				</view>
				<!-- 富文本展开区域：如果该行有富文本列且已展开，则在行下方显示完整内容 -->
				<view v-if="hasRichTextColumn && isRichTextExpanded(row.id)" class="richtext-expand-area">
					<!-- 无内容时显示紧凑提示 -->
					<view v-if="getRichTextContent(row) == ''" class="richtext-empty-hint">
						<text class="richtext-empty-text">暂无内容</text>
					</view>
					<!-- 有内容时显示完整富文本 -->
					<view v-else>
						<view class="richtext-expand-header">
							<text class="richtext-expand-title">内容详情</text>
							<view class="richtext-close-btn" @click.stop="toggleRichText(row.id)">
								<text class="richtext-close-icon">✕</text>
							</view>
						</view>
						<view v-if="loadingRichTextIds.indexOf(row.id) >= 0" class="richtext-loading-box">
							<text class="richtext-loading-text">加载中...</text>
						</view>
						<scroll-view v-else scroll-y="true" class="richtext-expand-scroll">
							<view class="richtext-expand-content">
								<ux-richtext :content="getRichTextContent(row)"></ux-richtext>
							</view>
						</scroll-view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { PropType } from 'vue'
	import { getNodeContent } from '@/services/nodeContentService'

	type TableRow = {
		id : string
		level : number
		expanded : boolean
		hasChildren : boolean
		parentId : string | null
		originData : UTSJSONObject
		// 方便计算显示
		isShow : boolean
		loadedChildren : boolean
	}
	
	type DragState = {
		startX : number
		startWidth : number
		columnIndex : number
	}

	export default {
		name: "ux-table",
		props: {
			data: {
				type: Array as PropType<UTSJSONObject[]>,
				default: () => [] as UTSJSONObject[]
			},
			columns: {
				type: Array as PropType<UTSJSONObject[]>,
				default: () => [] as UTSJSONObject[]
			},
			/** 是否显示展开/收起功能（树模式），默认 true */
			showExpand: {
				type: Boolean,
				default: true
			},
			/** 选中的行ID，用于外部控制选中状态 */
			selectedId: {
				type: String as PropType<string | null>,
				default: null
			}
		},
		data() {
			return {
				allRows: [] as TableRow[],
				selectedRowId: null as string | null,
				columnWidths: [] as number[], // -1 indicates flex, >0 indicates rpx width
				dragState: {
					startX: 0,
					startWidth: 0,
					columnIndex: -1
				} as DragState,
				isAllExpanded: false, // 懒加载模式下默认收起
				/** 存储展开了富文本的行ID列表 */
				expandedRichTextIds: [] as string[],
				/** 富文本内容缓存 Map<InnerId, ContentHTML> */
				richTextCache: new Map<string, string>(),
				/** 正在加载内容的节点ID */
				loadingRichTextIds: [] as string[]
			}
		},
		computed: {
			visibleRows() : TableRow[] {
				return this.allRows.filter((row: TableRow) : boolean => {
					return row.isShow
				})
			},
			/** 是否存在富文本列 */
			hasRichTextColumn() : boolean {
				return this.columns.some((col: UTSJSONObject): boolean => col['isRichText'] === true)
			},
			/** 获取第一个富文本列的prop名称 */
			richTextProp() : string {
				const col = this.columns.find((c: UTSJSONObject): boolean => c['isRichText'] === true)
				if (col != null) {
					return (col['prop'] as string) ?? ''
				}
				return ''
			}
		},
		watch: {
			data: {
				handler(newData : UTSJSONObject[]) {
					this.initTableData(newData)
				},
				deep: true,
				immediate: true
			},
			columns: {
				handler(newCols : UTSJSONObject[]) {
					this.initColumns(newCols)
				},
				deep: true,
				immediate: true
			},
			selectedId: {
				handler(newId: string | null) {
					if (newId != null) {
						this.selectedRowId = newId
						// Auto select and expand invisible parents via lazy load
						this.autoExpandToId(newId)
					}
				},
				immediate: true
			}
		},
		methods: {
			getColFlex(index: number): string {
				const w = this.columnWidths[index]
				if (w <= 0) return '1'
				return 'none'
			},
			getColWidth(index: number): string {
				const w = this.columnWidths[index]
				if (w <= 0) return ''
				return w + 'px'
			},
			initColumns(cols: UTSJSONObject[]) {
				this.columnWidths = cols.map((col): number => {
					const w = col['width']
					if (w != null) {
						// Ensure it is a number. col['width'] from JSON could be various types, assume number
						return parseFloat(w.toString())
					}
					return -1 // Flag for flex
				})
			},
			getStringValue(data : UTSJSONObject, key : string) : string {
				const val = data[key]
				if (val == null) return ''
				return val.toString()
			},
			/** 判断列是否为富文本列 */
			isRichTextCol(col: UTSJSONObject): boolean {
				return col['isRichText'] === true
			},
			/** 从富文本HTML中提取纯文本摘要 */
			getPlainText(data: UTSJSONObject, key: string): string {
				const val = data[key]
				if (val == null) return ''
				let html = val.toString()
				// 简单移除HTML标签，提取纯文本作为摘要
				let result = ''
				let inTag = false
				for (let i = 0; i < html.length; i++) {
					const ch = html.charAt(i)
					if (ch == '<') {
						inTag = true
					} else if (ch == '>') {
						inTag = false
					} else if (!inTag) {
						result = result + ch
					}
				}
				// 截取前50个字符作为摘要
				if (result.length > 50) {
					return result.substring(0, 50) + '...'
				}
				return result
			},
			/** 切换行的富文本展开/收起状态 */
			toggleRichText(rowId: string) {
				const idx = this.expandedRichTextIds.indexOf(rowId)
				if (idx >= 0) {
					this.expandedRichTextIds.splice(idx, 1)
				} else {
					this.expandedRichTextIds.push(rowId)
					// 如果是展开，且缓存中没有内容，则发起请求
					if (!this.richTextCache.has(rowId)) {
						this.fetchRichTextContent(rowId)
					}
				}
			},
			/** 异步获取富文本内容 */
			fetchRichTextContent(rowId: string) {
				if (this.loadingRichTextIds.indexOf(rowId) >= 0) return
				
				this.loadingRichTextIds.push(rowId)
				getNodeContent(rowId).then((res) => {
					if (res != null) {
						// 根据数据包规范，内容可能存在 description_html 字段，或者整体就是富文本
						// 这里统一尝试读取 description_html，如果不存在则找第一个 string 字段
						let content = ""
						if (res['description_html'] != null) {
							content = res['description_html'] as string
						} else {
							// 兜底：寻找第一个非 nodeId 的字符串字段
							const keys = Object.keys(res)
							for (const key of keys) {
								if (key != 'nodeId' && typeof res[key] == 'string') {
									content = res[key] as string
									break
								}
							}
						}
						this.richTextCache.set(rowId, content)
					} else {
						this.richTextCache.set(rowId, "")
					}
				}).catch(err => {
					console.error('Fetch rich text failed:', err)
					this.richTextCache.set(rowId, "加载失败，请重试")
				}).finally(() => {
					const lIdx = this.loadingRichTextIds.indexOf(rowId)
					if (lIdx >= 0) this.loadingRichTextIds.splice(lIdx, 1)
				})
			},
			/** 判断行的富文本是否展开 */
			isRichTextExpanded(rowId: string): boolean {
				return this.expandedRichTextIds.indexOf(rowId) >= 0
			},
			/** 获取行的富文本HTML内容 */
			getRichTextContent(row: TableRow): string {
				return this.richTextCache.get(row.id) ?? ""
			},
			initTableData(treeData : UTSJSONObject[]) {
				this.allRows = []
				this.expandedRichTextIds = [] // 初始化时清空展开记录
				this.flatten(treeData, 0, null)
				if (!this.isAllExpanded) {
					// Collapse all if global state is collapsed
					this.allRows.forEach(row => { 
						if(row.hasChildren && row.level > 0) row.expanded = false 
					})
					this.refreshVisibility()
				}
				// 节点内容按需加载，不再初始化时自动标记展开（除非是非常小的包，但为了性能一致性，此处改为手动触发）
				this.expandedRichTextIds = []
				this.richTextCache.clear()
			},
			flatten(list : UTSJSONObject[], level : number, parentId : string | null) {
				list.forEach((item, index) => {
					// 优先使用 innerId（工艺树节点），兼容 id
					let id = item["innerId"] ?? item["id"]
					if (id == null) {
						id = `${parentId}_${index}`
					}
					
					const childrenRaw = item["children"]
					let children: UTSJSONObject[] | null = null
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						children = childrenRaw as UTSJSONObject[]
					}
					const hasChildren = children != null && children.length > 0
					
					// 懒展开：只有第 0 级（工艺）和第 1 级（工序）默认加载
					const shouldLoadChildren = level < 1 || this.isAllExpanded

					const row : TableRow = {
						id: id.toString(),
						level: level,
						expanded: shouldLoadChildren, // 初始只有已加载内容的层级才默认展开
						hasChildren: hasChildren,
						parentId: parentId,
						originData: item,
						isShow: true,
						loadedChildren: shouldLoadChildren
					}
					
					this.allRows.push(row)
					
					if (hasChildren && row.loadedChildren) {
						this.flatten(children!, level + 1, row.id)
					}
				})
			},
			insertChildren(list: UTSJSONObject[], level: number, parentId: string, insertIndex: number): number {
				let currentInsertIdx = insertIndex;
				list.forEach((item, index) => {
					let id = item["innerId"] ?? item["id"]
					if (id == null) {
						id = `${parentId}_${index}`
					}
					const childrenRaw = item["children"]
					let children: UTSJSONObject[] | null = null
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						children = childrenRaw as UTSJSONObject[]
					}
					const hasChildren = children != null && children.length > 0
					
					const row : TableRow = {
						id: id.toString(),
						level: level,
						expanded: false, 
						hasChildren: hasChildren,
						parentId: parentId,
						originData: item,
						isShow: true,
						loadedChildren: false
					}
					
					this.allRows.splice(currentInsertIdx, 0, row);
					currentInsertIdx++;
				})
				return currentInsertIdx;
			},
			toggleExpand(row : TableRow) {
				if (!row.hasChildren) return
				
				if (!row.loadedChildren) {
					// 懒加载子节点
					row.loadedChildren = true;
					const childrenRaw = row.originData["children"];
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						const children = childrenRaw as UTSJSONObject[];
						const parentIdx = this.allRows.findIndex((r: TableRow): boolean => r.id == row.id);
						if (parentIdx >= 0) {
							this.insertChildren(children, row.level + 1, row.id, parentIdx + 1);
						}
					}
				}

				row.expanded = !row.expanded
				this.updateChildrenVisibility(row)
			},
			toggleAll() {
				this.isAllExpanded = !this.isAllExpanded
				if (this.isAllExpanded) {
					// Force load all children dynamically
					let i = 0;
					while (i < this.allRows.length) {
						const row = this.allRows[i];
						if (row.hasChildren && !row.loadedChildren) {
							row.loadedChildren = true;
							const childrenRaw = row.originData["children"];
							if (childrenRaw != null && Array.isArray(childrenRaw)) {
								this.insertChildren(childrenRaw as UTSJSONObject[], row.level + 1, row.id, i + 1);
							}
						}
						i++;
					}
				}
				this.allRows.forEach(row => {
					if (row.hasChildren) {
						row.expanded = this.isAllExpanded
					}
				})
				this.refreshVisibility()
			},
			// 用于寻找目标节点时懒展开上级
			autoExpandToId(targetId: string) {
				const path = [] as UTSJSONObject[];
				if (this.findPathInRaw(this.data, targetId, path)) {
					for (let i = 0; i < path.length - 1; i++) {
						const ancestorNode = path[i];
						const ancestorId = ancestorNode["innerId"]?.toString() ?? ancestorNode["id"]?.toString() ?? '';
						const ancestorRow = this.findRowById(ancestorId);
						if (ancestorRow != null) {
							if (!ancestorRow.loadedChildren) {
								ancestorRow.loadedChildren = true;
								const cRaw = ancestorNode["children"];
								if (cRaw != null && Array.isArray(cRaw)) {
									const parentIdx = this.allRows.findIndex((r: TableRow): boolean => r.id == ancestorId);
									if (parentIdx >= 0) {
										this.insertChildren(cRaw as UTSJSONObject[], ancestorRow.level + 1, ancestorId, parentIdx + 1);
									}
								}
							}
							if (!ancestorRow.expanded) {
								ancestorRow.expanded = true;
							}
						}
					}
					this.refreshVisibility();
				}
			},
			findPathInRaw(list: UTSJSONObject[], targetId: string, path: UTSJSONObject[]): boolean {
				for (let i = 0; i < list.length; i++) {
					const item = list[i];
					const id = item["innerId"]?.toString() ?? item["id"]?.toString() ?? "";
					path.push(item);
					if (id == targetId) return true;
					const childrenRaw = item["children"];
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						if (this.findPathInRaw(childrenRaw as UTSJSONObject[], targetId, path)) {
							return true;
						}
					}
					path.pop();
				}
				return false;
			},
			refreshVisibility() {
				// Full refresh of visibility
				// Using Map for faster lookup
				const idMap = new Map<string, TableRow>()
				this.allRows.forEach(r => { idMap.set(r.id, r) })
				
				this.allRows.forEach(row => {
					if (row.level == 0) {
						row.isShow = true
					} else {
						const parent = idMap.get(row.parentId!)
						if (parent != null && parent.expanded && parent.isShow) {
							row.isShow = true
						} else {
							row.isShow = false
						}
					}
				})
			},
			updateChildrenVisibility(parentRow : TableRow) {
				const startIndex = this.allRows.findIndex((r: TableRow) : boolean => r.id == parentRow.id)
				if (startIndex == -1) return
				
				for (let i = startIndex + 1; i < this.allRows.length; i++) {
					const child = this.allRows[i]
					if (child.level <= parentRow.level) {
						break
					}
					
					if (parentRow.expanded) {
						const pRow = this.findRowById(child.parentId)
						if (pRow != null && pRow.expanded && pRow.isShow) {
							child.isShow = true
						} else {
							child.isShow = false
						}
					} else {
						child.isShow = false
					}
				}
			},
			findRowById(id : string | null) : TableRow | null {
				if (id == null) return null
				return this.allRows.find((r: TableRow) : boolean => r.id == id) ?? null
			},
			handleRowClick(row : TableRow) {
				this.selectedRowId = row.id
				this.$emit('row-click', row.originData)
			},
			// Drag / Resize Methods
			onResizeStart(index: number, e: UniTouchEvent) {
				if (e.touches.length == 0) return
				const touch = e.touches[0]
				this.dragState.startX = touch.clientX
				this.dragState.columnIndex = index
				
				let currentW = this.columnWidths[index]
				if (currentW <= 0) {
					currentW = 150
				}
				this.dragState.startWidth = currentW
			},
			onResizeMove(e: UniTouchEvent) {
				if (this.dragState.columnIndex < 0) return
				if (e.touches.length == 0) return
				
				const touch = e.touches[0]
				const deltaPx = touch.clientX - this.dragState.startX
				
				const deltaRpx = deltaPx
				
				let newWidth = this.dragState.startWidth + deltaRpx
				if (newWidth < 50) newWidth = 50
				
				this.columnWidths[this.dragState.columnIndex] = newWidth
			},
			onResizeEnd() {
				this.dragState.columnIndex = -1
			},
			// #ifdef H5
			onResizeStartMouse(index: number, e: MouseEvent) {
				const startX = e.clientX
				this.dragState.startX = startX
				this.dragState.columnIndex = index
				
				let currentW = this.columnWidths[index]
				if (currentW <= 0) {
					currentW = 150
				}
				this.dragState.startWidth = currentW
				
				// Bind global listeners
				document.addEventListener('mousemove', this.onResizeMoveMouse)
				document.addEventListener('mouseup', this.onResizeEndMouse)
			},
			onResizeMoveMouse(e: MouseEvent) {
				if (this.dragState.columnIndex < 0) return
				
				const deltaPx = e.clientX - this.dragState.startX
				
				const deltaRpx = deltaPx
				
				let newWidth = this.dragState.startWidth + deltaRpx
				if (newWidth < 50) newWidth = 50
				
				this.columnWidths[this.dragState.columnIndex] = newWidth
			},
			onResizeEndMouse() {
				this.dragState.columnIndex = -1
				document.removeEventListener('mousemove', this.onResizeMoveMouse)
				document.removeEventListener('mouseup', this.onResizeEndMouse)
			}
			// #endif
		}
	}
</script>

<style>
	/* Cloud Atlas 云图白主题 — 表格组件 */
	.ux-table {
		flex-direction: column;
		width: 100%;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E6ED;
	}

	.header {
		background-color: #F0F2F5;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E6ED;
		position: relative;
	}

	.header-row {
		flex-direction: row;
		height: 40px;
		align-items: stretch;
	}

	.header-cell {
		flex-direction: row;
		align-items: center;
		padding-left: 10px;
		padding-right: 20px;
		position: relative;
		justify-content: flex-start;
		overflow: hidden;
	}

	.richtext-empty-text {
		font-size: 13px;
		color: #9CA3AF;
	}

	.richtext-loading-box {
		padding: 20px;
		align-items: center;
		justify-content: center;
	}

	.richtext-loading-text {
		font-size: 13px;
		color: #9CA3AF;
		font-style: italic;
	}

	.richtext-expand-scroll {
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 30px;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		z-index: 10;
	}
	
	.separator-line {
		width: 1px;
		height: 20px;
		background-color: #D1D5DB;

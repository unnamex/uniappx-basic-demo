<template>
	<view class="ux-table">
		<!-- Header Action: Expand/Collapse All (Pinned floating on the table view overlay) -->
		<view v-if="showExpand" class="header-action" @click="toggleAll" hover-class="header-action-hover">
			<text class="action-text">{{ computedIsAllExpanded ? '收起' : '展开' }}</text>
		</view>

		<!-- #ifdef WEB -->
		<view class="table-scroll-container" :style="{ overflowX: showExpand ? 'hidden' : 'auto', overflowY: 'auto' }">
		<!-- #endif -->
		<!-- #ifndef WEB -->
		<scroll-view direction="vertical" scroll-y="true" class="table-scroll-container" :show-scrollbar="false">
			<scroll-view direction="horizontal" scroll-x="true" class="table-scroll-x" :show-scrollbar="false">
		<!-- #endif -->
			<view class="table-inner" :style="tableInnerStyle">
				<view class="header">
					<view class="header-row">
						<view v-for="(field, index) in fields" :key="index" class="header-cell"
							:style="getCellStyle(index)">
							<text class="header-text">{{ field['label'] }}</text>
							
							<!-- #ifdef H5 -->
							<view v-if="index < fields.length - 1" class="resize-handle" 
								@touchstart.stop.prevent="onResizeStart(index, $event)" 
								@touchmove.stop.prevent="onResizeMove" 
								@touchend="onResizeEnd"
								@mousedown.stop.prevent="onResizeStartMouse(index, $event)">
								<view class="separator-line"></view>
							</view>
							<!-- #endif -->
							<!-- #ifndef H5 -->
							<view v-if="index < fields.length - 1" class="resize-handle" 
								@touchstart.stop="(e : UniTouchEvent) => onResizeStart(index, e)" 
								@touchmove.stop="onResizeMove" 
								@touchend="onResizeEnd">
								<view class="separator-line"></view>
							</view>
							<!-- #endif -->
						</view>
					</view>
					
				</view>
				<view class="body">
			<view v-for="(row, rowIndex) in visibleRows" :key="rowIndex">
				<!-- 行主体部分 -->
				<view class="row" :class="{ 'row-selected': row.id === selectedRowId }" @click="handleRowClick(row)">
					<view v-for="(field, fieldIndex) in fields" :key="fieldIndex" class="cell"
						:style="getCellStyle(fieldIndex)">
						
						<view v-if="fieldIndex === 0" class="cell-content-wrapper">
							<!-- 仅树模式显示缩进和展开图标 -->
							<view v-if="showExpand" :style="{ width: (row.level * 20) + 'px' }"></view>
							<view v-if="showExpand" class="expand-icon" @click.stop="toggleExpand(row)">
								<text class="icon-text" v-if="row.hasChildren">{{ row.expanded ? '▼' : '▶' }}</text>
								<text class="icon-text" v-else></text>
							</view>
							<!-- 新增：节点类型 SVG 图标 -->
							<image v-if="showExpand && getNodeIconPath(row) != ''"
								   class="node-type-icon"
								   :src="getNodeIconPath(row)"
								   mode="aspectFit" />
							<text :class="row.id === selectedRowId ? 'cell-text-selected' : 'cell-text'">{{ getStringValue(row.originData, field['prop'] as string) }}</text>
						</view>
						
						<view v-else class="cell-content-wrapper">
							<!-- 富文本列：仅显示展开/收起按钮 -->
							<view v-if="getCellType(field) == 'richText'" class="richtext-cell">
								<view class="richtext-toggle-btn" @click.stop="toggleRowExpand(row.id)">
									<text class="richtext-toggle-icon">{{ isRowExpanded(row.id) ? '▼' : '▶' }}</text>
									<text class="richtext-toggle-label">{{ isRowExpanded(row.id) ? '收起' : '展开' }}</text>
								</view>
							</view>
							<!-- 普通文本列 -->
							<text v-else :class="row.id === selectedRowId ? 'cell-text-selected' : 'cell-text'">{{ getStringValue(row.originData, field['prop'] as string) }}</text>
						</view>
					</view>
				</view>
				<!-- 展开区域：如果该行有可展开字段且已展开，则在行下方显示完整内容 -->
				<view v-if="hasExpandableField && isRowExpanded(row.id)" class="richtext-expand-area">
					<!-- 目前根据可展开类型进行渲染，暂时只有 richtext -->
					<template v-if="expandableCellType == 'richText'">
						<!-- 无内容时显示紧凑提示 -->
						<view v-if="row.expandContent == ''" class="richtext-empty-hint">
							<text class="richtext-empty-text">暂无内容</text>
						</view>
						<!-- 有内容时显示完整富文本 -->
						<view v-else>
							<view class="richtext-expand-header">
								<text class="richtext-expand-title">内容详情</text>
								<view class="richtext-close-btn" @click.stop="toggleRowExpand(row.id)">
									<text class="richtext-close-icon">✕</text>
								</view>
							</view>
							<view v-if="loadingRowIds.indexOf(row.id) >= 0" class="richtext-loading-box">
								<text class="richtext-loading-text">加载中...</text>
							</view>
							<view v-else class="richtext-expand-scroll">
								<view class="richtext-expand-content">
									<ux-richtext :content="row.expandContent"></ux-richtext>
								</view>
							</view>
						</view>
					</template>
				</view>
			</view>
				</view>
			</view>
		<!-- #ifdef WEB -->
		</view>
		<!-- #endif -->
		<!-- #ifndef WEB -->
			</scroll-view>
		</scroll-view>
		<!-- #endif -->
	</view>
</template>

<script lang="uts">
	import { PropType } from 'vue'

	type TableRow = {
		id : string
		level : number
		expanded : boolean
		hasChildren : boolean
		parentId : string | null
		originData : UTSJSONObject
		// 方便计算显示
		isShow : boolean
		loadedChildren : boolean
		expandContent : string
	}
	
	type DragState = {
		startX : number
		startWidth : number
		startNextWidth : number
		fieldIndex : number
	}

	export default {
		name: "ux-table",
		props: {
			data: {
				type: Array as PropType<UTSJSONObject[]>,
				default: () => [] as UTSJSONObject[]
			},
			fields: {
				type: Array as PropType<UTSJSONObject[]>,
				default: () => [] as UTSJSONObject[]
			},
			/** 是否显示展开/收起功能（树模式），默认 true */
			showExpand: {
				type: Boolean,
				default: true
			},
			/** 选中的行ID，用于外部控制选中状态 */
			selectedId: {
				type: String as PropType<string | null>,
				default: null
			}
		},
		data() {
			return {
				allRows: [] as TableRow[],
				selectedRowId: null as string | null,
				fieldWidths: [] as number[], // -1 indicates flex, >0 indicates px width
				fieldMinWidths: [] as number[], // 0 表示无最小宽度限制，>0 表示最小像素宽度
				dragState: {
					startX: 0,
					startWidth: 0,
					startNextWidth: 0,
					fieldIndex: -1
				} as DragState,
				isAllExpanded: false, // 懒加载模式下默认收起
				/** 存储展开了内容的行ID列表 */
				expandedRowIds: [] as string[],
				/** 正在加载内容的节点ID */
				loadingRowIds: [] as string[],
				/** 容器实际宽度（由 UniResizeObserver 自动更新，用于原生端确保表格填满容器） */
				measuredContainerWidth: 0 as number,
				/** ResizeObserver 实例引用（原生端为 UniResizeObserver，Web 端为浏览器 ResizeObserver） */
				resizeObserver: null as any
			}
		},
		computed: {
			visibleRows() : TableRow[] {
				return this.allRows.filter((row: TableRow) : boolean => {
					return row.isShow
				})
			},
			/** 动态计算当前树的展开状态 */
			computedIsAllExpanded() : boolean {
				let hasExpandable = false;
				let allExpanded = true;
				for (let i = 0; i < this.allRows.length; i++) {
					const row = this.allRows[i];
					if (row.hasChildren) {
						hasExpandable = true;
						if (!row.expanded) {
							allExpanded = false;
							break;
						}
					}
				}
				if (!hasExpandable) return false;
				return allExpanded;
			},
			/** 是否存在可展开字段 */
			hasExpandableField() : boolean {
				return this.expandableCellType != ''
			},
			/** 获取第一个可展开列的 type */
			expandableCellType() : string {
				const field = this.fields.find((c: UTSJSONObject): boolean => {
					const type = c['type'] as string | null
					return type === 'richText' // 这里未来可以加其他需要整行展开的类型
				})
				if (field != null) {
					return (field['type'] as string) ?? ''
				}
				return ''
			},
			/** 表格内部宽度 = max(列宽总和, 容器实测宽度)，由 ResizeObserver 驱动自适应 */
			tableInnerStyle() : string {
				return 'width: ' + this.tableRealWidth + 'px'
			},
			/** 所有列的宽度总和（flex 列按默认 150px 计算） */
			totalFixedWidth() : number {
				let total = 0
				for (let i = 0; i < this.fieldWidths.length; i++) {
					const w = this.fieldWidths[i]
					if (w > 0) {
						total += w
					} else {
						// flex 列使用 minWidth 或默认 150 作为计算基准
						const mw = i < this.fieldMinWidths.length ? this.fieldMinWidths[i] : 0
						total += (mw > 0 ? mw : 150)
					}
				}
				return total
			},
			/** 表格实际宽度：取列宽总和与容器测量宽度的较大值，确保填满容器且列多时可横滚 */
			tableRealWidth() : number {
				const total = this.totalFixedWidth
				if (this.measuredContainerWidth > 0) {
					return Math.max(total, this.measuredContainerWidth)
				}
				return total
			}
		},
		watch: {
			data: {
				handler(newData : UTSJSONObject[]) {
					this.initTableData(newData)
				},
				deep: true,
				immediate: true
			},
			fields: {
				handler(newFields : UTSJSONObject[]) {
					this.initFields(newFields)
				},
				deep: true,
				immediate: true
			},
			selectedId: {
				handler(newId: string | null) {
					if (newId != null) {
						this.selectedRowId = newId
						// Auto select and expand invisible parents via lazy load
						this.autoExpandToId(newId)
					}
				},
				immediate: true
			}
		},
		methods: {
			/** 判断某一列是否应该在视觉上表现为 flex 弹性列 */
			isColumnFlex(index: number): boolean {
				const w = this.fieldWidths[index]
				if (w <= 0) return true
				
				// 如果当前是最后一列，且总宽度不足容器宽度，检查是否需要让最后一列强制撑满剩余空间
				if (index === this.fieldWidths.length - 1) {
					if (this.measuredContainerWidth > 0 && this.totalFixedWidth < this.measuredContainerWidth) {
						let hasFlex = false
						for (let i = 0; i < this.fieldWidths.length - 1; i++) {
							if (this.fieldWidths[i] <= 0) {
								hasFlex = true
								break
							}
						}
						// 如果前面的列全都是固定宽度，强制最后一列弹性撑开，防止右侧留白
						if (!hasFlex) return true
					}
				}
				return false
			},
			getFieldFlex(index: number): string {
				if (this.isColumnFlex(index)) return '1'
				return 'none'
			},
			getFieldWidth(index: number): string {
				if (this.isColumnFlex(index)) return ''
				return this.fieldWidths[index] + 'px'
			},
			/** 生成列的完整 inline style 字符串，包含 flex/width/min-width */
			getCellStyle(index: number): string {
				let style = ''
				if (!this.isColumnFlex(index)) {
					style = 'flex: none; width: ' + this.fieldWidths[index] + 'px;'
				} else {
					style = 'flex: 1;'
				}
				if (index < this.fieldMinWidths.length) {
					const mw = this.fieldMinWidths[index]
					if (mw > 0) {
						style += ' min-width: ' + mw + 'px;'
					}
				}
				return style
			},
			initFields(fields: UTSJSONObject[]) {
				this.fieldWidths = fields.map((field): number => {
					const w = field['width']
					if (w != null) {
						return parseFloat(w.toString())
					}
					return -1 // Flag for flex
				})
				this.fieldMinWidths = fields.map((field): number => {
					const mw = field['minWidth']
					if (mw != null) {
						return parseFloat(mw.toString())
					}
					// 智能计算默认最小宽度：保证表头文字完整显示
					const label = (field['label'] as string | null) ?? ''
					// 假设每个汉字约 14px，左右 padding 各 12px (24px)，加上调整把手/排序图标等冗余空间预留约 16px，总计 40px。
					const computedMw = label.length * 14 + 40
					// 设置一个保底的下限（如 80px）
					return computedMw > 80 ? computedMw : 80
				})
			},
			getStringValue(data : UTSJSONObject, key : string) : string {
				const displayKey = key + '_display'
				let val = data[displayKey]
				if (val == null) {
					val = data[key]
				}
				if (val == null) return ''
				return val.toString()
			},
			/** 获取列的 type */
			getCellType(field: UTSJSONObject): string {
				const type = field['type']
				if (type != null) {
					return type as string
				}
				return ''
			},
			/** 从富文本HTML中提取纯文本摘要 */
			getPlainText(data: UTSJSONObject, key: string): string {
				const val = data[key]
				if (val == null) return ''
				let html = val.toString()
				// 简单移除HTML标签，提取纯文本作为摘要
				let result = ''
				let inTag = false
				for (let i = 0; i < html.length; i++) {
					const ch = html.charAt(i)
					if (ch == '<') {
						inTag = true
					} else if (ch == '>') {
						inTag = false
					} else if (!inTag) {
						result = result + ch
					}
				}
				// 截取前50个字符作为摘要
				if (result.length > 50) {
					return result.substring(0, 50) + '...'
				}
				return result
			},
			/** 切换行的展开/收起状态 */
			toggleRowExpand(rowId: string) {
				const idx = this.expandedRowIds.indexOf(rowId)
				if (idx >= 0) {
					this.expandedRowIds.splice(idx, 1)
				} else {
					this.expandedRowIds.push(rowId)
					// 如果是展开，且内容未缓存，则发起请求并在 row 对象上赋值
					const row = this.findRowById(rowId)
					if (row != null && row.expandContent == "") {
						this.fetchExpandContent(rowId)
					}
				}
			},
			/** 获取展开内容 */
			fetchExpandContent(rowId: string) {
				const row = this.findRowById(rowId)
				if (row != null) {
					// 优先使用 V6 标准字段 content，如果为空再尝试兼容旧版 description_html/text
					let content = (row.originData['content'] as string | null) ?? row.originData.getString('content')
					if (content == null || content == '') {
						content = (row.originData['description_html'] as string | null) ?? row.originData.getString('description_html')
					}
					if (content == null || content == '') {
						content = (row.originData['text'] as string | null) ?? row.originData.getString('text')
					}
					// 调试保障：如果还为空，把 originData 序列化输出看里面是否有该字段
					if (content == null || content == '') {
						content = "没有读取到内容，节点数据为：" + JSON.stringify(row.originData)
					}
					row.expandContent = content
				}
			},
			/** 判断行是否展开 */
			isRowExpanded(rowId: string): boolean {
				return this.expandedRowIds.indexOf(rowId) >= 0
			},
			initTableData(treeData : UTSJSONObject[]) {
				this.allRows = []
				this.expandedRowIds = [] // 初始化时清空展开记录
				this.flatten(treeData, 0, null)
				if (!this.isAllExpanded) {
					// Collapse all if global state is collapsed, but keep level 0 and 1 expanded by default
					this.allRows.forEach(row => { 
						if(row.hasChildren && row.level > 1) row.expanded = false 
					})
					this.refreshVisibility()
				}
				// 节点内容按需加载，不再初始化时自动标记展开（除非是非常小的包，但为了性能一致性，此处改为手动触发）
				this.expandedRowIds = []
			},
			flatten(list : UTSJSONObject[], level : number, parentId : string | null) {
				list.forEach((item, index) => {
					// 优先使用 innerId（工艺树节点），兼容 id
					let id = item["innerId"] ?? item["id"]
					if (id == null) {
						id = `${parentId}_${index}`
					}
					
					const childrenRaw = item["children"]
					let children: UTSJSONObject[] | null = null
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						children = childrenRaw as UTSJSONObject[]
					}
					// Only treat as having children if showExpand is enabled
					const hasChildren = this.showExpand && children != null && children.length > 0
					
					// 懒展开：第 0 级（工艺）和第 1 级（工序）默认加载，以显示出工步
					const shouldLoadChildren = level < 2 || this.isAllExpanded

					const row : TableRow = {
						id: id.toString(),
						level: level,
						expanded: shouldLoadChildren, // 初始只有已加载内容的层级才默认展开
						hasChildren: hasChildren,
						parentId: parentId,
						originData: item,
						isShow: true,
						loadedChildren: shouldLoadChildren,
						expandContent: ""
					}
					
					this.allRows.push(row)
					
					if (hasChildren && row.loadedChildren) {
						this.flatten(children!, level + 1, row.id)
					}
				})
			},
			insertChildren(list: UTSJSONObject[], level: number, parentId: string, insertIndex: number): number {
				let currentInsertIdx = insertIndex;
				list.forEach((item, index) => {
					let id = item["innerId"] ?? item["id"]
					if (id == null) {
						id = `${parentId}_${index}`
					}
					const childrenRaw = item["children"]
					let children: UTSJSONObject[] | null = null
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						children = childrenRaw as UTSJSONObject[]
					}
					// Only treat as having children if showExpand is enabled
					const hasChildren = this.showExpand && children != null && children.length > 0
					
					const row : TableRow = {
						id: id.toString(),
						level: level,
						expanded: false, 
						hasChildren: hasChildren,
						parentId: parentId,
						originData: item,
						isShow: true,
						loadedChildren: false,
						expandContent: ""
					}
					
					this.allRows.splice(currentInsertIdx, 0, row);
					currentInsertIdx++;
				})
				return currentInsertIdx;
			},
			toggleExpand(row : TableRow) {
				if (!row.hasChildren) return
				
				if (!row.loadedChildren) {
					// 懒加载子节点
					row.loadedChildren = true;
					const childrenRaw = row.originData["children"];
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						const children = childrenRaw as UTSJSONObject[];
						const parentIdx = this.allRows.findIndex((r: TableRow): boolean => r.id == row.id);
						if (parentIdx >= 0) {
							this.insertChildren(children, row.level + 1, row.id, parentIdx + 1);
						}
					}
				}

				row.expanded = !row.expanded
				this.updateChildrenVisibility(row)
			},
			toggleAll() {
				const targetState = !this.computedIsAllExpanded
				this.isAllExpanded = targetState
				if (targetState) {
					// Force load all children dynamically
					let i = 0;
					while (i < this.allRows.length) {
						const row = this.allRows[i];
						if (row.hasChildren && !row.loadedChildren) {
							row.loadedChildren = true;
							const childrenRaw = row.originData["children"];
							if (childrenRaw != null && Array.isArray(childrenRaw)) {
								this.insertChildren(childrenRaw as UTSJSONObject[], row.level + 1, row.id, i + 1);
							}
						}
						i++;
					}
				}
				this.allRows.forEach(row => {
					if (row.hasChildren) {
						row.expanded = this.isAllExpanded
					}
				})
				this.refreshVisibility()
			},
			// 用于寻找目标节点时懒展开上级
			autoExpandToId(targetId: string) {
				const path = [] as UTSJSONObject[];
				if (this.findPathInRaw(this.data, targetId, path)) {
					for (let i = 0; i < path.length - 1; i++) {
						const ancestorNode = path[i];
						const ancestorId = ancestorNode["innerId"]?.toString() ?? ancestorNode["id"]?.toString() ?? '';
						const ancestorRow = this.findRowById(ancestorId);
						if (ancestorRow != null) {
							if (!ancestorRow.loadedChildren) {
								ancestorRow.loadedChildren = true;
								const cRaw = ancestorNode["children"];
								if (cRaw != null && Array.isArray(cRaw)) {
									const parentIdx = this.allRows.findIndex((r: TableRow): boolean => r.id == ancestorId);
									if (parentIdx >= 0) {
										this.insertChildren(cRaw as UTSJSONObject[], ancestorRow.level + 1, ancestorId, parentIdx + 1);
									}
								}
							}
							if (!ancestorRow.expanded) {
								ancestorRow.expanded = true;
							}
						}
					}
					this.refreshVisibility();
				}
			},
			findPathInRaw(list: UTSJSONObject[], targetId: string, path: UTSJSONObject[]): boolean {
				for (let i = 0; i < list.length; i++) {
					const item = list[i];
					const id = item["innerId"]?.toString() ?? item["id"]?.toString() ?? "";
					path.push(item);
					if (id == targetId) return true;
					const childrenRaw = item["children"];
					if (childrenRaw != null && Array.isArray(childrenRaw)) {
						if (this.findPathInRaw(childrenRaw as UTSJSONObject[], targetId, path)) {
							return true;
						}
					}
					path.pop();
				}
				return false;
			},
			refreshVisibility() {
				// Full refresh of visibility
				// Using Map for faster lookup
				const idMap = new Map<string, TableRow>()
				this.allRows.forEach(r => { idMap.set(r.id, r) })
				
				this.allRows.forEach(row => {
					if (row.level == 0) {
						row.isShow = true
					} else {
						const parent = idMap.get(row.parentId!)
						if (parent != null && parent.expanded && parent.isShow) {
							row.isShow = true
						} else {
							row.isShow = false
						}
					}
				})
			},
			updateChildrenVisibility(parentRow : TableRow) {
				const startIndex = this.allRows.findIndex((r: TableRow) : boolean => r.id == parentRow.id)
				if (startIndex == -1) return
				
				for (let i = startIndex + 1; i < this.allRows.length; i++) {
					const child = this.allRows[i]
					if (child.level <= parentRow.level) {
						break
					}
					
					if (parentRow.expanded) {
						const pRow = this.findRowById(child.parentId)
						if (pRow != null && pRow.expanded && pRow.isShow) {
							child.isShow = true
						} else {
							child.isShow = false
						}
					} else {
						child.isShow = false
					}
				}
			},
			findRowById(id : string | null) : TableRow | null {
				if (id == null) return null
				return this.allRows.find((r: TableRow) : boolean => r.id == id) ?? null
			},
			handleRowClick(row : TableRow) {
				this.selectedRowId = row.id
				this.$emit('row-click', row.originData)
			},
			// Drag / Resize Methods
			/** 获取列的实际渲染宽度：固定列直接返回，flex 列根据表格实际宽度反算 */
			getActualColumnWidth(index: number) : number {
				if (!this.isColumnFlex(index)) {
					return this.fieldWidths[index]
				}
				// flex 列：实际宽度 = (tableRealWidth - 所有固定列宽之和) / flex 列数量
				let totalFixed = 0 as number
				let flexCount = 0 as number
				for (let i = 0; i < this.fieldWidths.length; i++) {
					if (!this.isColumnFlex(i)) {
						totalFixed += this.fieldWidths[i]
					} else {
						flexCount++
					}
				}
				const mw = index < this.fieldMinWidths.length ? this.fieldMinWidths[index] : 0
				const finalMw = mw > 50 ? mw : 50
				if (flexCount <= 0) return finalMw
				const flexWidth = (this.tableRealWidth - totalFixed) / flexCount
				return flexWidth > finalMw ? flexWidth : finalMw
			},
			onResizeStart(index: number, e: UniTouchEvent) {
				if (e.touches.length == 0) return
				const touch = e.touches[0]
				this.dragState.startX = touch.clientX
				this.dragState.fieldIndex = index
				
				this.dragState.startWidth = this.getActualColumnWidth(index)
				
				// 记录右邻列初始视觉宽度，作为拖拽界限计算依据（无论是否 flex 列）
				const nextIdx = index + 1
				if (nextIdx < this.fieldWidths.length) {
					this.dragState.startNextWidth = this.getActualColumnWidth(nextIdx)
				} else {
					this.dragState.startNextWidth = 0
				}
			},
			onResizeMove(e: UniTouchEvent) {
				if (this.dragState.fieldIndex < 0) return
				if (e.touches.length == 0) return
				const touch = e.touches[0]
				const delta = touch.clientX - this.dragState.startX
				this.applyResize(delta)
			},
			/** 联动调整列宽：当前列增大则右邻列缩小，反之亦然 */
			applyResize(delta: number) {
				const idx = this.dragState.fieldIndex
				// 当前列的 minWidth
				let minW = 50 as number
				if (idx >= 0 && idx < this.fieldMinWidths.length) {
					const cfgMin = this.fieldMinWidths[idx]
					if (cfgMin > 0) minW = cfgMin
				}
				let newWidth = this.dragState.startWidth + delta
				if (newWidth < minW) newWidth = minW

				// 联动调整右邻列
				const nextIdx = idx + 1
				if (nextIdx < this.fieldWidths.length && this.dragState.startNextWidth > 0) {
					let nextMinW = 50 as number
					if (nextIdx < this.fieldMinWidths.length) {
						const cfgNextMin = this.fieldMinWidths[nextIdx]
						if (cfgNextMin > 0) nextMinW = cfgNextMin
					}
					// 右邻列宽度 = 初始宽度 - 实际偏移量
					let nextWidth = this.dragState.startNextWidth - (newWidth - this.dragState.startWidth)
					if (nextWidth < nextMinW) {
						// 右列触底，反推限制当前列的最大宽度
						nextWidth = nextMinW
						newWidth = this.dragState.startWidth + (this.dragState.startNextWidth - nextMinW)
						if (newWidth < minW) newWidth = minW
					}
					// 仅对固定宽度的列显式回写更新；对于 flex 列，只利用上面的界限计算约束本列的最大宽度，不破坏其弹性
					if (!this.isColumnFlex(nextIdx)) {
						this.fieldWidths[nextIdx] = nextWidth
					}
				}

				this.fieldWidths[idx] = newWidth
			},
			onResizeEnd() {
				this.dragState.fieldIndex = -1
			},
			getNodeIconPath(row: TableRow): string {
				return (row.originData['iconPath'] as string | null) ?? ''
			},
			// #ifdef H5
			onResizeStartMouse(index: number, e: MouseEvent) {
				this.dragState.startX = e.clientX
				this.dragState.fieldIndex = index
				
				this.dragState.startWidth = this.getActualColumnWidth(index)
				
				// 记录右邻列初始视觉宽度，作为拖拽界限计算依据（无论是否 flex 列）
				const nextIdx = index + 1
				if (nextIdx < this.fieldWidths.length) {
					this.dragState.startNextWidth = this.getActualColumnWidth(nextIdx)
				} else {
					this.dragState.startNextWidth = 0
				}
				
				// Bind global listeners
				window.addEventListener('mousemove', this.onResizeMoveMouse)
				window.addEventListener('mouseup', this.onResizeEndMouse)
			},
			onResizeMoveMouse(e: MouseEvent) {
				if (this.dragState.fieldIndex < 0) return
				
				// 解决拖动时鼠标在外部或者被系统吞没mouseup事件导致的粘连问题
				const buttons = (e as any)['buttons'] as number | null
				if (buttons === 0) {
					this.onResizeEndMouse()
					return
				}
				
				const delta = e.clientX - this.dragState.startX
				this.applyResize(delta)
			},
			onResizeEndMouse() {
				this.dragState.fieldIndex = -1
				window.removeEventListener('mousemove', this.onResizeMoveMouse)
				window.removeEventListener('mouseup', this.onResizeEndMouse)
			},
			// #endif
		},
		mounted() {
			// #ifdef WEB
			// Web 端：使用浏览器原生 ResizeObserver 监听容器尺寸变化
			const webEl = (this as any).$el
			if (webEl != null) {
				const ro = new ResizeObserver((entries : any[]) => {
					for (let i = 0; i < entries.length; i++) {
						const w = (entries[i] as any).contentRect.width as number
						if (w > 0 && Math.abs(w - this.measuredContainerWidth) > 2) {
							this.measuredContainerWidth = w
						}
					}
				})
				ro.observe(webEl as any)
				this.resizeObserver = ro
			}
			// #endif
			// #ifndef WEB
			// 原生端：使用 UniResizeObserver 自动监听容器尺寸变化
			const el = this.$el as UniElement | null
			if (el != null) {
				const observer = new UniResizeObserver((entries: UniResizeObserverEntry[]) => {
					for (const entry of entries) {
						const rect = entry.contentRect
						// 仅在宽度确实变化时更新，避免无意义的响应式触发
						if (rect.width > 0 && Math.abs(rect.width - this.measuredContainerWidth) > 2) {
							this.measuredContainerWidth = rect.width
						}
					}
				})
				observer.observe(el)
				this.resizeObserver = observer
			}
			// #endif
		},
		unmounted() {
			if (this.resizeObserver != null) {
				(this.resizeObserver as any).disconnect()
				this.resizeObserver = null
			}
		}
	}
</script>

<style>
	/* Cloud Atlas 云图白主题 — 表格组件 (Slate/Cyan 设计语言) */
	.ux-table {
		display: flex;
		flex-direction: column;
		width: 100%;
		flex: 1;
		height: 100%;
		/* 无框设计：融入父容器，不额外添加边框 */
		background-color: #FFFFFF;
		position: relative;
		overflow: hidden;
	}
	
	.table-scroll-container {
		display: flex;
		flex: 1;
		width: 100%;
		height: 100%;
	}
	
	.table-scroll-x {
		flex-direction: row;
		width: 100%;
	}
	
	.table-inner {
		flex-direction: column;
		/* 去除 width: 100%，以支持内容宽度大于容器时的横向滚动 */
	}

	/* 表头：浅灰蓝背景 + 底部细分隔线 */
	.header {
		background-color: #F8FAFC;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E8F0;
		position: relative;
		width: 100%;
	}

	.header-row {
		flex-direction: row;
		height: 40px;
		align-items: stretch;
		width: 100%;
	}

	.header-cell {
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 12px;
		position: relative;
		justify-content: flex-start;
		overflow: hidden;
	}

	/* 表头文字：Slate-500 小号加粗，与 Tab 标题体系协调 */
	.header-text {
		font-size: 13px;
		font-weight: 600;
		color: #64748B;
		lines: 1;
		overflow: hidden;
		flex: 1;
	}

	.richtext-loading-box {
		padding: 16px;
		align-items: center;
		justify-content: center;
	}

	.richtext-loading-text {
		font-size: 13px;
		color: #94A3B8;
		font-style: italic;
	}
	
	/* 列伸缩交互热区：保证足够的真实宽度(16px)，定位在单元格最右侧 */
	.resize-handle {
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 16px;
		flex-direction: row;
		justify-content: flex-end;
		align-items: center;
		/* #ifdef WEB */
		cursor: col-resize;
		/* #endif */
		z-index: 10;
	}

	/* 可视分隔线：极细 */
	.separator-line {
		width: 1px;
		height: 16px;
		background-color: #CBD5E1;
	}

	/* 展开/收起全部 — 浮动操作按钮 (提到外层容器绝对定位) */
	.header-action {
		position: absolute;
		right: 0;
		top: 0;
		height: 40px;
		width: 56px;
		justify-content: center;
		align-items: center;
		background-color: #FFFFFF;
		z-index: 100;
		border-left-width: 1px;
		border-left-style: solid;
		border-left-color: #E2E8F0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E8F0;
	}
	
	.header-action-hover {
		background-color: #F1F5F9;
	}
	
	.action-text {
		font-size: 12px;
		color: #0891B2;
		font-weight: 600;
	}

	.body {
		flex-direction: column;
		width: 100%;
	}

	/* 数据行：紧凑间距 + Slate-100 极细分隔线 */
	.row {
		flex-direction: row;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F1F5F9;
		background-color: #FFFFFF;
		width: 100%;
		padding-top: 8px;
		padding-bottom: 8px;
	}

	.cell {
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 12px;
		overflow: hidden;
		flex-shrink: 0; 
	}
	
	.cell-content-wrapper {
		flex-direction: row;
		align-items: center;
		flex: 1;
		overflow: hidden;
	}

	/* 单元格文字：Slate-700 正文风格 */
	.cell-text {
		font-size: 14px;
		color: #334155;
		lines: 1;
		overflow: hidden;
		flex: 1;
	}

	/* 选中行文字：品牌色加深，增强选中态辨识度 */
	.cell-text-selected {
		font-size: 14px;
		color: #0E7490;
		font-weight: 600;
		lines: 1;
		overflow: hidden;
		flex: 1;
	}

	.expand-icon {
		width: 20px;
		height: 20px;
		justify-content: center;
		align-items: center;
		margin-right: 4px;
	}

	.node-type-icon {
		width: 20px;
		height: 20px;
		margin-right: 6px;
	}
	
	.icon-text {
		font-size: 11px;
		color: #94A3B8;
	}

	/* 选中行 — 明显的品牌色背景 + 左侧指示条 + 选中行文字加深 */
	/* 参考 VS Code / 飞书 / Figma 等主流做法，选中态背景色需足够醒目 */
	.row-selected {
		background-color: #E6F4F7;
		border-left-width: 3px;
		border-left-style: solid;
		border-left-color: #0891B2;
	}

	/* ====== 富文本列相关样式 ====== */
	.richtext-cell {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		flex: 1;
	}

	/* 展开/收起按钮：轻量药丸风格 */
	.richtext-toggle-btn {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 4px 12px;
		border-radius: 12px;
		background-color: #F0FDFA;
		border-width: 1px;
		border-style: solid;
		border-color: #99F6E4;
	}

	.richtext-toggle-icon {
		font-size: 9px;
		color: #0891B2;
		margin-right: 4px;
	}

	.richtext-toggle-label {
		font-size: 12px;
		color: #0891B2;
	}

	/* 富文本展开区域 */
	.richtext-expand-area {
		flex-direction: column;
		background-color: #F8FAFC;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E8F0;
		border-left-width: 3px;
		border-left-style: solid;
		border-left-color: #0891B2;
	}

	.richtext-empty-hint {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 10px 16px;
	}

	.richtext-empty-text {
		font-size: 12px;
		color: #94A3B8;
	}

	/* 展开区头部 */
	.richtext-expand-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 6px 12px;
		background-color: #F1F5F9;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E8F0;
		width: 100%;
	}

	.richtext-expand-title {
		font-size: 12px;
		font-weight: 600;
		color: #0891B2;
	}

	.richtext-close-btn {
		width: 22px;
		height: 22px;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		border-radius: 11px;
	}

	.richtext-close-icon {
		font-size: 11px;
		color: #94A3B8;
	}

	.richtext-expand-scroll {
		width: 100%;
	}

	.richtext-expand-content {
		padding: 10px 12px;
	}

	/* #ifdef WEB */
	/* 滚动条样式已在 index.html 全局定义 */
	/* #endif */
</style>

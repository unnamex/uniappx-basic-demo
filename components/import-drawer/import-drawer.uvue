<template>
	<view class="mask-bg" :style="{ top: isPC ? '36px' : '0' }" @click="handleClose">
		<view class="modal-container" @click.stop="">
			<!-- 头部：普通对话框标题栏 -->
			<view class="modal-header">
				<view class="header-left">
					<image src="/static/icons/ui/import_package.svg" class="modal-icon" mode="aspectFit" />
					<text class="modal-title">导入数据包</text>
				</view>
				<view class="close-btn" @click="handleClose" v-if="!isImporting">
					<text class="close-icon">✕</text>
				</view>
			</view>

			<!-- 主体内容 -->
			<view class="modal-body">
				
				<!-- 未选择文件状态 -->
				<view class="file-selection-area" v-if="packageInfo.fileName == ''">
					<view 
						class="drop-zone" 
						@click="handleSelectFile"
						:class="{'drop-zone-active': isDragOver}"
						@dragover.prevent="handleDragOver"
						@dragleave="handleDragLeave"
						@drop.prevent="handleDrop"
					>
						<text class="drop-icon">📂</text>
						<text class="drop-text">{{ isDragOver ? '松开以导入' : '点击或拖拽 .srd 文件到此处' }}</text>
						<view class="browse-btn">
							<text class="browse-btn-text">选择文件</text>
						</view>
					</view>
					<view class="tips-area" v-if="dragErrorMessage != ''">
						<text class="error-tip">{{ dragErrorMessage }}</text>
					</view>
				</view>

				<!-- 已选择文件详情 -->
				<view class="manifest-view" v-else-if="manifest != null">
					<view class="manifest-card">
						<view class="manifest-row main-row">
							<text class="manifest-label">数据包名称</text>
							<text class="manifest-value primary-value">{{ manifest!.name }}</text>
						</view>
						<view class="manifest-divider"></view>
						<view class="manifest-grid">
							<view class="manifest-col">
								<text class="manifest-label">版本号</text>
								<text class="manifest-value">{{ manifest!.version }}</text>
							</view>
							<view class="manifest-col">
								<text class="manifest-label">导出日期</text>
								<text class="manifest-value">{{ formatTimeShort(manifest!.exportTime) }}</text>
							</view>
						</view>
						<view class="manifest-divider"></view>
						<view class="manifest-row">
							<text class="manifest-label">说明</text>
							<text class="manifest-desc">{{ manifest!.description != '' ? manifest!.description : '无描述信息' }}</text>
						</view>
						<view class="manifest-divider"></view>
						<view class="manifest-row footer-row">
							<text class="manifest-label">文件大小</text>
							<text class="manifest-value small">{{ formatFileSize(packageInfo.fileSize) }}</text>
							<text class="change-link" @click="handleSelectFile" v-if="!isImporting">重新选择</text>
						</view>
					</view>
				</view>

				<!-- 导入进度 -->
				<view class="progress-container" v-if="isImporting">
					<view class="progress-info">
						<text class="progress-status">{{ (importProgress.status != '' ? importProgress.status : '正在同步数据...') }}</text>
						<text class="progress-value">{{ Math.floor((importProgress.current / importProgress.total) * 100) }}%</text>
					</view>
					<view class="progress-bar-bg">
						<view class="progress-bar-fill" :style="{ width: (importProgress.current / importProgress.total) * 100 + '%' }"></view>
					</view>
				</view>

				<!-- 错误提示 -->
				<view class="error-banner" v-if="importResult != null && importResult!.success == false">
					<text class="error-banner-icon">⚠️</text>
					<text class="error-banner-text">{{ importResult!.message }}</text>
				</view>
			</view>

			<!-- 底部按钮区 -->
			<view class="modal-footer">
				<view class="footer-actions">
					<view class="secondary-btn" @click="handleClose" v-if="!isImporting">
						<text class="secondary-btn-text">取消</text>
					</view>
					<view 
						class="primary-btn" 
						:class="{'primary-btn-disabled': packageInfo.fileName == '' || isImporting}"
						@click="(packageInfo.fileName == '' || isImporting) ? null : handleImport()"
					>
						<text class="primary-btn-text">{{ isImporting ? '导入中...' : '开始导入' }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { PackageManifest, ImportProgress, ImportResult, PackageInfo } from '@/types/data-package.uts'
	import { selectPackageFile, validatePackage, importPackage, ImportProgressCallback } from '@/services/dataPackage.uts'
	// #ifdef WEB
	import { handleDroppedFileWeb } from '@/services/dataPackage.uts'
	// #endif
	import { initDatabase } from '@/services/database.uts'
	
	const emit = defineEmits(['close', 'success'])

	// 状态定义
	const packageInfo = reactive({
		fileName: '',
		fileSize: 0,
		manifest: null as PackageManifest | null,
		isValid: false,
		errorMessage: ''
	} as PackageInfo)
	
	const manifest = ref<PackageManifest | null>(null)
	const isImporting = ref(false)
	const isDbReady = ref(false)
	
	const importProgress = reactive({
		current: 0,
		total: 100,
		currentFile: '',
		status: ''
	} as ImportProgress)
	
	const importResult = ref<ImportResult | null>(null)
	const isDragOver = ref(false)
	const dragErrorMessage = ref('')
	let errorTimer: number | null = null
	
	const isPC = ref(false)
	// #ifdef WEB
	if ((window as any).electronAPI != null) {
		isPC.value = true
	}
	// #endif
	
	/**
	 * 初始化数据库
	 */
	const initDb = () => {
		initDatabase()
			.then((_r: boolean) => {
				isDbReady.value = true
				console.log('数据库初始化成功')
			})
			.catch((e: any | null) => {
				console.error('数据库初始化失败：', e)
				uni.showToast({
					title: '数据库初始化失败',
					icon: 'none'
				})
			})
	}
	
	// 生命周期函数
	onMounted(() => {
		initDb()
	})

	/**
	 * 处理文件解析的核心逻辑
	 */
	const processFile = (info: PackageInfo) => {
		uni.showLoading({ title: '正在提取与解析...', mask: true })
		
		validatePackage('')
			.then((manifestRes: PackageManifest) => {
				uni.hideLoading()
				packageInfo.fileName = info.fileName
				packageInfo.fileSize = info.fileSize
				packageInfo.manifest = manifestRes
				packageInfo.isValid = true
				packageInfo.errorMessage = ''
				manifest.value = manifestRes
			})
			.catch((e: any | null) => {
				uni.hideLoading()
				packageInfo.fileName = ''
				packageInfo.manifest = null
				packageInfo.isValid = false
				const errMsg = e instanceof Error ? e.message : (e != null ? (e as UTSJSONObject)['message'] as string ?? '未知错误' : '未知错误')
				packageInfo.errorMessage = errMsg
				manifest.value = null
				
				importResult.value = {
					success: false,
					message: '解析失败: ' + errMsg,
					nodeCount: 0,
					uiConfigCount: 0,
					resourceCount: 0,
					importTime: 0
				}
				
				uni.showToast({
					title: '数据包解析失败',
					icon: 'none'
				})
			})
	}

	/**
	 * 选择文件
	 */
	const handleSelectFile = () => {
		if (isImporting.value) return
		importResult.value = null
		
		selectPackageFile()
			.then((info: PackageInfo) => {
				processFile(info)
			})
			.catch((e: any | null) => {
				console.error('选择文件失败/取消：', e)
			})
	}
	
	/**
	 * 处理拖拽进入
	 */
	const handleDragOver = (e: any) => {
		// #ifdef WEB
		isDragOver.value = true
		// #endif
	}
	
	/**
	 * 处理拖拽离开
	 */
	const handleDragLeave = (e: any) => {
		// #ifdef WEB
		isDragOver.value = false
		// #endif
	}
	
	/**
	 * 处理文件拖放
	 */
	const handleDrop = (e: any) => {
		// #ifdef WEB
		isDragOver.value = false
		dragErrorMessage.value = ''
		
		const files = (e as DragEvent).dataTransfer?.files
		if (files != null && files.length > 0) {
			const file = files[0]
			if (file.name.endsWith('.srd')) {
				const info = handleDroppedFileWeb(file)
				processFile(info)
			} else {
				dragErrorMessage.value = '仅支持 .srd 格式数据包'
				if (errorTimer != null) clearTimeout(errorTimer!)
				errorTimer = setTimeout(() => {
					dragErrorMessage.value = ''
				}, 3000)
				uni.showToast({ title: '仅支持 .srd 格式数据包', icon: 'none' })
			}
		}
		// #endif
	}
	
	/**
	 * 开始导入
	 */
	const handleImport = () => {
		if (isDbReady.value != true) {
			uni.showToast({ title: '数据库未就绪', icon: 'none' })
			return
		}
		
		if (packageInfo.fileName == '') {
			uni.showToast({ title: '请先选择数据包', icon: 'none' })
			return
		}
		
		isImporting.value = true
		importResult.value = null
		uni.showLoading({ title: '正在提取与导入...', mask: true })
		
		const onProgress: ImportProgressCallback = (progress: ImportProgress) => {
			importProgress.current = progress.current
			importProgress.total = progress.total
			importProgress.currentFile = progress.currentFile
			importProgress.status = progress.status
		}
		
		importPackage('', onProgress)
			.then((result: ImportResult) => {
				uni.hideLoading()
				isImporting.value = false
				uni.showToast({ title: '导入成功', icon: 'success' })
				handleReturnHome()
			})
			.catch((e: any | null) => {
				uni.hideLoading()
				isImporting.value = false
				const errMsg = e instanceof Error ? e.message : (e != null ? (e as UTSJSONObject)['message'] as string ?? '导入失败' : '导入失败')
				const errResult : ImportResult = {
					success: false,
					message: errMsg,
					nodeCount: 0,
					uiConfigCount: 0,
					resourceCount: 0,
					importTime: 0
				}
				importResult.value = errResult
				uni.showToast({ title: '导入失败', icon: 'none' })
			})
	}
	
	/**
	 * 格式化文件大小
	 */
	const formatFileSize = (size: number): string => {
		if (size < 1024) return size.toString() + ' B'
		if (size < 1024 * 1024) return (size / 1024).toFixed(2) + ' KB'
		return (size / 1024 / 1024).toFixed(2) + ' MB'
	}
	
	/**
	 * 格式化时间(短)
	 */
	const formatTimeShort = (isoTime: string | null): string => {
		if (isoTime == null) return '未知'
		try {
			const date = new Date(isoTime)
			const year = date.getFullYear()
			if (Number.isNaN(year)) return '无效'
			const month = (date.getMonth() + 1).toString().padStart(2, '0')
			const day = date.getDate().toString().padStart(2, '0')
			return `${year}-${month}-${day}`
		} catch (e) {
			return '无效'
		}
	}
	
	/**
	 * 点击遮罩/关闭按钮
	 */
	const handleClose = () => {
		if (isImporting.value) return
		emit('close')
	}
	
	/**
	 * 成功导入后返回主页并刷新
	 */
	const handleReturnHome = () => {
		emit('success')
		emit('close')
	}
</script>

<style>
	/* ====== VS Code 风格遮罩与容器 ====== */
	.mask-bg {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}
	
	.modal-container {
		background-color: #FFFFFF;
		width: 100%;
		max-width: 500px;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		/* #ifdef WEB */
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
		/* #endif */
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
		overflow: hidden;
	}
	
	/* ====== 标题栏 ====== */
	.modal-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		background-color: #F8FAFC;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E2E8F0;
	}
	
	.header-left {
		flex-direction: row;
		align-items: center;
	}
	
	.modal-icon {
		width: 18px;
		height: 18px;
		margin-right: 8px;
	}
	
	.modal-title {
		font-size: 13px;
		font-weight: 600;
		color: #374151;
	}
	
	.close-btn {
		padding: 4px;
		border-radius: 4px;
		transition-property: background-color;
		transition-duration: 0.2s;
	}
	
	.close-btn:hover {
		background-color: #E5E7EB;
	}
	
	.close-icon {
		font-size: 12px;
		color: #6B7280;
	}
	
	/* ====== 主体内容区 ====== */
	.modal-body {
		padding: 24px;
		flex-direction: column;
	}
	
	.file-selection-area {
		flex-direction: column;
	}
	
	.drop-zone {
		border-width: 1px;
		border-style: dashed;
		border-color: #D1D5DB;
		background-color: #F9FAFB;
		border-radius: 6px;
		padding: 32px 16px;
		align-items: center;
		justify-content: center;
		transition-property: border-color, background-color;
		transition-duration: 0.2s;
	}
	
	.drop-zone-active {
		border-color: #3B82F6;
		background-color: #EFF6FF;
		border-style: solid;
	}
	
	.drop-icon {
		font-size: 32px;
		margin-bottom: 12px;
	}
	
	.drop-text {
		font-size: 14px;
		color: #6B7280;
		margin-bottom: 16px;
	}
	
	.browse-btn {
		background-color: #3B82F6;
		padding: 6px 16px;
		border-radius: 4px;
	}
	
	.browse-btn-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 500;
	}
	
	.tips-area {
		margin-top: 12px;
	}
	
	.error-tip {
		font-size: 12px;
		color: #EF4444;
	}
	
	/* ====== 详情查看区 ====== */
	.manifest-view {
		flex-direction: column;
	}
	
	.manifest-card {
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
		border-radius: 6px;
		background-color: #FFFFFF;
		flex-direction: column;
	}
	
	.manifest-row {
		padding: 12px 16px;
		flex-direction: column;
	}
	
	.main-row {
		background-color: #F9FAFB;
	}
	
	.manifest-divider {
		height: 1px;
		background-color: #E5E7EB;
	}
	
	.manifest-grid {
		flex-direction: row;
		padding: 12px 16px;
	}
	
	.manifest-col {
		flex: 1;
		flex-direction: column;
	}
	
	.manifest-label {
		font-size: 11px;
		color: #9CA3AF;
		font-weight: 600;
		margin-bottom: 4px;
	}
	
	.manifest-value {
		font-size: 14px;
		color: #111827;
		font-weight: 500;
	}
	
	.primary-value {
		color: #2563EB;
		font-size: 15px;
		font-weight: 600;
	}
	
	.manifest-desc {
		font-size: 13px;
		color: #4B5563;
		line-height: 1.5;
	}
	
	.footer-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	
	.small {
		font-size: 12px;
		color: #6B7280;
	}
	
	.change-link {
		font-size: 12px;
		color: #3B82F6;
		font-weight: 500;
	}
	
	/* ====== 进度条 ====== */
	.progress-container {
		margin-top: 16px;
		flex-direction: column;
	}
	
	.progress-info {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 6px;
	}
	
	.progress-status {
		font-size: 12px;
		color: #4B5563;
	}
	
	.progress-value {
		font-size: 12px;
		color: #3B82F6;
		font-weight: 600;
	}
	
	.progress-bar-bg {
		height: 4px;
		background-color: #E5E7EB;
		border-radius: 2px;
		overflow: hidden;
	}
	
	.progress-bar-fill {
		height: 100%;
		background-color: #3B82F6;
		border-radius: 2px;
	}
	
	/* ====== 错误条 ====== */
	.error-banner {
		margin-top: 16px;
		background-color: #FEF2F2;
		border-width: 1px;
		border-style: solid;
		border-color: #FEE2E2;
		border-radius: 6px;
		padding: 10px 12px;
		flex-direction: row;
		align-items: center;
	}
	
	.error-banner-icon {
		font-size: 14px;
		margin-right: 8px;
	}
	
	.error-banner-text {
		font-size: 12px;
		color: #B91C1C;
		flex: 1;
	}
	
	/* ====== 底部按钮 ====== */
	.modal-footer {
		padding: 12px 16px;
		background-color: #F9FAFB;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E5E7EB;
	}
	
	.footer-actions {
		flex-direction: row;
		justify-content: flex-end;
	}
	
	.secondary-btn {
		padding: 6px 16px;
		margin-right: 8px;
		border-radius: 4px;
		background-color: #FFFFFF;
		border-width: 1px;
		border-style: solid;
		border-color: #D1D5DB;
	}
	
	.secondary-btn-text {
		color: #374151;
		font-size: 13px;
		font-weight: 500;
	}
	
	.primary-btn {
		padding: 6px 20px;
		background-color: #007ACC;
		border-radius: 4px;
	}
	
	.primary-btn-disabled {
		background-color: #94A3B8;
		opacity: 0.6;
	}
	
	.primary-btn-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 500;
	}
</style>

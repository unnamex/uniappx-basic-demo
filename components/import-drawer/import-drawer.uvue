<template>
	<view class="mask-bg" @click.stop="">
		<view class="modal-content" :class="getModalClass()">
			<!-- 头部：标题与关闭按钮 -->
			<view class="modal-header">
				<text class="modal-title">导入数据包</text>
				<view class="close-btn" @click="handleClose" v-if="!isImporting && (importResult == null || importResult!.success != true)">
					<text class="close-icon">✕</text>
				</view>
			</view>

			<!-- 状态一：选择文件及预览区 -->
			<view class="modal-body" v-if="importResult == null || importResult!.success != true">
				
				<!-- 未选择文件 -->
				<view 
					class="file-picker" 
					@click="handleSelectFile" 
					hover-class="file-picker-hover" 
					v-if="packageInfo.fileName == ''"
					:class="{'file-picker-dragging': isDragOver, 'file-picker-error': dragErrorMessage != ''}"
					@dragover.prevent="handleDragOver"
					@dragleave="handleDragLeave"
					@drop.prevent="handleDrop"
				>
					<view class="icon-circle" :style="{backgroundColor: dragErrorMessage != '' ? '#FEF2F2' : ''}">
						<text class="file-picker-icon">{{ dragErrorMessage != '' ? '⚠️' : '📂' }}</text>
					</view>
					<text class="file-picker-title" :style="{color: dragErrorMessage != '' ? '#EF4444' : ''}">
						{{ dragErrorMessage != '' ? dragErrorMessage : (isDragOver ? '松开以选择' : '选择数据包') }}
					</text>
					<text class="file-picker-hint">
						{{ dragErrorMessage != '' ? '请选择正确的 .srd 压缩包' : (isDragOver ? '松开手指自动解析' : '点击或拖拽 .srd 文件至此') }}
					</text>
				</view>

				<!-- 预览：Bento Box Grid -->
				<scroll-view class="bento-scroll" :show-scrollbar="false" v-if="manifest != null">
					<view class="bento-grid">
						<!-- Bento Item 1: 核心信息 (可点击重新挑选) -->
						<view class="bento-item bento-main" @click="handleSelectFile" hover-class="bento-hover">
							<view class="bento-main-left">
								<view class="file-icon-wrapper">
									<text class="file-type-icon">SRD</text>
								</view>
								<view class="file-desc">
									<text class="file-name">{{ manifest!.name }}</text>
									<text class="file-size">{{ formatFileSize(packageInfo.fileSize) }}</text>
								</view>
							</view>
							<text class="change-file-text">更换</text>
						</view>
						
						<!-- Bento Row: 分列数据 -->
						<view class="bento-row">
							<view class="bento-item bento-half" style="margin-right: 8px;">
								<text class="info-label">版本</text>
								<text class="info-value">{{ manifest!.version }}</text>
							</view>
							<view class="bento-item bento-half" style="margin-left: 8px;">
								<text class="info-label">日期</text>
								<text class="info-value">{{ formatTimeShort(manifest!.exportTime) }}</text>
							</view>
						</view>

						<!-- Bento Item 3: 说明信息 -->
						<view class="bento-item bento-full">
							<text class="info-label">说明详情</text>
							<text class="info-desc">{{ manifest!.description != '' ? manifest!.description : '未提供描述信息' }}</text>
						</view>
					</view>
				</scroll-view>

				<!-- 导入进度 -->
				<view class="progress-section" v-if="isImporting">
					<view class="progress-header">
						<text class="progress-title">处理中...</text>
						<text class="progress-percent">{{ Math.floor((importProgress.current / importProgress.total) * 100) }}%</text>
					</view>
					<view class="progress-track">
						<view class="progress-fill" :style="{ width: (importProgress.current / importProgress.total) * 100 + '%' }"></view>
					</view>
					<text class="progress-status">{{ (importProgress.status != '' ? importProgress.status : '正在写入数据...') }}</text>
				</view>

				<!-- 报错信息提炼 -->
				<view class="error-msg" v-if="importResult != null && importResult!.success == false">
					<text class="error-text">{{ importResult!.message }}</text>
				</view>
			</view>

			<!-- 状态二：成功导入 -->
			<view class="modal-body success-body" v-if="importResult != null && importResult!.success == true">
				<view class="success-icon-wrapper">
					<text class="success-icon-symbol">✓</text>
				</view>
				<text class="success-title">导入成功</text>
				<view class="success-stats-box">
					<!-- <text class="success-desc">已导入 {{ importResult!.processCount }} 条数据</text> -->
					<text class="success-desc">耗时 {{ (importResult!.importTime / 1000).toFixed(1) }}s </text>
				</view>
			</view>

			<!-- 底部操作区 -->
			<view class="modal-footer">
				<view 
					class="btn-primary" 
					:hover-class="(packageInfo.fileName == '' || isImporting) ? '' : 'btn-hover'"
					:class="{'btn-disabled': packageInfo.fileName == '' || isImporting}"
					@click="(packageInfo.fileName == '' || isImporting) ? null : handleImport()"
					v-if="importResult == null || importResult!.success != true"
				>
					<text class="btn-text" :class="{'text-disabled': packageInfo.fileName == '' || isImporting}">{{ isImporting ? '导入中' : '确认导入' }}</text>
				</view>
				
				<view 
					class="btn-success" 
					hover-class="btn-hover"
					v-if="importResult != null && importResult!.success == true"
					@click="handleReturnHome"
				>
					<text class="btn-text">完成</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { PackageManifest, ImportProgress, ImportResult, PackageInfo } from '@/types/data-package.uts'
	import { selectPackageFile, validatePackage, importPackage, ImportProgressCallback } from '@/services/dataPackage.uts'
	// #ifdef WEB
	import { handleDroppedFileWeb } from '@/services/dataPackage.uts'
	// #endif
	import { initDatabase } from '@/services/database.uts'
	
	const emit = defineEmits(['close', 'success'])

	// 状态定义
	const packageInfo = reactive({
		fileName: '',
		fileSize: 0,
		manifest: null as PackageManifest | null,
		isValid: false,
		errorMessage: ''
	} as PackageInfo)
	
	const manifest = ref<PackageManifest | null>(null)
	const isImporting = ref(false)
	const isDbReady = ref(false)
	
	const importProgress = reactive({
		current: 0,
		total: 100,
		currentFile: '',
		status: ''
	} as ImportProgress)
	
	const importResult = ref<ImportResult | null>(null)
	const isDragOver = ref(false)
	const dragErrorMessage = ref('')
	let errorTimer: number | null = null
	
	/**
	 * 初始化数据库
	 */
	const initDb = () => {
		initDatabase()
			.then((_r: boolean) => {
				isDbReady.value = true
				console.log('数据库初始化成功')
			})
			.catch((e: any | null) => {
				console.error('数据库初始化失败：', e)
				uni.showToast({
					title: '数据库初始化失败',
					icon: 'none'
				})
			})
	}
	
	// 生命周期函数
	onMounted(() => {
		initDb()
	})
	
	/**
	 * 获取不同平台的容器样式
	 */
	const getModalClass = (): string => {
		// #ifdef WEB
		return 'side-drawer'
		// #endif
		
		// #ifndef WEB
		return 'bottom-sheet'
		// #endif
	}

	/**
	 * 处理文件解析的核心逻辑
	 */
	const processFile = (info: PackageInfo) => {
		// 在这里先呼出 Loading，防止解析期间导致界面坍塌闪烁
		uni.showLoading({ title: '正在提取与解析...', mask: true })
		
		validatePackage('')
			.then((manifestRes: PackageManifest) => {
				uni.hideLoading()
				// 解析成功后，一并赋值，让视图瞬间由“选择文件”切换为“Bento 预览”
				packageInfo.fileName = info.fileName
				packageInfo.fileSize = info.fileSize
				packageInfo.manifest = manifestRes
				packageInfo.isValid = true
				packageInfo.errorMessage = ''
				manifest.value = manifestRes
			})
			.catch((e: any | null) => {
				uni.hideLoading()
				// 解析失败时，恢复未选择状态并给出报错
				packageInfo.fileName = ''
				packageInfo.manifest = null
				packageInfo.isValid = false
				packageInfo.errorMessage = e != null ? (e as UTSJSONObject)['message'] as string ?? '未知错误' : '未知错误'
				manifest.value = null
				
				uni.showToast({
					title: '数据包解析失败',
					icon: 'none'
				})
			})
	}

	/**
	 * 选择文件
	 */
	const handleSelectFile = () => {
		if (isImporting.value) return
		
		// 重置结果
		importResult.value = null
		
		selectPackageFile()
			.then((info: PackageInfo) => {
				processFile(info)
			})
			.catch((e: any | null) => {
				console.error('选择文件失败/取消：', e)
			})
	}
	
	/**
	 * 处理拖拽进入
	 */
	const handleDragOver = (e: any) => {
		// #ifdef WEB
		isDragOver.value = true
		// #endif
	}
	
	/**
	 * 处理拖拽离开
	 */
	const handleDragLeave = (e: any) => {
		// #ifdef WEB
		isDragOver.value = false
		// #endif
	}
	
	/**
	 * 处理文件拖放
	 */
	const handleDrop = (e: any) => {
		// #ifdef WEB
		isDragOver.value = false
		dragErrorMessage.value = ''
		
		const files = (e as DragEvent).dataTransfer?.files
		if (files != null && files.length > 0) {
			const file = files[0]
			if (file.name.endsWith('.srd')) {
				const info = handleDroppedFileWeb(file)
				processFile(info)
			} else {
				// 层级优化：除了 Toast，增加 UI 内部红色预警状态（双保险）
				dragErrorMessage.value = '仅支持 .srd 格式数据包'
				if (errorTimer != null) clearTimeout(errorTimer!)
				errorTimer = setTimeout(() => {
					dragErrorMessage.value = ''
				}, 3000)
				
				uni.showToast({ title: '仅支持 .srd 格式数据包', icon: 'none' })
			}
		}
		// #endif
	}
	
	/**
	 * 开始导入
	 */
	const handleImport = () => {
		if (isDbReady.value != true) {
			uni.showToast({ title: '数据库未就绪', icon: 'none' })
			return
		}
		
		if (packageInfo.fileName == '') {
			uni.showToast({ title: '请先选择数据包', icon: 'none' })
			return
		}
		
		isImporting.value = true
		importResult.value = null
		
		// 呼出系统级 Loading 遮罩，防止卡顿期间无反馈
		uni.showLoading({ title: '正在提取与导入...', mask: true })
		
		const onProgress: ImportProgressCallback = (progress: ImportProgress) => {
			importProgress.current = progress.current
			importProgress.total = progress.total
			importProgress.currentFile = progress.currentFile
			importProgress.status = progress.status
		}
		
		importPackage('', onProgress)
			.then((result: ImportResult) => {
				uni.hideLoading()
				isImporting.value = false
				importResult.value = result
			})
			.catch((e: any | null) => {
				uni.hideLoading()
				isImporting.value = false
				const errResult : ImportResult = {
					success: false,
					message: (e as UTSJSONObject)['message'] as string ?? '导入失败',
					nodeCount: 0,
					uiConfigCount: 0,
					resourceCount: 0,
					importTime: 0
				}
				importResult.value = errResult
				uni.showToast({ title: '导入失败', icon: 'none' })
			})
	}
	
	/**
	 * 格式化文件大小
	 */
	const formatFileSize = (size: number): string => {
		if (size < 1024) return size.toString() + ' B'
		if (size < 1024 * 1024) return (size / 1024).toFixed(2) + ' KB'
		return (size / 1024 / 1024).toFixed(2) + ' MB'
	}
	
	/**
	 * 格式化时间(短)
	 */
	const formatTimeShort = (isoTime: string | null): string => {
		if (isoTime == null) return '未知'
		try {
			const date = new Date(isoTime)
			const year = date.getFullYear()
			if (Number.isNaN(year)) return '无效'
			const month = (date.getMonth() + 1).toString().padStart(2, '0')
			const day = date.getDate().toString().padStart(2, '0')
			return `${year}-${month}-${day}`
		} catch (e) {
			return '无效'
		}
	}
	
	/**
	 * 点击遮罩/关闭按钮
	 */
	const handleClose = () => {
		if (isImporting.value) return
		emit('close')
	}
	
	/**
	 * 成功导入后返回主页并刷新
	 */
	const handleReturnHome = () => {
		emit('success')
		emit('close')
	}
</script>

<style>
	/* ====== 基础遮罩背景 ====== */
	.mask-bg {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(17, 24, 39, 0.4);
		z-index: 900;
	}
	
	/* ====== 条件容器布局 ====== */
	.modal-content {
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}
	
	.bottom-sheet {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		border-top-left-radius: 20px;
		border-top-right-radius: 20px;
		padding-bottom: 24px;
	}
	
	.side-drawer {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		width: 400px;
		/* #ifdef WEB */
		box-shadow: -10px 0 25px rgba(0, 0, 0, 0.1);
		/* #endif */
	}
	
	/* ====== 内部通用布局 ====== */
	.modal-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 20px;
		padding-bottom: 16px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F3F4F6;
	}
	
	.modal-title {
		font-size: 18px;
		font-weight: 700;
		color: #111827;
	}
	
	.close-btn {
		width: 32px;
		height: 32px;
		background-color: #F3F4F6;
		border-radius: 16px;
		justify-content: center;
		align-items: center;
	}
	
	.close-icon {
		font-size: 14px;
		color: #6B7280;
	}
	
	.modal-body {
		padding: 20px;
		flex-direction: column;
		flex: 1;
		/* #ifdef WEB */
		overflow-y: auto;
		/* #endif */
	}
	
	.file-picker {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 30px 20px;
		border-width: 2px;
		border-style: dashed;
		border-color: #D1D5DB;
		transition-property: background-color, border-color;
		transition-duration: 0.2s;
		align-items: center;
	}
	
	.file-picker-hover {
		background-color: #ECFEFF;
		border-color: #0891B2;
	}

	.file-picker-dragging {
		background-color: #ECFEFF;
		border-color: #0891B2;
		border-style: solid;
		transform: scale(1.02);
	}

	.file-picker-error {
		background-color: #FEF2F2 !important;
		border-color: #EF4444 !important;
		border-style: solid;
	}
	
	.icon-circle {
		width: 56px;
		height: 56px;
		background-color: #F0F2F5;
		border-radius: 28px;
		align-items: center;
		justify-content: center;
		margin-bottom: 12px;
	}
	
	.file-picker-icon {
		font-size: 28px;
	}
	
	.file-picker-title {
		font-size: 16px;
		font-weight: bold;
		color: #111827;
		margin-bottom: 6px;
	}
	
	.file-picker-hint {
		font-size: 13px;
		color: #9CA3AF;
	}
	
	.bento-scroll {
		/* #ifndef WEB */
		max-height: 380px;
		/* #endif */
		flex-direction: column;
	}
	
	.bento-grid {
		flex-direction: column;
		width: 100%;
	}
	
	.bento-item {
		background-color: #F8FAFC;
		border-radius: 12px;
		padding: 14px;
		margin-bottom: 12px;
		flex-direction: column;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E8F0;
	}
	
	.bento-hover {
		opacity: 0.8;
	}
	
	.bento-main {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	
	.bento-main-left {
		flex-direction: row;
		align-items: center;
	}
	
	.file-icon-wrapper {
		width: 44px;
		height: 44px;
		background-color: #ECFEFF;
		border-radius: 10px;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}
	
	.file-type-icon {
		color: #0891B2;
		font-size: 13px;
		font-weight: 700;
	}
	
	.file-desc {
		flex-direction: column;
	}
	
	.file-name {
		font-size: 15px;
		color: #0F172A;
		font-weight: bold;
		margin-bottom: 2px;
	}
	
	.file-size {
		font-size: 12px;
		color: #64748B;
	}
	
	.change-file-text {
		font-size: 12px;
		color: #0891B2;
		background-color: #CFFAFE;
		padding: 4px 10px;
		border-radius: 100px;
		font-weight: 600;
	}
	
	.bento-row {
		flex-direction: row;
		width: 100%;
		justify-content: space-between;
	}
	
	.bento-half {
		flex: 1;
	}
	
	.bento-full {
		width: 100%;
	}
	
	.info-label {
		color: #64748B;
		font-size: 12px;
		margin-bottom: 4px;
	}
	
	.info-value {
		color: #0F172A;
		font-size: 15px;
		font-weight: 600;
	}
	
	.info-desc {
		color: #334155;
		font-size: 13px;
		line-height: 1.4em;
	}
	
	.progress-section {
		margin-top: 8px;
		flex-direction: column;
	}
	
	.progress-header {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 8px;
	}
	
	.progress-title {
		font-size: 13px;
		color: #0F172A;
		font-weight: 600;
	}
	
	.progress-percent {
		font-size: 13px;
		color: #0891B2;
		font-weight: 700;
	}
	
	.progress-track {
		height: 8px;
		background-color: #E2E8F0;
		border-radius: 100px;
		overflow: hidden;
		margin-bottom: 8px;
	}
	
	.progress-fill {
		height: 100%;
		background-color: #0891B2;
		border-radius: 100px;
	}
	
	.progress-status {
		font-size: 12px;
		color: #64748B;
		/* #ifdef WEB */
		text-align: center;
		/* #endif */
	}
	
	.error-msg {
		background-color: #FEF2F2;
		padding: 12px;
		border-radius: 8px;
		margin-top: 12px;
		border-left-width: 4px;
		border-left-style: solid;
		border-left-color: #EF4444;
	}
	
	.error-text {
		color: #B91C1C;
		font-size: 13px;
	}
	
	.success-body {
		align-items: center;
		padding-top: 30px;
		padding-bottom: 30px;
	}
	
	.success-icon-wrapper {
		width: 72px;
		height: 72px;
		background-color: #D1FAE5;
		border-radius: 36px;
		align-items: center;
		justify-content: center;
		margin-bottom: 20px;
	}
	
	.success-icon-symbol {
		font-size: 36px;
		color: #059669;
		font-weight: bold;
	}
	
	.success-title {
		font-size: 20px;
		font-weight: 700;
		color: #0F172A;
		margin-bottom: 12px;
	}
	
	.success-stats-box {
		background-color: #F8FAFC;
		padding: 12px 20px;
		border-radius: 12px;
		align-items: center;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E8F0;
	}
	
	.success-desc {
		font-size: 14px;
		color: #475569;
		margin-bottom: 4px;
	}
	
	.modal-footer {
		padding: 16px 20px;
		background-color: #F8FAFC;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E2E8F0;
		width: 100%;
		border-radius: 0;
	}
	
	.btn-primary {
		background-color: #0891B2;
		border-radius: 12px;
		height: 48px;
		justify-content: center;
		align-items: center;
		border-width: 0;
		flex-direction: row;
	}
	
	.btn-success {
		background-color: #059669;
		border-radius: 12px;
		height: 48px;
		justify-content: center;
		align-items: center;
		border-width: 0;
		flex-direction: row;
	}
	
	.btn-disabled {
		background-color: #E2E8F0;
	}
	
	.btn-hover {
		opacity: 0.9;
		/* #ifdef WEB */
		transform: scale(0.98);
		/* #endif */
	}
	
	.btn-text {
		color: #FFFFFF;
		font-size: 16px;
		font-weight: bold;
	}
	
	.text-disabled {
		color: #94A3B8;
	}
</style>

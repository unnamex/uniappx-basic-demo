<template>
	<view class="ai-panel-root">
		<!-- 针对 PC 端的标题栏占位，防止与窗口系统按钮重叠（仅非全屏时显示） -->
		<view v-if="isPC && !isFullscreen" style="height: 36px; background-color: #FFFFFF; border-bottom: 1px solid #E2E8F0; -webkit-app-region: drag; flex: none;"></view>

		<!-- 头部（全屏时兼作系统的标题栏拖拽区） -->
		<view class="aip-header" :style="{ '-webkit-app-region': (isPC && isFullscreen) ? 'drag' : 'none', paddingRight: '14px' }">
			<view class="aip-header-left" style="-webkit-app-region: no-drag;">
				<view class="aip-mode-badge">
					<text class="aip-mode-badge-text">AI</text>
				</view>
				<text class="aip-title">工艺助手</text>
				<view class="aip-status-pill" :class="isOnline ? 'aip-pill-online' : 'aip-pill-offline'">
					<view class="aip-status-dot" :class="isOnline ? 'aip-dot-online' : 'aip-dot-offline'"></view>
					<text class="aip-status-text">{{ isOnline ? '在线' : '离线' }}</text>
				</view>
			</view>
			<view class="aip-header-actions" style="-webkit-app-region: no-drag;">
				<view class="aip-action-btn" v-if="currentNodeName != '' && !isAnalyzing" @click="reAnalyze">
					<text class="aip-action-icon">↺</text>
				</view>
				<view class="aip-action-btn" @click="$emit('toggle-fullscreen')">
					<text class="aip-action-icon" style="font-size: 14px;">{{ isFullscreen ? '✕' : '⛶' }}</text>
				</view>
			</view>
		</view>

		<view class="aip-node-card" v-if="currentNodeName != ''">
			<view class="aip-node-card-inner">
				<view class="aip-node-type-badge" :class="nodeTypeBadgeClass">
					<text class="aip-node-type-text">{{ currentNodeTypeLabel }}</text>
				</view>
				<text class="aip-node-name" :numberOfLines="2">{{ currentNodeName }}</text>
			</view>
			<view class="aip-analyzing-row" v-if="isAnalyzing">
				<view class="aip-typing-indicator">
					<view class="aip-typing-dot" ref="dot1Ref"></view>
					<view class="aip-typing-dot" ref="dot2Ref"></view>
					<view class="aip-typing-dot" ref="dot3Ref"></view>
				</view>
				<text class="aip-analyzing-text">{{ analyzingStatusText }}</text>
			</view>
		</view>

		<view class="aip-seg-bar" v-if="currentNodeName != ''">
			<view class="aip-seg-item" :class="activeTab == 'chat' ? 'aip-seg-active' : ''" @click="activeTab = 'chat'">
				<image src="/static/icons/industrial/analysis.svg" class="aip-ind-icon" :style="{ opacity: activeTab == 'chat' ? 1 : 0.6 }" mode="aspectFit" />
				<text class="aip-seg-text" :class="activeTab == 'chat' ? 'aip-seg-text-active' : ''">智能分析</text>
			</view>
			<view class="aip-seg-item" :class="activeTab == 'quality' ? 'aip-seg-active' : ''" @click="activeTab = 'quality'">
				<image src="/static/icons/industrial/quality.svg" class="aip-ind-icon" :style="{ opacity: activeTab == 'quality' ? 1 : 0.6 }" mode="aspectFit" />
				<text class="aip-seg-text" :class="activeTab == 'quality' ? 'aip-seg-text-active' : ''">质检</text>
			</view>
			<view class="aip-seg-item" :class="activeTab == 'record' ? 'aip-seg-active' : ''" @click="switchToRecordTab">
				<image src="/static/icons/industrial/record.svg" class="aip-ind-icon" :style="{ opacity: activeTab == 'record' ? 1 : 0.6 }" mode="aspectFit" />
				<text class="aip-seg-text" :class="activeTab == 'record' ? 'aip-seg-text-active' : ''">记录</text>
			</view>
		</view>

		<view class="aip-guide" v-if="currentNodeName == '' && !isAnalyzing">
			<image src="/static/icons/industrial/auto-parse.svg" class="aip-guide-icon" mode="aspectFit" />
			<text class="aip-guide-title">自动解析模式</text>
			<text class="aip-guide-desc">选中左侧节点，系统将自动解析该节点的工艺要点。</text>
		</view>

		<!-- ====== 智能分析 Tab 内容 ====== -->
		<!-- #ifdef WEB -->
		<view class="aip-content-scroll" style="flex: 1; overflow-y: auto; overflow-x: hidden;" v-if="activeTab == 'chat'">
		<!-- #endif -->
		<!-- #ifndef WEB -->
		<scroll-view class="aip-content-scroll" scroll-y="true" :scroll-top="scrollTop" :show-scrollbar="false" v-if="activeTab == 'chat'">
		<!-- #endif -->
			<view class="aip-content-inner">
			<view v-if="isAnalyzing && analysisData == null && analysisRawText == ''" class="aip-skeleton-card">
				<view class="aip-skeleton-line"></view>
				<view class="aip-skeleton-line"></view>
				<view class="aip-skeleton-line-short"></view>
			</view>

			<template v-if="analysisData != null">
				<view class="aip-card" v-if="analysisData!.summary != ''">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-blue"></view>
					<image src="/static/icons/industrial/summary.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">分析总结</text>
				  </view>
				  <text class="aip-card-text">{{ analysisData!.summary }}</text>
				</view>

				<view class="aip-card" v-if="analysisData!.keyPoints.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-purple"></view>
					<image src="/static/icons/industrial/keypoints.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">操作要点</text>
				  </view>
				  <view v-for="(kp, idx) in analysisData!.keyPoints" :key="idx" class="aip-diag-list-item">
					<text class="aip-diag-bullet">●</text>
					<text class="aip-diag-item-text">{{ kp }}</text>
				  </view>
				</view>

				<view class="aip-card" v-if="analysisData!.risks.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-red"></view>
					<image src="/static/icons/industrial/risks.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">风险预警</text>
				  </view>
				  <view v-for="(risk, idx) in analysisData!.risks" :key="idx" class="aip-risk-item">
					<view class="aip-risk-badge" :class="risk.level == 'high' ? 'aip-risk-high' : risk.level == 'medium' ? 'aip-risk-medium' : 'aip-risk-low'">
						<text :class="risk.level == 'high' ? 'aip-risk-high-text' : risk.level == 'medium' ? 'aip-risk-medium-text' : 'aip-risk-low-text'">
							{{ risk.level == 'high' ? '高风险' : risk.level == 'medium' ? '中风险' : '低风险' }}
						</text>
					</view>
					<text class="aip-risk-desc">{{ risk.desc }}</text>
				  </view>
				</view>

				<view class="aip-card" v-if="analysisData!.params.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-cyan"></view>
					<image src="/static/icons/industrial/params.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">工艺参数</text>
				  </view>
				  <view class="aip-param-header">
					<text class="aip-param-cell aip-param-label">参数名</text>
					<text class="aip-param-cell aip-param-label">推荐值</text>
					<text class="aip-param-cell aip-param-label">允许范围</text>
				  </view>
				  <view v-for="(p, idx) in analysisData!.params" :key="idx" class="aip-param-row">
					<text class="aip-param-cell aip-param-name">{{ p.name }}</text>
					<text class="aip-param-cell aip-param-value">{{ p.recommend }}</text>
					<text class="aip-param-cell aip-param-range">{{ p.range }}</text>
				  </view>
				</view>

				<view class="aip-card" v-if="analysisData!.checklist.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-green"></view>
					<image src="/static/icons/industrial/checklist.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">检查清单</text>
				  </view>
				  <view v-for="(item, idx) in analysisData!.checklist" :key="idx" class="aip-check-item" @click="toggleChecklist(idx)">
					<text class="aip-check-icon" :class="checklistStates.length > idx && checklistStates[idx] ? 'aip-check-done' : ''">
						{{ (checklistStates.length > idx && checklistStates[idx]) ? '☑' : '☐' }}
					</text>
					<text class="aip-check-text" :class="checklistStates.length > idx && checklistStates[idx] ? 'aip-check-done' : ''">{{ item }}</text>
				  </view>
				</view>

				<view class="aip-card" v-if="analysisData!.faq.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-amber"></view>
					<image src="/static/icons/industrial/faq.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">常见问题</text>
				  </view>
				  <view v-for="(f, idx) in analysisData!.faq" :key="idx" class="aip-faq-item">
					<view class="aip-faq-q" @click="toggleFaq(idx)">
						<text class="aip-faq-q-text">Q: {{ f.q }}</text>
						<text class="aip-faq-arrow">{{ expandedFaqIndex == idx ? '▼' : '▶' }}</text>
					</view>
					<view class="aip-faq-a" v-if="expandedFaqIndex == idx">
						<text class="aip-faq-a-text">A: {{ f.a }}</text>
					</view>
				  </view>
				</view>

				<view class="aip-card" v-if="analysisData!.suggestions.length > 0">
				  <view class="aip-card-header">
					<view class="aip-card-bar aip-bar-blue"></view>
					<image src="/static/icons/industrial/suggestions.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-card-title">快捷追问</text>
				  </view>
				  <view class="aip-chip-row">
					<view v-for="(sug, idx) in analysisData!.suggestions" :key="idx" class="aip-chip" @click="sendSuggestion(sug)">
						<text class="aip-chip-text">{{ sug }}</text>
					</view>
				  </view>
				</view>
			</template>

			<view class="aip-card" v-if="analysisRawText != '' && analysisData == null">
				<text class="aip-card-text">{{ analysisRawText }}</text>
			</view>

			<view v-if="followUpMessages.length > 0" class="aip-followup-section">
				<view class="aip-section-divider">
					<view class="aip-divider-line"></view>
					<text class="aip-divider-text">追问记录</text>
					<view class="aip-divider-line"></view>
				</view>
				<view v-for="(msg, idx) in followUpMessages" :key="idx"
					class="aip-msg-item" :class="msg.role == 'user' ? 'aip-msg-user' : 'aip-msg-ai'"
					v-show="msg.content != ''">
					<view class="aip-msg-bubble" :class="msg.role == 'user' ? 'aip-bubble-user' : 'aip-bubble-ai'">
						<text class="aip-msg-text" :class="msg.role == 'user' ? 'aip-text-user' : 'aip-text-ai'">{{ msg.content }}</text>
					</view>
					<text class="aip-msg-time" :class="msg.role == 'user' ? 'aip-time-user' : 'aip-time-ai'">{{ msg.time }}</text>
				</view>
				<!-- 追问加载态 -->
				<view class="aip-msg-item aip-msg-ai" v-if="isFollowUpTyping && (followUpMessages.length == 0 || followUpMessages[followUpMessages.length - 1].content == '')">
					<view class="aip-msg-bubble aip-bubble-ai aip-typing-bubble">
						<view class="aip-typing-indicator">
							<view class="aip-typing-dot" ref="dot4Ref"></view>
							<view class="aip-typing-dot" ref="dot5Ref"></view>
							<view class="aip-typing-dot" ref="dot6Ref"></view>
						</view>
						<text class="aip-typing-label">{{ followUpStatusText }}</text>
					</view>
					<text v-if="followUpMessages.length > 0" class="aip-msg-time aip-time-ai">{{ followUpMessages[followUpMessages.length - 1].time }}</text>
				</view>
			</view>

			<view class="aip-offline-tip" v-if="currentNodeName != '' && !isOnline && analysisData == null && analysisRawText == '' && !isAnalyzing">
				<image src="/static/icons/industrial/offline.svg" class="aip-offline-icon" mode="aspectFit" />
				<text class="aip-offline-text">服务未连接，请确认本地服务已启动。</text>
			</view>

			<view class="aip-content-footer"></view>
			</view>
		<!-- #ifdef WEB -->
		</view>
		<!-- #endif -->
		<!-- #ifndef WEB -->
		</scroll-view>
		<!-- #endif -->

		<!-- ====== 质检 Tab 内容 ====== -->
		<!-- #ifdef WEB -->
		<view class="aip-content-scroll" style="flex: 1; overflow-y: auto; overflow-x: hidden;" v-if="activeTab == 'quality'">
		<!-- #endif -->
		<!-- #ifndef WEB -->
		<scroll-view class="aip-content-scroll" scroll-y="true" :show-scrollbar="false" v-if="activeTab == 'quality'">
		<!-- #endif -->
			<view class="aip-content-inner">
			<view class="aip-quality-section">
				<view class="aip-quick-diag-row">
					<view class="aip-quick-diag-btn" @click="sendQualityQuery('表面粗糙度不达标')">
						<text class="aip-quick-diag-text">表面粗糙度不达标</text>
					</view>
					<view class="aip-quick-diag-btn" @click="sendQualityQuery('尺寸超差')">
						<text class="aip-quick-diag-text">尺寸超差</text>
					</view>
					<view class="aip-quick-diag-btn" @click="sendQualityQuery('刀具异常磨损')">
						<text class="aip-quick-diag-text">刀具异常磨损</text>
					</view>
				</view>
				
				<view class="aip-quality-input-area">
					<input class="aip-quality-input" v-model="qualitySymptom" placeholder="描述遇到的缺陷或问题..." @confirm="doQualityCheck(qualitySymptom)" />
					<view class="aip-quality-btn" @click="doQualityCheck(qualitySymptom)">
						<text class="aip-quality-btn-text">诊断</text>
					</view>
				</view>

				<view v-if="isQualityChecking" class="aip-skeleton-card">
					<view class="aip-skeleton-line"></view>
					<view class="aip-skeleton-line-short"></view>
				</view>

				<view class="aip-diag-result-card" v-if="qualityResult != null && !isQualityChecking">
					<text class="aip-diag-title">🩺 诊断结论</text>
					<text class="aip-diag-text">{{ qualityResult!.diagnosis }}</text>

					<text class="aip-diag-title" style="margin-top: 12px;">🔍 可能原因</text>
					<view v-for="(item, idx) in qualityResult!.possibleCauses" :key="idx" class="aip-diag-list-item">
						<text class="aip-diag-bullet">●</text>
						<text class="aip-diag-item-text">{{ item }}</text>
					</view>

					<text class="aip-diag-title" style="margin-top: 12px;">🛠️ 解决方案</text>
					<view v-for="(item, idx) in qualityResult!.solutions" :key="idx" class="aip-diag-list-item">
						<text class="aip-diag-bullet">●</text>
						<text class="aip-diag-item-text">{{ item }}</text>
					</view>

					<text class="aip-diag-title" style="margin-top: 12px;">🛡️ 预防措施</text>
					<view v-for="(item, idx) in qualityResult!.preventionTips" :key="idx" class="aip-diag-list-item">
						<text class="aip-diag-bullet">●</text>
						<text class="aip-diag-item-text">{{ item }}</text>
					</view>
				</view>
			</view>
			<view class="aip-content-footer"></view>
			</view>
		<!-- #ifdef WEB -->
		</view>
		<!-- #endif -->
		<!-- #ifndef WEB -->
		</scroll-view>
		<!-- #endif -->

		<!-- ====== 记录 Tab 内容 ====== -->
		<!-- #ifdef WEB -->
		<view class="aip-content-scroll" style="flex: 1; overflow-y: auto; overflow-x: hidden;" v-if="activeTab == 'record'">
		<!-- #endif -->
		<!-- #ifndef WEB -->
		<scroll-view class="aip-content-scroll" scroll-y="true" :show-scrollbar="false" v-if="activeTab == 'record'">
		<!-- #endif -->
			<view class="aip-content-inner">
			<!-- 统计概览卡片 -->
			<view class="aip-stat-card" v-if="nodeRecords.length > 0">
				<view class="aip-stat-header">
					<image src="/static/icons/industrial/overview.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-stat-title">问题概览</text>
				</view>
				<view class="aip-stat-row">
					<view class="aip-stat-item">
						<text class="aip-stat-num aip-stat-open">{{ openCount }}</text>
						<text class="aip-stat-label">待处理</text>
					</view>
					<view class="aip-stat-divider"></view>
					<view class="aip-stat-item">
						<text class="aip-stat-num aip-stat-resolved">{{ resolvedCount }}</text>
						<text class="aip-stat-label">已解决</text>
					</view>
					<view class="aip-stat-divider"></view>
					<view class="aip-stat-item">
						<text class="aip-stat-num aip-stat-total">{{ nodeRecords.length }}</text>
						<text class="aip-stat-label">总计</text>
					</view>
				</view>
				<view class="aip-stat-severity-row">
					<view class="aip-stat-sev-item">
						<view class="aip-sev-dot" style="background-color: #EF4444;"></view>
						<text class="aip-sev-critical-text">严重 {{ criticalCount }}</text>
					</view>
					<view class="aip-stat-sev-item">
						<view class="aip-sev-dot" style="background-color: #F59E0B;"></view>
						<text class="aip-sev-major-text">一般 {{ majorCount }}</text>
					</view>
					<view class="aip-stat-sev-item">
						<view class="aip-sev-dot" style="background-color: #10B981;"></view>
						<text class="aip-sev-minor-text">轻微 {{ minorCount }}</text>
					</view>
				</view>
			</view>

			<!-- 记录工作区头部 -->
			<view class="aip-rec-header">
				<view class="aip-rec-header-left">
					<image src="/static/icons/industrial/workspace.svg" class="aip-card-icon" mode="aspectFit" />
					<text class="aip-rec-title">记录工作区</text>
					<text class="aip-rec-count">{{ filteredRecords.length }} 条记录</text>
				</view>
				<view class="aip-rec-export-btn" v-if="nodeRecords.length > 0" @click="exportRecords">
					<image src="/static/icons/industrial/export.svg" class="aip-export-icon" mode="aspectFit" />
				</view>
			</view>

			<!-- 筛选栏 -->
			<view class="aip-filter-section" v-if="nodeRecords.length > 0">
				<view class="aip-filter-row">
					<view class="aip-filter-chip" :class="recordFilter == 'all' ? 'aip-filter-active' : ''" @click="recordFilter = 'all'">
						<text class="aip-filter-chip-text" :class="recordFilter == 'all' ? 'aip-filter-text-active' : ''">全部</text>
					</view>
					<view class="aip-filter-chip" :class="recordFilter == 'open' ? 'aip-filter-active' : ''" @click="recordFilter = 'open'">
						<text class="aip-filter-chip-text" :class="recordFilter == 'open' ? 'aip-filter-text-active' : ''">待处理</text>
					</view>
					<view class="aip-filter-chip" :class="recordFilter == 'resolved' ? 'aip-filter-active' : ''" @click="recordFilter = 'resolved'">
						<text class="aip-filter-chip-text" :class="recordFilter == 'resolved' ? 'aip-filter-text-active' : ''">已解决</text>
					</view>
				</view>
				<view class="aip-filter-row" style="margin-top: 4px;">
					<view class="aip-filter-chip" :class="categoryFilter == 'all' ? 'aip-filter-active' : ''" @click="categoryFilter = 'all'">
						<text class="aip-filter-chip-text" :class="categoryFilter == 'all' ? 'aip-filter-text-active' : ''">全部分类</text>
					</view>
					<view class="aip-filter-chip" :class="categoryFilter == 'quality' ? 'aip-filter-active' : ''" @click="categoryFilter = 'quality'">
						<text class="aip-filter-chip-text" :class="categoryFilter == 'quality' ? 'aip-filter-text-active' : ''">质量</text>
					</view>
					<view class="aip-filter-chip" :class="categoryFilter == 'equipment' ? 'aip-filter-active' : ''" @click="categoryFilter = 'equipment'">
						<text class="aip-filter-chip-text" :class="categoryFilter == 'equipment' ? 'aip-filter-text-active' : ''">设备</text>
					</view>
					<view class="aip-filter-chip" :class="categoryFilter == 'process' ? 'aip-filter-active' : ''" @click="categoryFilter = 'process'">
						<text class="aip-filter-chip-text" :class="categoryFilter == 'process' ? 'aip-filter-text-active' : ''">工艺</text>
					</view>
					<view class="aip-filter-chip" :class="categoryFilter == 'safety' ? 'aip-filter-active' : ''" @click="categoryFilter = 'safety'">
						<text class="aip-filter-chip-text" :class="categoryFilter == 'safety' ? 'aip-filter-text-active' : ''">安全</text>
					</view>
				</view>
			</view>

			<!-- 记录列表 -->
			<view v-if="filteredRecords.length > 0" class="aip-rec-list">
				<view v-for="(rec, rIdx) in filteredRecords" :key="rIdx" class="aip-rec-card-v2">
					<view class="aip-rec-color-bar" :class="rec.severity == 'critical' ? 'aip-color-critical' : rec.severity == 'major' ? 'aip-color-major' : 'aip-color-minor'"></view>
					<view class="aip-rec-card-body">
						<view class="aip-rec-card-top">
							<view class="aip-rec-badges">
								<view class="aip-rec-cat-badge" :class="'aip-cat-' + rec.category">
									<image :src="'/static/icons/industrial/cat-' + rec.category + '.svg'" class="aip-ind-icon" mode="aspectFit" />
									<text class="aip-rec-cat-text">{{ getCategoryLabel(rec.category) }}</text>
								</view>
								<view class="aip-rec-sev-badge" :class="'aip-sev-' + rec.severity">
									<text class="aip-rec-sev-text">{{ getSeverityLabel(rec.severity) }}</text>
								</view>
							</view>
						</view>
						<view class="aip-rec-node-row" v-if="rec.nodeName != ''">
							<image src="/static/icons/industrial/pin.svg" class="aip-ind-icon" mode="aspectFit" />
							<text class="aip-rec-node-text">[{{ getNodeTypeLabel(rec.nodeType) }}] {{ rec.nodeName }}</text>
						</view>
						<text class="aip-rec-card-content-v2">{{ rec.content }}</text>
						<view class="aip-rec-card-bottom">
							<view style="flex-direction: row; align-items: center;">
								<image src="/static/icons/industrial/time.svg" class="aip-ind-icon" mode="aspectFit" />
								<text class="aip-rec-card-time-v2">{{ rec.displayTime }}</text>
							</view>
							<view class="aip-rec-actions">
								<view class="aip-rec-status-btn" :class="rec.status == 'resolved' ? 'aip-status-resolved' : 'aip-status-open'" @click="toggleRecordStatus(rIdx)">
									<view v-if="rec.status == 'resolved'" class="aip-sev-dot" style="background-color: #10B981; margin-right: 4px;"></view>
									<image v-else src="/static/icons/industrial/pending.svg" class="aip-ind-icon" mode="aspectFit" />
									<text class="aip-rec-status-text" :class="rec.status == 'resolved' ? 'aip-status-resolved-text' : 'aip-status-open-text'">{{ rec.status == 'resolved' ? '已解决' : '待处理' }}</text>
								</view>
								<view class="aip-rec-del-btn" @click="deleteFilteredRecord(rIdx)">
									<image src="/static/icons/industrial/delete.svg" class="aip-ind-icon" mode="aspectFit" />
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 记录空状态 -->
			<view v-if="filteredRecords.length == 0" class="aip-rec-empty">
				<image src="/static/icons/industrial/record.svg" class="aip-offline-icon" mode="aspectFit" />
				<text class="aip-rec-empty-title">{{ nodeRecords.length == 0 ? '暂无记录' : '无匹配记录' }}</text>
				<text class="aip-rec-empty-desc">{{ nodeRecords.length == 0 ? '切换到记录模式，选择分类后输入内容即可记录。' : '调整筛选条件查看其他记录。' }}</text>
			</view>

			<view class="aip-content-footer"></view>
			</view>
		<!-- #ifdef WEB -->
		</view>
		<!-- #endif -->
		<!-- #ifndef WEB -->
		</scroll-view>
		<!-- #endif -->


		<!-- 底部输入区（仅在聊天或记录页） -->
		<view class="aip-input-area" v-if="currentNodeName != '' && activeTab != 'quality'">
			<!-- 记录模式：分类和等级选择 -->
			<view class="aip-record-selectors" v-if="inputMode == 'record'">
				<view class="aip-record-tags-wrapper">
					<view class="aip-cat-select-row">
						<view class="aip-cat-btn" :class="selectedCategory == 'quality' ? 'aip-cat-btn-active aip-cat-quality' : ''" @click="selectCategory('quality')">
							<text class="aip-cat-btn-text">质量</text>
						</view>
						<view class="aip-cat-btn" :class="selectedCategory == 'equipment' ? 'aip-cat-btn-active aip-cat-equipment' : ''" @click="selectCategory('equipment')">
							<text class="aip-cat-btn-text">设备</text>
						</view>
						<view class="aip-cat-btn" :class="selectedCategory == 'process' ? 'aip-cat-btn-active aip-cat-process' : ''" @click="selectCategory('process')">
							<text class="aip-cat-btn-text">工艺</text>
						</view>
						<view class="aip-cat-btn" :class="selectedCategory == 'safety' ? 'aip-cat-btn-active aip-cat-safety' : ''" @click="selectCategory('safety')">
							<text class="aip-cat-btn-text">安全</text>
						</view>
						<view class="aip-cat-btn" :class="selectedCategory == 'material' ? 'aip-cat-btn-active aip-cat-material' : ''" @click="selectCategory('material')">
							<text class="aip-cat-btn-text">物料</text>
						</view>
					</view>
					<view class="aip-sev-select-row">
					<view class="aip-sev-btn" :class="selectedSeverity == 'critical' ? 'aip-sev-btn-critical' : ''" @click="selectSeverity('critical')">
						<view class="aip-sev-dot" style="background-color: #EF4444;"></view>
						<text class="aip-sev-btn-text" :class="selectedSeverity == 'critical' ? 'aip-sev-btn-text-active' : ''">严重</text>
					</view>
					<view class="aip-sev-btn" :class="selectedSeverity == 'major' ? 'aip-sev-btn-major' : ''" @click="selectSeverity('major')">
						<view class="aip-sev-dot" style="background-color: #F59E0B;"></view>
						<text class="aip-sev-btn-text" :class="selectedSeverity == 'major' ? 'aip-sev-btn-text-active' : ''">一般</text>
					</view>
					<view class="aip-sev-btn" :class="selectedSeverity == 'minor' ? 'aip-sev-btn-minor' : ''" @click="selectSeverity('minor')">
						<view class="aip-sev-dot" style="background-color: #10B981;"></view>
						<text class="aip-sev-btn-text" :class="selectedSeverity == 'minor' ? 'aip-sev-btn-text-active' : ''">轻微</text>
					</view>
				</view>
				</view>
			</view>
			<view class="aip-input-wrapper">
				<textarea class="aip-input"
					v-model="inputValue"
					:placeholder="inputMode == 'ask' ? '请输入问题...' : '输入记录内容...'"
					placeholder-style="color: #94A3B8"
					:auto-height="true"
					:maxlength="-1"
					confirm-type="send"
					@confirm="handleSend" />
				<view class="aip-input-footer">
					<view class="aip-mode-toggle" :class="inputMode == 'ask' ? 'aip-mode-ask' : 'aip-mode-record'" @click="toggleInputMode">
						<image v-if="inputMode == 'ask'" src="/static/icons/industrial/mode-ask.svg" class="aip-mode-icon" mode="aspectFit" />
						<image v-if="inputMode == 'record'" src="/static/icons/industrial/mode-record.svg" class="aip-mode-icon" mode="aspectFit" />
					</view>
					<view class="aip-action-btns">
						<view class="aip-stop-btn" v-if="isFollowUpTyping" @click="stopChatGeneration">
							<view class="aip-stop-square"></view>
						</view>
						<view class="aip-send-btn-circle" v-else :class="sendBtnClass" @click="handleSend">
							<image src="/static/icons/industrial/send.svg" class="aip-send-arrow-svg" mode="aspectFit" />
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, onMounted, defineExpose } from 'vue'

	type MsgItem = {
		role: string
		content: string
		time: string
	}

	type NodeRecord = {
		nodeId: string
		nodeName: string
		nodeType: string
		content: string
		timestamp: string
		displayTime: string
		category: string
		severity: string
		status: string
	}

	type RiskItem = {
		level: string
		desc: string
	}

	type ParamItem = {
		name: string
		recommend: string
		range: string
	}

	type FAQItem = {
		q: string
		a: string
	}

	type AnalysisData = {
		summary: string
		keyPoints: string[]
		risks: RiskItem[]
		params: ParamItem[]
		checklist: string[]
		faq: FAQItem[]
		suggestions: string[]
	}

	type QualityDiagnosis = {
		diagnosis: string
		possibleCauses: string[]
		solutions: string[]
		preventionTips: string[]
	}

	type Props = {
		processName: string
		isPC?: boolean
		isFullscreen?: boolean
	}
	const props = withDefaults(defineProps<Props>(), {
		processName: '',
		isPC: false,
		isFullscreen: false
	})
	const emit = defineEmits(['toggle-fullscreen'])

	const AI_BASE_URL = 'http://localhost:3001'

	const currentNodeName = ref('')
	const currentNodeTypeRaw = ref('')
	const currentNodeId = ref('')
	const isAnalyzing = ref(false)
	
	const analysisData = ref<AnalysisData | null>(null)
	const analysisRawText = ref('')
	const checklistStates = ref<boolean[]>([])
	const expandedFaqIndex = ref(-1)
	const prefetchCache = ref(new Map<string, AnalysisData>())

	const qualitySymptom = ref('')
	const qualityResult = ref<QualityDiagnosis | null>(null)
	const isQualityChecking = ref(false)
	const isFollowUpTyping = ref(false)
	const currentChatReqTask = ref<RequestTask | null>(null)

	const stopChatGeneration = () => {
		if (currentChatReqTask.value != null) {
			currentChatReqTask.value!.abort()
			currentChatReqTask.value = null
		}
		isFollowUpTyping.value = false
	}
	
	const isOnline = ref(false)
	const scrollTop = ref(0)
	const inputValue = ref('')
	const followUpMessages = ref([] as MsgItem[])

	const inputMode = ref('ask')
	const activeTab = ref('chat')
	const nodeRecords = ref([] as NodeRecord[])

	// 记录模块状态
	const selectedCategory = ref('')
	const selectedSeverity = ref('minor')
	const recordFilter = ref('all')
	const categoryFilter = ref('all')

	const dot1Ref = ref<UniElement | null>(null)
	const dot2Ref = ref<UniElement | null>(null)
	const dot3Ref = ref<UniElement | null>(null)
	const dot4Ref = ref<UniElement | null>(null)
	const dot5Ref = ref<UniElement | null>(null)
	const dot6Ref = ref<UniElement | null>(null)

	let analyzeTimer: number = -1

	const analyzingElapsed = ref(0)
	let elapsedTimer: number = -1

	const analyzingStatusText = computed((): string => {
		const s = (analyzingElapsed.value / 1000).toFixed(1)
		return `AI 解析中 ${s}s`
	})

	const followUpElapsed = ref(0)
	let followUpTimer: number = -1

	const followUpStatusText = computed((): string => {
		const s = (followUpElapsed.value / 1000).toFixed(1)
		return `思考中 ${s}s`
	})

	const currentNodeTypeLabel = computed((): string => {
		return getNodeTypeLabel(currentNodeTypeRaw.value)
	})

	const nodeTypeBadgeClass = computed((): string => {
		const t = currentNodeTypeRaw.value
		if (t == 'process') return 'aip-badge-process'
		if (t == 'operation') return 'aip-badge-operation'
		if (t == 'step') return 'aip-badge-step'
		if (t == 'action' || t == 'action-unit') return 'aip-badge-action'
		return 'aip-badge-default'
	})

	const sendBtnClass = computed((): string => {
		if (inputValue.value.trim() == '') return 'aip-btn-disabled'
		return inputMode.value == 'ask' ? 'aip-btn-ask' : 'aip-btn-record'
	})

	// ====== 记录模块 computed ======
	const filteredRecords = computed((): NodeRecord[] => {
		let list = nodeRecords.value
		if (recordFilter.value == 'open') {
			list = list.filter((r: NodeRecord): boolean => r.status == 'open')
		} else if (recordFilter.value == 'resolved') {
			list = list.filter((r: NodeRecord): boolean => r.status == 'resolved')
		}
		if (categoryFilter.value != 'all') {
			const cf = categoryFilter.value
			list = list.filter((r: NodeRecord): boolean => r.category == cf)
		}
		return list
	})

	const openCount = computed((): number => {
		return nodeRecords.value.filter((r: NodeRecord): boolean => r.status == 'open').length
	})
	const resolvedCount = computed((): number => {
		return nodeRecords.value.filter((r: NodeRecord): boolean => r.status == 'resolved').length
	})
	const criticalCount = computed((): number => {
		return nodeRecords.value.filter((r: NodeRecord): boolean => r.severity == 'critical').length
	})
	const majorCount = computed((): number => {
		return nodeRecords.value.filter((r: NodeRecord): boolean => r.severity == 'major').length
	})
	const minorCount = computed((): number => {
		return nodeRecords.value.filter((r: NodeRecord): boolean => r.severity == 'minor').length
	})

	const getCategoryLabel = (cat: string): string => {
		if (cat == 'quality') return '质量问题'
		if (cat == 'equipment') return '设备异常'
		if (cat == 'process') return '工艺偏差'
		if (cat == 'safety') return '安全隐患'
		if (cat == 'material') return '物料问题'
		return '其他'
	}
	const getCategoryIcon = (cat: string): string => {
		if (cat == 'quality') return '🔴'
		if (cat == 'equipment') return '⚙️'
		if (cat == 'process') return '📋'
		if (cat == 'safety') return '🛡️'
		if (cat == 'material') return '📦'
		return '💡'
	}
	const getSeverityLabel = (sev: string): string => {
		if (sev == 'critical') return '严重'
		if (sev == 'major') return '一般'
		return '轻微'
	}

	watch(isAnalyzing, (newVal: boolean) => {
		if (newVal) {
			analyzingElapsed.value = 0
			if (elapsedTimer != -1) clearInterval(elapsedTimer)
			elapsedTimer = setInterval(() => {
				analyzingElapsed.value += 100
			}, 100)
			setTimeout(() => {
				startDotAnimation([dot1Ref.value, dot2Ref.value, dot3Ref.value])
			}, 50)
		} else {
			if (elapsedTimer != -1) {
				clearInterval(elapsedTimer)
				elapsedTimer = -1
			}
		}
	})

	watch(isFollowUpTyping, (newVal: boolean) => {
		if (newVal) {
			followUpElapsed.value = 0
			if (followUpTimer != -1) clearInterval(followUpTimer)
			followUpTimer = setInterval(() => {
				followUpElapsed.value += 100
			}, 100)
			setTimeout(() => {
				startDotAnimation([dot4Ref.value, dot5Ref.value, dot6Ref.value])
			}, 50)
		} else {
			if (followUpTimer != -1) {
				clearInterval(followUpTimer)
				followUpTimer = -1
			}
		}
	})

	const getNodeTypeLabel = (type: string): string => {
		if (type == 'process') return '工艺'
		if (type == 'operation') return '工序'
		if (type == 'step') return '工步'
		if (type == 'action' || type == 'action-unit') return '动作'
		return '节点'
	}

	const getCurrentTime = (): string => {
		const now = new Date()
		const h = now.getHours().toString().padStart(2, '0')
		const m = now.getMinutes().toString().padStart(2, '0')
		return `${h}:${m}`
	}

	const scrollToBottom = () => {
		setTimeout(() => {
			scrollTop.value = scrollTop.value + 9999
		}, 80)
	}

	const startDotAnimation = (dots: (UniElement | null)[]) => {
		const keyframes = [
			{ opacity: 0.3, transform: 'translateY(0px)' },
			{ opacity: 1.0, transform: 'translateY(-5px)' },
			{ opacity: 0.3, transform: 'translateY(0px)' }
		] as UTSJSONObject[]
		dots.forEach((dot: UniElement | null, index: number) => {
			if (dot != null) {
				dot.animate(keyframes, {
					duration: 800,
					delay: index * 200,
					iterations: 100,
					easing: 'ease-in-out'
				})
			}
		})
	}

	const checkStatus = () => {
		uni.request({
			url: `${AI_BASE_URL}/status`,
			method: 'GET',
			success: (res) => {
				const data = res.data as UTSJSONObject | null
				if (data != null) {
					const ollama = data['ollama'] as string | null
					isOnline.value = (ollama == 'connected')
				} else {
					isOnline.value = false
				}
			},
			fail: () => {
				isOnline.value = false
			}
		})
	}

	onMounted(() => {
		checkStatus()
		loadRecords()
	})

	// ====== UI 交互 ======
	const toggleChecklist = (index: number) => {
		if (checklistStates.value.length > index) {
			checklistStates.value[index] = !checklistStates.value[index]
			saveChecklistState()
		}
	}

	const toggleFaq = (index: number) => {
		if (expandedFaqIndex.value == index) {
			expandedFaqIndex.value = -1
		} else {
			expandedFaqIndex.value = index
		}
	}

	const sendSuggestion = (text: string) => {
		inputValue.value = text
		inputMode.value = 'ask'
		handleSend()
	}

	const sendQualityQuery = (text: string) => {
		qualitySymptom.value = text
		doQualityCheck(text)
	}

	const saveChecklistState = () => {
		if (currentNodeId.value == '') return
		const key = `ai_checklist_${currentNodeId.value}`
		uni.setStorageSync(key, JSON.stringify(checklistStates.value))
	}

	const loadChecklistState = () => {
		if (currentNodeId.value == '') return
		const key = `ai_checklist_${currentNodeId.value}`
		const saved = uni.getStorageSync(key) as string | null
		if (saved != null && saved != '') {
			try {
				const arr = JSON.parse(saved) as boolean[]
				checklistStates.value = arr
			} catch (e) {}
		}
	}

	// ====== AI ======
	const doQualityCheck = (symptom: string) => {
		if (symptom.trim() == '') return

		isQualityChecking.value = true
		qualityResult.value = null

		uni.request({
			url: `${AI_BASE_URL}/check-quality`,
			method: 'POST',
			timeout: 60000,
			header: { 'Content-Type': 'application/json' },
			data: {
				symptom: symptom,
				nodeName: currentNodeName.value,
				nodeType: currentNodeTypeRaw.value,
				model: 'qwen2.5:3b'
			},
			success: (res) => {
				isQualityChecking.value = false
				const data = res.data as UTSJSONObject | null
				if (data != null && data['success'] === true) {
					if (data['data'] != null) {
						qualityResult.value = JSON.parse(JSON.stringify(data['data'])) as QualityDiagnosis
					}
				}
			},
			fail: () => {
				isQualityChecking.value = false
			}
		})
	}

	const doAnalyze = (node: UTSJSONObject) => {
		isAnalyzing.value = true
		analysisData.value = null
		analysisRawText.value = ''
		checklistStates.value = []

		const name = (node['displayName'] as string | null) ?? (node['name'] as string | null) ?? '未命名节点'
		const type = (node['type'] as string | null) ?? 'process'

		uni.request({
			url: `${AI_BASE_URL}/analyze-node`,
			method: 'POST',
			timeout: 60000,
			header: { 'Content-Type': 'application/json' },
			data: {
				nodeName: name,
				nodeType: type,
				processName: props.processName,
				model: 'qwen2.5:3b'
			},
			success: (res) => {
				isAnalyzing.value = false
				const data = res.data as UTSJSONObject | null
				if (data != null && data['success'] === true) {
					if (data['data'] != null) {
						analysisData.value = JSON.parse(JSON.stringify(data['data'])) as AnalysisData
						const len = analysisData.value!.checklist.length
						const arr = [] as boolean[]
						for(let i=0; i<len; i++) {
							arr.push(false)
						}
						checklistStates.value = arr
						loadChecklistState()
					} else if (data['rawText'] != null) {
						analysisRawText.value = data['rawText'] as string
					}
				} else {
					analysisRawText.value = '⚠️ AI 分析失败'
				}
			},
			fail: () => {
				isAnalyzing.value = false
				analysisRawText.value = '⚠️ 连接 AI 服务失败，请检查本地服务状态。'
			}
		})
	}

	const prefetchNextNode = (node: UTSJSONObject) => {
		const name = (node['displayName'] as string | null) ?? (node['name'] as string | null) ?? '未命名节点'
		const type = (node['type'] as string | null) ?? 'process'

		uni.request({
			url: `${AI_BASE_URL}/prefetch-next`,
			method: 'POST',
			data: {
				nodeName: name,
				nodeType: type,
				processName: props.processName,
				model: 'qwen2.5:3b'
			}
		})
	}

	const analyzeNode = (node: UTSJSONObject) => {
		if (analyzeTimer != -1) {
			clearTimeout(analyzeTimer)
			analyzeTimer = -1
		}

		const name = (node['displayName'] as string | null) ?? (node['name'] as string | null) ?? '未命名节点'
		const type = (node['type'] as string | null) ?? 'process'
		const id = (node['innerId'] as string | null) ?? (node['id'] as string | null) ?? ''

		currentNodeName.value = name
		currentNodeTypeRaw.value = type
		currentNodeId.value = id

		analysisData.value = null
		analysisRawText.value = ''
		followUpMessages.value = []
		expandedFaqIndex.value = -1
		
		const cacheKey = `${type}:${name}`
		if (prefetchCache.value.has(cacheKey)) {
			analysisData.value = prefetchCache.value.get(cacheKey) as AnalysisData | null
			if (analysisData.value != null && analysisData.value!.checklist != null) {
				const len = analysisData.value!.checklist.length
				const arr = [] as boolean[]
				for(let i=0; i<len; i++) {
					arr.push(false)
				}
				checklistStates.value = arr
				loadChecklistState()
			}
			return
		}

		analyzeTimer = setTimeout(() => {
			doAnalyze(node)
			analyzeTimer = -1
		}, 300)
	}

	const reAnalyze = () => {
		if (currentNodeName.value == '') return
		const node = {
			name: currentNodeName.value,
			type: currentNodeTypeRaw.value,
			innerId: currentNodeId.value
		} as UTSJSONObject
		analyzeNode(node)
	}

	// 追问功能
	const handleSend = () => {
		const text = inputValue.value.trim()
		if (text == '') return

		if (inputMode.value == 'record') {
			saveRecord(text)
			inputValue.value = ''
			if (activeTab.value != 'record') {
				activeTab.value = 'record'
			}
			return
		}

		inputValue.value = ''
		followUpMessages.value.push({ role: 'user', content: text, time: getCurrentTime() } as MsgItem)
		isFollowUpTyping.value = true
		followUpMessages.value.push({ role: 'ai', content: '', time: getCurrentTime() } as MsgItem)
		scrollToBottom()

		const history = [] as UTSJSONObject[]
		for (let i = 0; i < followUpMessages.value.length - 1; i++) {
			history.push({
				role: followUpMessages.value[i].role == 'user' ? 'user' : 'assistant',
				content: followUpMessages.value[i].content
			} as UTSJSONObject)
		}

		let promptContext = `我们在讨论工艺节点[${currentNodeName.value}]。\n`
		if (analysisRawText.value != '') {
			promptContext += `分析内容：${analysisRawText.value.substring(0, Math.min(analysisRawText.value.length, 500))}...\n`
		}
		promptContext += `问题：${text}`

		let buffer = ''
		const decoder = new TextDecoder('utf-8')

		const reqTask = uni.request({
			url: `${AI_BASE_URL}/chat`,
			method: 'POST',
			enableChunked: true,
			timeout: 120000,
			header: { 'Content-Type': 'application/json' },
			data: {
				prompt: promptContext,
				model: 'qwen2.5:3b',
				history: history
			},
			success: (_res) => {
				isFollowUpTyping.value = false
				scrollToBottom()
			},
			fail: (_err) => {
				isFollowUpTyping.value = false
				const lastMsg = followUpMessages.value[followUpMessages.value.length - 1]
				if (lastMsg.content == '') {
					lastMsg.content = '⏹️ 生成已中止'
				}
				scrollToBottom()
			}
		})
		currentChatReqTask.value = reqTask as RequestTask

		reqTask.onChunkReceived((res) => {
			const chunkStr = decoder.decode(new Uint8Array(res.data as ArrayBuffer))
			buffer += chunkStr
			const lines = buffer.split('\n')
			buffer = lines.pop() ?? ''

			for (let i = 0; i < lines.length; i++) {
				const line = lines[i].trim()
				if (line == '') continue
				try {
					const data = JSON.parse(line) as UTSJSONObject
					if (data['type'] == 'status' || data['type'] == 'docs') continue
					if (data['type'] == 'error') {
						isFollowUpTyping.value = false
						const errText = (data['error'] as string | null) ?? '错误'
						followUpMessages.value[followUpMessages.value.length - 1].content += '\n⚠️ ' + errText
						continue
					}
					let token = data['response'] as string | null
					if (token == null && data['message'] != null) {
						const msgObj = data['message'] as UTSJSONObject
						token = msgObj['content'] as string | null
					}
					if (token != null && token != '') {
						followUpMessages.value[followUpMessages.value.length - 1].content += token
						scrollToBottom()
					}
					if (data['done'] === true) {
						isFollowUpTyping.value = false
					}
				} catch (_e) {}
			}
		})
	}

	const toggleInputMode = () => {
		inputMode.value = inputMode.value == 'ask' ? 'record' : 'ask'
	}
	const switchToRecordTab = () => {
		activeTab.value = 'record'
	}

	const STORAGE_KEY = 'avpbc_ai_node_records'
	const loadRecords = () => {
		const str = uni.getStorageSync(STORAGE_KEY) as string | null
		if (str != null && str != '') {
			try {
				const arr = JSON.parse(str) as NodeRecord[]
				// 兼容旧格式记录：补全缺失的字段
				for (let i = 0; i < arr.length; i++) {
					if (arr[i].category == null || arr[i].category == '') {
						arr[i].category = 'other'
					}
					if (arr[i].severity == null || arr[i].severity == '') {
						arr[i].severity = 'minor'
					}
					if (arr[i].status == null || arr[i].status == '') {
						arr[i].status = 'open'
					}
				}
				nodeRecords.value = arr
			} catch (e) {}
		}
	}
	const saveRecord = (text: string) => {
		const cat = selectedCategory.value != '' ? selectedCategory.value : 'other'
		const sev = selectedSeverity.value
		const rec = {
			nodeId: currentNodeId.value,
			nodeName: currentNodeName.value,
			nodeType: currentNodeTypeRaw.value,
			content: text,
			timestamp: new Date().toISOString(),
			displayTime: getCurrentTime(),
			category: cat,
			severity: sev,
			status: 'open'
		} as NodeRecord
		nodeRecords.value.unshift(rec)
		uni.setStorageSync(STORAGE_KEY, JSON.stringify(nodeRecords.value))
		// 重置选择状态
		selectedCategory.value = ''
		selectedSeverity.value = 'minor'
	}

	const deleteRecord = (index: number) => {
		nodeRecords.value.splice(index, 1)
		uni.setStorageSync(STORAGE_KEY, JSON.stringify(nodeRecords.value))
	}

	const deleteFilteredRecord = (filteredIdx: number) => {
		const targetRec = filteredRecords.value[filteredIdx]
		const origIdx = nodeRecords.value.indexOf(targetRec)
		if (origIdx >= 0) {
			nodeRecords.value.splice(origIdx, 1)
			uni.setStorageSync(STORAGE_KEY, JSON.stringify(nodeRecords.value))
		}
	}

	const toggleRecordStatus = (filteredIdx: number) => {
		const targetRec = filteredRecords.value[filteredIdx]
		const origIdx = nodeRecords.value.indexOf(targetRec)
		if (origIdx >= 0) {
			const current = nodeRecords.value[origIdx].status
			nodeRecords.value[origIdx].status = current == 'open' ? 'resolved' : 'open'
			uni.setStorageSync(STORAGE_KEY, JSON.stringify(nodeRecords.value))
		}
	}

	const selectCategory = (cat: string) => {
		selectedCategory.value = selectedCategory.value == cat ? '' : cat
	}

	const selectSeverity = (sev: string) => {
		selectedSeverity.value = sev
	}

	const exportRecords = () => {
		if (nodeRecords.value.length == 0) {
			uni.showToast({ title: '暂无记录可导出', icon: 'none' })
			return
		}
		// 添加 BOM 头确保 Excel 正确识别中文
		const BOM = '\uFEFF'
		let content = BOM + '时间,节点类型,节点名称,问题分类,严重等级,状态,描述\n'
		nodeRecords.value.forEach((rec: NodeRecord) => {
			const catLabel = getCategoryLabel(rec.category)
			const sevLabel = getSeverityLabel(rec.severity)
			const statusLabel = rec.status == 'open' ? '待处理' : '已解决'
			// CSV 中内容需要用双引号包裹并转义内部双引号
			const escapedContent = '"' + rec.content.replace(/"/g, '""') + '"'
			content += `${rec.displayTime},${getNodeTypeLabel(rec.nodeType)},${rec.nodeName},${catLabel},${sevLabel},${statusLabel},${escapedContent}\n`
		})

		// #ifdef WEB
		// Web/Electron 环境：通过 Blob 创建下载链接
		const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' })
		const url = URL.createObjectURL(blob)
		const a = document.createElement('a')
		a.href = url
		a.download = 'ai_records_export.csv'
		document.body.appendChild(a)
		a.click()
		document.body.removeChild(a)
		URL.revokeObjectURL(url)
		uni.showToast({ title: `已导出 ${nodeRecords.value.length} 条记录`, icon: 'success' })
		// #endif

		// #ifndef WEB
		const fsAPI = uni.getFileSystemManager()
		const filePath = `${uni.env.USER_DATA_PATH}/ai_records_export.csv`
		fsAPI.writeFile({
			filePath: filePath,
			data: content,
			encoding: 'utf-8',
			success: () => {
				uni.showModal({
					title: '导出成功',
					content: `已导出 ${nodeRecords.value.length} 条记录（CSV 格式）:\n${filePath}`,
					showCancel: false
				})
			},
			fail: () => {
				uni.showToast({ title: '导出失败', icon: 'none' })
			}
		})
		// #endif
	}

	defineExpose({
		analyzeNode,
		prefetchNextNode
	})
</script>


<template>
	<!-- 全屏欢迎页：无数据时铺满整个窗口 -->
	<welcome-view v-if="!isDataLoaded" @import="handleImportData" @reset="handleResetData" />

	<!-- 正常工作区布局：有数据时显示 -->
	<outsider-layout v-if="isDataLoaded"
		:initLeftWidth="adaptiveLeftWidth" 
		:minLeftWidth="50" 
		:maxLeftWidth="800"
		:initMainTopRatio="0.52"
		:initRightWidth="adaptiveRightWidth"
		:maxRightWidth="1200"
		:showMainBottom="true"
		:showRightBottom="true"
		:minMainWidthRatio="0.25"
	>
		<template #header>
			<view v-if="isPC" class="vscode-titlebar" style="-webkit-app-region: drag; display: flex; flex-direction: row; align-items: center; height: 36px; padding: 0 12px; background-color: #FFFFFF;">
				<!-- APP图标 (使用客户端火箭图标) -->
				<image src="/static/logo.png" style="width: 20px; height: 20px; margin-right: 12px;" mode="aspectFit"></image>
				
				<!-- 文件菜单按钮 -->
				<view class="vscode-menu-btn" style="-webkit-app-region: no-drag; padding: 4px 8px; border-radius: 4px; display: flex; align-items: center;" @click="toggleSettingsMenu">
					<text style="font-size: 13px; color: #334155;">文件</text>
				</view>
			</view>

			<view class="header-container" :style="{ paddingTop: (!isPC ? statusBarHeight : 0) + 'px' }">
				<!-- 左侧：当前工艺大图标 -->
				<view v-if="headerIconPath != ''" class="header-icon-area">
					<image class="header-process-icon-img"
						   :src="headerIconPath"
						   mode="aspectFit" />
				</view>
				<!-- 右侧：面包屑区域（上下两行） -->
				<view class="header-breadcrumb-area">
					<!-- 上部分面包屑：部件信息 > 工艺信息 -->
					<view class="header-breadcrumb-row">
						<ux-breadcrumb :items="topBreadcrumbItems"></ux-breadcrumb>
					</view>
					<!-- 下部分面包屑：部件详情 > 工艺详情 -->
					<view class="header-breadcrumb-row">
						<ux-breadcrumb :items="bottomBreadcrumbItems"></ux-breadcrumb>
					</view>
				</view>
				<!-- 右侧操作区：设置按钮 + 企业Logo -->
				<view class="header-actions">
					<view v-if="!isPC" class="settings-icon-btn" @click="toggleSettingsMenu">
						<image class="settings-icon-img" src="/static/icons/settings_icon.svg" mode="aspectFit"></image>
					</view>
					<image class="header-logo" src="/static/icons/casc_logo.png" mode="aspectFit"></image>
				</view>
			</view>
		</template>

		<template #left>
			<view class="left-panel" style="flex: 1; display: flex; flex-direction: column; height: 100%;">
				<ux-table style="flex: 1; height: 100%;" :data="tableData" :fields="fields" :selectedId="selectedRowId" @row-click="handleRowClick"></ux-table>
			</view>
		</template>
		<!-- Main Top Area (Dynamic Group) -->
		<view class="main-content-top">
			<view v-if="topGroup != null" style="height: 100%; display: flex; flex-direction: column;">

				<ux-tabs :modelValue="activeTabs.get(topGroup?.id ?? '') ?? ''" @update:modelValue="onTabChange(topGroup?.id ?? '', $event)">
					<ux-tab-pane v-for="tab in topGroup!.tabs" :key="tab.id" :label="tab.title" :name="tab.id">
						<view style="flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden;">
							<!-- #ifdef WEB -->
							<view class="tab-content-wrap" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
							<!-- #endif -->
							<!-- #ifndef WEB -->
							<scroll-view class="tab-content-wrap" :show-scrollbar="false" style="flex: 1; display: flex; flex-direction: column;">
							<!-- #endif -->
								<view v-for="comp in tab.components" :key="comp.id" class="component-wrapper" :style="{ flex: comp.type == 'table' ? 1 : 'none', display: 'flex', flexDirection: 'column', overflow: 'hidden' }">
									<text class="comp-title" v-if="comp.title && tab.components.length > 1">{{ comp.title }}</text>
									
									<!-- Table Component -->
									<view v-if="comp.type == 'table'" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 200px;">
										<ux-table 
											style="flex: 1; height: 100%; display: flex; flex-direction: column;"
											:fields="getFieldsFromConfig(comp.config)" 
											:data="comp.data"
											:showExpand="false"
										></ux-table>
									</view>
									
									<!-- InfoView 组件 -->
									<ux-info-view
										v-else-if="comp.type == 'infoView'"
										:fields="getFieldsFromConfig(comp.config)"
										:data="comp.data.length > 0 ? comp.data[0] : null"
										:columns="getInfoViewColumnCount(comp.config)"
									/>
									
									<!-- Text Block Component -->
									<view v-else-if="comp.type == 'richText'" class="node-info-panel" style="width: 100%;">
										<ux-richtext :content="comp.data.length > 0 ? ((comp.data[0]['content'] as string | null) ?? '无描述') : '无描述'"></ux-richtext>
									</view>
									
									<!-- List Component -->
									<view v-else-if="comp.type == 'list'" class="list-panel">
										<view v-for="(item, idx) in comp.data" :key="idx" class="list-item-simple">
											<text class="list-item-name">{{ item['text'] }}</text>
										</view>
										<text v-if="comp.data.length == 0" class="empty-hint">暂无数据</text>
									</view>
									
								</view>
							<!-- #ifdef WEB -->
							</view>
							<!-- #endif -->
							<!-- #ifndef WEB -->
							</scroll-view>
							<!-- #endif -->
						</view>
					</ux-tab-pane>
				</ux-tabs>
			</view>
			
			<view v-else class="loading-state">
				<text>请在左侧工艺树中选择节点查看详情</text>
			</view>
		</view>
		
		<!-- Main Bottom Area (Dynamic Group) -->
		<template #main-bottom>
			<view class="main-bottom-wrapper">
				<view class="main-content-bottom">
					<view v-if="bottomGroup != null" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">

						<ux-tabs :modelValue="activeTabs.get(bottomGroup?.id ?? '') ?? ''" @update:modelValue="onTabChange(bottomGroup?.id ?? '', $event)">
							<ux-tab-pane v-for="tab in bottomGroup!.tabs" :key="tab.id" :label="tab.title" :name="tab.id">
								<view style="flex: 1; display: flex; flex-direction: column; height: 100%; overflow: hidden;">
									<!-- #ifdef WEB -->
									<view class="tab-content-wrap" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
									<!-- #endif -->
									<!-- #ifndef WEB -->
									<scroll-view class="tab-content-wrap" :show-scrollbar="false" style="flex: 1; display: flex; flex-direction: column;">
									<!-- #endif -->
										<view v-for="comp in tab.components" :key="comp.id" class="component-wrapper" :style="{ flex: comp.type == 'table' ? 1 : 'none', display: 'flex', flexDirection: 'column', overflow: 'hidden' }">
											<text class="comp-title" v-if="comp.title && tab.components.length > 1">{{ comp.title }}</text>
											
											<!-- Table Component -->
											<view v-if="comp.type == 'table'" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 200px;">
												<ux-table 
													style="flex: 1; height: 100%; display: flex; flex-direction: column;"
													:fields="getFieldsFromConfig(comp.config)" 
													:data="comp.data"
													:showExpand="false"
												></ux-table>
											</view>
											
											<!-- InfoView 组件 -->
											<ux-info-view
												v-else-if="comp.type == 'infoView'"
												:fields="getFieldsFromConfig(comp.config)"
												:data="comp.data.length > 0 ? comp.data[0] : null"
												:columns="getInfoViewColumnCount(comp.config)"
											/>
											
											<!-- Text Block Component -->
											<view v-else-if="comp.type == 'richText'" class="node-info-panel" style="width:100%;">
												<ux-richtext :content="comp.data.length > 0 ? ((comp.data[0]['content'] as string | null) ?? '无描述') : '无描述'"></ux-richtext>
											</view>
											
											<!-- List Component -->
											<view v-else-if="comp.type == 'list'" class="list-panel">
												<view v-for="(item, idx) in comp.data" :key="idx" class="list-item-simple">
													<text class="list-item-name">{{ item['text'] }}</text>
												</view>
												<text v-if="comp.data.length == 0" class="empty-hint">暂无数据</text>
											</view>
											
										</view>
									<!-- #ifdef WEB -->
									</view>
									<!-- #endif -->
									<!-- #ifndef WEB -->
									</scroll-view>
									<!-- #endif -->
								</view>
							</ux-tab-pane>
						</ux-tabs>
					</view>
					<view v-else class="no-selection">
						<text>选择节点查看概览</text>
					</view>
				</view>
				
				<!-- 底部节点导航区域 -->
				<view class="main-nav-actions">
					<view class="nav-action-btn" :class="{ 'btn-disabled': !hasPrevNode }" @click="goToPrevNode">
						<text class="nav-action-text" :class="{ 'nav-text-disabled': !hasPrevNode }">上一步</text>
					</view>
					<view class="nav-action-btn nav-action-btn-primary" :class="{ 'btn-primary-disabled': !hasNextNode }" @click="goToNextNode">
						<text class="nav-action-text-primary">下一步</text>
					</view>
				</view>
			</view>
		</template>

		<!-- Right Sidebar Top Area - 资源预览 -->
		<template #right>
			<view class="right-panel">
				<!-- 右侧区域头部 -->
				<view class="right-header">
					<text class="right-header-title">查看器</text>
					<view class="right-header-btn" @click="toggleResourceMaximize">
						<text class="btn-icon">{{ isResourceMaximized ? '⤡' : '⤢' }}</text>
					</view>
				</view>
				<view style="flex: 1; padding: 4px 4px 2px 4px; display: flex; flex-direction: column;">
					<resource-preview :resource="previewResource" @error="onPreviewError" />
				</view>
			</view>
		</template>
		
		<!-- Right Sidebar Bottom Area - 资源列表 -->
		<template #right-bottom>
			<view class="right-panel-bottom">
				<resource-list 
					:title="nodeResourcesTitle"
					:resources="nodeResources"
					:selectedId="previewResourceId"
					@select="onResourceSelect"
				/>
			</view>
		</template>
	</outsider-layout>
	
	<!-- 设置菜单遮罩层 -->
	<view v-if="isSettingsMenuVisible" class="settings-overlay" :style="{ top: isPC ? '36px' : '0' }" @click="closeSettingsMenu"></view>
	
	<!-- 设置下拉菜单 (根据平台调整位置) -->
	<view v-if="isSettingsMenuVisible" class="settings-dropdown" :style="{ top: settingsMenuTop + 'px', left: isPC ? '36px' : 'auto', right: isPC ? 'auto' : '20px' }">
		<view class="menu-item" @click="handleImportData">
			<text class="menu-item-icon">📦</text>
			<text class="menu-item-text">导入数据包</text>
		</view>
		<view class="menu-divider"></view>
		<view class="menu-item menu-item-danger" @click="handleResetData">
			<text class="menu-item-icon">🔄</text>
			<text class="menu-item-text-danger">重置数据</text>
		</view>
	</view>
	
	<!-- 全屏资源预览覆盖层 -->
	<view v-if="isResourceMaximized" class="resource-fullscreen-overlay">
		<view class="fullscreen-container" :style="{ paddingTop: (!isPC ? statusBarHeight : 0) + 'px' }">
			<!-- 头部工具栏 (PC端预留右上角原生按钮空间) -->
			<view class="fullscreen-header" :style="{ height: isPC ? '36px' : 'auto', paddingRight: isPC ? '140px' : '12px', '-webkit-app-region': isPC ? 'drag' : 'none' }">
				<view class="header-left" style="-webkit-app-region: no-drag;">
					<text v-if="nodeResources.length > 0" class="resource-counter">{{ currentResourceIndex + 1 }} / {{ nodeResources.length }}</text>
				</view>
				<view class="header-actions" style="-webkit-app-region: no-drag;">
					<!-- 列表显示/隐藏按钮 -->
					<view class="header-btn" @click="toggleFullscreenList">
						<text class="header-btn-icon">{{ isFullscreenListVisible ? '◧' : '☰' }}</text>
					</view>
					<!-- 关闭按钮 -->
					<view class="fullscreen-close" @click="toggleResourceMaximize">
						<text class="close-icon">✕</text>
					</view>
				</view>
			</view>
			
			<!-- 内容区域 -->
			<view class="fullscreen-content">
				<!-- 预览区（可占满或与列表共存） -->
				<view :class="isFullscreenListVisible ? 'fullscreen-preview' : 'fullscreen-preview-full'">
					<!-- 上一个/下一个导航按钮 -->
					<view v-if="nodeResources.length > 1" class="nav-btn nav-prev" @click="goPrevResource">
						<text class="nav-icon">‹</text>
					</view>
					
					<!-- 图片类型：自定义可变换预览 -->
					<view v-if="previewResource != null && previewResource?.type == 'image'" class="image-viewer-container">
						<scroll-view 
							scroll-x="true" 
							scroll-y="true" 
							class="image-scroll-view"
						>
							<view class="image-transform-wrapper" :style="imageTransformStyle">
								<image 
									class="fullscreen-image" 
									:src="previewResource?.path ?? ''" 
									mode="aspectFit"
									@load="onFullscreenImageLoad"
								/>
							</view>
						</scroll-view>
						
						<!-- 图片操作工具栏 -->
						<view class="image-toolbar">
							<view class="toolbar-btn" @click="imageZoomOut">
								<text class="toolbar-icon">−</text>
								<text class="toolbar-label">缩小</text>
							</view>
							<view class="toolbar-info">
								<text class="zoom-percentage">{{ Math.round(imageScale * 100) }}%</text>
							</view>
							<view class="toolbar-btn" @click="imageZoomIn">
								<text class="toolbar-icon">+</text>
								<text class="toolbar-label">放大</text>
							</view>
							<view class="toolbar-divider"></view>
							<view class="toolbar-btn" @click="imageRotateLeft">
								<text class="toolbar-icon">↺</text>
								<text class="toolbar-label">左旋</text>
							</view>
							<view class="toolbar-btn" @click="imageRotateRight">
								<text class="toolbar-icon">↻</text>
								<text class="toolbar-label">右旋</text>
							</view>
							<view class="toolbar-divider"></view>
							<view class="toolbar-btn" @click="imageReset">
								<text class="toolbar-icon">⟲</text>
								<text class="toolbar-label">重置</text>
							</view>
						</view>
					</view>
					
					<!-- 非图片类型：使用原组件 -->
					<resource-preview v-else :resource="previewResource" @error="onPreviewError" />
					
					<view v-if="nodeResources.length > 1" class="nav-btn nav-next" @click="goNextResource">
						<text class="nav-icon">›</text>
					</view>
				</view>
				
				<!-- 右侧缩略图列表（可隐藏） -->
				<view v-if="isFullscreenListVisible" class="fullscreen-list">
					<scroll-view scroll-y="true" style="flex: 1;">
						<view class="fullscreen-list-inner">
							<view 
								v-for="(item, index) in nodeResources" 
								:key="item.id"
								:class="previewResourceId == item.id ? 'fullscreen-thumb-item-selected' : 'fullscreen-thumb-item'"
								@click="onResourceSelect(item)"
							>
								<view class="thumb-wrapper">
									<image 
										v-if="item.type == 'image'" 
										class="fullscreen-thumb-img"
										:src="item.thumbnail != '' ? item.thumbnail : item.path"
										mode="aspectFill"
									/>
									<text v-else-if="item.type == 'video'" class="fullscreen-thumb-icon">🎬</text>
									<text v-else-if="item.type == 'audio'" class="fullscreen-thumb-icon">🎵</text>
									<text v-else class="fullscreen-thumb-icon">📄</text>
								</view>
								<text class="thumb-name" :numberOfLines="1">{{ formatName(item.name) }}</text>
							</view>
						</view>
					</scroll-view>
				</view>
			</view>
		</view>
	</view>
	
	<!-- 导入包抽屉组件 -->
	<import-drawer v-if="showImportDrawer" @close="showImportDrawer = false" @success="handleImportSuccess" />
</template>

<script setup lang="uts">
	import { initDatabase, querySQL, executeSQL } from '@/services/database.uts'
	// #ifdef WEB
	import { webGetAll, webGetByIndex, webGetCount, webClearStore } from '@/services/database.uts'
	// #endif

	import { ResourceItem } from '@/types/resource'
	import { getResourcesByNodeId, clearAllResources } from '@/services/resourceService.uts'
	import { queryNodeById, queryChildrenByParentId } from '@/services/processService.uts'
	import { getIconPath } from '@/utils/iconRegistry.uts'

	import OutsiderLayout from '@/uni_modules/outsider-layout/components/outsider-layout/outsider-layout.uvue'
	import UxTabs from '@/components/ux-tabs/ux-tabs.uvue'
	import UxTabPane from '@/components/ux-tab-pane/ux-tab-pane.uvue'
	import UxTable from '@/components/ux-table/ux-table.uvue'

	import ResourcePreview from '@/components/resource-preview/resource-preview.uvue'
	import ResourceList from '@/components/resource-list/resource-list.uvue'
	import UxBreadcrumb from '@/components/ux-breadcrumb/ux-breadcrumb.uvue'
	import WelcomeView from '@/components/welcome-view/welcome-view.uvue'

	// 获取状态栏高度（自定义导航栏模式下需要手动避让状态栏）
	const statusBarHeight = ref(0)
	const windowInfo = uni.getWindowInfo()
	statusBarHeight.value = windowInfo.statusBarHeight

	const settingsMenuTop = computed((): number => {
		// PC端自定义标题栏高度为36px，其他端为基础偏移量加状态栏高度
		return isPC.value ? 36 : (statusBarHeight.value + 50)
	})

	// ============ 自适应布局计算 (响应式) ============
	const adaptiveLeftWidth = computed((): number => {
		// 左侧工艺树：占宽目标的 22%
		const ideal = windowInfo.windowWidth * 0.22
		if (ideal < 240) return 240   // 最小值防止字挤
		if (ideal > 340) return 340   // 最大值防止太宽
		return Math.floor(ideal)
	})

	const adaptiveRightWidth = computed((): number => {
		// 右侧查看器：建议占宽 42%
		const ideal = windowInfo.windowWidth * 0.42
		if (ideal < 360) return 360   // 最小值保证预览清晰
		if (ideal > 800) return 800   // 最大值限制
		return Math.floor(ideal)
	})

	// ===========================================

	// 面包屑项类型
	type BreadcrumbItem = {
		label: string
		value: string
		state: string
		stateType: string
		version: string
	}
	
	// 状态主题映射字典
	const stateTagMap = new Map<string, string>()
	stateTagMap.set('设计中', 'primary')
	stateTagMap.set('更改中', 'danger')
	stateTagMap.set('受控中', 'warning')
	stateTagMap.set('审批中', 'warning')
	stateTagMap.set('已发布', 'success')
	stateTagMap.set('已废弃', 'info')
	
	// 获取状态对应的标签类型
	const getStateTagType = (stateName: string): string => {
		if (stateName == '') return 'default'
		return stateTagMap.get(stateName) ?? 'default'
	}

	// Define ViewModels
	type ComponentVM = {
		id: string
		type: string
		title: string
		config: any // Config can be Array (for table) or Object (for collapse)
		data: UTSJSONObject[]
	}
	
	type TabVM = {
		id: string
		title: string
		components: ComponentVM[]
	}
	
	type GroupVM = {
		id: string
		name: string
		tabs: TabVM[]
	}

	// State
	const leftGroup = ref<GroupVM | null>(null)
	const topGroup = ref<GroupVM | null>(null)
	const bottomGroup = ref<GroupVM | null>(null)
	
	const activeTabs = reactive(new Map<string, string>())
	const statusMessage = ref('Ready')
	const isPC = ref(false)

	const isDataLoaded = computed((): boolean => tableData.value.length > 0)
	
	// Left panel Tree Data (Ref to data in leftGroup for template compatibility)
	const tableData = ref([] as UTSJSONObject[])
	// 树表字段配置 - 将从数据包中加载，此处为默认值
	const fields = ref([] as UTSJSONObject[])
	const selectedRow = ref(null as UTSJSONObject | null)
	
	// 资源预览相关状态
	const nodeResources = ref([] as ResourceItem[])
	const nodeResourcesTitle = ref('资源列表')
	const previewResource = ref(null as ResourceItem | null)
	const previewResourceId = computed((): string => previewResource.value != null ? previewResource.value!.id : '')
	const isResourceMaximized = ref(false)
	const isFullscreenListVisible = ref(true)
	
	// 当前工艺图标（左侧大图标），由面包屑更新时赋值，空值则不显示
	const headerIconPath = ref('')
	// 上部分面包屑：部件编号/名称/生命周期/版本 > 工艺编号/名称/生命周期/版本
	const topBreadcrumbItems = ref([] as BreadcrumbItem[])
	// 下部分面包屑：部件类型|用户|时间|位置|密级 > 工艺类型|用户|时间|位置|密级
	const bottomBreadcrumbItems = ref([] as BreadcrumbItem[])
	
	// 当前资源索引
	const currentResourceIndex = computed((): number => {
		if (previewResource.value == null) return 0
		const idx = nodeResources.value.findIndex((r: ResourceItem): boolean => r.id == previewResource.value!.id)
		return idx >= 0 ? idx : 0
	})
	
	// 图片变换状态
	const imageScale = ref(1)
	const imageRotation = ref(0)
	
	// 图片变换样式
	const imageTransformStyle = computed((): string => {
		// transform 在 App 端可能不完全支持，但通过内联 style 设置通常可用
		return `transform: scale(${imageScale.value}) rotate(${imageRotation.value}deg);`
	})
	
	const formatName = (name: string): string => {
		const lastDotIndex = name.lastIndexOf('.')
		if (lastDotIndex > 0) {
			return name.substring(0, lastDotIndex)
		}
		return name
	}

	// ====== 树节点扁平化及导航 ======
	const flattenTree = (nodes: UTSJSONObject[]): UTSJSONObject[] => {
		const result = [] as UTSJSONObject[]
		for (let i = 0; i < nodes.length; i++) {
			const node = nodes[i]
			result.push(node)
			const children = node['children']
			if (children != null && Array.isArray(children)) {
				const childNodes = children as UTSJSONObject[]
				const flatChildren = flattenTree(childNodes)
				for (let j = 0; j < flatChildren.length; j++) {
					result.push(flatChildren[j])
				}
			}
		}
		return result
	}

	const flatNodes = computed((): UTSJSONObject[] => {
		return flattenTree(tableData.value)
	})

	// 兼容获取节点唯一ID
	const getNodeId = (node: UTSJSONObject | null): string => {
		if (node == null) return ''
		return (node['innerId'] as string | null) ?? (node['id'] as string | null) ?? ''
	}

	const hasPrevNode = computed((): boolean => {
		if (selectedRow.value == null) return false
		const targetId = getNodeId(selectedRow.value!)
		const index = flatNodes.value.findIndex((n: UTSJSONObject): boolean => getNodeId(n) == targetId)
		return index > 0
	})

	const hasNextNode = computed((): boolean => {
		if (selectedRow.value == null) return false
		const targetId = getNodeId(selectedRow.value!)
		const index = flatNodes.value.findIndex((n: UTSJSONObject): boolean => getNodeId(n) == targetId)
		return index >= 0 && index < flatNodes.value.length - 1
	})

	const selectedRowId = computed((): string | null => {
		if (selectedRow.value == null) return null
		return getNodeId(selectedRow.value!)
	})

	const goToPrevNode = () => {
		if (!hasPrevNode.value) return
		const list = flatNodes.value
		const targetId = getNodeId(selectedRow.value!)
		const index = list.findIndex((n: UTSJSONObject): boolean => getNodeId(n) == targetId)
		if (index > 0) {
			const prevNode = list[index - 1]
			handleRowClick(prevNode)
		}
	}

	const goToNextNode = () => {
		if (!hasNextNode.value) return
		const list = flatNodes.value
		const targetId = getNodeId(selectedRow.value!)
		const index = list.findIndex((n: UTSJSONObject): boolean => getNodeId(n) == targetId)
		if (index >= 0 && index < list.length - 1) {
			const nextNode = list[index + 1]
			handleRowClick(nextNode)
		}
	}

	onLoad((options: OnLoadOptions) => {
		// console.log('Page Load')
		// #ifdef WEB
		if ((window as any).electronAPI != null) {
			isPC.value = true
			const electronAPI = (window as any).electronAPI
			electronAPI.onMenuAction((action: string) => {
				if (action == 'import-data') {
					handleImportData()
				} else if (action == 'reset-data') {
					handleResetData()
				}
			})
			electronAPI.onLeaveFullScreen(() => {
				if (isResourceMaximized.value) {
					isResourceMaximized.value = false
				}
			})
		}
		
		window.addEventListener('keydown', handleGlobalKeyDown)
		// #endif
		const nodeId = options['id'] as string | null
		initData(nodeId)
	})
	
	onPageShow(() => {
		// 每次页面显示时检查并刷新数据
		// console.log('Page Show')
		initData(null)
	})
	
	onUnload(() => {
		// #ifdef WEB
		window.removeEventListener('keydown', handleGlobalKeyDown)
		// #endif
	})
	
	const initData = async (targetNodeId: string | null = null) => {
		// #ifdef WEB
		// Web: Check if data exists in IndexedDB
		await initDatabase()
		const count = await webGetCount('meta_tab_groups')
		// #endif
		
		// #ifndef WEB
		// SQL: Check meta_tab_groups table
		await initDatabase()
		const res = await querySQL("SELECT count(*) as total FROM meta_tab_groups")
		// 鸿蒙端 getColumnName 可能不返回别名，打印完整结果以诊断
		let count = 0
		if (res.length > 0) {
			const row = res[0]
			console.log('initData: 查询结果 row =', JSON.stringify(row))
			// 尝试多种可能的列名
			const val = row['total'] ?? row['count'] ?? row['count(*)'] ?? row['COUNT(*)']
			if (val != null) {
				count = Number(val)
			} else {
				// 如果所有已知列名都不匹配，取第一个 key 的值
				const keys = Object.keys(row)
				if (keys.length > 0) {
					count = Number(row[keys[0]])
				}
			}
		}
		console.log('initData: meta_tab_groups count =', count)
		// #endif
		
		if (count == 0 || Number.isNaN(count)) {
			statusMessage.value = 'No data found. Please Reset & Import.'
			console.log('No data found, attempting to load default package if available...')
		} else {
			statusMessage.value = 'Data loaded from DB'
			await loadLeftPanel(targetNodeId)
		}
	}
	
	// 设置菜单显示状态
	const isSettingsMenuVisible = ref(false)
	
	/**
	 * 切换设置菜单显示状态
	 */
	const toggleSettingsMenu = () => {
		isSettingsMenuVisible.value = !isSettingsMenuVisible.value
	}
	
	/**
	 * 关闭设置菜单
	 */
	const closeSettingsMenu = () => {
		isSettingsMenuVisible.value = false
	}
	
	const showImportDrawer = ref(false)
	
	const handleImportSuccess = () => {
		initData(null)
	}
	
	/**
	 * 处理导入数据包 - 显示导入抽屉组件
	 */
	const handleImportData = () => {
		closeSettingsMenu()
		showImportDrawer.value = true
	}
	
	/**
	 * 处理重置数据 - 直接执行重置
	 */
	const handleResetData = () => {
		closeSettingsMenu()
		// 直接执行重置，无需确认
		resetData()
	}
	
	// 重置数据 - 只清空数据库存储
	const resetData = async () => {
		try {
			uni.showLoading({ title: '重置中...' })
			
			// #ifdef WEB
			console.log('Resetting all data...')
			await webClearStore('meta_tab_groups')
			await webClearStore('meta_tabs')
			await webClearStore('meta_components')
			await webClearStore('meta_process_tree')
			await webClearStore('t_process')
			await webClearStore('t_operation')
			await webClearStore('t_step')
			await webClearStore('t_action')
			await webClearStore('t_resources')  // V3: 清空资源表
			console.log('All data cleared')
			// #endif
			
			// #ifndef WEB
			await executeSQL('DELETE FROM meta_tab_groups')
			await executeSQL('DELETE FROM meta_tabs')
			await executeSQL('DELETE FROM meta_components')
			await executeSQL('DELETE FROM meta_process_tree')
			await executeSQL('DELETE FROM t_process')
			await executeSQL('DELETE FROM t_operation')
			await executeSQL('DELETE FROM t_step')
			await executeSQL('DELETE FROM t_action')
			await executeSQL('DELETE FROM t_resources')  // V3: 清空资源表
			// #endif
			
			// 清理资源文件（仅 App 端）
			await clearAllResources()
			
			// 清空 UI 状态
			leftGroup.value = null
			topGroup.value = null
			bottomGroup.value = null
			tableData.value = []
			selectedRow.value = null
			activeTabs.clear()
			
			// 清空资源状态
			nodeResources.value = []
			nodeResourcesTitle.value = '资源列表'
			previewResource.value = null
			
			// 清空面包屑状态
			headerIconPath.value = ''
			topBreadcrumbItems.value = []
			bottomBreadcrumbItems.value = []
			
			uni.hideLoading()
			uni.showToast({
				title: '数据已清空',
				icon: 'success'
			})
		} catch (e) {
			uni.hideLoading()
			console.error('Reset failed:', e)
			uni.showToast({
				title: '重置失败',
				icon: 'none'
			})
		}
	}
	
	const loadLeftPanel = async (targetNodeId: string | null = null) => {
		// 首先获取左侧树数据
		const treeData = await loadTableTreeFromMeta()
		if (treeData.length > 0) {
			// 将数据加工并直接赋值给左侧树
			tableData.value = treeData.map((node: UTSJSONObject): UTSJSONObject => enrichNodeForDisplay(node))
			
			// 直接从 meta_components 读取 tableTree 配置，跳过 tabs 配置
			fields.value = await loadTableTreeFields()
			
			// 自动选中逻辑
			if (tableData.value.length > 0) {
				let targetRow: UTSJSONObject | null = null
				
				if (targetNodeId != null) {
					// 在扁平化节点中查找匹配 ID 的节点
					const found = flatNodes.value.find((n: UTSJSONObject): boolean => n['innerId'] == targetNodeId || n['id'] == targetNodeId)
					if (found != null) {
						targetRow = found
					}
				}
				
				// 如果没找到或没提供 ID，选第一个
				if (targetRow == null) {
					targetRow = tableData.value[0]
				}
				
				// 延迟执行确保 UI 渲染完成
				const finalRow = targetRow as UTSJSONObject
				setTimeout(() => {
					handleRowClick(finalRow)
				}, 100)
			}
		}
	}
	
	// 从 meta_components 中加载左侧树表头配置，不依赖 tabs_groups
	const loadTableTreeFields = async (): Promise<UTSJSONObject[]> => {
		const defaultFields = [{"label": "名称", "prop": "name", "width": -1}] as UTSJSONObject[]
		
		// #ifdef WEB
		try {
			const allComps = await webGetAll('meta_components')
			// 匹配左侧面板工艺树组件
			let targetComp: any = null
			for (let i = 0; i < allComps.length; i++) {
				const c = allComps[i] as any
				if (c.id == 'left_process_tree') {
					targetComp = c
					break
				}
			}
			if (targetComp != null) {
				return getFieldsFromConfig(targetComp.config)
			}
		} catch (e) { }
		// #endif
		
		// #ifndef WEB
		try {
			const comps = await querySQL("SELECT * FROM meta_components WHERE id = 'left_process_tree' LIMIT 1")
			if (comps.length > 0) {
				const configStr = comps[0]['config_json'] as string
				if (configStr != '') {
					try {
						const config = JSON.parse(configStr)
						return getFieldsFromConfig(config)
					} catch(e){}
				}
			}
		} catch (e) { }
		// #endif
		
		return defaultFields
	}
	
	// 通用：为 Group 中的组件加载初始数据 (仅处理需要全量的如 tableTree)
	const loadDataForGroup = async (group: GroupVM, preloadedTree: UTSJSONObject[] | null = null) => {
		for (const tab of group.tabs) {
			for (const comp of tab.components) {
				if (comp.type == 'tableTree') {
					let treeData = preloadedTree
					if (treeData == null) {
						treeData = await loadTableTreeFromMeta()
					}
					// 为了避免改变原对象，enrichNodeForDisplay内部如果修改了引用可能会有问题，但原本的写法也是map()
					// 这里我们需要深拷贝吗？不用，因为enrichNodeForDisplay会改变原对象，
					// map本身只是浅拷贝数组，但里面的对象还是被修改了，这其实没问题。
					comp.data = treeData.map((node: UTSJSONObject): UTSJSONObject => enrichNodeForDisplay(node))
				}
			}
		}
	}
	
	// 加载整表数据
	
	// 加载导航轻量工艺树
	const loadTableTreeFromMeta = async (): Promise<UTSJSONObject[]> => {
		let data: UTSJSONObject[] = []
		// #ifdef WEB
		try {
			const rows = await webGetAll('meta_process_tree')
			if (rows.length > 0 && rows[0]['data_json'] != null) {
				try { data = JSON.parse(rows[0]['data_json'] as string) as UTSJSONObject[] } catch(e){}
			}
		} catch (e) { }
		// #endif
		
		// #ifndef WEB
		try {
			const rows = await querySQL(`SELECT * FROM meta_process_tree WHERE id = 'process_tree'`)
			if (rows.length > 0 && rows[0]['data_json'] != null) {
				try { data = JSON.parse(rows[0]['data_json'] as string) as UTSJSONObject[] } catch(e){}
			}
		} catch (e) { }
		// #endif
		return data
	}

	const loadTableData = async (tableName: string): Promise<UTSJSONObject[]> => {
		let data: UTSJSONObject[] = []
		// #ifdef WEB
		try {
			const rows = await webGetAll(tableName)
			// Web 存储的是对象，直接转换
			data = rows.map((p: any): UTSJSONObject => p as UTSJSONObject)
		} catch (e) { /* console.error('Web load table failed:', tableName, e) */ }
		// #endif
		
		// #ifndef WEB
		try {
			const rows = await querySQL(`SELECT * FROM ${tableName}`)
			data = rows.map((p: any): UTSJSONObject => {
				const row = p as UTSJSONObject
				const obj: UTSJSONObject = {}
				
				// 将 snake_case 转换为 camelCase
				for (const key in row) {
					if (key != 'extra_json') {
						const camelKey = key.replace(/_([a-z])/g, (match: string, letter: string): string => letter.toUpperCase())
						obj[camelKey] = row[key]
					}
				}
				
				// 合并 extra_json
				const extraStr = row['extra_json'] as string | null
				if (extraStr != null && extraStr != '') {
					try {
						const extra = JSON.parse(extraStr) as UTSJSONObject
						for (const k in extra) {
							obj[k] = extra[k]
						}
					} catch (e: any) { }
				}
				
				// 兼容：确保有 innerId 字段，即使是从旧数据里也读出来
				if (obj['innerId'] != null) obj['innerId'] = obj['innerId'].toString()
				
				return obj
			})
		} catch (e) { console.error('SQL load table failed:', tableName, e) }
		// #endif
		
		return data
	}
	
	// 为节点添加显示字段（图标+名称，资源计数标签）
	const enrichNodeForDisplay = (node: UTSJSONObject): UTSJSONObject => {
		// 统一处理兼容 V4/V5 的 targetClassId 映射 (如果有遗漏)
		if (node['type'] == null && node['targetClassId'] != null) {
			const targetCls = node['targetClassId'] as string
			if (targetCls == 'Process') node['type'] = 'process'
			else if (targetCls == 'Operation') node['type'] = 'operation'
			else if (targetCls == 'Step') node['type'] = 'step'
			else if (targetCls == 'ActionUnit') node['type'] = 'action-unit'
			else node['type'] = targetCls.toLowerCase()
		}
		
		// 图标：classId_icon 非空则查注册表，为空则不显示
		const iconKey = (node['classId_icon'] as string | null) ?? ''
		node['iconPath'] = getIconPath(iconKey)
		
		const name = node['name'] as string
		node['displayName'] = name
		
		// 生成资源计数标签: #(数量)
		const resourceCount = node['resourceCount']
		if (resourceCount != null) {
			node['resourceLabel'] = `#(${resourceCount})`
		} else {
			node['resourceLabel'] = ''
		}
		
		// 递归处理嵌套子树
		const children = node['children']
		if (children != null && Array.isArray(children)) {
			const childList = children as UTSJSONObject[]
			for (let i = 0; i < childList.length; i++) {
				enrichNodeForDisplay(childList[i])
			}
		}
		
		return node
	}
	
	const loadGroup = async (groupId: string): Promise<GroupVM | null> => {
		// #ifdef WEB
		return await loadGroupWeb(groupId)
		// #endif
		// #ifndef WEB
		return await loadGroupSQL(groupId)
		// #endif
	}
	
	// #ifdef WEB
	const loadGroupWeb = async (groupId: string): Promise<GroupVM | null> => {
		try {
			const allGroups = await webGetAll('meta_tab_groups')
			const groups = allGroups.filter((g: any) => g.id == groupId)
			if (groups.length == 0) {
				console.log('Web: Group not found:', groupId)
				return null
			}
			
			const groupRow = groups[0]
			const groupVM: GroupVM = {
				id: groupRow.id as string,
				name: groupRow.name as string,
				tabs: []
			}
			
			// Load Tabs
			const allTabs = await webGetByIndex('meta_tabs', 'group_id', groupId)
			const tabs = allTabs.sort((a: any, b: any) => (a.sort_order || 0) - (b.sort_order || 0))
			console.log('Web: Found tabs:', tabs.length)
			
			for (let i = 0; i < tabs.length; i++) {
				const t = tabs[i] as any
				const tabId = t.id as string
				const tabVM: TabVM = {
					id: tabId,
					title: t.title as string,
					components: []
				}
				
				// Load Components
				const allComps = await webGetByIndex('meta_components', 'tab_id', tabId)
				const comps = allComps.sort((a: any, b: any) => (a.sort_order || 0) - (b.sort_order || 0))
				
				for (let j = 0; j < comps.length; j++) {
					const c = comps[j] as any
					const compId = c.id as string
					
					const compVM: ComponentVM = {
						id: compId,
						type: c.type as string,
						title: c.title as string,
						config: c.config,  // Object already parsed in IndexedDB
						data: []
					}
					
					// 运行时数据由 bindDataToGroup 根据 dataSource 填充，不在此处预加载
					
					tabVM.components.push(compVM)
				}
				
				groupVM.tabs.push(tabVM)
			}
			
			console.log('Web: Group loaded:', groupVM.name, 'with', groupVM.tabs.length, 'tabs')
			return groupVM
		} catch (e) {
			console.error('Web loadGroup error:', e)
			return null
		}
	}
	// #endif
	
	// #ifndef WEB
	const loadGroupSQL = async (groupId: string): Promise<GroupVM | null> => {
		const groups = await querySQL("SELECT * FROM meta_tab_groups WHERE id = ?", [groupId])
		if (groups.length == 0) return null
		
		const groupRow = groups[0]
		const groupVM: GroupVM = {
			id: groupRow['id'] as string,
			name: groupRow['name'] as string,
			tabs: []
		}
		
		// Load Tabs
		const tabs = await querySQL("SELECT * FROM meta_tabs WHERE group_id = ? ORDER BY sort_order", [groupId])
		
		for (let i = 0; i < tabs.length; i++) {
			const t = tabs[i]
			const tabId = t['id'] as string
			const tabVM: TabVM = {
				id: tabId,
				title: t['title'] as string,
				components: []
			}
			
			// Load Components
			const comps = await querySQL("SELECT * FROM meta_components WHERE tab_id = ? ORDER BY sort_order", [tabId])
			for (let j = 0; j < comps.length; j++) {
				const c = comps[j]
				const compId = c['id'] as string
				
				// Parse config
				let config: any = null
				const configStr = c['config_json'] as string
				if (configStr != '') {
					try {
						config = JSON.parse(configStr)
					} catch (e) { console.error('Config parse error', e) }
				}
				
				const compVM: ComponentVM = {
					id: compId,
					type: c['type'] as string,
					title: c['title'] as string,
					config: config,
					data: []
				}
				
				// 运行时数据由 bindDataToGroup 根据 dataSource 填充，不在此处预加载
				
				tabVM.components.push(compVM)
			}
			
			groupVM.tabs.push(tabVM)
		}
		
		return groupVM
	}
	// #endif

	
	const onTabChange = (groupId: string, tabId: any) => {
		activeTabs.set(groupId, tabId as string)
	}
	

	
	// Helper to get string safely
	const getString = (obj: UTSJSONObject | null, key: string): string => {
		if (obj == null) return ''
		return obj[key]?.toString() ?? ''
	}
	
	/**
	 * 更新面包屑数据
	 * 从当前选中节点中提取部件和工艺信息，填充上下两行面包屑
	 * @param node 当前选中的节点数据
	 */
	const updateBreadcrumbs = (node: UTSJSONObject) => {
		// 如果选中的不是底层工艺节点(process)，则不更新面包屑，始终保持顶部显示部件和工艺信息
		const nodeType = node['type'] as string
		if (nodeType != 'process') return
		
		// === 工艺侧元数据 ===
		const processCode = (node['code'] as string) ?? ''
		const processName = (node['name'] as string) ?? ''
		const classIdDisplay = (node['classId_display'] as string) ?? ''
		const stateName = (node['stateName'] as string) ?? ''
		const fullversionNo = (node['fullversionNo'] as string) ?? ''
		const secretIdDisplay = (node['secretId_display'] as string) ?? ''
		const modifyByIdDisplay = (node['modifyById_display'] as string) ?? ''
		const modifyTime = (node['modifyTime'] as string) ?? ''
		const contextName = (node['contextName'] as string) ?? ''
		const phaseIdDisplay = (node['phaseId_display'] as string) ?? ''

		// === 部件侧元数据 ===
		const partCode = (node['partCode'] as string) ?? ''
		const partName = (node['partName'] as string) ?? ''
		const partClassIdDisplay = (node['partClassId_display'] as string) ?? '部件'
		const partStateName = (node['partStateName'] as string) ?? ''
		const partFullversionNo = (node['partFullversionNo'] as string) ?? ''
		const partSecretIdDisplay = (node['partSecretId_display'] as string) ?? ''
		const partModifyByIdDisplay = (node['partModifyById_display'] as string) ?? ''
		const partModifyTime = (node['partModifyTime'] as string) ?? ''
		const partContextName = (node['partContextName'] as string) ?? ''
		const partPhaseIdDisplay = (node['partPhaseId_display'] as string) ?? ''

		// === 尝试获取 Header 业务大图标 ===
		const partBusinessIcon = (node['partClassId_business_icon'] as string | null) ?? ''
		const processBusinessIcon = (node['classId_business_icon'] as string | null) ?? ''
		const businessIconKey = partBusinessIcon != '' ? partBusinessIcon : processBusinessIcon
		headerIconPath.value = getIconPath(businessIconKey)

		// === 上部分面包屑：部件编号/名称/版本 > 工艺编号/名称/版本 ===
		const topItems: BreadcrumbItem[] = [] as BreadcrumbItem[]

		// 部件面包屑项
		let partLabel = '未关联部件'
		if (partCode != '') {
			partLabel = partName != '' ? `${partCode}，${partName}` : partCode
		}
		topItems.push({ 
			label: partLabel, 
			value: 'part',
			state: partCode != '' ? partStateName : '',
			stateType: getStateTagType(partStateName),
			version: partCode != '' ? partFullversionNo : ''
		} as BreadcrumbItem)

		// 工艺面包屑项
		let processLabel = processName
		if (processCode != '') {
			processLabel = `${processCode}，${processName}`
		}
		topItems.push({ 
			label: processLabel, 
			value: 'process',
			state: processCode != '' ? stateName : '',
			stateType: getStateTagType(stateName),
			version: processCode != '' ? fullversionNo : ''
		} as BreadcrumbItem)

		topBreadcrumbItems.value = topItems

		// === 下部分面包屑：部件详情 > 工艺详情 ===
		const bottomItems: BreadcrumbItem[] = [] as BreadcrumbItem[]

		// 部件详情面包屑项（类型 | 修改人 | 修改时间 | 上下文名称 | 密级）
		const partDetailParts: string[] = [] as string[]
		if (partClassIdDisplay != '') partDetailParts.push(partClassIdDisplay)
		if (partModifyByIdDisplay != '') partDetailParts.push(partModifyByIdDisplay)
		if (partModifyTime != '') partDetailParts.push(partModifyTime)
		if (partContextName != '') partDetailParts.push(partContextName)
		if (partPhaseIdDisplay != '') partDetailParts.push(partPhaseIdDisplay)
		if (partSecretIdDisplay != '') partDetailParts.push(partSecretIdDisplay)
		const partDetailLabel = partDetailParts.length > 0 ? partDetailParts.join(' | ') : '无部件详情'
		bottomItems.push({ 
			label: partDetailLabel, 
			value: 'part-detail',
			state: '',
			stateType: 'default',
			version: ''
		} as BreadcrumbItem)

		// 工艺详情面包屑项（类型 | 修改人 | 修改时间 | 上下文名称 | 密级）
		const processDetailParts: string[] = [] as string[]
		if (classIdDisplay != '') processDetailParts.push(classIdDisplay)
		if (modifyByIdDisplay != '') processDetailParts.push(modifyByIdDisplay)
		if (modifyTime != '') processDetailParts.push(modifyTime)
		if (contextName != '') processDetailParts.push(contextName)
		if (phaseIdDisplay != '') processDetailParts.push(phaseIdDisplay)
		if (secretIdDisplay != '') processDetailParts.push(secretIdDisplay)
		const processDetailLabel = processDetailParts.length > 0 ? processDetailParts.join(' | ') : '无工艺详情'
		bottomItems.push({ 
			label: processDetailLabel, 
			value: 'process-detail',
			state: '',
			stateType: 'default',
			version: ''
		} as BreadcrumbItem)

		bottomBreadcrumbItems.value = bottomItems
	}

	const handleRowClick = async (row: UTSJSONObject) => {
		// 如果是骨架节点（缺少业务字段），尝试从数据库获取完整记录
		let fullRow = row
		const nodeId = getNodeId(row)
		const nodeType = (row['type'] as string) ?? ''
		
		if (row['tabs_top'] == null || row['tabs_top'] == '') {
			const dbRecord = await queryNodeById(nodeType, nodeId)
			if (dbRecord != null) {
				fullRow = dbRecord
				// 继承骨架中的 children (如果是树节点点击)
				if (row['children'] != null) {
					fullRow['children'] = row['children']
				}
			}
		}

		selectedRow.value = fullRow
		// console.log('Row clicked:', fullRow['id'], fullRow['type'], fullRow['name'])
		
		statusMessage.value = `选中: ${fullRow['name']} (${fullRow['type']})`
		updateSelectedNodeInfo(fullRow)
		
		// 更新面包屑
		updateBreadcrumbs(fullRow)
		
		// 从节点的 tabs_top / tabs_bottom 字段动态读取关联的 group ID
		const nodeName = (fullRow['name'] as string) ?? ''
		const tabsTopId = (fullRow['tabs_top'] as string) ?? ''
		const tabsBottomId = (fullRow['tabs_bottom'] as string) ?? ''
		
		// 加载上方 Tab Group
		if (tabsTopId != '') {
			const group = await loadGroup(tabsTopId)
			if (group != null) {
				// 将当前节点数据绑定到 Group 的组件中
				await bindDataToGroup(group, fullRow)
				topGroup.value = group
				
				// 默认选中第一个 Tab
				if (!activeTabs.has(group.id) && group.tabs.length > 0) {
					activeTabs.set(group.id, group.tabs[0].id)
				}
			}
		} else {
			topGroup.value = null
		}
		
		// 加载下方 Tab Group
		if (tabsBottomId != '') {
			const group = await loadGroup(tabsBottomId)
			if (group != null) {
				await bindDataToGroup(group, fullRow)
				bottomGroup.value = group
				
				// 默认选中第一个 Tab
				if (!activeTabs.has(group.id) && group.tabs.length > 0) {
					activeTabs.set(group.id, group.tabs[0].id)
				}
			}
		} else {
			bottomGroup.value = null
		}
		
		// 加载节点关联的资源列表
		await loadNodeResources(nodeId, nodeName, nodeType)
	}
	
	// 将节点数据绑定到 Group 中的各个组件
	const bindDataToGroup = async (group: GroupVM, node: UTSJSONObject) => {
		const nodeType = (node['type'] as string) ?? ''
		const nodeId = getNodeId(node)

		for (let i = 0; i < group.tabs.length; i++) {
			const tab = group.tabs[i]
			for (let j = 0; j < tab.components.length; j++) {
				const comp = tab.components[j]
				// 始终先重置数据，防止任何残留
				comp.data = []

				if (comp.type == 'infoView' || comp.type == 'richText') {
					// 查自身
					const record = await queryNodeById(nodeType, nodeId)
					if (record != null) {
						comp.data = [record]
					} else {
						// Fallback: 如果数据库没查到，显示当前节点对象兜底
						comp.data = [node]
					}
				} else if (comp.type == 'table' || comp.type == 'list') {
					// 查子节点列表
					const children = await queryChildrenByParentId(nodeType, nodeId)
					// 如果外键未匹配到（可能是更底层的 action），fallback 为拿内存节点的 children
					if (children.length > 0) {
						comp.data = children.map((c: UTSJSONObject): UTSJSONObject => enrichNodeForDisplay(c))
					} else {
						const memoryChildren = node['children']
						if (memoryChildren != null && Array.isArray(memoryChildren)) {
							const list = memoryChildren as UTSJSONObject[]
							comp.data = list.map((c: UTSJSONObject): UTSJSONObject => enrichNodeForDisplay(c))
						}
					}
					
					// 按照 sortOrder 排序
					comp.data.sort((a, b) => {
					    const sa = a['sortOrder'] as number | null ?? 0
					    const sb = b['sortOrder'] as number | null ?? 0
					    return sa - sb
					})
				}
			}
		}
	}
	
	// 从 config 中提取 fields (用于表格和 InfoView)
	const getFieldsFromConfig = (config: any): UTSJSONObject[] => {
		if (config == null) return []
		const confObj = config as UTSJSONObject
		// 只从 fields 字段读取
		if (confObj['fields'] != null) {
			const fields = confObj['fields']
			if (Array.isArray(fields)) return fields as UTSJSONObject[]
		}
		return []
	}
	
	// 从 config 中提取列数配置（用于 InfoView 布局，默认 2 列）
	const getInfoViewColumnCount = (config: any): number => {
		if (config == null) return 2
		const confObj = config as UTSJSONObject
		const cols = confObj['columns']
		if (cols != null) return parseInt(cols.toString())
		return 2
	}
	
	// 获取节点类型的中文标签
	const getNodeTypeLabel = (nodeType: string): string => {
		if (nodeType == 'process') return '工艺'
		if (nodeType == 'operation') return '工序'
		if (nodeType == 'step') return '工步'
		return nodeType
	}
	
	// 更新选中节点的详细信息 (仅用于日志)
	const updateSelectedNodeInfo = (node: UTSJSONObject) => {
		/*
		const nodeType = node['type'] as string
		if (nodeType == 'process') {
			console.log('Selected process:', node['name'])
		} else if (nodeType == 'operation') {
			console.log('Selected operation:', node['name'])
		} else if (nodeType == 'step') {
			console.log('Selected step:', node['name'])
		}
		*/
	}
	
	// ============ 资源相关方法 ============
	
	/**
	 * 加载节点关联的资源列表
	 * @param nodeId 节点ID
	 * @param nodeName 节点名称（用于显示标题）
	 * @param nodeType 节点类型
	 */
	const loadNodeResources = async (nodeId: string, nodeName: string, nodeType: string) => {
		try {
			// 更新标题
			const typeLabel = getNodeTypeLabel(nodeType)
			nodeResourcesTitle.value = `${typeLabel}资源`
			
			// 从数据库加载资源
			const resources = await getResourcesByNodeId(nodeId)
			nodeResources.value = resources
			
			// 清空预览状态
			previewResource.value = null
			
			// 如果有资源，默认选中第一个
			if (resources.length > 0) {
				previewResource.value = resources[0]
			}
			
			console.log(`Loaded ${resources.length} resources for node: ${nodeId}`)
		} catch (e) {
			console.error('loadNodeResources error:', e)
			nodeResources.value = []
			previewResource.value = null
		}
	}
	
	/**
	 * 资源选择事件处理
	 * @param item 选中的资源项
	 */
	const onResourceSelect = (item: ResourceItem) => {
		previewResource.value = item
		console.log('Resource selected:', item.name, item.type)
	}
	
	/**
	 * 资源预览错误处理
	 * @param message 错误消息
	 */
	const onPreviewError = (message: string) => {
		uni.showToast({
			title: message,
			icon: 'none'
		})
	}
	
	/**
	 * 切换资源区域最大化
	 */
	const toggleResourceMaximize = () => {
		isResourceMaximized.value = !isResourceMaximized.value
		// 重置列表为可见状态
		if (isResourceMaximized.value) {
			isFullscreenListVisible.value = true
		}
		// PC 客户端：进入/退出沉浸式全屏（隐藏标题栏和菜单栏）
		// #ifdef WEB
		if (isPC.value) {
			const electronAPI = (window as any).electronAPI
			if (electronAPI != null) {
				if (isResourceMaximized.value) {
					electronAPI.enterImmersive()
				} else {
					electronAPI.exitImmersive()
				}
			}
		}
		// #endif
	}
	
	/**
	 * 切换全屏列表显示/隐藏
	 */
	const toggleFullscreenList = () => {
		isFullscreenListVisible.value = !isFullscreenListVisible.value
	}
	
	/**
	 * 切换到上一个资源
	 */
	const goPrevResource = () => {
		if (nodeResources.value.length <= 1) return
		let idx = currentResourceIndex.value - 1
		if (idx < 0) idx = nodeResources.value.length - 1
		previewResource.value = nodeResources.value[idx]
		// 切换资源时重置图片变换
		resetImageTransform()
	}
	
	/**
	 * 切换到下一个资源
	 */
	const goNextResource = () => {
		if (nodeResources.value.length <= 1) return
		let idx = currentResourceIndex.value + 1
		if (idx >= nodeResources.value.length) idx = 0
		previewResource.value = nodeResources.value[idx]
		// 切换资源时重置图片变换
		resetImageTransform()
	}
	
	/**
	 * 重置图片变换状态
	 */
	const resetImageTransform = () => {
		imageScale.value = 1
		imageRotation.value = 0
	}
	
	/**
	 * 图片放大
	 */
	const imageZoomIn = () => {
		if (imageScale.value < 5) {
			imageScale.value = Math.min(5, imageScale.value + 0.25)
		}
	}
	
	/**
	 * 图片缩小
	 */
	const imageZoomOut = () => {
		if (imageScale.value > 0.25) {
			imageScale.value = Math.max(0.25, imageScale.value - 0.25)
		}
	}
	
	/**
	 * 图片左旋转 90 度
	 */
	const imageRotateLeft = () => {
		imageRotation.value = (imageRotation.value - 90) % 360
	}
	
	/**
	 * 图片右旋转 90 度
	 */
	const imageRotateRight = () => {
		imageRotation.value = (imageRotation.value + 90) % 360
	}
	
	/**
	 * 图片重置到原始状态
	 */
	const imageReset = () => {
		resetImageTransform()
	}
	
	/**
	 * 全屏图片加载完成
	 */
	const onFullscreenImageLoad = (e: UniImageLoadEvent) => {
		// 图片加载完成时可以进行尺寸适配等操作
		const width = e.detail.width
		const height = e.detail.height
		
		if (width > 0 && height > 0) {
			const ratio = width / height
			// 如果是竖图 (高大于宽)，在宽屏/横屏显示模式下 aspectFit 会导致显示过小
			// 自动放大以便看得更清楚，让宽度尽可能撑满
			// 阈值设为 0.8 (即 height > 1.25 * width)
			if (ratio < 0.8) {
				imageScale.value = 1.5
			}
		}
	}
	
	/**
	 * 全局键盘事件处理（快捷键等）
	 */
	const handleGlobalKeyDown = (e : any) => {
		// 导入数据快捷键 Ctrl+I
		if (e.ctrlKey == true && (e.key == 'i' || e.key == 'I' || e.key == 'l' || e.key == 'L')) {
			if (typeof e.preventDefault == 'function') {
				e.preventDefault()
			}
			handleImportData()
			return
		}
		// 重置数据快捷键 Ctrl+R
		if (e.ctrlKey == true && (e.key == 'r' || e.key == 'R')) {
			if (typeof e.preventDefault == 'function') {
				e.preventDefault()
			}
			handleResetData()
			return
		}
		// 全屏资源预览退出快捷键 Esc
		if (isResourceMaximized.value && e.key == 'Escape') {
			toggleResourceMaximize()
		}
	}
	

	
</script>


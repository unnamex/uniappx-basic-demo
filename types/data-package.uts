/**
 * MPM 工艺预览系统 - V5 数据包类型定义
 * @description 定义 SRD 数据包的清单与配置类型
 */

/**
 * 数据包清单 (manifest.json)
 */
export type PackageManifest = {
	name: string
	version: string         // 应该为 "5.0" 或更高
	description: string | null
	exportTime: string | null
	source: string | null
	files: ManifestFileRefs
	checksum: string | null
}

/**
 * V5 文件引用
 * 所有布局配置使用 layout/ 前缀，工艺树为固定路径 data/process_tree.json 不再此处解析
 */
export type ManifestFileRefs = {
	tabs: string            // layout/tabs.json (原 groups.json)
	tab: string             // layout/tab.json (原 tabs.json)
	components: string      // layout/components.json
	icons: string | null    // layout/icons.json（可选）
	records: string | null  // data/records.json
	descriptions: string | null // data/descriptions.json（可选，V5.2 新增）
	attachment: string      // data/attachment.json (V5 强制独立附件列表)
	assets: string | null   // 资源目录路径 "assets/"
}

/**
 * 节点富文本内容记录 (对应 data/descriptions.json)
 */
export type NodeDescription = {
	nodeId: string          // 关联的工艺节点 innerId
	[key: string]: any      // 存储在此节点的富文本/长文本，如 description_html, safety_notice 等
}


/**
 * Tab 分组 (对应 layout/tabs.json)
 */
export type TabGroup = {
	id: string
	name: string
	type: string

	description: string
	sort_order: number
}

/**
 * Tab 配置 (对应 layout/tab.json)
 */
export type TabConfig = {
	id: string
	group_id: string
	title: string
	sort_order: number
	visible_condition: string | null
}

/**
 * 组件配置 (对应 layout/components.json)
 */
export type ComponentConfig = {
	id: string
	tab_id: string
	type: string // 'table' | 'collapse' | 'tableTree' | 'infoView' | 'richText' | 'list'
	title: string
	config: any // 组件自定义配置（JSON）
	sort_order: number
}

/**
 * 数据记录 (对应 data/records.json)
 */
export type DataRecord = {
	record_id: string
	component_id: string
	data: any // 数据内容（JSON）
}

/**
 * 导入进度类型
 */
export type ImportProgress = {
	current: number
	total: number
	currentFile: string
	status: string
}

/**
 * 导入结果类型
 */
export type ImportResult = {
	success: boolean
	message: string
	nodeCount: number        // 工艺树节点总数
	uiConfigCount: number
	resourceCount: number
	importTime: number
}

/**
 * 数据包文件信息
 */
export type PackageInfo = {
	fileName: string
	fileSize: number
	manifest: PackageManifest | null
	isValid: boolean
	errorMessage: string
}

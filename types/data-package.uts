/**
 * MPM 工艺预览系统 - V6 数据包类型定义
 * @description 定义 SRD 数据包的清单与配置类型
 */

/**
 * 数据包清单 (manifest.json)
 */
export type PackageManifest = {
	name: string;
	version: string;// 显示工艺的版本如 A.1, B.2 等
	description: string | null;
	exportTime: string | null;
	source: string | null;
	files: ManifestFileRefs;
	checksum: string | null;
}

/**
 * V6 文件引用
 * 所有布局配置使用 layout/ 前缀，工艺表存放在 data/ 路径下
 */
export type ManifestFileRefs = {
	tabs: string;// layout/tabs.json (原 groups.json)
	tab: string;// layout/tab.json (原 tabs.json)
	components: string;// layout/components.json
	icons: string | null;// layout/icons.json（可选）
	attachment: string;// data/attachment.json (独立附件列表)
	assets: string | null;// 资源目录路径 "assets/"
    
    // V6 新增工艺表数据文件
    process: string | null;// data/process.json
    operation: string | null;// data/operation.json
    step: string | null;// data/step.json
    action: string | null;// data/action.json
    
    // V6.1 节点关联数据集
    nodeDatasets: string | null;// data/node_datasets.json
}


/**
 * Tab 分组 (对应 layout/tabs.json)
 */
export type TabGroup = {
	id: string;
	name: string;
	type: string;

	description: string;
	sort_order: number;
}

/**
 * Tab 配置 (对应 layout/tab.json)
 */
export type TabConfig = {
	id: string;
	group_id: string;
	title: string;
	sort_order: number;
	visible_condition: string | null;
}

/**
 * 组件配置 (对应 layout/components.json)
 */
export type ComponentConfig = {
	id: string;
	tab_id: string;
	type: string;// 'table' | 'collapse' | 'tableTree' | 'infoView' | 'richText'
	title: string;
	config: any;// 组件自定义配置（JSON）
	sort_order: number;
}



/**
 * 导入进度类型
 */
export type ImportProgress = {
	current: number;
	total: number;
	currentFile: string;
	status: string;
}

/**
 * 导入结果类型
 */
export type ImportResult = {
	success: boolean;
	message: string;
	nodeCount: number;// 工艺树节点总数
	uiConfigCount: number;
	resourceCount: number;
	importTime: number;
}

/**
 * 数据包文件信息
 */
export type PackageInfo = {
	fileName: string;
	fileSize: number;
	manifest: PackageManifest | null;
	isValid: boolean;
	errorMessage: string;
}

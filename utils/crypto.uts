/**
 * MPM 工艺预览系统 - AES-256 加解密工具
 * @description 提供数据包的加密和解密功能
 */

// 预置密钥（生产环境应使用更安全的密钥管理方式）
export const PRESET_KEY: string = 'MPM_OFFLINE_2026_SECURE_KEY_256B'
const ALGORITHM: string = 'AES-256-CBC'

/**
 * 加密头信息类型
 */
type EncryptHeader = {
	iv: string
	algorithm: string
}

/**
 * 解密结果类型
 */
export type DecryptResult = {
	success: boolean
	data: ArrayBuffer | null
	errorMessage: string
}

/**
 * 解密数据包文件
 * @param encryptedData - 加密的数据
 * @returns 解密结果
 */
export function decryptPackage(encryptedData: ArrayBuffer): DecryptResult {
	// #ifdef APP-ANDROID
	return decryptAndroid(encryptedData)
	// #endif
	
	// #ifdef APP-HARMONY
	return decryptHarmony(encryptedData)
	// #endif
	
	// #ifdef WEB
	return decryptWeb(encryptedData)
	// #endif
}

/**
 * 异步解密数据包（Web 端使用 Web Crypto API，不走 IPC/contextBridge）
 * @param encryptedData - 加密的数据
 * @returns Promise<DecryptResult>
 */
export function decryptPackageAsync(encryptedData: ArrayBuffer): Promise<DecryptResult> {
	// #ifdef APP-ANDROID
	return new Promise((resolve: (value: DecryptResult) => void, reject: (reason: Error) => void) => {
		resolve(decryptAndroid(encryptedData))
	})
	// #endif
	
	// #ifdef APP-HARMONY
	return new Promise((resolve: (value: DecryptResult) => void, reject: (reason: Error) => void) => {
		resolve(decryptHarmony(encryptedData))
	})
	// #endif
	
	// #ifdef WEB
	return decryptWebAsync(encryptedData)
	// #endif
}

// #ifdef APP-ANDROID
import Cipher from 'javax.crypto.Cipher';
import SecretKeySpec from 'javax.crypto.spec.SecretKeySpec';
import IvParameterSpec from 'javax.crypto.spec.IvParameterSpec';

/**
 * Android 平台解密实现
 */
function decryptAndroid(encryptedData: ArrayBuffer): DecryptResult {
	try {
		const dataBytes = new Int8Array(encryptedData)
		
		// 读取加密头（前16字节为IV）
		if (dataBytes.length < 16) {
			return {
				success: false,
				data: null,
				errorMessage: '数据包格式错误：数据太短'
			}
		}
		
		const ivBytes = dataBytes.slice(0, 16)
		const encryptedBytes = dataBytes.slice(16)
		
		// 初始化解密器
		const keyBytes = PRESET_KEY.substring(0, 32).split('').map((c: string): number => c.charCodeAt(0) as number)
		const secretKey = new SecretKeySpec(keyBytes as ByteArray, 'AES')
		const ivSpec = new IvParameterSpec(ivBytes as ByteArray)
		
		const cipher = Cipher.getInstance('AES/CBC/PKCS5Padding')
		cipher.init(Cipher.DECRYPT_MODE, secretKey, ivSpec)
		
		const decryptedBytes = cipher.doFinal(encryptedBytes as ByteArray)
		
		return {
			success: true,
			data: (decryptedBytes as Int8Array).buffer,
			errorMessage: ''
		}
	} catch (e: any) {
		return {
			success: false,
			data: null,
			errorMessage: '解密失败：' + e.message
		}
	}
}
// #endif

// #ifdef APP-HARMONY
import cryptoFramework from '@ohos.security.cryptoFramework';
import buffer from '@ohos.buffer';
import fs from '@ohos.file.fs';

/**
 * HarmonyOS 平台解密实现
 * @description 使用 @ohos.security.cryptoFramework 的 AES-256-CBC 解密
 */
function decryptHarmony(encryptedData: ArrayBuffer): DecryptResult {
	try {
		const dataBytes = new Uint8Array(encryptedData)
		
		// 校验数据长度（至少包含 16 字节 IV）
		if (dataBytes.length < 16) {
			return {
				success: false,
				data: null,
				errorMessage: '数据包格式错误：数据太短'
			}
		}
		
		// 提取 IV（前 16 字节）和加密数据
		const ivBytes = dataBytes.slice(0, 16)
		const cipherBytes = dataBytes.slice(16)
		
		// 构建密钥（截取前 32 字节）
		const keyStr = PRESET_KEY.substring(0, 32)
		const keyBuffer = buffer.from(keyStr, 'utf-8')
		
		// 创建对称密钥
		const symKeyBlob: cryptoFramework.DataBlob = { data: new Uint8Array(keyBuffer.buffer) }
		const symKeyGenerator = cryptoFramework.createSymKeyGenerator('AES256')
		const symKey = symKeyGenerator.convertKeySync(symKeyBlob)
		
		// 创建 IV 参数
		const ivBlob: cryptoFramework.DataBlob = { data: ivBytes }
		const ivParam: cryptoFramework.IvParamsSpec = {
			algName: 'IvParamsSpec',
			iv: ivBlob
		}
		
		// 创建解密器并执行解密
		const cipher = cryptoFramework.createCipher('AES256|CBC|PKCS7')
		cipher.initSync(cryptoFramework.CryptoMode.DECRYPT_MODE, symKey, ivParam)
		
		const cipherBlob: cryptoFramework.DataBlob = { data: cipherBytes }
		const decryptedBlob = cipher.doFinalSync(cipherBlob)
		
		if (decryptedBlob != null && decryptedBlob.data != null) {
			return {
				success: true,
				data: decryptedBlob.data.buffer as ArrayBuffer,
				errorMessage: ''
			}
		} else {
			return {
				success: false,
				data: null,
				errorMessage: 'Harmony 解密结果为空'
			}
		}
	} catch (e: any) {
		return {
			success: false,
			data: null,
			errorMessage: 'Harmony 解密失败：' + e.message
		}
	}
}

/**
 * 鸿蒙平台超大文件流式解密
 * @param sourcePath 原始加密文件路径
 * @param destPath 解密后写出的路径
 * @returns 解密是否成功
 */
export async function streamDecryptHarmony(sourcePath: string, destPath: string): Promise<boolean> {
	let sourceFile: fs.File | null = null;
	let destFile: fs.File | null = null;
	try {
		sourceFile = fs.openSync(sourcePath, fs.OpenMode.READ_ONLY);
		
		// 1. 读取前4字节判断是否为ZIP
		let headerBuffer = new ArrayBuffer(4);
		let readLen = fs.readSync(sourceFile.fd, headerBuffer, { offset: 0, length: 4 });
		let isZip = false;
		if (readLen == 4) {
			const headerArray = new Uint8Array(headerBuffer);
			isZip = headerArray[0] == 0x50 && headerArray[1] == 0x4B && headerArray[2] == 0x03 && headerArray[3] == 0x04;
		}

		// 2. 若为未加密 ZIP，直接复制
		if (isZip) {
			fs.closeSync(sourceFile);
			sourceFile = null;
			fs.copyFileSync(sourcePath, destPath);
			return true;
		}

		// 3. 若加密，读取前16字节为 IV
		let ivBuffer = new ArrayBuffer(16);
		readLen = fs.readSync(sourceFile.fd, ivBuffer, { offset: 0, length: 16 });
		if (readLen < 16) {
			throw new Error("数据包格式错误：文件大小不足");
		}
		const ivBytes = new Uint8Array(ivBuffer);

		// 构建解密器
		const keyStr = PRESET_KEY.substring(0, 32);
		const keyBuffer = buffer.from(keyStr, 'utf-8');
		const symKeyBlob: cryptoFramework.DataBlob = { data: new Uint8Array(keyBuffer.buffer) };
		const symKeyGenerator = cryptoFramework.createSymKeyGenerator('AES256');
		const symKey = symKeyGenerator.convertKeySync(symKeyBlob);
		
		const ivBlob: cryptoFramework.DataBlob = { data: ivBytes };
		const ivParam: cryptoFramework.IvParamsSpec = { algName: 'IvParamsSpec', iv: ivBlob };
		
		const cipher = cryptoFramework.createCipher('AES256|CBC|PKCS7');
		cipher.initSync(cryptoFramework.CryptoMode.DECRYPT_MODE, symKey, ivParam);

		// 打开目标文件用于写入
		destFile = fs.openSync(destPath, fs.OpenMode.WRITE_ONLY | fs.OpenMode.CREATE | fs.OpenMode.TRUNC);

		// 4. 流式读取和解密 (每次 1MB)
		let offset = 16;
		let chunkSize = 1024 * 1024;
		let chunkBuffer = new ArrayBuffer(chunkSize);
		
		while (true) {
			let bytesRead = fs.readSync(sourceFile.fd, chunkBuffer, { offset: offset, length: chunkSize });
			if (bytesRead <= 0) break;
			
			// 只取实际读取到的长度
			const actualData = new Uint8Array(chunkBuffer).subarray(0, bytesRead);
			let updateData: cryptoFramework.DataBlob = { data: actualData };
			let res = cipher.updateSync(updateData);
			
			if (res != null && res.data != null && res.data.length > 0) {
				fs.writeSync(destFile.fd, res.data.buffer);
			}
			offset += bytesRead;
		}

		// 5. 处理最后的分组和 padding
		let finalResult = cipher.doFinalSync(null);
		if (finalResult != null && finalResult.data != null && finalResult.data.length > 0) {
			fs.writeSync(destFile.fd, finalResult.data.buffer);
		}

		return true;
	} catch (e: any) {
		console.error("鸿蒙流式解密失败: ", e.message);
		return false;
	} finally {
		if (sourceFile != null) {
			try { fs.closeSync(sourceFile); } catch (e: any) {}
		}
		if (destFile != null) {
			try { fs.closeSync(destFile); } catch (e: any) {}
		}
	}
}
// #endif

// #ifdef WEB
/**
 * Web 平台同步解密实现（保留兼容，但不推荐用于大文件）
 */
function decryptWeb(encryptedData: ArrayBuffer): DecryptResult {
	// 同步版本不再使用，直接返回提示使用异步版本
	return {
		success: false,
		data: null,
		errorMessage: 'Web 端请使用异步解密 decryptPackageAsync'
	}
}

/**
 * Web 平台异步解密实现（使用浏览器内置 Web Crypto API）
 * @description 完全在渲染进程内完成解密，不走 IPC/contextBridge，避免大数据跨进程传输导致的 OOM 崩溃
 */
function decryptWebAsync(encryptedData: ArrayBuffer): Promise<DecryptResult> {
	return new Promise((resolve: (value: DecryptResult) => void, reject: (reason: Error) => void) => {
		try {
			const data = new Uint8Array(encryptedData)
			if (data.length < 16) {
				resolve({
					success: false,
					data: null,
					errorMessage: '数据包格式错误：数据太短'
				} as DecryptResult)
				return
			}
			
			// 提取 IV（前 16 字节）和密文
			const iv = data.slice(0, 16)
			const cipherText = data.slice(16)
			
			// 构建密钥（UTF-8 编码，截取前 32 字节）
			const keyStr = PRESET_KEY.substring(0, 32)
			const keyBytes = new Uint8Array(32)
			for (let i = 0; i < 32; i++) {
				keyBytes[i] = keyStr.charCodeAt(i)
			}
			
			// 使用 Web Crypto API 解密（完全在渲染进程本地完成，零 IPC 开销）
			const subtle = (window as any).crypto.subtle
			subtle.importKey('raw', keyBytes.buffer as ArrayBuffer, { name: 'AES-CBC' }, false, ['decrypt'])
				.then((key: any) => {
					return subtle.decrypt({ name: 'AES-CBC', iv: iv }, key, cipherText)
				})
				.then((decrypted: any) => {
					console.log('Web Crypto API 解密成功，数据大小:', (decrypted as ArrayBuffer).byteLength)
					resolve({
						success: true,
						data: decrypted as ArrayBuffer,
						errorMessage: ''
					} as DecryptResult)
				})
				.catch((e: any) => {
					console.error('Web Crypto API 解密失败:', e)
					resolve({
						success: false,
						data: null,
						errorMessage: 'Web Crypto 解密失败：' + (e.message != null ? e.message : String(e))
					} as DecryptResult)
				})
		} catch (e: any) {
			console.error('Web 解密异常:', e)
			resolve({
				success: false,
				data: null,
				errorMessage: '解密异常：' + (e.message != null ? e.message : String(e))
			} as DecryptResult)
		}
	})
}
// #endif

/**
 * 验证数据包完整性（MD5校验）
 * @param data - 数据
 * @param expectedChecksum - 期望的校验值
 * @returns 是否验证通过
 */
export function verifyChecksum(data: ArrayBuffer, expectedChecksum: string): boolean {
	// #ifdef APP-ANDROID
	return verifyChecksumAndroid(data, expectedChecksum)
	// #endif
	
	// #ifdef APP-HARMONY
	return verifyChecksumHarmony(data, expectedChecksum)
	// #endif
	
	// #ifdef WEB
	return verifyChecksumWeb(data, expectedChecksum)
	// #endif
}

// #ifdef APP-ANDROID
import MessageDigest from 'java.security.MessageDigest';

function verifyChecksumAndroid(data: ArrayBuffer, expectedChecksum: string): boolean {
	try {
		const md = MessageDigest.getInstance('MD5')
		const dataBytes = new Int8Array(data)
		md.update(dataBytes as ByteArray)
		const digestBytes = md.digest()
		
		// 转换为十六进制字符串
		let hexString = ''
		for (let i = 0; i < digestBytes.length; i++) {
			const hex = (digestBytes[i] & 0xFF).toString(16)
			if (hex.length == 1) {
				hexString += '0'
			}
			hexString += hex
		}
		
		return hexString.toLowerCase() == expectedChecksum.toLowerCase()
	} catch (e: any) {
		console.error('MD5 校验失败：', e.message)
		return false
	}
}
// #endif

// #ifdef APP-HARMONY
/**
 * HarmonyOS 平台 MD5 校验实现
 * @description 使用 @ohos.security.cryptoFramework 计算 MD5 哈希
 */
function verifyChecksumHarmony(data: ArrayBuffer, expectedChecksum: string): boolean {
	try {
		const md = cryptoFramework.createMd('MD5')
		const dataBlob: cryptoFramework.DataBlob = { data: new Uint8Array(data) }
		md.updateSync(dataBlob)
		const digestBlob = md.digestSync()
		
		// 转换为十六进制字符串
		let hexString = ''
		if (digestBlob.data != null) {
			for (let i = 0; i < digestBlob.data.length; i++) {
				const hex = (digestBlob.data[i] & 0xFF).toString(16)
				if (hex.length == 1) {
					hexString += '0'
				}
				hexString += hex
			}
		}
		
		return hexString.toLowerCase() == expectedChecksum.toLowerCase()
	} catch (e: any) {
		console.error('Harmony MD5 校验失败：', e.message)
		return false
	}
}
// #endif

// #ifdef WEB
function verifyChecksumWeb(data: ArrayBuffer, expectedChecksum: string): boolean {
	try {
		// 检查是否在 Electron 环境下并提供了 MD5 校验方法
		if ((window as any).electronAPI != null && typeof (window as any).electronAPI.verifyMD5_Sync === 'function') {
			return (window as any).electronAPI.verifyMD5_Sync(data, expectedChecksum) as boolean
		}
		
		console.log('Web checksum verification (placeholder)')
		return true
	} catch (e: any) {
		console.error('Web MD5 校验失败：', e.message)
		return false
	}
}
// #endif
